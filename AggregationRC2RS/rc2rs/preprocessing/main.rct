stm AggregationFSM {
	uses Ievents uses IvarsAggregationFSM requires AggregationIface requires I_clone_AggregationFSM_MoveClockwise_entry_1 requires I_clone_AggregationFSM_RotateClockwise_entry_2 initial I
	state S1 {
		state EmptyCycle {
		}
		initial i
		transition tS1 {
			from i
			to EmptyCycle
		}
		entry clone_AggregationFSM_MoveClockwise_entry_1 ( 1 , 1 )
	}
	state S2 {
		state EmptyCycle {
		}
		initial i
		transition tS2 {
			from i
			to EmptyCycle
		}
		entry clone_AggregationFSM_RotateClockwise_entry_2 ( 1 )
	}
	transition T1 {
		from I
		to S1
	}
	transition T2 {
		from S2
		to S1
		trigger seeWall
	}
	transition T3 {
		from S1
		to S2
		trigger seeRobot
	}
}

