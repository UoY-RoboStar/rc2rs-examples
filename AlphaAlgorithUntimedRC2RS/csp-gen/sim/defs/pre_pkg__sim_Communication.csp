				    const_pre_pkg__sim_Communication_RC) = STM_VS_O(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) \ localClockResets
		D__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = timed_priority(STM(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) \ union(internal_events,localClockResets))
		O__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = dbisim(D__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC))
		VS__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = FVS__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC)
		VS_O__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = dbisim(FVS__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC))
		HEXT__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = O__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) [|shared_variable_events|] SKIP
		FVS_C__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = dbisim(timed_priority(STM(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) \ internal_events))
		HUP__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = timed_priority(O__(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) [|{share__}|] SKIP)
		
		-- Clocks
		Clock_CLID_RCC(id__,x__,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC) = 
			TimeOut_1(
				clockReset.CLID_RCC -> Clock_CLID_RCC(id__,0,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)
				[]
				get_CLID_RCC!x__ -> Clock_CLID_RCC(id__,x__,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)
				[]
				terminate -> SKIP,Clock_CLID_RCC(id__,clock_type_plus(x__,1,CLID_RCC_clock_type(id__,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)),
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC))
		
		Clocks(id__,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC) = dbisim(Clock_CLID_RCC(id__,0,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC))
		
		clockSync = {|get_CLID_RCC,clockReset.CLID_RCC|}
		
		Clock_CLID_Receive(id__,x__,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC) = 
			TimeOut_1(
				Receive::entered -> Clock_CLID_Receive(id__,0,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)
				[]
				get_CLID_Receive!x__ -> Clock_CLID_Receive(id__,x__,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)
				[]
				terminate -> SKIP,Clock_CLID_Receive(id__,clock_type_plus(x__,1,CLID_Receive_clock_type(id__,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)),
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC))
		Clock_CLID_Broadcast(id__,x__,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC) = 
			TimeOut_1(
				Broadcast::entered -> Clock_CLID_Broadcast(id__,0,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)
				[]
				get_CLID_Broadcast!x__ -> Clock_CLID_Broadcast(id__,x__,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)
				[]
				terminate -> SKIP,Clock_CLID_Broadcast(id__,clock_type_plus(x__,1,CLID_Broadcast_clock_type(id__,
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC)),
						          const_pre_pkg__sim_Communication_id,
						          const_pre_pkg__sim_Communication_RC))
		
		StateClocks(id__,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC) = dbisim(Clock_CLID_Receive(id__,0,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC))
		[| { terminate } |] (
		dbisim(Clock_CLID_Broadcast(id__,0,
				          const_pre_pkg__sim_Communication_id,
				          const_pre_pkg__sim_Communication_RC))
		)
		
		stateClockSync = {|get_CLID_Receive,Receive::entered,get_CLID_Broadcast,Broadcast::entered|}
		
		
		-- Shared memory
		-- Shared memory variables
		
		Memory_broadcast(x__) = (
			get_broadcast!x__ -> Memory_broadcast(x__)
			[]
			registerRead.i_broadcast?x__ -> Memory_broadcast(x__)
			[]
			terminate -> SKIP
		)
		Memory_receive(x__) = (
			get_receive!x__ -> Memory_receive(x__)
			[]
			registerRead.i_receive?x__ -> Memory_receive(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_pre_pkg__sim_Communication_Communication,
				    const_pre_pkg__sim_Communication_id,
				    const_pre_pkg__sim_Communication_RC) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_broadcast(false.0)
		 [| { terminate } |] (
		 Memory_receive(false.(0,0))
		 )
		 )
		)
		
		sharedVarSync = union({|get_broadcast,
		get_receive|},
			  {||}
			 )
		
		sharedVarHide = union({|get_broadcast,
		get_receive|},
			  {||}
			 )
		
		}
endmodule
