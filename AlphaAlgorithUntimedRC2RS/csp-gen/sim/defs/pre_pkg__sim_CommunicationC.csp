			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = STM_VS_O(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) \ localClockResets
			D__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = timed_priority(STM(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) \ union(internal_events,localClockResets))
			O__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = dbisim(D__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id))
			VS__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = FVS__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id)
			VS_O__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = dbisim(FVS__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id))
			HEXT__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = O__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) [|shared_variable_events|] SKIP
			FVS_C__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = dbisim(timed_priority(STM(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) \ internal_events))
			HUP__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = timed_priority(O__(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) [|{share__}|] SKIP)
			
			-- Clocks
			
			Clocks(id__,
					          const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = terminate -> SKIP
			
			clockSync = {||}
			
			
			StateClocks(id__,
					          const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = terminate -> SKIP
			
			stateClockSync = {||}
			
			}
				endmodule
	
	Timed(OneStep) {
	-- (Rule 8) cycleController(...) : CSPProcess
	datatype SOutputEvents = SOutput_receive
		| SOutput_broadcast
		| SOutput_robots
	
	DVarsEvents = {}
	
	EVarsEvents = {}
	
	cycleController(id__,cycle_pre_pkg__sim_CommunicationC_CommunicationC,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_RC) =
	let
				
		project_stm_ref0(stm_ref0::o_receive.x__) = SOutput_receive
		project_stm_ref0(stm_ref0::o_broadcast.x__) = SOutput_broadcast
		project_stm_ref0(stm_ref0::o_robots.x__) = SOutput_robots
	
		connected_stm_ref0(stm_ref0::o_receive.x__) = true
		connected_stm_ref0(stm_ref0::o_broadcast.x__) = true
		connected_stm_ref0(stm_ref0::o_robots.x__) = true
		connected_stm_ref0(_) = false
	
		lift_stm_ref0(stm_ref0::o_receive.x__) = o_receive.x__
		lift_stm_ref0(stm_ref0::o_broadcast.x__) = o_broadcast.x__
		lift_stm_ref0(stm_ref0::o_robots.x__) = o_robots.x__
		
		CycleController =
			Deadline(
			-- read inputs from the controller and pass to state machines
			(
			((registerRead.i_broadcast?x__ ->
				((stm_ref0::registerRead.stm_ref0::i_broadcast!x__ -> SKIP)))
				|||
			(registerRead.i_receive?x__ ->
				((stm_ref0::registerRead.stm_ref0::i_receive!x__ -> SKIP))))
			-- ensure state machines read the values being communicated via evars
					);
			-- synchronize on events related to evars to erase memory
			-- collect outputs, and monitor termination of the cycle, by all controllers
			(CollectOutputs(SOutputEvents) [| {endexec} |] Monitor),0);
			-- wait for the cycleDef period
			TimeOut_1(terminate -> SKIP,WAIT(cycle_pre_pkg__sim_CommunicationC_CommunicationC-1));
			-- recurse
			CycleController
			
									
		CollectOutputs(sout) =
			(stm_ref0::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- stm_ref0::RegisterDataOutput, connected_stm_ref0(outp), project_stm_ref0(outp) == outc}
					-> registerWrite!lift_stm_ref0(outp)
						-> CollectOutputs(diff(sout,{project_stm_ref0(outp)}))
			[]
			endexec -> SKIP
			)
	
		Monitor = 
			(	 (stm_ref0::endexec -> SKIP)); endexec -> SKIP
	within
		CycleController
	
	-- (Rule 5) memoryComp(...) : CSPProcess
	memoryComp(id__,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_RC) = (
		STOP)
	
	
	-- (Rule 7) [[ c : Controller ]]_C : CSPProcess
	D__(id__,cycle_pre_pkg__sim_CommunicationC_CommunicationC,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_RC) =
	timed_priority(
		(
			(
				(
					(
					dbisim(cycleController(id__,cycle_pre_pkg__sim_CommunicationC_CommunicationC,
							    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
							    const_pre_pkg__sim_CommunicationC_stm_ref0_RC))
				 	 [| Union({{||},
				 	 		  {||},
				 	 		  {||},
				 	 		  {||}}) |]
				 	memoryComp(id__,
				 			    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
				 			    const_pre_pkg__sim_CommunicationC_stm_ref0_RC)
				 	)\{||}
					[| {| 	terminate,tock,
							stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((let
				 		const_pre_pkg__sim_Communication_id = const_pre_pkg__sim_CommunicationC_stm_ref0_id
				 		const_pre_pkg__sim_Communication_RC = const_pre_pkg__sim_CommunicationC_stm_ref0_RC
				 		cycle_pre_pkg__sim_Communication_Communication = cycle_pre_pkg__sim_CommunicationC_CommunicationC
				 	within
				 		(stm_ref0::D__(id__,cycle_pre_pkg__sim_Communication_Communication,
				 				    const_pre_pkg__sim_Communication_id,
				 				    const_pre_pkg__sim_Communication_RC)
				 		\{| 
				 		stm_ref0::registerRead.stm_ref0::i_receive
				 	|})
				 		[[stm_ref0::terminate <- terminate]]
				 	)
				 	)
				) \ {|	stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	
	O__(id__,cycle_pre_pkg__sim_CommunicationC_CommunicationC,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
			    const_pre_pkg__sim_CommunicationC_stm_ref0_RC) = 
	timed_priority(
		dbisim(
			(
				(
					(
					dbisim(cycleController(id__,cycle_pre_pkg__sim_CommunicationC_CommunicationC,
							    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
							    const_pre_pkg__sim_CommunicationC_stm_ref0_RC))
				 	 [| Union({{||},
				 	 		  {||},
				 	 		  {||},
				 	 		  {||}}) |]
				 	memoryComp(id__,
				 			    const_pre_pkg__sim_CommunicationC_stm_ref0_id,
				 			    const_pre_pkg__sim_CommunicationC_stm_ref0_RC)
				 	)\{||}
					[| {| 	terminate,tock,
							stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((let
				 		const_pre_pkg__sim_Communication_id = const_pre_pkg__sim_CommunicationC_stm_ref0_id
				 		const_pre_pkg__sim_Communication_RC = const_pre_pkg__sim_CommunicationC_stm_ref0_RC
				 		cycle_pre_pkg__sim_Communication_Communication = cycle_pre_pkg__sim_CommunicationC_CommunicationC
				 	within
				 		(stm_ref0::O__(id__,cycle_pre_pkg__sim_Communication_Communication,
				 				    const_pre_pkg__sim_Communication_id,
				 				    const_pre_pkg__sim_Communication_RC)
				 		\{| 
				 		stm_ref0::registerRead.stm_ref0::i_receive
				 	|})
				 		[[stm_ref0::terminate <- terminate]]
				 	)
				 	)
				) \ {|	stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	}
endmodule
