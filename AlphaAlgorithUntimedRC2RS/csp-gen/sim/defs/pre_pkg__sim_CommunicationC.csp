						)
						 \ hideSet)
						[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
						[[ endexec_action <- endexec ]]
						[[ startexec_action <- startexec ]]
					)
					)
					 [| union(stateClockSync,{terminate}) |]
					 StateClocks(id__,
					 		          const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id)
					)\diff(stateClockSync,enteredSS))
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__,
					    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) = 
				dbisim((let
					stateClockSync = {||}
				 within
					(MachineBody(id__,
							    const_pre_pkg__sim_clone_normal_Communication_Broadcast_entry_id) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
