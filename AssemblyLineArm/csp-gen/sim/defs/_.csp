		-- Visible counterparts
		MachineBody_VS_O(id__,
					param_x,
					param_y,
				    const_pidOp_HEIGHT_TO_SHAPE1,
				    const_pidOp_HEIGHT_TO_SHAPE2,
				    const_pidOp_WAIT_LOWER1,
				    const_pidOp_WAIT_LOWER2,
				    const_pidOp_BELT_SPEED,
				    const_pidOp_step_size,
				    const_pidOp_STEP_SIZE) = 
			dbisim((
			let
				finalNodesEntered = {|f1::entered|}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					i1::enter,
					STEP::enter,
					j1::enter,
					f1::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited|})
						transSync = {|internal__.NID_i1,internal__.NID_j1,internal__.NID_STEP,internal__.NID_j1|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   i1::VS_O__(id__,
						   			param_x,
						   			param_y,
						   		    const_pidOp_HEIGHT_TO_SHAPE1,
						   		    const_pidOp_HEIGHT_TO_SHAPE2,
						   		    const_pidOp_WAIT_LOWER1,
						   		    const_pidOp_WAIT_LOWER2,
						   		    const_pidOp_BELT_SPEED,
						   		    const_pidOp_step_size,
						   		    const_pidOp_STEP_SIZE)
						   [| { share__, terminate } |] (
						   STEP::VS_O__(id__,
						   			param_x,
						   			param_y,
						   		    const_pidOp_HEIGHT_TO_SHAPE1,
						   		    const_pidOp_HEIGHT_TO_SHAPE2,
						   		    const_pidOp_WAIT_LOWER1,
						   		    const_pidOp_WAIT_LOWER2,
						   		    const_pidOp_BELT_SPEED,
						   		    const_pidOp_step_size,
						   		    const_pidOp_STEP_SIZE)
						   [| { share__, terminate } |] (
						   j1::VS_O__(id__,
						   			param_x,
						   			param_y,
						   		    const_pidOp_HEIGHT_TO_SHAPE1,
						   		    const_pidOp_HEIGHT_TO_SHAPE2,
						   		    const_pidOp_WAIT_LOWER1,
						   		    const_pidOp_WAIT_LOWER2,
						   		    const_pidOp_BELT_SPEED,
						   		    const_pidOp_step_size,
						   		    const_pidOp_STEP_SIZE)
						   [| { share__, terminate } |] (
						   f1::VS_O__(id__,
						   			param_x,
						   			param_y,
						   		    const_pidOp_HEIGHT_TO_SHAPE1,
						   		    const_pidOp_HEIGHT_TO_SHAPE2,
						   		    const_pidOp_WAIT_LOWER1,
						   		    const_pidOp_WAIT_LOWER2,
						   		    const_pidOp_BELT_SPEED,
						   		    const_pidOp_step_size,
						   		    const_pidOp_STEP_SIZE)
						   )
						   )
						   )
						 )
						 [[STEP::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_STEP|}]]
						 [[f1::interrupt <- x__ | x__ <- {|interrupt|}]]
						 [[i1::interrupt <- x__ | x__ <- {|internal__.NID_i1|}]]
						 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1,internal__.NID_j1|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						  [[set_e_radius <- setL_e_radius,set_epsilon_radius <- setL_epsilon_radius,set_e_theta <- setL_e_theta,set_epsilon_theta <- setL_epsilon_theta]]
						 )
						 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
						 			,setL_e_radius
						 			,setL_epsilon_radius
						 			,setL_e_theta
						 			,setL_epsilon_theta
						|}) |]
						 ((i1::enter -> Transitions(id__,
						 			param_x,
						 			param_y,
						 		    const_pidOp_HEIGHT_TO_SHAPE1,
						 		    const_pidOp_HEIGHT_TO_SHAPE2,
						 		    const_pidOp_WAIT_LOWER1,
						 		    const_pidOp_WAIT_LOWER2,
						 		    const_pidOp_BELT_SPEED,
						 		    const_pidOp_step_size,
						 		    const_pidOp_STEP_SIZE))
						  [[ share__ <- x__ | x__ <- {| share__,setL_e_radius,setL_epsilon_radius,setL_e_theta,setL_epsilon_theta |} ]]
						 )
						)[[setL_e_radius <- set_e_radius,setL_epsilon_radius <- set_epsilon_radius,setL_e_theta <- set_e_theta,setL_epsilon_theta <- set_epsilon_theta]]
						)
					)
					 \ hideSet)
					[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
					[[ endexec_action <- endexec ]]
					[[ startexec_action <- startexec ]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__,
				 		          const_pidOp_HEIGHT_TO_SHAPE1,
				 		          const_pidOp_HEIGHT_TO_SHAPE2,
				 		          const_pidOp_WAIT_LOWER1,
				 		          const_pidOp_WAIT_LOWER2,
				 		          const_pidOp_BELT_SPEED,
				 		          const_pidOp_step_size,
				 		          const_pidOp_STEP_SIZE)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour_VS_O(id__,
					param_x,
					param_y,
				    const_pidOp_HEIGHT_TO_SHAPE1,
				    const_pidOp_HEIGHT_TO_SHAPE2,
