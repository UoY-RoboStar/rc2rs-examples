								          const_pidOp_STEP_SIZE))
					)\{|get_CLID_STEP|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,
					param_x,
					param_y,
