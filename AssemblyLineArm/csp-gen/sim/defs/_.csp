		----------------------------------------------------------------------
		-- Initial: i1
		module i1
		exports
		
			channel enter, interrupt
			
			Timed(OneStep) {
				D__(id__,
							param_x,
							param_y,
						    const_interceptOp_HEIGHT_TO_SHAPE1,
						    const_interceptOp_HEIGHT_TO_SHAPE2,
						    const_interceptOp_WAIT_LOWER1,
						    const_interceptOp_WAIT_LOWER2,
						    const_interceptOp_BELT_SPEED,
						    const_interceptOp_step_size,
						    const_interceptOp_STEP_SIZE) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,
							param_x,
							param_y,
						    const_interceptOp_HEIGHT_TO_SHAPE1,
						    const_interceptOp_HEIGHT_TO_SHAPE2,
