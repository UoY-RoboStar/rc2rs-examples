		----------------------------------------------------------------------
		-- State: STEP
		module STEP
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			channel endexec__ : NIDS
			
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
							param_x,
							param_y,
						    const_interceptOp_HEIGHT_TO_SHAPE1,
						    const_interceptOp_HEIGHT_TO_SHAPE2,
						    const_interceptOp_WAIT_LOWER1,
						    const_interceptOp_WAIT_LOWER2,
						    const_interceptOp_BELT_SPEED,
						    const_interceptOp_step_size,
						    const_interceptOp_STEP_SIZE) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(share__choice(get_t_theta?t_theta -> share__choice(get_c_theta?c_theta -> true & (share__choice(set_e_theta!calc_e_theta(t_theta,c_theta) -> SKIP)))));share__choice(share__choice(get_c_radius?c_radius -> share__choice(get_t_radius?t_radius -> true & (share__choice(set_e_radius!calc_e_radius(t_radius,c_radius) -> SKIP)))));share__choice(share__choice(get_e_theta?e_theta -> share__choice(get_p_e_theta?p_e_theta -> true & (share__choice(set_d_theta!calc_d_theta(e_theta,p_e_theta,const_interceptOp_STEP_SIZE) -> SKIP)))));share__choice(share__choice(get_p_e_radius?p_e_radius -> share__choice(get_e_radius?e_radius -> true & (share__choice(set_d_radius!calc_d_radius(e_radius,p_e_radius,const_interceptOp_STEP_SIZE) -> SKIP)))));share__choice(share__choice(get_e_theta?e_theta -> share__choice(get_p_e_theta?p_e_theta -> share__choice(get_i_theta?i_theta -> true & (share__choice(set_i_theta!Plus(i_theta, calc_i_theta(e_theta,p_e_theta,const_interceptOp_STEP_SIZE), core_real) -> SKIP))))));share__choice(share__choice(get_p_e_radius?p_e_radius -> share__choice(get_i_radius?i_radius -> share__choice(get_e_radius?e_radius -> true & (share__choice(set_i_radius!Plus(i_radius, calc_i_radius(e_radius,p_e_radius,const_interceptOp_STEP_SIZE), core_real) -> SKIP))))));share__choice(share__choice(get_e_theta?e_theta -> share__choice(get_i_theta?i_theta -> share__choice(get_d_theta?d_theta -> true & (share__choice(set_v_theta!calc_v_theta(e_theta,i_theta,d_theta) -> SKIP))))));share__choice(get_v_theta?v_theta -> true&CALL__set_v_theta(
								id__,
							    const_interceptOp_HEIGHT_TO_SHAPE1,
							    const_interceptOp_HEIGHT_TO_SHAPE2,
							    const_interceptOp_WAIT_LOWER1,
							    const_interceptOp_WAIT_LOWER2,
							    const_interceptOp_BELT_SPEED,
							    const_interceptOp_step_size,
							    const_interceptOp_STEP_SIZE,
								v_theta
							));share__choice(share__choice(get_d_radius?d_radius -> share__choice(get_e_radius?e_radius -> share__choice(get_i_radius?i_radius -> true & (share__choice(set_v_radius!calc_v_radius(e_radius,i_radius,d_radius) -> SKIP))))));share__choice(get_v_radius?v_radius -> true&CALL__set_v_radius(
								id__,
							    const_interceptOp_HEIGHT_TO_SHAPE1,
							    const_interceptOp_HEIGHT_TO_SHAPE2,
							    const_interceptOp_WAIT_LOWER1,
							    const_interceptOp_WAIT_LOWER2,
							    const_interceptOp_BELT_SPEED,
							    const_interceptOp_step_size,
							    const_interceptOp_STEP_SIZE,
								v_radius
							)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
							param_x,
							param_y,
						    const_interceptOp_HEIGHT_TO_SHAPE1,
						    const_interceptOp_HEIGHT_TO_SHAPE2,
						    const_interceptOp_WAIT_LOWER1,
						    const_interceptOp_WAIT_LOWER2,
						    const_interceptOp_BELT_SPEED,
						    const_interceptOp_step_size,
						    const_interceptOp_STEP_SIZE) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(share__choice(get_t_theta?t_theta -> share__choice(get_c_theta?c_theta -> true & (share__choice(set_e_theta!calc_e_theta(t_theta,c_theta) -> SKIP)))));share__choice(share__choice(get_c_radius?c_radius -> share__choice(get_t_radius?t_radius -> true & (share__choice(set_e_radius!calc_e_radius(t_radius,c_radius) -> SKIP)))));share__choice(share__choice(get_e_theta?e_theta -> share__choice(get_p_e_theta?p_e_theta -> true & (share__choice(set_d_theta!calc_d_theta(e_theta,p_e_theta,const_interceptOp_STEP_SIZE) -> SKIP)))));share__choice(share__choice(get_p_e_radius?p_e_radius -> share__choice(get_e_radius?e_radius -> true & (share__choice(set_d_radius!calc_d_radius(e_radius,p_e_radius,const_interceptOp_STEP_SIZE) -> SKIP)))));share__choice(share__choice(get_e_theta?e_theta -> share__choice(get_p_e_theta?p_e_theta -> share__choice(get_i_theta?i_theta -> true & (share__choice(set_i_theta!Plus(i_theta, calc_i_theta(e_theta,p_e_theta,const_interceptOp_STEP_SIZE), core_real) -> SKIP))))));share__choice(share__choice(get_p_e_radius?p_e_radius -> share__choice(get_i_radius?i_radius -> share__choice(get_e_radius?e_radius -> true & (share__choice(set_i_radius!Plus(i_radius, calc_i_radius(e_radius,p_e_radius,const_interceptOp_STEP_SIZE), core_real) -> SKIP))))));share__choice(share__choice(get_e_theta?e_theta -> share__choice(get_i_theta?i_theta -> share__choice(get_d_theta?d_theta -> true & (share__choice(set_v_theta!calc_v_theta(e_theta,i_theta,d_theta) -> SKIP))))));share__choice(get_v_theta?v_theta -> true&CALL__set_v_theta(
								id__,
							    const_interceptOp_HEIGHT_TO_SHAPE1,
							    const_interceptOp_HEIGHT_TO_SHAPE2,
							    const_interceptOp_WAIT_LOWER1,
							    const_interceptOp_WAIT_LOWER2,
							    const_interceptOp_BELT_SPEED,
							    const_interceptOp_step_size,
							    const_interceptOp_STEP_SIZE,
								v_theta
							));share__choice(share__choice(get_d_radius?d_radius -> share__choice(get_e_radius?e_radius -> share__choice(get_i_radius?i_radius -> true & (share__choice(set_v_radius!calc_v_radius(e_radius,i_radius,d_radius) -> SKIP))))));share__choice(get_v_radius?v_radius -> true&CALL__set_v_radius(
								id__,
							    const_interceptOp_HEIGHT_TO_SHAPE1,
							    const_interceptOp_HEIGHT_TO_SHAPE2,
							    const_interceptOp_WAIT_LOWER1,
							    const_interceptOp_WAIT_LOWER2,
							    const_interceptOp_BELT_SPEED,
							    const_interceptOp_step_size,
							    const_interceptOp_STEP_SIZE,
								v_radius
							)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__,
						          const_interceptOp_HEIGHT_TO_SHAPE1,
						          const_interceptOp_HEIGHT_TO_SHAPE2,
						          const_interceptOp_WAIT_LOWER1,
						          const_interceptOp_WAIT_LOWER2,
						          const_interceptOp_BELT_SPEED,
						          const_interceptOp_step_size,
						          const_interceptOp_STEP_SIZE) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- Junction: j1
		module j1
		exports
		
			channel enter, interrupt
			
			Timed(OneStep) {
				D__(id__,
							param_x,
							param_y,
						    const_interceptOp_HEIGHT_TO_SHAPE1,
						    const_interceptOp_HEIGHT_TO_SHAPE2,
