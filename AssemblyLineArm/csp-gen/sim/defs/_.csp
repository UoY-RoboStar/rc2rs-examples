	-- RoboSim-specific declarations
	channel endexec, endexec_action
	channel endexec__ : NIDS
	channel startexec, startexec_action
	
	-- declaring registerRead/Write datatypes
	datatype RegisterDataInput = i_rShapeY.Bool.core_real
		| i_lShapeY.Bool.core_real
		| i_lShapeTS.Bool.core_real
		| i_rShapeX.Bool.core_real
		| i_lShapeX.Bool.core_real
		| i_lifted_TS.Bool.core_real
		| i_rShapeTS.Bool.core_real
	
	
	datatype RegisterDataOutput = o_set_v_theta.core_real
		| o_lower.core_real
		| o_pick
		| o_drop
		| o_lift
		| o_set_v_radius.core_real
		| o_interceptOp.core_real.core_real
		| o_pidOp.core_real.core_real
	
	
	nametype RegisterOutputs = {|
	o_set_v_theta,
	o_lower,
	o_pick,
	o_drop,
	o_lift,
	o_set_v_radius,
	o_interceptOp,
	o_pidOp|}
		
	nametype RegisterInputs = {|
	i_rShapeY,
	i_lShapeY,
	i_lShapeTS,
	i_rShapeX,
	i_lShapeX,
	i_lifted_TS,
	i_rShapeTS|}
	
	channel registerRead 	: RegisterDataInput
	channel registerWrite 	: RegisterDataOutput
	
	-- variable channels
	channel get_rShapeX : Bool.core_real
	channel get_rShapeY : Bool.core_real
	channel get_rShapeTS : Bool.core_real
	channel get_lShapeX : Bool.core_real
	channel get_lShapeY : Bool.core_real
	channel get_lShapeTS : Bool.core_real
	channel get_lifted_TS : Bool.core_real
	
	-- channel set with all visible events
	sem__events = {|endexec,terminate
				,registerRead
				,registerWrite
	,	set_v_radiusCall,
		liftCall,
		pidOpCall,
		lowerCall,
		set_v_thetaCall,
		pickCall,
		interceptOpCall,
		dropCall
		|}

		-- Nodes --
		-- declaring all nodes
		
		----------------------------------------------------------------------
		-- Initial: i1
		module i1
		exports
		
			channel enter, interrupt
			
			Timed(OneStep) {
				D__(id__,cycle_simDetectionBehaviourStm_simDetectionBehaviourStm,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
						    const_simDetectionBehaviourStm_WAIT_LOWER1,
						    const_simDetectionBehaviourStm_WAIT_LOWER2,
						    const_simDetectionBehaviourStm_BELT_SPEED,
						    const_simDetectionBehaviourStm_step_size,
						    const_simDetectionBehaviourStm_HOME_X,
						    const_simDetectionBehaviourStm_HOME_Y,
						    const_simDetectionBehaviourStm_DELAY_DISCARD,
						    const_simDetectionBehaviourStm_WAIT_PICK,
						    const_simDetectionBehaviourStm_WAIT_DROP) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,cycle_simDetectionBehaviourStm_simDetectionBehaviourStm,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
						    const_simDetectionBehaviourStm_WAIT_LOWER1,
						    const_simDetectionBehaviourStm_WAIT_LOWER2,
						    const_simDetectionBehaviourStm_BELT_SPEED,
						    const_simDetectionBehaviourStm_step_size,
						    const_simDetectionBehaviourStm_HOME_X,
						    const_simDetectionBehaviourStm_HOME_Y,
						    const_simDetectionBehaviourStm_DELAY_DISCARD,
						    const_simDetectionBehaviourStm_WAIT_PICK,
						    const_simDetectionBehaviourStm_WAIT_DROP) = D__(id__,cycle_simDetectionBehaviourStm_simDetectionBehaviourStm,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
						    const_simDetectionBehaviourStm_WAIT_LOWER1,
						    const_simDetectionBehaviourStm_WAIT_LOWER2,
						    const_simDetectionBehaviourStm_BELT_SPEED,
						    const_simDetectionBehaviourStm_step_size,
						    const_simDetectionBehaviourStm_HOME_X,
						    const_simDetectionBehaviourStm_HOME_Y,
						    const_simDetectionBehaviourStm_DELAY_DISCARD,
						    const_simDetectionBehaviourStm_WAIT_PICK,
						    const_simDetectionBehaviourStm_WAIT_DROP)
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: FINDING_FIRST_SHAPE
		module FINDING_FIRST_SHAPE
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			channel endexec__ : NIDS
			
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,cycle_simDetectionBehaviourStm_simDetectionBehaviourStm,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
						    const_simDetectionBehaviourStm_WAIT_LOWER1,
						    const_simDetectionBehaviourStm_WAIT_LOWER2,
						    const_simDetectionBehaviourStm_BELT_SPEED,
						    const_simDetectionBehaviourStm_step_size,
						    const_simDetectionBehaviourStm_HOME_X,
						    const_simDetectionBehaviourStm_HOME_Y,
						    const_simDetectionBehaviourStm_DELAY_DISCARD,
						    const_simDetectionBehaviourStm_WAIT_PICK,
						    const_simDetectionBehaviourStm_WAIT_DROP) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,cycle_simDetectionBehaviourStm_simDetectionBehaviourStm,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
						    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
						    const_simDetectionBehaviourStm_WAIT_LOWER1,
						    const_simDetectionBehaviourStm_WAIT_LOWER2,
						    const_simDetectionBehaviourStm_BELT_SPEED,
						    const_simDetectionBehaviourStm_step_size,
						    const_simDetectionBehaviourStm_HOME_X,
						    const_simDetectionBehaviourStm_HOME_Y,
						    const_simDetectionBehaviourStm_DELAY_DISCARD,
						    const_simDetectionBehaviourStm_WAIT_PICK,
						    const_simDetectionBehaviourStm_WAIT_DROP) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__,
						          const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
						          const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
						          const_simDetectionBehaviourStm_WAIT_LOWER1,
						          const_simDetectionBehaviourStm_WAIT_LOWER2,
						          const_simDetectionBehaviourStm_BELT_SPEED,
						          const_simDetectionBehaviourStm_step_size,
						          const_simDetectionBehaviourStm_HOME_X,
						          const_simDetectionBehaviourStm_HOME_Y,
						          const_simDetectionBehaviourStm_DELAY_DISCARD,
						          const_simDetectionBehaviourStm_WAIT_PICK,
						          const_simDetectionBehaviourStm_WAIT_DROP) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
