		-- END
		
		-- Memory
		-- Memory variables
		Memory_epsilon_theta(epsilon_theta) =
			get_epsilon_theta!epsilon_theta -> Memory_epsilon_theta(epsilon_theta)
			[]
			set_epsilon_theta?x__ -> Memory_epsilon_theta(x__)
			[]
			terminate -> SKIP
		Memory_epsilon_radius(epsilon_radius) =
			get_epsilon_radius!epsilon_radius -> Memory_epsilon_radius(epsilon_radius)
			[]
			set_epsilon_radius?x__ -> Memory_epsilon_radius(x__)
			[]
			terminate -> SKIP
		Memory_target_x(target_x) =
			get_target_x!target_x -> Memory_target_x(target_x)
			[]
			set_target_x?x__ -> Memory_target_x(x__)
			[]
			terminate -> SKIP
		Memory_target_y(target_y) =
			get_target_y!target_y -> Memory_target_y(target_y)
			[]
			set_target_y?x__ -> Memory_target_y(x__)
			[]
			terminate -> SKIP
		Memory_c_theta(c_theta) =
			get_c_theta!c_theta -> Memory_c_theta(c_theta)
			[]
			set_c_theta?x__ -> Memory_c_theta(x__)
			[]
			terminate -> SKIP
		Memory_c_radius(c_radius) =
			get_c_radius!c_radius -> Memory_c_radius(c_radius)
			[]
			set_c_radius?x__ -> Memory_c_radius(x__)
			[]
			terminate -> SKIP
		Memory_i_theta(i_theta) =
