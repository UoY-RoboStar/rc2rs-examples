		getsetLocalChannels = {|get_epsilon_theta,set_epsilon_theta,get_epsilon_radius,set_epsilon_radius,get_target_x,set_target_x,get_target_y,set_target_y,get_c_theta,set_c_theta,get_c_radius,set_c_radius,get_i_theta,set_i_theta,get_i_radius,set_i_radius,get_p_e_theta,set_p_e_theta,get_p_e_radius,set_p_e_radius,get_e_theta,set_e_theta,get_e_radius,set_e_radius,get_d_theta,set_d_theta,get_d_radius,set_d_radius,get_t_theta,set_t_theta,get_t_radius,set_t_radius,get_v_theta,set_v_theta,get_v_radius,set_v_radius|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,
