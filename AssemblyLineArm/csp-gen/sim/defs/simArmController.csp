			    const_simArmController_sm_WAIT_PICK,
			    const_simArmController_sm_WAIT_DROP) =
	let
				
		project_sm(sm::o_pick) = SOutput_pick
		project_sm(sm::o_set_v_theta.x__) = SOutput_set_v_theta
		project_sm(sm::o_pidOp.x__) = SOutput_pidOp
		project_sm(sm::o_lower.x__) = SOutput_lower
		project_sm(sm::o_drop) = SOutput_drop
		project_sm(sm::o_set_v_radius.x__) = SOutput_set_v_radius
		project_sm(sm::o_interceptOp.x__) = SOutput_interceptOp
		project_sm(sm::o_lift) = SOutput_lift
	
		connected_sm(sm::o_pick) = true
		connected_sm(sm::o_set_v_theta.x__) = true
		connected_sm(sm::o_pidOp.x__) = true
		connected_sm(sm::o_lower.x__) = true
		connected_sm(sm::o_drop) = true
		connected_sm(sm::o_set_v_radius.x__) = true
		connected_sm(sm::o_interceptOp.x__) = true
		connected_sm(sm::o_lift) = true
		connected_sm(_) = false
	
		lift_sm(sm::o_pick) = o_pick
		lift_sm(sm::o_set_v_theta.x__) = o_set_v_theta.x__
		lift_sm(sm::o_pidOp.x__) = o_pidOp.x__
		lift_sm(sm::o_lower.x__) = o_lower.x__
		lift_sm(sm::o_drop) = o_drop
		lift_sm(sm::o_set_v_radius.x__) = o_set_v_radius.x__
		lift_sm(sm::o_interceptOp.x__) = o_interceptOp.x__
		lift_sm(sm::o_lift) = o_lift
		
		CycleController =
			Deadline(
			-- read inputs from the controller and pass to state machines
			(
			((registerRead.i_rShapeX?x__ ->
				((sm::registerRead.sm::i_rShapeX!x__ -> SKIP)))
				|||
			(registerRead.i_rShapeY?x__ ->
				((sm::registerRead.sm::i_rShapeY!x__ -> SKIP)))
				|||
			(registerRead.i_rShapeTS?x__ ->
				((sm::registerRead.sm::i_rShapeTS!x__ -> SKIP)))
				|||
			(registerRead.i_lShapeX?x__ ->
				((sm::registerRead.sm::i_lShapeX!x__ -> SKIP)))
				|||
			(registerRead.i_lShapeY?x__ ->
				((sm::registerRead.sm::i_lShapeY!x__ -> SKIP)))
				|||
			(registerRead.i_lShapeTS?x__ ->
				((sm::registerRead.sm::i_lShapeTS!x__ -> SKIP)))
				|||
			(registerRead.i_lifted_TS?x__ ->
				((sm::registerRead.sm::i_lifted_TS!x__ -> SKIP))))
			-- ensure state machines read the values being communicated via evars
					);
			-- synchronize on events related to evars to erase memory
			-- collect outputs, and monitor termination of the cycle, by all controllers
			(CollectOutputs(SOutputEvents) [| {endexec} |] Monitor),0);
			-- wait for the cycleDef period
			TimeOut_1(terminate -> SKIP,WAIT(cycle_simArmController_simArmController-1));
			-- recurse
			CycleController
			
									
		CollectOutputs(sout) =
			(sm::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- sm::RegisterDataOutput, connected_sm(outp), project_sm(outp) == outc}
					-> registerWrite!lift_sm(outp)
						-> CollectOutputs(diff(sout,{project_sm(outp)}))
			[]
			endexec -> SKIP
			)
	
		Monitor = 
			(	 (sm::endexec -> SKIP)); endexec -> SKIP
	within
		CycleController
	
	-- (Rule 5) memoryComp(...) : CSPProcess
	memoryComp(id__,
			    const_simArmController_HEIGHT_TO_SHAPE1,
			    const_simArmController_HEIGHT_TO_SHAPE2,
			    const_simArmController_WAIT_LOWER1,
			    const_simArmController_WAIT_LOWER2,
			    const_simArmController_BELT_SPEED,
			    const_simArmController_step_size,
			    const_simArmController_sm_HOME_X,
			    const_simArmController_sm_HOME_Y,
			    const_simArmController_sm_DELAY_DISCARD,
			    const_simArmController_sm_WAIT_PICK,
			    const_simArmController_sm_WAIT_DROP) = (
		STOP)
	
	
	-- (Rule 7) [[ c : Controller ]]_C : CSPProcess
	D__(id__,cycle_simArmController_simArmController,
			    const_simArmController_HEIGHT_TO_SHAPE1,
			    const_simArmController_HEIGHT_TO_SHAPE2,
			    const_simArmController_WAIT_LOWER1,
			    const_simArmController_WAIT_LOWER2,
			    const_simArmController_BELT_SPEED,
			    const_simArmController_step_size,
			    const_simArmController_sm_HOME_X,
			    const_simArmController_sm_HOME_Y,
			    const_simArmController_sm_DELAY_DISCARD,
			    const_simArmController_sm_WAIT_PICK,
			    const_simArmController_sm_WAIT_DROP) =
	timed_priority(
		(
			(
				(
					(
					dbisim(cycleController(id__,cycle_simArmController_simArmController,
							    const_simArmController_HEIGHT_TO_SHAPE1,
							    const_simArmController_HEIGHT_TO_SHAPE2,
							    const_simArmController_WAIT_LOWER1,
							    const_simArmController_WAIT_LOWER2,
							    const_simArmController_BELT_SPEED,
							    const_simArmController_step_size,
							    const_simArmController_sm_HOME_X,
							    const_simArmController_sm_HOME_Y,
							    const_simArmController_sm_DELAY_DISCARD,
							    const_simArmController_sm_WAIT_PICK,
							    const_simArmController_sm_WAIT_DROP))
				 	 [| Union({{||},
				 	 		  {||},
				 	 		  {||},
				 	 		  {||}}) |]
				 	memoryComp(id__,
				 			    const_simArmController_HEIGHT_TO_SHAPE1,
				 			    const_simArmController_HEIGHT_TO_SHAPE2,
				 			    const_simArmController_WAIT_LOWER1,
				 			    const_simArmController_WAIT_LOWER2,
				 			    const_simArmController_BELT_SPEED,
				 			    const_simArmController_step_size,
				 			    const_simArmController_sm_HOME_X,
				 			    const_simArmController_sm_HOME_Y,
				 			    const_simArmController_sm_DELAY_DISCARD,
				 			    const_simArmController_sm_WAIT_PICK,
				 			    const_simArmController_sm_WAIT_DROP)
				 	)\{||}
					[| {| 	terminate,tock,
							sm::endexec,sm::registerRead,sm::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((let
				 		const_simDetectionBehaviourStm_HOME_X = const_simArmController_sm_HOME_X
				 		const_simDetectionBehaviourStm_HOME_Y = const_simArmController_sm_HOME_Y
				 		const_simDetectionBehaviourStm_DELAY_DISCARD = const_simArmController_sm_DELAY_DISCARD
				 		const_simDetectionBehaviourStm_WAIT_PICK = const_simArmController_sm_WAIT_PICK
				 		const_simDetectionBehaviourStm_WAIT_DROP = const_simArmController_sm_WAIT_DROP
				 		const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1 = const_simArmController_HEIGHT_TO_SHAPE1
				 		const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2 = const_simArmController_HEIGHT_TO_SHAPE2
				 		const_simDetectionBehaviourStm_WAIT_LOWER1 = const_simArmController_WAIT_LOWER1
				 		const_simDetectionBehaviourStm_WAIT_LOWER2 = const_simArmController_WAIT_LOWER2
				 		const_simDetectionBehaviourStm_BELT_SPEED = const_simArmController_BELT_SPEED
				 		const_simDetectionBehaviourStm_step_size = const_simArmController_step_size
				 		cycle_simDetectionBehaviourStm_simDetectionBehaviourStm = cycle_simArmController_simArmController
				 	within
				 		(sm::D__(id__,cycle_simDetectionBehaviourStm_simDetectionBehaviourStm,
				 				    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
				 				    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
				 				    const_simDetectionBehaviourStm_WAIT_LOWER1,
				 				    const_simDetectionBehaviourStm_WAIT_LOWER2,
				 				    const_simDetectionBehaviourStm_BELT_SPEED,
				 				    const_simDetectionBehaviourStm_step_size,
				 				    const_simDetectionBehaviourStm_HOME_X,
				 				    const_simDetectionBehaviourStm_HOME_Y,
				 				    const_simDetectionBehaviourStm_DELAY_DISCARD,
				 				    const_simDetectionBehaviourStm_WAIT_PICK,
				 				    const_simDetectionBehaviourStm_WAIT_DROP)
				 		\{| |})
				 		[[sm::terminate <- terminate]]
				 	)
				 	)
				) \ {|	sm::endexec,sm::registerRead,sm::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	
	O__(id__,cycle_simArmController_simArmController,
			    const_simArmController_HEIGHT_TO_SHAPE1,
			    const_simArmController_HEIGHT_TO_SHAPE2,
			    const_simArmController_WAIT_LOWER1,
			    const_simArmController_WAIT_LOWER2,
			    const_simArmController_BELT_SPEED,
			    const_simArmController_step_size,
			    const_simArmController_sm_HOME_X,
			    const_simArmController_sm_HOME_Y,
			    const_simArmController_sm_DELAY_DISCARD,
			    const_simArmController_sm_WAIT_PICK,
			    const_simArmController_sm_WAIT_DROP) = 
	timed_priority(
		dbisim(
			(
				(
					(
					dbisim(cycleController(id__,cycle_simArmController_simArmController,
							    const_simArmController_HEIGHT_TO_SHAPE1,
							    const_simArmController_HEIGHT_TO_SHAPE2,
							    const_simArmController_WAIT_LOWER1,
							    const_simArmController_WAIT_LOWER2,
							    const_simArmController_BELT_SPEED,
							    const_simArmController_step_size,
							    const_simArmController_sm_HOME_X,
							    const_simArmController_sm_HOME_Y,
							    const_simArmController_sm_DELAY_DISCARD,
							    const_simArmController_sm_WAIT_PICK,
							    const_simArmController_sm_WAIT_DROP))
				 	 [| Union({{||},
				 	 		  {||},
				 	 		  {||},
				 	 		  {||}}) |]
				 	memoryComp(id__,
				 			    const_simArmController_HEIGHT_TO_SHAPE1,
				 			    const_simArmController_HEIGHT_TO_SHAPE2,
				 			    const_simArmController_WAIT_LOWER1,
				 			    const_simArmController_WAIT_LOWER2,
				 			    const_simArmController_BELT_SPEED,
				 			    const_simArmController_step_size,
				 			    const_simArmController_sm_HOME_X,
				 			    const_simArmController_sm_HOME_Y,
				 			    const_simArmController_sm_DELAY_DISCARD,
				 			    const_simArmController_sm_WAIT_PICK,
				 			    const_simArmController_sm_WAIT_DROP)
				 	)\{||}
					[| {| 	terminate,tock,
							sm::endexec,sm::registerRead,sm::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((let
				 		const_simDetectionBehaviourStm_HOME_X = const_simArmController_sm_HOME_X
				 		const_simDetectionBehaviourStm_HOME_Y = const_simArmController_sm_HOME_Y
				 		const_simDetectionBehaviourStm_DELAY_DISCARD = const_simArmController_sm_DELAY_DISCARD
				 		const_simDetectionBehaviourStm_WAIT_PICK = const_simArmController_sm_WAIT_PICK
				 		const_simDetectionBehaviourStm_WAIT_DROP = const_simArmController_sm_WAIT_DROP
				 		const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1 = const_simArmController_HEIGHT_TO_SHAPE1
				 		const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2 = const_simArmController_HEIGHT_TO_SHAPE2
				 		const_simDetectionBehaviourStm_WAIT_LOWER1 = const_simArmController_WAIT_LOWER1
				 		const_simDetectionBehaviourStm_WAIT_LOWER2 = const_simArmController_WAIT_LOWER2
				 		const_simDetectionBehaviourStm_BELT_SPEED = const_simArmController_BELT_SPEED
				 		const_simDetectionBehaviourStm_step_size = const_simArmController_step_size
				 		cycle_simDetectionBehaviourStm_simDetectionBehaviourStm = cycle_simArmController_simArmController
				 	within
				 		(sm::O__(id__,cycle_simDetectionBehaviourStm_simDetectionBehaviourStm,
				 				    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
				 				    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
				 				    const_simDetectionBehaviourStm_WAIT_LOWER1,
				 				    const_simDetectionBehaviourStm_WAIT_LOWER2,
				 				    const_simDetectionBehaviourStm_BELT_SPEED,
				 				    const_simDetectionBehaviourStm_step_size,
				 				    const_simDetectionBehaviourStm_HOME_X,
				 				    const_simDetectionBehaviourStm_HOME_Y,
				 				    const_simDetectionBehaviourStm_DELAY_DISCARD,
				 				    const_simDetectionBehaviourStm_WAIT_PICK,
				 				    const_simDetectionBehaviourStm_WAIT_DROP)
				 		\{| |})
				 		[[sm::terminate <- terminate]]
				 	)
				 	)
				) \ {|	sm::endexec,sm::registerRead,sm::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	}
endmodule
