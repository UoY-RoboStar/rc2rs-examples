	Timed(OneStep) {
	-- (Rule 8) cycleController(...) : CSPProcess
	datatype SOutputEvents = SOutput_pick
		| SOutput_set_v_theta
		| SOutput_pidOp
		| SOutput_lower
		| SOutput_drop
		| SOutput_set_v_radius
		| SOutput_interceptOp
		| SOutput_lift
	
	DVarsEvents = {}
	
