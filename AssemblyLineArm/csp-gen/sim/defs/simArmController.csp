					    const_simDetectionBehaviourStm_WAIT_PICK,
					    const_simDetectionBehaviourStm_WAIT_DROP) = EDeadline(registerWrite.o_pick,0)
			CALL__interceptOp(id__,
					    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
					    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
					    const_simDetectionBehaviourStm_WAIT_LOWER1,
					    const_simDetectionBehaviourStm_WAIT_LOWER2,
					    const_simDetectionBehaviourStm_BELT_SPEED,
					    const_simDetectionBehaviourStm_step_size,
					    const_simDetectionBehaviourStm_HOME_X,
					    const_simDetectionBehaviourStm_HOME_Y,
					    const_simDetectionBehaviourStm_DELAY_DISCARD,
					    const_simDetectionBehaviourStm_WAIT_PICK,
					    const_simDetectionBehaviourStm_WAIT_DROP,
						param_x,
						param_y) = EDeadline(registerWrite.o_interceptOp.param_x.param_y,0)
			CALL__drop(id__,
					    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE1,
					    const_simDetectionBehaviourStm_HEIGHT_TO_SHAPE2,
					    const_simDetectionBehaviourStm_WAIT_LOWER1,
					    const_simDetectionBehaviourStm_WAIT_LOWER2,
					    const_simDetectionBehaviourStm_BELT_SPEED,
