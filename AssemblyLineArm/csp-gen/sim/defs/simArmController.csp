					    const_simDetectionBehaviourStm_WAIT_DROP) = EDeadline(registerWrite.o_drop,0)
			
			-- END of Operation calls --
		
			datatype SOutputEvents = SOutput_set_v_theta
				| SOutput_lower
				| SOutput_pick
				| SOutput_drop
				| SOutput_lift
				| SOutput_set_v_radius
				| SOutput_interceptOp
				| SOutput_pidOp
			
			cycle(cycle_simDetectionBehaviourStm_simDetectionBehaviourStm) =
				let
					project(o_set_v_theta.x__) = SOutput_set_v_theta
					project(o_lower.x__) = SOutput_lower
					project(o_pick) = SOutput_pick
					project(o_drop) = SOutput_drop
					project(o_lift) = SOutput_lift
					project(o_set_v_radius.x__) = SOutput_set_v_radius
					project(o_interceptOp.x__) = SOutput_interceptOp
					project(o_pidOp.x__) = SOutput_pidOp
			
					Cycle =
						Deadline(
							(registerRead.i_rShapeY?x__ -> SKIP
								||| registerRead.i_lShapeY?x__ -> SKIP
								||| registerRead.i_lShapeTS?x__ -> SKIP
								||| registerRead.i_rShapeX?x__ -> SKIP
								||| registerRead.i_lShapeX?x__ -> SKIP
								||| registerRead.i_lifted_TS?x__ -> SKIP
								||| registerRead.i_rShapeTS?x__ -> SKIP);
							startexec -> CollectOutputs(SOutputEvents),0);
						TimeOut_1(terminate -> SKIP,WAIT(cycle_simDetectionBehaviourStm_simDetectionBehaviourStm-1);Cycle)
					
					CollectOutputs(sout) =
						(registerWrite?outp:{ outp | outc <- inter(sout,SOutputEvents), outp <- RegisterDataOutput,project(outp) == outc} -> CollectOutputs(diff(sout,{project(outp)}))
							[]
						endexec -> SKIP
						)
				within
					Cycle
			
