							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = ((let
						Trans = share__choice(get_retrievedConfiguration?retrievedConfiguration -> (
							((share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; j0::enter -> SKIP))))
							 	 [] dbisim(((not (ConfigAgeChecker_retrieved(retrievedConfiguration))))&(internal__!NID_j0 -> SKIP ;  ((SKIP ; f0::enter -> SKIP))))
							 	 [] dbisim((ConfigAgeChecker_retrieved(retrievedConfiguration))&(internal__!NID_j0 -> SKIP ;  ((share__choice(share__choice(get_retrievedConfiguration?retrievedConfiguration -> true & (share__choice(set_rate!ConfigAgeChecker_rate(retrievedConfiguration) -> SKIP))));share__choice(share__choice(get_retrievedConfiguration?retrievedConfiguration -> true & (share__choice(set_ageToStartRamp!ConfigAgeChecker_ageToStartRamp(retrievedConfiguration) -> SKIP))));share__choice(share__choice(get_retrievedConfiguration?retrievedConfiguration -> true & (share__choice(set_ageToStop!ConfigAgeChecker_ageToStop(retrievedConfiguration) -> SKIP)))) ; f0::enter -> SKIP))))
							 ) ; Trans)
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
						)
						)
					within
						Trans
					)
					)
					
				
				endmodule
