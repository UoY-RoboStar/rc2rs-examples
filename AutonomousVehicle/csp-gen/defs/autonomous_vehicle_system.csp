				-- Declaring state machine events
				channel podstatus__: NIDS.InOut.Status
				channel podstatus: InOut.Status
				channel output_pod_demand__: NIDS.InOut.PodDemand
				channel output_pod_demand: InOut.PodDemand
				channel auxiliary_demand__: NIDS.InOut.AuxiliaryDemand
				channel auxiliary_demand: InOut.AuxiliaryDemand
				channel session_control__: NIDS.InOut.SessionControl
				channel session_control: InOut.SessionControl
				channel control_command1__: NIDS.InOut.PodDemand
				channel control_command1: InOut.PodDemand
				
				-- Declaring call and ret events for undefined operations
				channel setParkingBrakeCall: BrakeState
				channel setFrontSteeringCall: Angle
				channel sendHandshakeResponseCall: Handshake
				channel setSpeedCall: Speed
				channel requestStateCall: VehicleState
				channel setRearSteeringCall: Angle
				channel setAuxiliariesCall: AuxiliaryDemand
				
				enterSS = {|
				SpinOnce::enter,
				ApplyControl::enter,
				i0::enter,
				Initialise::enter,
				Sleep::enter
				|}
				
				enteredSS = 	{|
