				              NID_ApplyControl|
				              NID_i0|
				              NID_Initialise|
				              NID_Sleep
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
