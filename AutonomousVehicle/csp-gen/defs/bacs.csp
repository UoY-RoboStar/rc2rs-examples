					)\{|get_currentConfiguration,set_currentConfiguration|}
				)
				)
			
			-- END
			
			-- Memory
			-- Memory variables
			Memory_currentConfiguration(currentConfiguration) =
				get_currentConfiguration!currentConfiguration -> Memory_currentConfiguration(currentConfiguration)
