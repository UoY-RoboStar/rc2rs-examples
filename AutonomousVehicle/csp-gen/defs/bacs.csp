																		stm_ref11::pod_demand_limited.in <- stm_ref9::pod_demand_limited.out,
																		stm_ref11::pod_demand_limited.out <- stm_ref9::pod_demand_limited.in,
																		stm_ref11::config <- configAgeCheck
																	]]
																)
																	[|{|terminate, stm_ref11::pod_demand_age_checked|}|]
																(
																	stm_ref12::VS_O__(id__)[[
																		stm_ref12::terminate <- terminate,
																		stm_ref12::pod_demand_age_checked.in <- stm_ref11::pod_demand_age_checked.out,
																		stm_ref12::pod_demand_age_checked.out <- stm_ref11::pod_demand_age_checked.in,
																		stm_ref12::output_pod_demand <- output_pod_demand,
																		stm_ref12::configBrakeTime <- configBrakeTime
																	]]
																)
															)
															\diff(
																{|terminate, stm_ref11::pod_demand_age_checked|},
																{|terminate|}
															)
														)
														\diff(
															{|terminate|},
															{|terminate|}
														)
													)
													\diff(
														{|terminate, stm_ref9::pod_demand_limited|},
														{|terminate|}
													)
												)
												\diff(
													{|terminate, stm_ref10::locationOut1|},
													{|terminate|}
												)
											)
											\diff(
												{|terminate|},
												{|terminate|}
											)
										)
										\diff(
											{|terminate, stm_ref7::demand|},
											{|terminate|}
										)
									)
									\diff(
										{|terminate, stm_ref0::location1, stm_ref10::locationOut2|},
										{|terminate|}
									)
								)
								\diff(
									{|terminate, stm_ref0::location2, stm_ref1::goal, stm_ref1::routeOrigin|},
									{|terminate|}
								)
							)
							\diff(
								{|terminate, stm_ref5::turnigy_pod_demand|},
								{|terminate|}
							)
						)
						\diff(
							{|terminate, stm_ref5::turnigy_auxiliary_demand, stm_ref1::auxiliary_demand|},
							{|terminate|}
						)
					)
					\diff(
						{|terminate, stm_ref2::speed_limit|},
						{|terminate|}
					)
				)
				\diff(
					{|terminate, stm_ref8::geofence_limit, stm_ref6::pod_demand, stm_ref3::pod_demand_geo_limited|},
					{|terminate|}
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__, const_bacs_B_acs_ZERO_SPEED, const_bacs_B_acs_MINIMIM_SPEED, const_bacs_B_acs_MAXIMUM_SPEED, const_bacs_B_acs_ZERO_STEER))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__,
					    const_bacs_B_acs_ZERO_SPEED,
					    const_bacs_B_acs_MINIMIM_SPEED,
					    const_bacs_B_acs_MAXIMUM_SPEED,
					    const_bacs_B_acs_ZERO_STEER,
					    const_bacs_B_acs_stm_ref3_ZERO_SPEED,
					    const_bacs_B_acs_stm_ref2_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref2_zeroSpeedLimit,
					    const_bacs_B_acs_stm_ref2_oneSpeedLimit,
					    const_bacs_B_acs_stm_ref4_AUXILIARY_SELECTION_PERIOD,
					    const_bacs_B_acs_stm_ref4_ZERO_AUXILIARY_DEMAND,
					    const_bacs_B_acs_stm_ref5_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref6_ZERO_VEHICLE_DEMAND,
					    const_bacs_B_acs_stm_ref6_MAX_TIME_BETWEEN_DEMAND,
					    const_bacs_B_acs_stm_ref7_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref7_ZERO_SPEED,
					    const_bacs_B_acs_stm_ref7_MINIMIM_SPEED,
					    const_bacs_B_acs_stm_ref7_MAXIMUM_SPEED,
					    const_bacs_B_acs_stm_ref7_ZERO_STEER,
					    const_bacs_B_acs_stm_ref9_ZERO_RATIO,
					    const_bacs_B_acs_stm_ref11_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref11_MESSAGE_HANDLING_DELAY,
					    const_bacs_B_acs_stm_ref11_RATE,
					    const_bacs_B_acs_stm_ref11_ZERO_SPEED,
					    const_bacs_B_acs_stm_ref11_MINIMIM_SPEED,
					    const_bacs_B_acs_stm_ref11_MAXIMUM_SPEED,
					    const_bacs_B_acs_stm_ref11_ZERO_STEER) = O__(id__,
					    const_bacs_B_acs_ZERO_SPEED,
					    const_bacs_B_acs_MINIMIM_SPEED,
					    const_bacs_B_acs_MAXIMUM_SPEED,
					    const_bacs_B_acs_ZERO_STEER,
					    const_bacs_B_acs_stm_ref3_ZERO_SPEED,
					    const_bacs_B_acs_stm_ref2_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref2_zeroSpeedLimit,
					    const_bacs_B_acs_stm_ref2_oneSpeedLimit,
					    const_bacs_B_acs_stm_ref4_AUXILIARY_SELECTION_PERIOD,
					    const_bacs_B_acs_stm_ref4_ZERO_AUXILIARY_DEMAND,
					    const_bacs_B_acs_stm_ref5_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref6_ZERO_VEHICLE_DEMAND,
					    const_bacs_B_acs_stm_ref6_MAX_TIME_BETWEEN_DEMAND,
					    const_bacs_B_acs_stm_ref7_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref7_ZERO_SPEED,
					    const_bacs_B_acs_stm_ref7_MINIMIM_SPEED,
					    const_bacs_B_acs_stm_ref7_MAXIMUM_SPEED,
					    const_bacs_B_acs_stm_ref7_ZERO_STEER,
					    const_bacs_B_acs_stm_ref9_ZERO_RATIO,
					    const_bacs_B_acs_stm_ref11_DEFAULT_CONFIGURATION,
					    const_bacs_B_acs_stm_ref11_MESSAGE_HANDLING_DELAY,
					    const_bacs_B_acs_stm_ref11_RATE,
					    const_bacs_B_acs_stm_ref11_ZERO_SPEED,
					    const_bacs_B_acs_stm_ref11_MINIMIM_SPEED,
					    const_bacs_B_acs_stm_ref11_MAXIMUM_SPEED,
					    const_bacs_B_acs_stm_ref11_ZERO_STEER) [|shared_variable_events|] SKIP			

	endmodule


module Brake
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_Initialise|
	              NID_Spin|
	              NID_DemandCallback|
	              NID_i0
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_brakeTime, set_brakeTime, setL_brakeTime, setR_brakeTime: core_real
	channel get_demand, set_demand, setL_demand, setR_demand: PodDemand
	channel get_brakedDemand, set_brakedDemand, setL_brakedDemand, setR_brakedDemand: PodDemand
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel output_pod_demand__: NIDS.InOut.PodDemand
	channel output_pod_demand: InOut.PodDemand
	channel pod_demand_age_checked__: NIDS.InOut.PodDemand
	channel pod_demand_age_checked: InOut.PodDemand
	channel configBrakeTime__: NIDS.InOut.core_real
	channel configBrakeTime: InOut.core_real
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	Initialise::enter,
	Spin::enter,
	DemandCallback::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	Initialise::entered,
	Spin::entered,
	DemandCallback::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	output_pod_demand,
		pod_demand_age_checked,
		configBrakeTime
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: Initialise
	module Initialise
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Spin
	module Spin
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: DemandCallback
	module DemandCallback
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Initial: i0
	module i0
	exports
	
		channel enter, interrupt
		
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
			 	 [] dbisim((true)&(internal__!NID_Initialise -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Spin::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Spin -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; DemandCallback::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_DemandCallback -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Spin::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				Initialise::enter,
				Spin::enter,
				DemandCallback::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,internal__.NID_Initialise,internal__.NID_Spin,internal__.NID_DemandCallback|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   Initialise::D__(id__)
					   [| { share__, terminate } |] (
					   Spin::D__(id__)
					   [| { share__, terminate } |] (
					   DemandCallback::D__(id__)
					   [| { share__, terminate } |] (
					   i0::D__(id__)
					   )
					   )
					   )
					 )
					 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Initialise|}]]
					 [[Spin::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Spin|}]]
					 [[DemandCallback::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_DemandCallback|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					output_pod_demand__.x____ <- output_pod_demand,
					pod_demand_age_checked__.x____ <- pod_demand_age_checked,
					configBrakeTime__.x____ <- configBrakeTime
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	Stateful(id__) = 
		((
			(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								Behaviour(id__)
								[| {|get_brakedDemand,set_brakedDemand,terminate|} |]
								Memory_brakedDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
							)\{|get_brakedDemand,set_brakedDemand|}
						)
						[| {|get_demand,set_demand,terminate|} |]
						Memory_demand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
					)\{|get_demand,set_demand|}
				)
				[| {|get_brakeTime,set_brakeTime,terminate|} |]
				Memory_brakeTime(0)
			)\{|get_brakeTime,set_brakeTime|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				Initialise::enter,
				Spin::enter,
				DemandCallback::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,internal__.NID_Initialise,internal__.NID_Spin,internal__.NID_DemandCallback|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   Initialise::VS_O__(id__)
					   [| { share__, terminate } |] (
					   Spin::VS_O__(id__)
					   [| { share__, terminate } |] (
					   DemandCallback::VS_O__(id__)
					   [| { share__, terminate } |] (
					   i0::VS_O__(id__)
					   )
					   )
					   )
					 )
					 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Initialise|}]]
					 [[Spin::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Spin|}]]
					 [[DemandCallback::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_DemandCallback|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					output_pod_demand__.x____ <- output_pod_demand,
					pod_demand_age_checked__.x____ <- pod_demand_age_checked,
					configBrakeTime__.x____ <- configBrakeTime
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	IteratedBehaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	Stateful_VS_O(id__) = 
		dbisim((
			(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								Behaviour_VS_O(id__)
								[| {|get_brakedDemand,set_brakedDemand,terminate|} |]
								Memory_brakedDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
							)\{|get_brakedDemand,set_brakedDemand|}
						)
						[| {|get_demand,set_demand,terminate|} |]
						Memory_demand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
					)\{|get_demand,set_demand|}
				)
				[| {|get_brakeTime,set_brakeTime,terminate|} |]
				Memory_brakeTime(0)
			)\{|get_brakeTime,set_brakeTime|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_brakeTime(brakeTime) =
		get_brakeTime!brakeTime -> Memory_brakeTime(brakeTime)
		[]
		set_brakeTime?x__ -> Memory_brakeTime(x__)
		[]
		terminate -> SKIP
	Memory_demand(demand) =
		get_demand!demand -> Memory_demand(demand)
		[]
		set_demand?x__ -> Memory_demand(x__)
		[]
		terminate -> SKIP
	Memory_brakedDemand(brakedDemand) =
		get_brakedDemand!brakedDemand -> Memory_brakedDemand(brakedDemand)
		[]
		set_brakedDemand?x__ -> Memory_brakedDemand(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__) = Memory_brakeTime(0)
	[| { terminate } |] (
	Memory_demand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
	[| { terminate } |] (
	Memory_brakedDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
	)
	)
	
	getsetLocalChannels = {|get_brakeTime,set_brakeTime,get_demand,set_demand,get_brakedDemand,set_brakedDemand|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__) = STM_VS_O(id__)
	
	D__(id__) = STM(id__) \ internal_events
	O__(id__) = sbisim(diamond(D__(id__)))
	VS__(id__) = FVS__(id__)
	VS_O__(id__) = sbisim(diamond(FVS__(id__)))
	HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
	HUP__(id__) = O__(id__) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule

module OP_SetOrigin
exports
	datatype TIDS = NULLTRANSITION__
	-- These definitions are needed to make the structure of an incompletely defined operation compatible with that of fully defined operations.
	MemoryTransitions(id__) = STOP -- this is STOP because MemoryTransitions is put in a choice with the state machine's MemoryTransitions. if it were SKIP, a divergence would be introduced.
			MemoryVariablesSyncSet = {}
			MemoryVariablesHideSet = {}
			MachineMemorySyncSet = {}
			MachineMemoryHidingSet = {}
			channel internal__
	D__(id__,
				param_newOrigin) = let
		AUX = SKIP 
			  |~|
			  STOP 
			  		  within 
		AUX
	
	O__(id__,
				param_newOrigin) = D__(id__,
				param_newOrigin)
	HUP__(id__,
				param_newOrigin) = D__(id__,
				param_newOrigin)
endmodule

endmodule
