						 		   		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						 		   [| { share__, terminate } |] (
						 		   PrepareNewDemand::VS_O__(id__,
						 		   		    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 		   		    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 		   		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						 		   )
						 		   )
						 		   )
						 		   )
						 		   )
						 		   )
						 		   )
						 		 )
						 		 [[RampDown::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_RampDown|}]]
						 		 [[Stop::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Stop|}]]
						 		 [[finalCheckAge::interrupt <- x__ | x__ <- {|interrupt|}]]
						 		 [[PrepareNewDemand::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_PrepareNewDemand,internal__.NID_PrepareNewDemand|}]]
						 		 [[initialCheckAge::interrupt <- x__ | x__ <- {|internal__.NID_initialCheckAge|}]]
						 		 [[checkAgeOut::interrupt <- x__ | x__ <- {|internal__.NID_checkAgeOut|}]]
						 		 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
						 		 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
						 		 )
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 		  [[set_age <- setL_age,set_ageToStartRamp <- setL_ageToStartRamp,set_ageToStop <- setL_ageToStop]]
						 		 )
						 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 		 			,setL_age
						 		 			,setL_ageToStartRamp
						 		 			,setL_ageToStop
						 		|}) |]
						 		 ((initialCheckAge::enter -> Transitions(id__,
						 		 		    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 		 		    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 		 		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		 		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		 		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		 		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		 		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
						 		  [[ share__ <- x__ | x__ <- {| share__,setL_age,setL_ageToStartRamp,setL_ageToStop |} ]]
						 		 )
						 		)[[setL_age <- set_age,setL_ageToStartRamp <- set_ageToStartRamp,setL_ageToStop <- set_ageToStop]]
						 		)
						 	)
						 	 \ hideSet)
						 	[[
						 		pod_demand_limited__.x____ <- pod_demand_limited,
						 		pod_demand_age_checked__.x____ <- pod_demand_age_checked,
						 		config__.x____ <- config
						 		| x____ <- NIDS
						 	]]
						 )
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_age,setR_ageToStartRamp,setR_newDemand,setR_ageToStop,setR_rate,setR_retrievedConfiguration,setR_executingCheckAge,setR_demand |} ]] 
						  [[set_age <- setL_age,set_ageToStartRamp <- setL_ageToStartRamp,set_newDemand <- setL_newDemand,set_ageToStop <- setL_ageToStop,set_rate <- setL_rate,set_retrievedConfiguration <- setL_retrievedConfiguration,set_executingCheckAge <- setL_executingCheckAge,set_demand <- setL_demand]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_age
						 			,setL_ageToStartRamp
						 			,setL_newDemand
						 			,setL_ageToStop
						 			,setL_rate
						 			,setL_retrievedConfiguration
						 			,setL_executingCheckAge
						 			,setL_demand
						 			,setR_age
						 			 			,setR_ageToStartRamp
						 			 			,setR_newDemand
						 			 			,setR_ageToStop
						 			 			,setR_rate
						 			 			,setR_retrievedConfiguration
						 			 			,setR_executingCheckAge
						 			 			,setR_demand
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_age,setL_ageToStartRamp,setL_newDemand,setL_ageToStop,setL_rate,setL_retrievedConfiguration,setL_executingCheckAge,setL_demand |} ]]
						  [[set_age <- setR_age,set_ageToStartRamp <- setR_ageToStartRamp,set_newDemand <- setR_newDemand,set_ageToStop <- setR_ageToStop,set_rate <- setR_rate,set_retrievedConfiguration <- setR_retrievedConfiguration,set_executingCheckAge <- setR_executingCheckAge,set_demand <- setR_demand]]
						 )
						)[[setL_age <- set_age,setL_ageToStartRamp <- set_ageToStartRamp,setL_newDemand <- set_newDemand,setL_ageToStop <- set_ageToStop,setL_rate <- set_rate,setL_retrievedConfiguration <- set_retrievedConfiguration,setL_executingCheckAge <- set_executingCheckAge,setL_demand <- set_demand]]
						 [[setR_age <- set_age,setR_ageToStartRamp <- set_ageToStartRamp,setR_newDemand <- set_newDemand,setR_ageToStop <- set_ageToStop,setR_rate <- set_rate,setR_retrievedConfiguration <- set_retrievedConfiguration,setR_executingCheckAge <- set_executingCheckAge,setR_demand <- set_demand]]
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__,
						    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						    const_bacs_AgeChecker_AgeChecker_RATE,
						    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = ((let
					Trans = share__choice(get_age?age -> get_ageToStartRamp?ageToStartRamp -> get_ageToStop?ageToStop -> (
						((share__ -> SKIP
						 [] dbisim(((age>ageToStartRamp))&(internal__!NID_j0 -> SKIP ;  ((SKIP ; PrepareNewDemand::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_RampDown -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; checkAgeOut::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_Stop -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; checkAgeOut::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_checkAgeOut -> SKIP ;  ((share__choice(get_newDemand?newDemand -> true&(share__choice(pod_demand_age_checked.out!newDemand -> SKIP))) ; j1::enter -> SKIP))))
						 	 [] dbisim(((age>=ageToStop))&(internal__!NID_PrepareNewDemand -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Stop::enter -> SKIP)))
						 	 [] dbisim(((not ((age>ageToStartRamp))))&(internal__!NID_j0 -> SKIP ;  ((SKIP ; j1::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_initialCheckAge -> SKIP ;  ((SKIP ; j0::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_j1 -> SKIP ;  ((share__choice(true & (share__choice(set_executingCheckAge!false -> SKIP))) ; finalCheckAge::enter -> SKIP))))
						 	 [] dbisim(((age<ageToStop))&(internal__!NID_PrepareNewDemand -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; RampDown::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
					)
				within
					Trans
				)
				)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: DemandCallback
			module DemandCallback
			
			enterSS = 
					{|			initialDemandCallback::enter,
						finalDemandCallback::enter,
						j0::enter,
						j1::enter
					|}
			enteredSS = 
					{|			finalDemandCallback::entered
					|}
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_initialDemandCallback|
				              NID_finalDemandCallback|
				              NID_j0|
				              NID_j1
				
				channel internal__ : NIDS
				channel pod_demand_limited__: NIDS.InOut.PodDemand
				channel pod_demand_age_checked__: NIDS.InOut.PodDemand
				channel config__: NIDS.InOut.ConfigAgeChecker
				
				--	Nodes
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: initialDemandCallback
				module initialDemandCallback
				exports
				
					channel enter, interrupt
					
					D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Final state: finalDemandCallback
				module finalDemandCallback
				
				exports
				
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
					--	Rule: behaviours(Node)
					D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
							
							Entering 	= entered -> SKIP ; Active
							Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
							Interrupted	= share__choice(exit -> exited -> Inactive)
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Junction: j0
				module j0
				exports
				
					channel enter, interrupt
					
					D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Junction: j1
				module j1
				exports
				
					channel enter, interrupt
					
					D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
				
				endmodule
				----------------------------------------------------------------------
				
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						    const_bacs_AgeChecker_AgeChecker_RATE,
						    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(share__choice(get_demand?demand -> true & (share__choice(set_age!Minus(autonomous_vehicle_system_GetSystemTime(), Header_stamp(PodDemand_header(demand)), core_real) -> SKIP)))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((let
						 	-- IMPLEMENTATION NOTE:
						 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 	-- modules for defining the semantics of each node.
						 	enterSS = {|
						 	initialDemandCallback::enter,
						 	finalDemandCallback::enter,
						 	j0::enter,
						 	j1::enter
						 	|}
						 	hideSet = union(enterSS,{|exit,exited,internal__|})
						 within 
						 	((let
						 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 		-- because CSPM modules are used for the semantics of Node.
						 		flowevts = union(enterSS,{|exit,exited,interrupt|})
						 		transSync = {|internal__.NID_j1,internal__.NID_j1,internal__.NID_j0,internal__.NID_initialDemandCallback|}
						 	within
						 		((
						 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 		   initialDemandCallback::D__(id__,
						 		   		    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 		   		    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 		   		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						 		   [| { share__, terminate } |] (
						 		   finalDemandCallback::D__(id__,
						 		   		    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 		   		    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 		   		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						 		   [| { share__, terminate } |] (
						 		   j0::D__(id__,
						 		   		    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 		   		    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 		   		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						 		   [| { share__, terminate } |] (
						 		   j1::D__(id__,
						 		   		    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 		   		    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 		   		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		   		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						 		   )
						 		   )
						 		   )
						 		 )
						 		 [[finalDemandCallback::interrupt <- x__ | x__ <- {|interrupt|}]]
						 		 [[initialDemandCallback::interrupt <- x__ | x__ <- {|internal__.NID_initialDemandCallback|}]]
						 		 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0|}]]
						 		 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1,internal__.NID_j1|}]]
						 		 )
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 		  [[set_age <- setL_age,set_ageToStartRamp <- setL_ageToStartRamp]]
						 		 )
						 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 		 			,setL_age
						 		 			,setL_ageToStartRamp
						 		|}) |]
						 		 ((initialDemandCallback::enter -> Transitions(id__,
						 		 		    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 		 		    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 		 		    const_bacs_AgeChecker_AgeChecker_RATE,
						 		 		    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 		 		    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 		 		    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 		 		    const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
