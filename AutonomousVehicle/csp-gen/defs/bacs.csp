					(Behaviour_VS_O(id__,
							    const_bacs_DemandLimiterRatio_DemandLimiterRatio_ZERO_RATIO) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
							    const_bacs_DemandLimiterRatio_DemandLimiterRatio_ZERO_RATIO))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__,
					    const_bacs_DemandLimiterRatio_DemandLimiterRatio_ZERO_RATIO) =
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										Behaviour_VS_O(id__,
												    const_bacs_DemandLimiterRatio_DemandLimiterRatio_ZERO_RATIO)
										[| {|get_speedLimitDisabled,set_speedLimitDisabled,terminate|} |]
										Memory_speedLimitDisabled(true)
									)\{|get_speedLimitDisabled,set_speedLimitDisabled|}
								)
								[| {|get_limitingRatio,set_limitingRatio,terminate|} |]
								Memory_limitingRatio(((0,0,""),0))
							)\{|get_limitingRatio,set_limitingRatio|}
						)
						[| {|get_newDemand,set_newDemand,terminate|} |]
						Memory_newDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
					)\{|get_newDemand,set_newDemand|}
				)
				)
			
			-- END
			
			-- Memory
			-- Memory variables
			Memory_newDemand(newDemand) =
				get_newDemand!newDemand -> Memory_newDemand(newDemand)
				[]
				set_newDemand?x__ -> Memory_newDemand(x__)
				[]
				terminate -> SKIP
			Memory_limitingRatio(limitingRatio) =
				get_limitingRatio!limitingRatio -> Memory_limitingRatio(limitingRatio)
				[]
				set_limitingRatio?x__ -> Memory_limitingRatio(x__)
				[]
				terminate -> SKIP
			Memory_speedLimitDisabled(speedLimitDisabled) =
				get_speedLimitDisabled!speedLimitDisabled -> Memory_speedLimitDisabled(speedLimitDisabled)
				[]
				set_speedLimitDisabled?x__ -> Memory_speedLimitDisabled(x__)
				[]
				terminate -> SKIP
			
			-- varMemory process
			varMemory(id__,
					    const_bacs_DemandLimiterRatio_DemandLimiterRatio_ZERO_RATIO) = Memory_newDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
			[| { terminate } |] (
			Memory_limitingRatio(((0,0,""),0))
			[| { terminate } |] (
			Memory_speedLimitDisabled(true)
