							 [[Ready::interrupt <- x__ | x__ <- {|interrupt,latlng__.NID_Ready.in|}]]
							 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,origin__.NID_Initialise.in|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_configuredOrigin,setR_geographic |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 			,setR_configuredOrigin
							 			 			,setR_geographic
							 			|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							  [[set_configuredOrigin <- setR_configuredOrigin,set_geographic <- setR_geographic]]
							 )
							)
							 [[setR_configuredOrigin <- set_configuredOrigin,setR_geographic <- set_geographic]]
							)
						)
						 \ hideSet)
						[[
