			channel pod_demand_limited: InOut.PodDemand
			channel pod_demand_age_checked__: NIDS.InOut.PodDemand
			channel pod_demand_age_checked: InOut.PodDemand
			channel config__: NIDS.InOut.ConfigAgeChecker
			channel config: InOut.ConfigAgeChecker
			
			-- Declaring call and ret events for undefined operations
			
			enterSS = {|
			SpinOnce::enter,
			i0::enter,
			Initialise::enter,
			CheckAge::enter,
			DemandCallback::enter,
			Sleep::enter
			|}
			
			enteredSS = 	{|
			SpinOnce::entered,
			Initialise::entered,
			CheckAge::entered,
			DemandCallback::entered,
			Sleep::entered
