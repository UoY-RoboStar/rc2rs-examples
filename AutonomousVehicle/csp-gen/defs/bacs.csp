			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			
			-- END of Operation calls --
			
			-- STM processes
			STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__) = ((let
				Trans = share__choice(get_goalPoint?goalPoint -> get_goalConfig?goalConfig -> get_locationLatest?locationLatest -> get_currentRoute?currentRoute -> (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_ConfigureOrigin -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Reset::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Unconfigured::enter -> SKIP))))
					 	 [] dbisim((true)&(config__!NID_Unconfigured.in?goalConfig:{goalConfig|goalConfig <- ConfigGoalGeneration, true} -> share__choice(set_goalConfig!goalConfig -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WaitForRoute::enter -> SKIP)))
					 	 [] dbisim((true)&(route__!NID_WaitForRoute.in?currentRoute:{currentRoute|currentRoute <- LSeq(GpsPathPoint,2), true} -> share__choice(set_currentRoute!currentRoute -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j1::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_Reset -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; NextGoal::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_TranslateAuxiliaries -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_goalAuxiliaries?goalAuxiliaries -> true&(share__choice(auxiliary_demand.out!goalAuxiliaries -> SKIP))) ; CurrentGoal::enter -> SKIP)))
					 	 [] dbisim((bacs_DemandGoalReached(locationLatest,goalPoint,goalConfig))&(internal__!NID_CurrentGoal -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j0::enter -> SKIP)))
					 	 [] dbisim((true)&(location__!NID_CurrentGoal.in?locationLatest:{locationLatest|locationLatest <- Pose2DStamped, true} -> share__choice(set_locationLatest!locationLatest -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; CurrentGoal::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_NextGoal -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_newObjective?newObjective -> true&(share__choice(goal.out!newObjective -> SKIP))) ; TranslateAuxiliaries::enter -> SKIP)))
					 	 [] dbisim((true)&(config__!NID_CurrentGoal.in?goalConfig:{goalConfig|goalConfig <- ConfigGoalGeneration, true} -> share__choice(set_goalConfig!goalConfig -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; CurrentGoal::enter -> SKIP)))
					 	 [] dbisim((sequence_toolkit_isNonEmpty(currentRoute))&(internal__!NID_j0 -> SKIP ;  ((SKIP ; NextGoal::enter -> SKIP))))
					 	 [] dbisim(((not (sequence_toolkit_isNonEmpty(currentRoute))))&(internal__!NID_j0 -> SKIP ;  ((SKIP ; WaitForRoute::enter -> SKIP))))
					 	 [] dbisim((sequence_toolkit_isNonEmpty(currentRoute))&(internal__!NID_j1 -> SKIP ;  ((SKIP ; ConfigureOrigin::enter -> SKIP))))
					 	 [] dbisim(((not (sequence_toolkit_isNonEmpty(currentRoute))))&(internal__!NID_j1 -> SKIP ;  ((SKIP ; WaitForRoute::enter -> SKIP))))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						ConfigureOrigin::enter,
						Reset::enter,
						i0::enter,
						Unconfigured::enter,
						WaitForRoute::enter,
						CurrentGoal::enter,
						NextGoal::enter,
						TranslateAuxiliaries::enter,
						j0::enter,
						j1::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_ConfigureOrigin,internal__.NID_i0,config__.NID_Unconfigured.in,route__.NID_WaitForRoute.in,internal__.NID_Reset,internal__.NID_TranslateAuxiliaries,internal__.NID_CurrentGoal,location__.NID_CurrentGoal.in,internal__.NID_NextGoal,config__.NID_CurrentGoal.in,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j1|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   ConfigureOrigin::D__(id__)
							   [| { share__, terminate } |] (
							   Reset::D__(id__)
							   [| { share__, terminate } |] (
							   i0::D__(id__)
							   [| { share__, terminate } |] (
							   Unconfigured::D__(id__)
							   [| { share__, terminate } |] (
							   WaitForRoute::D__(id__)
							   [| { share__, terminate } |] (
							   CurrentGoal::D__(id__)
							   [| { share__, terminate } |] (
							   NextGoal::D__(id__)
							   [| { share__, terminate } |] (
							   TranslateAuxiliaries::D__(id__)
							   [| { share__, terminate } |] (
							   j0::D__(id__)
							   [| { share__, terminate } |] (
							   j1::D__(id__)
							   )
							   )
							   )
							   )
							   )
							   )
							   )
							   )
							   )
							 )
							 [[ConfigureOrigin::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_ConfigureOrigin|}]]
							 [[Reset::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Reset|}]]
							 [[Unconfigured::interrupt <- x__ | x__ <- {|interrupt,config__.NID_Unconfigured.in|}]]
							 [[WaitForRoute::interrupt <- x__ | x__ <- {|interrupt,route__.NID_WaitForRoute.in|}]]
							 [[CurrentGoal::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_CurrentGoal,location__.NID_CurrentGoal.in,config__.NID_CurrentGoal.in|}]]
							 [[NextGoal::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_NextGoal|}]]
							 [[TranslateAuxiliaries::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_TranslateAuxiliaries|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
							 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1,internal__.NID_j1|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_goalConfig,setR_locationLatest,setR_currentRoute |} ]] 
							  [[set_goalPoint <- setL_goalPoint,set_goalConfig <- setL_goalConfig,set_locationLatest <- setL_locationLatest,set_currentRoute <- setL_currentRoute]]
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 			,setL_goalPoint
							 			,setL_goalConfig
							 			,setL_locationLatest
							 			,setL_currentRoute
							 			,setR_goalConfig
							 			 			,setR_locationLatest
							 			 			,setR_currentRoute
							 			|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__,setL_goalPoint,setL_goalConfig,setL_locationLatest,setL_currentRoute |} ]]
							  [[set_goalConfig <- setR_goalConfig,set_locationLatest <- setR_locationLatest,set_currentRoute <- setR_currentRoute]]
							 )
							)[[setL_goalPoint <- set_goalPoint,setL_goalConfig <- set_goalConfig,setL_locationLatest <- set_locationLatest,setL_currentRoute <- set_currentRoute]]
							 [[setR_goalConfig <- set_goalConfig,setR_locationLatest <- set_locationLatest,setR_currentRoute <- set_currentRoute]]
							)
						)
						 \ hideSet)
						[[
							location__.x____ <- location,
							goal__.x____ <- goal,
							route__.x____ <- route,
							config__.x____ <- config,
							auxiliary_demand__.x____ <- auxiliary_demand,
							routeOrigin__.x____ <- routeOrigin
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			IteratedBehaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			Stateful(id__) = 
				((
					(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful(id__) =
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												dbisim(
													sbisim(
														dbisim(
															sbisim(
																dbisim(
																	sbisim(
																		Behaviour(id__)
																		[| {|get_goalAuxiliaries,set_goalAuxiliaries,terminate|} |]
																		Memory_goalAuxiliaries((true,true,true,0,(0,0,"")))
																	)\{|get_goalAuxiliaries,set_goalAuxiliaries|}
																)
																[| {|get_newObjective,set_newObjective,terminate|} |]
																Memory_newObjective((0,0,(0,0,0)))
															)\{|get_newObjective,set_newObjective|}
														)
														[| {|get_goalPoint,set_goalPoint,terminate|} |]
														Memory_goalPoint(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
													)\{|get_goalPoint,set_goalPoint|}
												)
												[| {|get_locationLatest,set_locationLatest,terminate|} |]
												Memory_locationLatest((0,0,0))
											)\{|get_locationLatest,set_locationLatest|}
										)
										[| {|get_goalConfig,set_goalConfig,terminate|} |]
										Memory_goalConfig((0,0))
									)\{|get_goalConfig,set_goalConfig|}
								)
								[| {|get_currentRoute,set_currentRoute,terminate|} |]
								Memory_currentRoute(<>)
							)\{|get_currentRoute,set_currentRoute|}
						)
						[| {|get_origin,set_origin,terminate|} |]
						Memory_origin(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
					)\{|get_origin,set_origin|}
				)
				)
			
			-- Visible counterparts
			MachineBody_VS_O(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						ConfigureOrigin::enter,
						Reset::enter,
						i0::enter,
						Unconfigured::enter,
						WaitForRoute::enter,
						CurrentGoal::enter,
						NextGoal::enter,
						TranslateAuxiliaries::enter,
						j0::enter,
						j1::enter
