					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(share__choice(get_msg?msg -> share__choice(get_speedLimit?speedLimit -> true & (share__choice(set_speedLimit!update_SpeedLimit_header(speedLimit,update_Header_stamp(SpeedLimit_header(speedLimit),Header_stamp(LatLngHeadingFix_header(msg)))) -> SKIP)))));share__choice(share__choice(get_msg?msg -> share__choice(get_speedLimit?speedLimit -> share__choice(get_currentConfiguration?currentConfiguration -> true & (share__choice(set_speedLimit!update_SpeedLimit_speedLimit(speedLimit,bacs_Geofence_GeoFenceLocalMaxSpeed(msg,ConfigGeofence_fence(currentConfiguration),ConfigGeofence_maxSpeed(currentConfiguration))) -> SKIP)))))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(share__choice(get_msg?msg -> share__choice(get_speedLimit?speedLimit -> true & (share__choice(set_speedLimit!update_SpeedLimit_header(speedLimit,update_Header_stamp(SpeedLimit_header(speedLimit),Header_stamp(LatLngHeadingFix_header(msg)))) -> SKIP)))));share__choice(share__choice(get_msg?msg -> share__choice(get_speedLimit?speedLimit -> share__choice(get_currentConfiguration?currentConfiguration -> true & (share__choice(set_speedLimit!update_SpeedLimit_speedLimit(speedLimit,bacs_Geofence_GeoFenceLocalMaxSpeed(msg,ConfigGeofence_fence(currentConfiguration),ConfigGeofence_maxSpeed(currentConfiguration))) -> SKIP)))))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Initial: i0
			module i0
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			
			-- END of Operation calls --
			
			-- STM processes
			STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__) = ((let
				Trans = (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
					 	 [] dbisim((true)&(configuration__!NID_Initialise.in?currentConfiguration:{currentConfiguration|currentConfiguration <- ConfigGeofence, true} -> share__choice(set_currentConfiguration!currentConfiguration -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Spin::enter -> SKIP)))
					 	 [] dbisim((true)&(latlng__!NID_Spin.in?msg:{msg|msg <- LatLngHeadingFix, true} -> share__choice(set_msg!msg -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; GpsCallback::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_GpsCallback -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_speedLimit?speedLimit -> true&(share__choice(geofence_limit.out!speedLimit -> SKIP))) ; Spin::enter -> SKIP)))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						Initialise::enter,
						Spin::enter,
						GpsCallback::enter,
						i0::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,configuration__.NID_Initialise.in,latlng__.NID_Spin.in,internal__.NID_GpsCallback|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   Initialise::D__(id__)
							   [| { share__, terminate } |] (
							   Spin::D__(id__)
							   [| { share__, terminate } |] (
							   GpsCallback::D__(id__)
							   [| { share__, terminate } |] (
							   i0::D__(id__)
							   )
							   )
							   )
							 )
							 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,configuration__.NID_Initialise.in|}]]
							 [[Spin::interrupt <- x__ | x__ <- {|interrupt,latlng__.NID_Spin.in|}]]
							 [[GpsCallback::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_GpsCallback|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_msg,setR_currentConfiguration |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 			,setR_msg
							 			 			,setR_currentConfiguration
							 			|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							  [[set_msg <- setR_msg,set_currentConfiguration <- setR_currentConfiguration]]
							 )
							)
							 [[setR_msg <- set_msg,setR_currentConfiguration <- set_currentConfiguration]]
							)
						)
						 \ hideSet)
						[[
							latlng__.x____ <- latlng,
							geofence_limit__.x____ <- geofence_limit,
							configuration__.x____ <- configuration
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			IteratedBehaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			Stateful(id__) = 
				((
					(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful(id__) =
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										Behaviour(id__)
										[| {|get_speedLimit,set_speedLimit,terminate|} |]
										Memory_speedLimit(((0,0,""),0))
									)\{|get_speedLimit,set_speedLimit|}
								)
								[| {|get_msg,set_msg,terminate|} |]
								Memory_msg((0,0,(0,0,"")))
							)\{|get_msg,set_msg|}
						)
						[| {|get_currentConfiguration,set_currentConfiguration,terminate|} |]
						Memory_currentConfiguration((<>,0))
					)\{|get_currentConfiguration,set_currentConfiguration|}
				)
				)
			
			-- Visible counterparts
			MachineBody_VS_O(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						Initialise::enter,
						Spin::enter,
						GpsCallback::enter,
						i0::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,configuration__.NID_Initialise.in,latlng__.NID_Spin.in,internal__.NID_GpsCallback|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   Initialise::VS_O__(id__)
							   [| { share__, terminate } |] (
							   Spin::VS_O__(id__)
							   [| { share__, terminate } |] (
							   GpsCallback::VS_O__(id__)
							   [| { share__, terminate } |] (
							   i0::VS_O__(id__)
							   )
							   )
							   )
							 )
							 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,configuration__.NID_Initialise.in|}]]
							 [[Spin::interrupt <- x__ | x__ <- {|interrupt,latlng__.NID_Spin.in|}]]
							 [[GpsCallback::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_GpsCallback|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_msg,setR_currentConfiguration |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 			,setR_msg
							 			 			,setR_currentConfiguration
							 			|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							  [[set_msg <- setR_msg,set_currentConfiguration <- setR_currentConfiguration]]
							 )
							)
							 [[setR_msg <- set_msg,setR_currentConfiguration <- set_currentConfiguration]]
							)
						)
						 \ hideSet)
						[[
							latlng__.x____ <- latlng,
							geofence_limit__.x____ <- geofence_limit,
							configuration__.x____ <- configuration
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__) = 
				dbisim((MachineBody_VS_O(id__))
				)
			
			IteratedBehaviour_VS_O(id__) = 
				dbisim((MachineBody_VS_O(id__))
				)
			
			Stateful_VS_O(id__) = 
				dbisim((
					(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__) =
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										Behaviour_VS_O(id__)
										[| {|get_speedLimit,set_speedLimit,terminate|} |]
										Memory_speedLimit(((0,0,""),0))
