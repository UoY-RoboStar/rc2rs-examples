			 	 [] dbisim((true)&(internal__!NID_DemandCallback -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; SpinOnce::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_SpinOnce -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; CheckAge::enter -> SKIP)))
			 	 [] dbisim(((not (executingCheckAge)))&(internal__!NID_CheckAge -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Sleep::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Sleep -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; SpinOnce::enter -> SKIP)))
			 ) ; Trans)
