	----------------------------------------------------------------------
	-- State: CheckAge
	module CheckAge
	
	enterSS = 
			{|			RampDown::enter,
				Stop::enter,
				initialCheckAge::enter,
				finalCheckAge::enter,
				checkAgeOut::enter,
				j0::enter,
				j1::enter,
				PrepareNewDemand::enter
			|}
	enteredSS = 
			{|			RampDown::entered,
				Stop::entered,
				finalCheckAge::entered,
				PrepareNewDemand::entered
			|}
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		-- declaring identifiers of transitions
		datatype NIDS = 
		              NID_RampDown|
		              NID_Stop|
		              NID_initialCheckAge|
		              NID_finalCheckAge|
		              NID_checkAgeOut|
		              NID_j0|
		              NID_j1|
		              NID_PrepareNewDemand
		
		channel internal__ : NIDS
		channel pod_demand_limited__: NIDS.InOut.PodDemand
		channel pod_demand_age_checked__: NIDS.InOut.PodDemand
		channel config__: NIDS.InOut.ConfigAgeChecker
		
		--	Nodes
		-- declaring all nodes
		
		----------------------------------------------------------------------
		-- State: RampDown
		module RampDown
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--	Nodes
			-- declaring all nodes
			
			
			--	Rule: behaviours(Node)
			--  Note that FDR has problems with efficiently compiling the process below
			-- 	if using a different recursion pattern.
			D__(id__,
					    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
					    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
					    const_bacs_AgeChecker_AgeChecker_RATE,
					    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
			dbisim(let
				-- IMPLEMENTATION NOTE: 
				-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
				-- however FDR struggles with that form in certain cases. So we use the exception operator
				-- instead to 'terminate'.
				
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(share__choice(get_age?age -> share__choice(get_ageToStartRamp?ageToStartRamp -> share__choice(get_ageToStop?ageToStop -> share__choice(get_newDemand?newDemand -> share__choice(get_demand?demand -> (Minus(ageToStop, ageToStartRamp, core_real)) != 0 & (share__choice(set_newDemand!update_PodDemand_speed(newDemand,RealToSpeed(Div(Mult(SpeedToReal(PodDemand_speed(demand)), (Minus(ageToStop, age, core_real)), core_real), (Minus(ageToStop, ageToStartRamp, core_real)), core_real))) -> SKIP)))))))) ; 
						 	  Behaviour ; 
						 	  share__choice(exit -> SKIP) ; SKIP ; 
						 	  share__choice(exited -> SKIP) ; Inactive
			
				Behaviour 	= entered -> During
				During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
			within
				Inactive [| {terminate} |> SKIP)
				
			VS_O__(id__,
					    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
					    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
					    const_bacs_AgeChecker_AgeChecker_RATE,
					    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(share__choice(get_age?age -> share__choice(get_ageToStartRamp?ageToStartRamp -> share__choice(get_ageToStop?ageToStop -> share__choice(get_newDemand?newDemand -> share__choice(get_demand?demand -> (Minus(ageToStop, ageToStartRamp, core_real)) != 0 & (share__choice(set_newDemand!update_PodDemand_speed(newDemand,RealToSpeed(Div(Mult(SpeedToReal(PodDemand_speed(demand)), (Minus(ageToStop, age, core_real)), core_real), (Minus(ageToStop, ageToStartRamp, core_real)), core_real))) -> SKIP)))))))) ; 
						 	  Behaviour ; 
						 	  share__choice(exit -> SKIP) ; SKIP ; 
						 	  share__choice(exited -> SKIP) ; Inactive
			
				Behaviour 	= entered -> During
				During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
			within
				Inactive [| {terminate} |> SKIP)
			
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: Stop
		module Stop
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--	Nodes
			-- declaring all nodes
			
			
			--	Rule: behaviours(Node)
			--  Note that FDR has problems with efficiently compiling the process below
			-- 	if using a different recursion pattern.
			D__(id__,
					    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
					    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
					    const_bacs_AgeChecker_AgeChecker_RATE,
					    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
			dbisim(let
				-- IMPLEMENTATION NOTE: 
				-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
				-- however FDR struggles with that form in certain cases. So we use the exception operator
				-- instead to 'terminate'.
				
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(share__choice(get_newDemand?newDemand -> true & (share__choice(set_newDemand!update_PodDemand_speed(newDemand,const_bacs_AgeChecker_AgeChecker_ZERO_SPEED) -> SKIP))));share__choice(share__choice(get_newDemand?newDemand -> true & (share__choice(set_newDemand!update_PodDemand_steer(newDemand,const_bacs_AgeChecker_AgeChecker_ZERO_STEER) -> SKIP)))) ; 
						 	  Behaviour ; 
						 	  share__choice(exit -> SKIP) ; SKIP ; 
						 	  share__choice(exited -> SKIP) ; Inactive
			
				Behaviour 	= entered -> During
				During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
			within
				Inactive [| {terminate} |> SKIP)
				
			VS_O__(id__,
					    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
					    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
					    const_bacs_AgeChecker_AgeChecker_RATE,
					    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
					    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(share__choice(get_newDemand?newDemand -> true & (share__choice(set_newDemand!update_PodDemand_speed(newDemand,const_bacs_AgeChecker_AgeChecker_ZERO_SPEED) -> SKIP))));share__choice(share__choice(get_newDemand?newDemand -> true & (share__choice(set_newDemand!update_PodDemand_steer(newDemand,const_bacs_AgeChecker_AgeChecker_ZERO_STEER) -> SKIP)))) ; 
						 	  Behaviour ; 
						 	  share__choice(exit -> SKIP) ; SKIP ; 
						 	  share__choice(exited -> SKIP) ; Inactive
			
				Behaviour 	= entered -> During
				During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
			within
				Inactive [| {terminate} |> SKIP)
			
		
		endmodule
