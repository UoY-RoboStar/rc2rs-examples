	-- Variable channels
	channel get_pointCloud, set_pointCloud, setL_pointCloud, setR_pointCloud: LSeq(Point2d,2)
	channel get_objects, set_objects, setL_objects, setR_objects: LSeq(DetectedObject,2)
	channel get_image, set_image, setL_image, setR_image: StereoImage
	channel get_warning, set_warning, setL_warning, setR_warning: DriverWarning
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel environmentPointCloud__: NIDS.InOut.LSeq(Point2d,2)
	channel environmentPointCloud: InOut.LSeq(Point2d,2)
	channel environmentObjects__: NIDS.InOut.LSeq(DetectedObject,2)
	channel environmentObjects: InOut.LSeq(DetectedObject,2)
	channel environmentImage__: NIDS.InOut.StereoImage
	channel environmentImage: InOut.StereoImage
	channel earlyWarning__: NIDS.InOut.DriverWarning
	channel earlyWarning: InOut.DriverWarning
	
	-- Declaring call and ret events for undefined operations
	channel LogEarlyWarningCall: DriverWarning
	channel LogEnvironmentImageCall: StereoImage
	channel LogEnvironmentObjectsCall: LSeq(DetectedObject,2)
	channel LogEnvironmentPointCloudCall: LSeq(Point2d,2)
	
	enterSS = {|
	Log::enter,
	i0::enter
	|}
	
	enteredSS = 	{|
	Log::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	environmentPointCloud,
		environmentObjects,
		environmentImage,
		earlyWarning
	,	LogEarlyWarningCall,
		LogEnvironmentImageCall,
		LogEnvironmentObjectsCall,
		LogEnvironmentPointCloudCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- State: Log
	module Log
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Initial: i0
	module i0
	exports
	
		channel enter, interrupt
		
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__LogEarlyWarning(id__,
				param_warningToLog) 	= LogEarlyWarningCall.param_warningToLog -> SKIP
	CALL__LogEnvironmentImage(id__,
				param_imageToLog) 	= LogEnvironmentImageCall.param_imageToLog -> SKIP
	CALL__LogEnvironmentObjects(id__,
				param_objectsToLog) 	= LogEnvironmentObjectsCall.param_objectsToLog -> SKIP
	CALL__LogEnvironmentPointCloud(id__,
				param_eventToLog) 	= LogEnvironmentPointCloudCall.param_eventToLog -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Log::enter -> SKIP))))
			 	 [] dbisim((true)&(environmentPointCloud__!NID_Log.in?pointCloud:{pointCloud|pointCloud <- LSeq(Point2d,2), true} -> share__choice(set_pointCloud!pointCloud -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_pointCloud?pointCloud -> true&CALL__LogEnvironmentPointCloud(
			 			id__,
			 			pointCloud
			 		)) ; Log::enter -> SKIP)))
			 	 [] dbisim((true)&(environmentObjects__!NID_Log.in?objects:{objects|objects <- LSeq(DetectedObject,2), true} -> share__choice(set_objects!objects -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_objects?objects -> true&CALL__LogEnvironmentObjects(
			 			id__,
			 			objects
			 		)) ; Log::enter -> SKIP)))
			 	 [] dbisim((true)&(environmentImage__!NID_Log.in?image:{image|image <- StereoImage, true} -> share__choice(set_image!image -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_image?image -> true&CALL__LogEnvironmentImage(
			 			id__,
			 			image
			 		)) ; Log::enter -> SKIP)))
			 	 [] dbisim((true)&(earlyWarning__!NID_Log.in?warning:{warning|warning <- DriverWarning, true} -> share__choice(set_warning!warning -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_warning?warning -> true&CALL__LogEarlyWarning(
			 			id__,
			 			warning
			 		)) ; Log::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				Log::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,environmentPointCloud__.NID_Log.in,environmentObjects__.NID_Log.in,environmentImage__.NID_Log.in,earlyWarning__.NID_Log.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   Log::D__(id__)
					   [| { share__, terminate } |] (
					   i0::D__(id__)
					   )
					 )
					 [[Log::interrupt <- x__ | x__ <- {|interrupt,environmentPointCloud__.NID_Log.in,environmentObjects__.NID_Log.in,environmentImage__.NID_Log.in,earlyWarning__.NID_Log.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_warning,setR_objects,setR_pointCloud,setR_image |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_warning
					 			 			,setR_objects
					 			 			,setR_pointCloud
					 			 			,setR_image
					 			|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_warning <- setR_warning,set_objects <- setR_objects,set_pointCloud <- setR_pointCloud,set_image <- setR_image]]
					 )
					)
					 [[setR_warning <- set_warning,setR_objects <- set_objects,setR_pointCloud <- set_pointCloud,setR_image <- set_image]]
					)
				)
				 \ hideSet)
				[[
					environmentPointCloud__.x____ <- environmentPointCloud,
					environmentObjects__.x____ <- environmentObjects,
					environmentImage__.x____ <- environmentImage,
					earlyWarning__.x____ <- earlyWarning
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	Stateful(id__) = 
		((
			(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										Behaviour(id__)
										[| {|get_warning,set_warning,terminate|} |]
										Memory_warning((0,true,true,true))
									)\{|get_warning,set_warning|}
								)
								[| {|get_image,set_image,terminate|} |]
								Memory_image(((<>),(<>)))
							)\{|get_image,set_image|}
						)
						[| {|get_objects,set_objects,terminate|} |]
						Memory_objects(<>)
					)\{|get_objects,set_objects|}
				)
				[| {|get_pointCloud,set_pointCloud,terminate|} |]
				Memory_pointCloud(<>)
			)\{|get_pointCloud,set_pointCloud|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				Log::enter,
				i0::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,environmentPointCloud__.NID_Log.in,environmentObjects__.NID_Log.in,environmentImage__.NID_Log.in,earlyWarning__.NID_Log.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   Log::VS_O__(id__)
					   [| { share__, terminate } |] (
					   i0::VS_O__(id__)
					   )
					 )
					 [[Log::interrupt <- x__ | x__ <- {|interrupt,environmentPointCloud__.NID_Log.in,environmentObjects__.NID_Log.in,environmentImage__.NID_Log.in,earlyWarning__.NID_Log.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_warning,setR_objects,setR_pointCloud,setR_image |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_warning
					 			 			,setR_objects
					 			 			,setR_pointCloud
					 			 			,setR_image
					 			|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_warning <- setR_warning,set_objects <- setR_objects,set_pointCloud <- setR_pointCloud,set_image <- setR_image]]
					 )
					)
					 [[setR_warning <- set_warning,setR_objects <- set_objects,setR_pointCloud <- set_pointCloud,setR_image <- set_image]]
					)
				)
				 \ hideSet)
				[[
					environmentPointCloud__.x____ <- environmentPointCloud,
					environmentObjects__.x____ <- environmentObjects,
					environmentImage__.x____ <- environmentImage,
					earlyWarning__.x____ <- earlyWarning
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	IteratedBehaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	Stateful_VS_O(id__) = 
		dbisim((
			(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										Behaviour_VS_O(id__)
										[| {|get_warning,set_warning,terminate|} |]
										Memory_warning((0,true,true,true))
									)\{|get_warning,set_warning|}
								)
								[| {|get_image,set_image,terminate|} |]
								Memory_image(((<>),(<>)))
							)\{|get_image,set_image|}
						)
						[| {|get_objects,set_objects,terminate|} |]
						Memory_objects(<>)
					)\{|get_objects,set_objects|}
				)
				[| {|get_pointCloud,set_pointCloud,terminate|} |]
				Memory_pointCloud(<>)
			)\{|get_pointCloud,set_pointCloud|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_pointCloud(pointCloud) =
		get_pointCloud!pointCloud -> Memory_pointCloud(pointCloud)
		[]
		set_pointCloud?x__ -> Memory_pointCloud(x__)
		[]
		terminate -> SKIP
	Memory_objects(objects) =
		get_objects!objects -> Memory_objects(objects)
		[]
		set_objects?x__ -> Memory_objects(x__)
		[]
		terminate -> SKIP
	Memory_image(image) =
		get_image!image -> Memory_image(image)
		[]
		set_image?x__ -> Memory_image(x__)
		[]
		terminate -> SKIP
	Memory_warning(warning) =
		get_warning!warning -> Memory_warning(warning)
		[]
		set_warning?x__ -> Memory_warning(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__) = Memory_pointCloud(<>)
	[| { terminate } |] (
	Memory_objects(<>)
	[| { terminate } |] (
	Memory_image(((<>),(<>)))
	[| { terminate } |] (
	Memory_warning((0,true,true,true))
	)
	)
	)
	
	getsetLocalChannels = {|get_pointCloud,set_pointCloud,get_objects,set_objects,get_image,set_image,get_warning,set_warning|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__) = STM_VS_O(id__)
	
	D__(id__) = STM(id__) \ internal_events
	O__(id__) = sbisim(diamond(D__(id__)))
	VS__(id__) = FVS__(id__)
	VS_O__(id__) = sbisim(diamond(FVS__(id__)))
	HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
	HUP__(id__) = O__(id__) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule


endmodule
