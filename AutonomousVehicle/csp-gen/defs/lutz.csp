							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   Distribute::D__(id__)
							   [| { share__, terminate } |] (
							   i0::D__(id__)
							   [| { share__, terminate } |] (
							   Initialise::D__(id__)
