							 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							  [[set_newInstructionAndSession <- setL_newInstructionAndSession,set_newInstruction <- setL_newInstruction]]
