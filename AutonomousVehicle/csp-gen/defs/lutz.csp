						 			,setL_podStatus
						 			,setL_sessionControl
						 			,setL_auxDemand
						 			,setL_executingApplyControl
						 			,setL_podDemand
						 			,setR_podStatus
						 			 			,setR_sessionControl
						 			 			,setR_auxDemand
						 			 			,setR_executingApplyControl
						 			 			,setR_podDemand
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_podStatus,setL_sessionControl,setL_auxDemand,setL_executingApplyControl,setL_podDemand |} ]]
						  [[set_podStatus <- setR_podStatus,set_sessionControl <- setR_sessionControl,set_auxDemand <- setR_auxDemand,set_executingApplyControl <- setR_executingApplyControl,set_podDemand <- setR_podDemand]]
						 )
						)[[setL_podStatus <- set_podStatus,setL_sessionControl <- set_sessionControl,setL_auxDemand <- set_auxDemand,setL_executingApplyControl <- set_executingApplyControl,setL_podDemand <- set_podDemand]]
						 [[setR_podStatus <- set_podStatus,setR_sessionControl <- set_sessionControl,setR_auxDemand <- set_auxDemand,setR_executingApplyControl <- set_executingApplyControl,setR_podDemand <- set_podDemand]]
						)\union(enteredSS,{terminate}) 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(true & (share__choice(set_executingApplyControl!true -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((let
						 	-- IMPLEMENTATION NOTE:
						 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 	-- modules for defining the semantics of each node.
						 	enterSS = {|
						 	Steering::enter,
						 	Speed::enter,
						 	Auxiliaries::enter,
						 	State::enter,
						 	i0::enter,
						 	f0::enter,
						 	ZeroSpeed::enter,
						 	j0::enter
						 	|}
						 	hideSet = union(enterSS,{|exit,exited,internal__|})
						 within 
						 	((let
						 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 		-- because CSPM modules are used for the semantics of Node.
						 		flowevts = union(enterSS,{|exit,exited,interrupt|})
						 		transSync = {|internal__.NID_Steering,internal__.NID_j0,internal__.NID_State,internal__.NID_Auxiliaries,internal__.NID_i0,internal__.NID_Steering,internal__.NID_Speed,internal__.NID_ZeroSpeed,internal__.NID_Steering|}
						 	within
						 		((
						 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 		   Steering::VS_O__(id__,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						 		   		    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
