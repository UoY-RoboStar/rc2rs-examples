						 		 [[Speed::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Speed|}]]
						 		 [[Auxiliaries::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Auxiliaries|}]]
						 		 [[State::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_State|}]]
