					 	 [] dbisim((true)&(powertrainIn__!NID_Initialise.in?currentPowertrainState:{currentPowertrainState|currentPowertrainState <- Powertrain, true} -> share__choice(set_currentPowertrainState!currentPowertrainState -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
					 ) ; Trans)
