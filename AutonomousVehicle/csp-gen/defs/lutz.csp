							)
							 [[setR_newIndicator <- set_newIndicator,setR_newPowertrain <- set_newPowertrain]]
							)
						)
						 \ hideSet)
						[[
							powertrain__.x____ <- powertrain,
							indicator__.x____ <- indicator,
							pod_state__.x____ <- pod_state
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__) = 
