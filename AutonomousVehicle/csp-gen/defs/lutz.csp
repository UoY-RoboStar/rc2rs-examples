						 		   Speed::VS_O__(id__,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						 		   		    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						 		   		    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY)
						 		   [| { share__, terminate } |] (
						 		   Auxiliaries::VS_O__(id__,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						 		   		    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						 		   		    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY)
						 		   [| { share__, terminate } |] (
						 		   State::VS_O__(id__,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						 		   		    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						 		   		    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						 		   		    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY)
						 		   [| { share__, terminate } |] (
