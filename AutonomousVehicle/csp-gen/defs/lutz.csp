						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_podStatus,setR_sessionControl,setR_auxDemand,setR_executingApplyControl,setR_podDemand |} ]] 
						  [[set_podStatus <- setL_podStatus,set_sessionControl <- setL_sessionControl,set_auxDemand <- setL_auxDemand,set_executingApplyControl <- setL_executingApplyControl,set_podDemand <- setL_podDemand]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_podStatus
						 			,setL_sessionControl
						 			,setL_auxDemand
						 			,setL_executingApplyControl
						 			,setL_podDemand
						 			,setR_podStatus
						 			 			,setR_sessionControl
						 			 			,setR_auxDemand
						 			 			,setR_executingApplyControl
						 			 			,setR_podDemand
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_podStatus,setL_sessionControl,setL_auxDemand,setL_executingApplyControl,setL_podDemand |} ]]
						  [[set_podStatus <- setR_podStatus,set_sessionControl <- setR_sessionControl,set_auxDemand <- setR_auxDemand,set_executingApplyControl <- setR_executingApplyControl,set_podDemand <- setR_podDemand]]
						 )
						)[[setL_podStatus <- set_podStatus,setL_sessionControl <- set_sessionControl,setL_auxDemand <- set_auxDemand,setL_executingApplyControl <- set_executingApplyControl,setL_podDemand <- set_podDemand]]
						 [[setR_podStatus <- set_podStatus,setR_sessionControl <- set_sessionControl,setR_auxDemand <- set_auxDemand,setR_executingApplyControl <- set_executingApplyControl,setR_podDemand <- set_podDemand]]
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__,
						    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY) = ((let
					Trans = share__choice(get_podStatus?podStatus -> get_sessionControl?sessionControl -> (
						((share__ -> SKIP
						 [] dbisim(((Status_systemState(podStatus)==VehicleState_AUTONOMOUS))&(internal__!NID_Steering -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Speed::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_j0 -> SKIP ;  ((share__choice(get_podDemand?podDemand -> true&(share__choice(control_command1.out!podDemand -> SKIP))) ; State::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_State -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Auxiliaries::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_Auxiliaries -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(true & (share__choice(set_executingApplyControl!false -> SKIP))) ; f0::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Steering::enter -> SKIP))))
						 	 [] dbisim((((SessionControl_requestedState(sessionControl)==VehicleState_AUTONOMOUS) and (Status_systemState(podStatus)!=VehicleState_AUTONOMOUS)))&(internal__!NID_Steering -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; ZeroSpeed::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_Speed -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j0::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_ZeroSpeed -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j0::enter -> SKIP)))
						 	 [] dbisim((((SessionControl_requestedState(sessionControl)!=VehicleState_AUTONOMOUS) and (Status_systemState(podStatus)!=VehicleState_AUTONOMOUS)))&(internal__!NID_Steering -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; State::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
					)
				within
					Trans
				)
				)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Initial: i0
			module i0
			exports
			
				channel enter, interrupt
				
				D__(id__,
						    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,
						    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY) = D__(id__,
						    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Initialise
			module Initialise
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
