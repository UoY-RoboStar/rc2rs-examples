							 [[Ready::interrupt <- x__ | x__ <- {|interrupt,powertrain__.NID_Ready.in,indicator__.NID_Ready.in|}]]
							 [[UpdateLutzState::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_UpdateLutzState|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
