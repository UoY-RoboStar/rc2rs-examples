						  [[ share__ <- x__ | x__ <- {| share__,setR_podStatus,setR_sessionControl,setR_auxDemand,setR_executingApplyControl,setR_podDemand |} ]] 
						  [[set_podStatus <- setL_podStatus,set_sessionControl <- setL_sessionControl,set_auxDemand <- setL_auxDemand,set_executingApplyControl <- setL_executingApplyControl,set_podDemand <- setL_podDemand]]
						 )
