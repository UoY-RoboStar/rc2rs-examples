					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((share__choice(share__choice(get_newPodstate?newPodstate -> share__choice(get_newPowertrain?newPowertrain -> true & (share__choice(set_newPodstate!update_PodState_speedMetersPerSecond(newPodstate,lutz_LutzState_KilometersPerHourToMetersPerSecond(Powertrain_speedKilometersPerHour(newPowertrain))) -> SKIP)))));share__choice(share__choice(get_newIndicator?newIndicator -> share__choice(get_newPodstate?newPodstate -> true & (share__choice(set_newPodstate!update_PodState_indicatorLeft(newPodstate,Indicator_left(newIndicator)) -> SKIP)))));share__choice(share__choice(get_newIndicator?newIndicator -> share__choice(get_newPodstate?newPodstate -> true & (share__choice(set_newPodstate!update_PodState_indicatorRight(newPodstate,Indicator_right(newIndicator)) -> SKIP))))) ; SStop) /\ interrupt -> SKIP)
				within
