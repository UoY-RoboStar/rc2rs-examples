	-- Memory
	-- Memory variables
	Memory_next(next) =
		get_next!next -> Memory_next(next)
		[]
		set_next?x__ -> Memory_next(x__)
		[]
		terminate -> SKIP
	Memory_newInstruction(newInstruction) =
		get_newInstruction!newInstruction -> Memory_newInstruction(newInstruction)
		[]
		set_newInstruction?x__ -> Memory_newInstruction(x__)
		[]
		terminate -> SKIP
	Memory_newReadyState(newReadyState) =
		get_newReadyState!newReadyState -> Memory_newReadyState(newReadyState)
		[]
		set_newReadyState?x__ -> Memory_newReadyState(x__)
		[]
		terminate -> SKIP
	Memory_newInstructionAndSession(newInstructionAndSession) =
		get_newInstructionAndSession!newInstructionAndSession -> Memory_newInstructionAndSession(newInstructionAndSession)
		[]
		set_newInstructionAndSession?x__ -> Memory_newInstructionAndSession(x__)
		[]
		terminate -> SKIP
	
