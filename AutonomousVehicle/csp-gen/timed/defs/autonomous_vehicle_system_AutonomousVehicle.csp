								Termination = terminate -> SKIP
								
								Active 		= SKIP ; 
										 	  Behaviour ; 
										 	  share__choice(exit -> SKIP) ; SKIP ; 
										 	  share__choice(exited -> SKIP) ; Inactive
							
								Behaviour 	= entered -> During
								During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
							within
								Inactive [| {terminate} |> SKIP)
							
							
							-- Clocks
							
							StateClocks(id__) = terminate -> SKIP
							
							stateClockSync = {||}
						}
					
					endmodule
					----------------------------------------------------------------------
					
					
					----------------------------------------------------------------------
					-- Initial: i0
					module i0
					exports
					
						channel enter, interrupt
						
						Timed(OneStep) {
							D__(id__) = 
								dbisim(let
									Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
									
									Termination = terminate -> SKIP
									
									Active 		= share__choice(interrupt -> SKIP) ; Inactive
								within
									Inactive [| {terminate} |> SKIP)
							
							VS_O__(id__) = D__(id__)
						}
					
					endmodule
					----------------------------------------------------------------------
					
					-- END of Nodes --
					
					Timed(OneStep) {
					-- Operation calls --
					-- Only the undefined operations are declared here.
					-- If the state machine is in isolation, all required operations will be undefined.
					-- If it is in the context of a controller, the required operations not provided by the
					-- controller will be declared here, and the defined operations will be defined in the
					-- context of the Controller module, and therefore within scope of the state machine module.
					
					-- END of Operation calls --
				
					-- STM processes
					STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
					( 
						(
							(
								(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {||} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__))
					)\sharedVarHide
					
					STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
					( 
						(
							(
								(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {||} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__))
					)\sharedVarHide
					
					-- Transitions
					Transitions(id__) = ((let
						Trans = TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_Initialise -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Spin::enter -> SKIP)))
							 [] dbisim((true)&(internal__!NID_Spin -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; DemandCallback::enter -> SKIP)))
							 [] dbisim((true)&(internal__!NID_DemandCallback -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Spin::enter -> SKIP)))
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
							 )
						,SKIP);Trans
					within
						Trans [|{terminate}|> SKIP
					)
					)
					
					-- Stateful
					-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
					
					-- Named process definitions
					MachineBody(id__) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								Initialise::enter,
								Spin::enter,
								DemandCallback::enter,
								i0::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_i0,internal__.NID_Initialise,internal__.NID_Spin,internal__.NID_DemandCallback|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   Initialise::D__(id__)
									   [| { share__, terminate } |] (
									   Spin::D__(id__)
									   [| { share__, terminate } |] (
									   DemandCallback::D__(id__)
									   [| { share__, terminate } |] (
									   i0::D__(id__)
									   )
									   )
									   )
									 )
									 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Initialise|}]]
									 [[Spin::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Spin|}]]
									 [[DemandCallback::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_DemandCallback|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 )
									)
									)
								)
								 \ hideSet)
								[[
									output_pod_demand__.x____ <- output_pod_demand,
									pod_demand_age_checked__.x____ <- pod_demand_age_checked,
									configBrakeTime__.x____ <- configBrakeTime
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_DemandCallback,DemandCallback::entered,get_CLID_Initialise,Initialise::entered,get_CLID_Spin,Spin::entered|}
						 within
							(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
						)
						)
					
					IteratedBehaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_DemandCallback,DemandCallback::entered,get_CLID_Initialise,Initialise::entered,get_CLID_Spin,Spin::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody(id__)
													[| {|get_CLID_Spin,Spin::entered,terminate|} |]
													dbisim(Clock_CLID_Spin(id__,0))
												)\{|get_CLID_Spin|}
											)
											[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
											dbisim(Clock_CLID_Initialise(id__,0))
										)\{|get_CLID_Initialise|}
									)
									[| {|get_CLID_DemandCallback,DemandCallback::entered,terminate|} |]
									dbisim(Clock_CLID_DemandCallback(id__,0))
								)\{|get_CLID_DemandCallback|}
							)
							) \ union(stateClockSync,enteredSS)
						)
						)
					
					Stateful(id__) = 
						((let
							getsetLocalChannels = {|get_brakeTime,set_brakeTime,
							get_demand,set_demand,
							get_brakedDemand,set_brakedDemand|}
							clockSync = {||}
						within
							(Behaviour(id__) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful(id__) =
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												IteratedBehaviour(id__)
												[| {|get_brakedDemand,set_brakedDemand,terminate|} |]
												Memory_brakedDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
											)\{|get_brakedDemand,set_brakedDemand|}
										)
										[| {|get_demand,set_demand,terminate|} |]
										Memory_demand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
									)\{|get_demand,set_demand|}
								)
								[| {|get_brakeTime,set_brakeTime,terminate|} |]
								Memory_brakeTime(0)
							)\{|get_brakeTime,set_brakeTime|}
						)
						)
					
					-- Visible counterparts
					MachineBody_VS_O(id__) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								Initialise::enter,
								Spin::enter,
								DemandCallback::enter,
								i0::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_i0,internal__.NID_Initialise,internal__.NID_Spin,internal__.NID_DemandCallback|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   Initialise::VS_O__(id__)
									   [| { share__, terminate } |] (
									   Spin::VS_O__(id__)
									   [| { share__, terminate } |] (
									   DemandCallback::VS_O__(id__)
									   [| { share__, terminate } |] (
									   i0::VS_O__(id__)
									   )
									   )
									   )
									 )
									 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Initialise|}]]
									 [[Spin::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Spin|}]]
									 [[DemandCallback::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_DemandCallback|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 )
									)
									)
								)
								 \ hideSet)
								[[
									output_pod_demand__.x____ <- output_pod_demand,
									pod_demand_age_checked__.x____ <- pod_demand_age_checked,
									configBrakeTime__.x____ <- configBrakeTime
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_DemandCallback,DemandCallback::entered,get_CLID_Initialise,Initialise::entered,get_CLID_Spin,Spin::entered|}
						 within
							(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					IteratedBehaviour_VS_O(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_DemandCallback,DemandCallback::entered,get_CLID_Initialise,Initialise::entered,get_CLID_Spin,Spin::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody_VS_O(id__)
													[| {|get_CLID_Spin,Spin::entered,terminate|} |]
													dbisim(Clock_CLID_Spin(id__,0))
												)\{|get_CLID_Spin|}
											)
											[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
											dbisim(Clock_CLID_Initialise(id__,0))
										)\{|get_CLID_Initialise|}
									)
									[| {|get_CLID_DemandCallback,DemandCallback::entered,terminate|} |]
									dbisim(Clock_CLID_DemandCallback(id__,0))
								)\{|get_CLID_DemandCallback|}
							)
							) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					Stateful_VS_O(id__) = 
						dbisim((let
							getsetLocalChannels = {|get_brakeTime,set_brakeTime,
							get_demand,set_demand,
							get_brakedDemand,set_brakedDemand|}
							clockSync = {||}
						within
							(Behaviour_VS_O(id__) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful_VS_O(id__) =
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												IteratedBehaviour_VS_O(id__)
												[| {|get_brakedDemand,set_brakedDemand,terminate|} |]
												Memory_brakedDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
											)\{|get_brakedDemand,set_brakedDemand|}
										)
										[| {|get_demand,set_demand,terminate|} |]
										Memory_demand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
									)\{|get_demand,set_demand|}
								)
								[| {|get_brakeTime,set_brakeTime,terminate|} |]
								Memory_brakeTime(0)
							)\{|get_brakeTime,set_brakeTime|}
						)
						)
					
					-- END
					
					-- Memory
					-- Memory variables
					Memory_brakeTime(brakeTime) =
						get_brakeTime!brakeTime -> Memory_brakeTime(brakeTime)
						[]
						set_brakeTime?x__ -> Memory_brakeTime(x__)
						[]
						terminate -> SKIP
					Memory_demand(demand) =
						get_demand!demand -> Memory_demand(demand)
						[]
						set_demand?x__ -> Memory_demand(x__)
						[]
						terminate -> SKIP
					Memory_brakedDemand(brakedDemand) =
						get_brakedDemand!brakedDemand -> Memory_brakedDemand(brakedDemand)
						[]
						set_brakedDemand?x__ -> Memory_brakedDemand(x__)
						[]
						terminate -> SKIP
					
					-- varMemory process
					varMemory(id__) = Memory_brakeTime(0)
					[| { terminate } |] (
					Memory_demand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
					[| { terminate } |] (
					Memory_brakedDemand((0,0,BrakeState_BRAKE_ON,true,DemandSource_DEMAND_AUTONOMOUS_CONTROL,true,(0,0,"")))
					)
					)
					
					getsetLocalChannels = {|get_brakeTime,set_brakeTime,get_demand,set_demand,get_brakedDemand,set_brakedDemand|}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__) = STM_VS_O(id__) \ localClockResets
					D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
					O__(id__) = dbisim(D__(id__))
					VS__(id__) = FVS__(id__)
					VS_O__(id__) = dbisim(FVS__(id__))
					HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
					FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
					HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
					
					-- Clocks
					
					Clocks(id__) = terminate -> SKIP
					
					clockSync = {||}
					
					Clock_CLID_DemandCallback(id__,x__) = 
						TimeOut_1(
							DemandCallback::entered -> Clock_CLID_DemandCallback(id__,0)
							[]
							get_CLID_DemandCallback!x__ -> Clock_CLID_DemandCallback(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_DemandCallback(id__,clock_type_plus(x__,1,CLID_DemandCallback_clock_type(id__))))
					Clock_CLID_Initialise(id__,x__) = 
						TimeOut_1(
							Initialise::entered -> Clock_CLID_Initialise(id__,0)
							[]
							get_CLID_Initialise!x__ -> Clock_CLID_Initialise(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_Initialise(id__,clock_type_plus(x__,1,CLID_Initialise_clock_type(id__))))
					Clock_CLID_Spin(id__,x__) = 
						TimeOut_1(
							Spin::entered -> Clock_CLID_Spin(id__,0)
							[]
							get_CLID_Spin!x__ -> Clock_CLID_Spin(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_Spin(id__,clock_type_plus(x__,1,CLID_Spin_clock_type(id__))))
					
					StateClocks(id__) = dbisim(Clock_CLID_DemandCallback(id__,0))
					[| { terminate } |] (
					dbisim(Clock_CLID_Initialise(id__,0))
					[| { terminate } |] (
					dbisim(Clock_CLID_Spin(id__,0))
					)
					)
					
					stateClockSync = {|get_CLID_DemandCallback,DemandCallback::entered,get_CLID_Initialise,Initialise::entered,get_CLID_Spin,Spin::entered|}
					
					-- Shared memory
					-- Shared memory variables
					
					-- sharedVarMemory process
					sharedVarMemory(id__) = terminate -> SKIP
					
					sharedVarSync = {||}
					
					sharedVarHide = {||}
					}
			endmodule
			
			Timed(OneStep) {
					-- undefined operations
					
					-- declaring controller memory
					Memory(id__, ZERO_SPEED, MINIMIM_SPEED, MAXIMUM_SPEED, ZERO_STEER) = SKIP
					
					D__(id__,
							    const_bacs_B_acs_ZERO_SPEED,
							    const_bacs_B_acs_MINIMIM_SPEED,
							    const_bacs_B_acs_MAXIMUM_SPEED,
							    const_bacs_B_acs_ZERO_STEER,
							    const_bacs_B_acs_stm_ref3_ZERO_SPEED,
							    const_bacs_B_acs_stm_ref2_DEFAULT_CONFIGURATION,
							    const_bacs_B_acs_stm_ref2_zeroSpeedLimit,
							    const_bacs_B_acs_stm_ref2_oneSpeedLimit,
							    const_bacs_B_acs_stm_ref4_AUXILIARY_SELECTION_PERIOD,
							    const_bacs_B_acs_stm_ref4_ZERO_AUXILIARY_DEMAND,
							    const_bacs_B_acs_stm_ref5_DEFAULT_CONFIGURATION,
							    const_bacs_B_acs_stm_ref6_ZERO_VEHICLE_DEMAND,
							    const_bacs_B_acs_stm_ref6_MAX_TIME_BETWEEN_DEMAND,
							    const_bacs_B_acs_stm_ref7_DEFAULT_CONFIGURATION,
							    const_bacs_B_acs_stm_ref7_ZERO_SPEED,
							    const_bacs_B_acs_stm_ref7_MINIMIM_SPEED,
							    const_bacs_B_acs_stm_ref7_MAXIMUM_SPEED,
							    const_bacs_B_acs_stm_ref7_ZERO_STEER,
							    const_bacs_B_acs_stm_ref9_ZERO_RATIO,
							    const_bacs_B_acs_stm_ref11_DEFAULT_CONFIGURATION,
							    const_bacs_B_acs_stm_ref11_MESSAGE_HANDLING_DELAY,
							    const_bacs_B_acs_stm_ref11_RATE,
							    const_bacs_B_acs_stm_ref11_ZERO_SPEED,
							    const_bacs_B_acs_stm_ref11_MINIMIM_SPEED,
							    const_bacs_B_acs_stm_ref11_MAXIMUM_SPEED,
							    const_bacs_B_acs_stm_ref11_ZERO_STEER) = prioritise(	((
							(
								let
									const_bacs_DemandLimiterSpeed_DemandLimiterSpeed_ZERO_SPEED = const_bacs_B_acs_stm_ref3_ZERO_SPEED
								within 
								stm_ref3::D__(id__,
										    const_bacs_DemandLimiterSpeed_DemandLimiterSpeed_ZERO_SPEED)[[
									stm_ref3::terminate <- terminate,
									stm_ref3::geofence_limit.in <- stm_ref8::geofence_limit.out,
									stm_ref3::geofence_limit.out <- stm_ref8::geofence_limit.in,
									stm_ref3::pod_demand.in <- stm_ref6::pod_demand.out,
									stm_ref3::pod_demand.out <- stm_ref6::pod_demand.in
								]]
							)
								[|{|terminate, stm_ref8::geofence_limit, stm_ref6::pod_demand, stm_ref3::pod_demand_geo_limited|}|]
							(
								(
									let
										const_bacs_DeadMansHandle_DeadMansHandle_DEFAULT_CONFIGURATION = const_bacs_B_acs_stm_ref2_DEFAULT_CONFIGURATION
										const_bacs_DeadMansHandle_DeadMansHandle_zeroSpeedLimit = const_bacs_B_acs_stm_ref2_zeroSpeedLimit
										const_bacs_DeadMansHandle_DeadMansHandle_oneSpeedLimit = const_bacs_B_acs_stm_ref2_oneSpeedLimit
									within 
									stm_ref2::D__(id__,
											    const_bacs_DeadMansHandle_DeadMansHandle_DEFAULT_CONFIGURATION,
											    const_bacs_DeadMansHandle_DeadMansHandle_zeroSpeedLimit,
											    const_bacs_DeadMansHandle_DeadMansHandle_oneSpeedLimit)[[
										stm_ref2::terminate <- terminate,
										stm_ref2::deadmanshandle <- deadmanshandle,
										stm_ref2::configuration <- configDeadMansController
									]]
								)
									[|{|terminate, stm_ref2::speed_limit|}|]
								(
									(
										let
											const_bacs_AuxiliarySwitch_AuxiliarySwitch_AUXILIARY_SELECTION_PERIOD = const_bacs_B_acs_stm_ref4_AUXILIARY_SELECTION_PERIOD
											const_bacs_AuxiliarySwitch_AuxiliarySwitch_ZERO_AUXILIARY_DEMAND = const_bacs_B_acs_stm_ref4_ZERO_AUXILIARY_DEMAND
										within 
										stm_ref4::D__(id__,
												    const_bacs_AuxiliarySwitch_AuxiliarySwitch_AUXILIARY_SELECTION_PERIOD,
												    const_bacs_AuxiliarySwitch_AuxiliarySwitch_ZERO_AUXILIARY_DEMAND)[[
											stm_ref4::terminate <- terminate,
											stm_ref4::resultantDemand <- auxiliary_demand,
											stm_ref4::turnigy_pod_demand.in <- stm_ref5::turnigy_auxiliary_demand.out,
											stm_ref4::turnigy_pod_demand.out <- stm_ref5::turnigy_auxiliary_demand.in,
											stm_ref4::auxiliary_demand.in <- stm_ref1::auxiliary_demand.out,
											stm_ref4::auxiliary_demand.out <- stm_ref1::auxiliary_demand.in
										]]
									)
										[|{|terminate, stm_ref5::turnigy_auxiliary_demand, stm_ref1::auxiliary_demand|}|]
									(
