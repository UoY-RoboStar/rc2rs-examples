					-- Transitions
					Transitions(id__) = ((let
						Trans = TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(latlng__!NID_Ready.in?geographic:{geographic|geographic <- LatLngHeadingFix, true} -> share__choice(set_geographic!geographic -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TranslateLocation::enter -> SKIP)))
							 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_TranslateLocation -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_local?local -> true&(share__choice(location1.out!local -> SKIP)));share__choice(get_local?local -> true&(share__choice(location2.out!local -> SKIP))) ; Ready::enter -> SKIP)))
							 [] dbisim((true)&(origin__!NID_Initialise.in?configuredOrigin:{configuredOrigin|configuredOrigin <- GpsPathPoint, true} -> share__choice(set_configuredOrigin!configuredOrigin -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Ready::enter -> SKIP)))
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
							 )
						,SKIP);Trans
					within
						Trans [|{terminate}|> SKIP
					)
					)
					
					-- Stateful
					-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
					
					-- Named process definitions
					MachineBody(id__) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								TranslateLocation::enter,
								i0::enter,
								Ready::enter,
								Initialise::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|latlng__.NID_Ready.in,internal__.NID_i0,internal__.NID_TranslateLocation,origin__.NID_Initialise.in|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   TranslateLocation::D__(id__)
									   [| { share__, terminate } |] (
									   i0::D__(id__)
									   [| { share__, terminate } |] (
									   Ready::D__(id__)
									   [| { share__, terminate } |] (
									   Initialise::D__(id__)
									   )
									   )
									   )
									 )
									 [[TranslateLocation::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_TranslateLocation|}]]
									 [[Ready::interrupt <- x__ | x__ <- {|interrupt,latlng__.NID_Ready.in|}]]
									 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,origin__.NID_Initialise.in|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__,setR_configuredOrigin,setR_geographic |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 			,setR_configuredOrigin
									 			 			,setR_geographic
									 			|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									  [[set_configuredOrigin <- setR_configuredOrigin,set_geographic <- setR_geographic]]
									 )
									)
									 [[setR_configuredOrigin <- set_configuredOrigin,setR_geographic <- set_geographic]]
									)
								)
								 \ hideSet)
								[[
									latlng__.x____ <- latlng,
									location1__.x____ <- location1,
									location2__.x____ <- location2,
									origin__.x____ <- origin
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Ready,Ready::entered,get_CLID_Initialise,Initialise::entered,get_CLID_TranslateLocation,TranslateLocation::entered|}
						 within
							(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
						)
						)
					
					IteratedBehaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Ready,Ready::entered,get_CLID_Initialise,Initialise::entered,get_CLID_TranslateLocation,TranslateLocation::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody(id__)
													[| {|get_CLID_TranslateLocation,TranslateLocation::entered,terminate|} |]
													dbisim(Clock_CLID_TranslateLocation(id__,0))
												)\{|get_CLID_TranslateLocation|}
											)
											[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
											dbisim(Clock_CLID_Initialise(id__,0))
										)\{|get_CLID_Initialise|}
									)
									[| {|get_CLID_Ready,Ready::entered,terminate|} |]
									dbisim(Clock_CLID_Ready(id__,0))
								)\{|get_CLID_Ready|}
							)
							) \ union(stateClockSync,enteredSS)
						)
						)
					
					Stateful(id__) = 
						((let
							getsetLocalChannels = {|get_geographic,set_geographic,
							get_local,set_local,
							get_configuredOrigin,set_configuredOrigin|}
							clockSync = {||}
						within
							(Behaviour(id__) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful(id__) =
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												IteratedBehaviour(id__)
												[| {|get_configuredOrigin,set_configuredOrigin,terminate|} |]
												Memory_configuredOrigin(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
											)\{|get_configuredOrigin,set_configuredOrigin|}
										)
										[| {|get_local,set_local,terminate|} |]
										Memory_local((0,0,0))
									)\{|get_local,set_local|}
								)
								[| {|get_geographic,set_geographic,terminate|} |]
								Memory_geographic((0,0,(0,0,"")))
							)\{|get_geographic,set_geographic|}
						)
						)
					
					-- Visible counterparts
					MachineBody_VS_O(id__) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								TranslateLocation::enter,
								i0::enter,
								Ready::enter,
								Initialise::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|latlng__.NID_Ready.in,internal__.NID_i0,internal__.NID_TranslateLocation,origin__.NID_Initialise.in|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   TranslateLocation::VS_O__(id__)
									   [| { share__, terminate } |] (
									   i0::VS_O__(id__)
									   [| { share__, terminate } |] (
									   Ready::VS_O__(id__)
									   [| { share__, terminate } |] (
									   Initialise::VS_O__(id__)
									   )
									   )
									   )
									 )
									 [[TranslateLocation::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_TranslateLocation|}]]
									 [[Ready::interrupt <- x__ | x__ <- {|interrupt,latlng__.NID_Ready.in|}]]
									 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,origin__.NID_Initialise.in|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__,setR_configuredOrigin,setR_geographic |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 			,setR_configuredOrigin
									 			 			,setR_geographic
									 			|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									  [[set_configuredOrigin <- setR_configuredOrigin,set_geographic <- setR_geographic]]
									 )
									)
									 [[setR_configuredOrigin <- set_configuredOrigin,setR_geographic <- set_geographic]]
									)
								)
								 \ hideSet)
								[[
									latlng__.x____ <- latlng,
									location1__.x____ <- location1,
									location2__.x____ <- location2,
									origin__.x____ <- origin
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Ready,Ready::entered,get_CLID_Initialise,Initialise::entered,get_CLID_TranslateLocation,TranslateLocation::entered|}
						 within
							(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					IteratedBehaviour_VS_O(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Ready,Ready::entered,get_CLID_Initialise,Initialise::entered,get_CLID_TranslateLocation,TranslateLocation::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody_VS_O(id__)
													[| {|get_CLID_TranslateLocation,TranslateLocation::entered,terminate|} |]
													dbisim(Clock_CLID_TranslateLocation(id__,0))
												)\{|get_CLID_TranslateLocation|}
											)
											[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
											dbisim(Clock_CLID_Initialise(id__,0))
										)\{|get_CLID_Initialise|}
									)
									[| {|get_CLID_Ready,Ready::entered,terminate|} |]
									dbisim(Clock_CLID_Ready(id__,0))
								)\{|get_CLID_Ready|}
							)
							) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					Stateful_VS_O(id__) = 
						dbisim((let
							getsetLocalChannels = {|get_geographic,set_geographic,
							get_local,set_local,
							get_configuredOrigin,set_configuredOrigin|}
							clockSync = {||}
						within
							(Behaviour_VS_O(id__) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful_VS_O(id__) =
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												IteratedBehaviour_VS_O(id__)
												[| {|get_configuredOrigin,set_configuredOrigin,terminate|} |]
												Memory_configuredOrigin(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
											)\{|get_configuredOrigin,set_configuredOrigin|}
										)
										[| {|get_local,set_local,terminate|} |]
										Memory_local((0,0,0))
									)\{|get_local,set_local|}
								)
								[| {|get_geographic,set_geographic,terminate|} |]
								Memory_geographic((0,0,(0,0,"")))
							)\{|get_geographic,set_geographic|}
						)
						)
					
					-- END
					
					-- Memory
					-- Memory variables
					Memory_geographic(geographic) =
						get_geographic!geographic -> Memory_geographic(geographic)
						[]
						set_geographic?x__ -> Memory_geographic(x__)
						[]
						terminate -> SKIP
					Memory_local(local) =
						get_local!local -> Memory_local(local)
						[]
						set_local?x__ -> Memory_local(x__)
						[]
						terminate -> SKIP
					Memory_configuredOrigin(configuredOrigin) =
						get_configuredOrigin!configuredOrigin -> Memory_configuredOrigin(configuredOrigin)
						[]
						set_configuredOrigin?x__ -> Memory_configuredOrigin(x__)
						[]
						terminate -> SKIP
					
					-- varMemory process
					varMemory(id__) = Memory_geographic((0,0,(0,0,"")))
					[| { terminate } |] (
					Memory_local((0,0,0))
					[| { terminate } |] (
					Memory_configuredOrigin(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
					)
					)
					
					getsetLocalChannels = {|get_geographic,set_geographic,get_local,set_local,get_configuredOrigin,set_configuredOrigin|}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__) = STM_VS_O(id__) \ localClockResets
					D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
					O__(id__) = dbisim(D__(id__))
					VS__(id__) = FVS__(id__)
					VS_O__(id__) = dbisim(FVS__(id__))
					HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
					FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
					HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
					
					-- Clocks
					
					Clocks(id__) = terminate -> SKIP
					
					clockSync = {||}
					
					Clock_CLID_Ready(id__,x__) = 
						TimeOut_1(
							Ready::entered -> Clock_CLID_Ready(id__,0)
							[]
							get_CLID_Ready!x__ -> Clock_CLID_Ready(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_Ready(id__,clock_type_plus(x__,1,CLID_Ready_clock_type(id__))))
					Clock_CLID_Initialise(id__,x__) = 
						TimeOut_1(
							Initialise::entered -> Clock_CLID_Initialise(id__,0)
							[]
							get_CLID_Initialise!x__ -> Clock_CLID_Initialise(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_Initialise(id__,clock_type_plus(x__,1,CLID_Initialise_clock_type(id__))))
					Clock_CLID_TranslateLocation(id__,x__) = 
						TimeOut_1(
							TranslateLocation::entered -> Clock_CLID_TranslateLocation(id__,0)
							[]
							get_CLID_TranslateLocation!x__ -> Clock_CLID_TranslateLocation(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_TranslateLocation(id__,clock_type_plus(x__,1,CLID_TranslateLocation_clock_type(id__))))
					
					StateClocks(id__) = dbisim(Clock_CLID_Ready(id__,0))
					[| { terminate } |] (
					dbisim(Clock_CLID_Initialise(id__,0))
					[| { terminate } |] (
					dbisim(Clock_CLID_TranslateLocation(id__,0))
					)
					)
					
					stateClockSync = {|get_CLID_Ready,Ready::entered,get_CLID_Initialise,Initialise::entered,get_CLID_TranslateLocation,TranslateLocation::entered|}
					
					-- Shared memory
					-- Shared memory variables
					
					-- sharedVarMemory process
					sharedVarMemory(id__) = terminate -> SKIP
					
					sharedVarSync = {||}
					
					sharedVarHide = {||}
					}
			endmodule
			module stm_ref6
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
			
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_Ready|
				              NID_CheckPriority|
				              NID_i0|
				              NID_DropDemand|
				              NID_AcceptDemand|
				              NID_UpdateAutonomousDemandStatus|
				              NID_UpdateDriveByWireStatus|
				              NID_CheckAllAbdicating|
				              NID_Initialise|
				              NID_j0
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
				channel get_msg, set_msg, setL_msg, setR_msg: PodDemand
				channel get_acceptDemand, set_acceptDemand, setL_acceptDemand, setR_acceptDemand: core_boolean
				channel get_allAbdicating, set_allAbdicating, setL_allAbdicating, setR_allAbdicating: core_boolean
				channel get_driveByWireAbdicated, set_driveByWireAbdicated, setL_driveByWireAbdicated, setR_driveByWireAbdicated: core_boolean
				channel get_autonomousControlAbdicated, set_autonomousControlAbdicated, setL_autonomousControlAbdicated, setR_autonomousControlAbdicated: core_boolean
				channel get_priorityCheckComplete, set_priorityCheckComplete, setL_priorityCheckComplete, setR_priorityCheckComplete: core_boolean
				
				-- Shared variable channels
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				channel demand__: NIDS.InOut.PodDemand
				channel demand: InOut.PodDemand
				channel turnigy_pod_demand__: NIDS.InOut.PodDemand
				channel turnigy_pod_demand: InOut.PodDemand
				channel pod_demand__: NIDS.InOut.PodDemand
				channel pod_demand: InOut.PodDemand
				
				-- Declaring call and ret events for undefined operations
				
				enterSS = {|
				Ready::enter,
				CheckPriority::enter,
				i0::enter,
				DropDemand::enter,
				AcceptDemand::enter,
				UpdateAutonomousDemandStatus::enter,
				UpdateDriveByWireStatus::enter,
				CheckAllAbdicating::enter,
				Initialise::enter,
				j0::enter
				|}
				
				enteredSS = 	{|
				Ready::entered,
				CheckPriority::entered,
				DropDemand::entered,
				AcceptDemand::entered,
				UpdateAutonomousDemandStatus::entered,
				UpdateDriveByWireStatus::entered,
				CheckAllAbdicating::entered,
				Initialise::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	demand,
					turnigy_pod_demand,
					pod_demand
					|}
				datatype ClockSet = 
					CLID_driveByWireDemandTimer|
					CLID_autonomousDemandTimer
				
				channel clockReset, clockResetL, clockResetR : ClockSet
				
				localClockResets = {|clockReset.CLID_driveByWireDemandTimer,clockReset.CLID_autonomousDemandTimer|}
				
				
				channel get_CLID_UpdateDriveByWireStatus : core_clock_type 
				channel get_CLID_driveByWireDemandTimer : core_clock_type 
				channel get_CLID_CheckAllAbdicating : core_clock_type 
				channel get_CLID_Initialise : core_clock_type 
				channel get_CLID_autonomousDemandTimer : core_clock_type 
				channel get_CLID_CheckPriority : core_clock_type 
				channel get_CLID_Ready : core_clock_type 
				channel get_CLID_AcceptDemand : core_clock_type 
				channel get_CLID_DropDemand : core_clock_type 
				channel get_CLID_UpdateAutonomousDemandStatus : core_clock_type 
				--channel increment__
				
				CLID_UpdateDriveByWireStatus_clock_type(id__,
						          const_bacs_ControlSwitch_ControlSwitch_ZERO_VEHICLE_DEMAND,
						          const_bacs_ControlSwitch_ControlSwitch_MAX_TIME_BETWEEN_DEMAND) = 
					let
						max = (clock_type_max(Union({
				{}
				}))+1)
					ctype = {0..max}
				within
					if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
				
				CLID_driveByWireDemandTimer_clock_type(id__,
						          const_bacs_ControlSwitch_ControlSwitch_ZERO_VEHICLE_DEMAND,
						          const_bacs_ControlSwitch_ControlSwitch_MAX_TIME_BETWEEN_DEMAND) = 
					let
						max = (clock_type_max(Union({
				({const_bacs_ControlSwitch_ControlSwitch_MAX_TIME_BETWEEN_DEMAND|MAX_TIME_BETWEEN_DEMAND <- core_nat}),
				({const_bacs_ControlSwitch_ControlSwitch_MAX_TIME_BETWEEN_DEMAND|MAX_TIME_BETWEEN_DEMAND <- core_nat}),
				{}
				}))+1)
					ctype = {0..max}
				within
