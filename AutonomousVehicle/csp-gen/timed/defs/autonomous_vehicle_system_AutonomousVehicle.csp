				channel latlng: InOut.LatLngHeadingFix
				channel location1__: NIDS.InOut.Pose2DStamped
				channel location1: InOut.Pose2DStamped
				channel location2__: NIDS.InOut.Pose2DStamped
				channel location2: InOut.Pose2DStamped
				channel origin__: NIDS.InOut.GpsPathPoint
				channel origin: InOut.GpsPathPoint
				
