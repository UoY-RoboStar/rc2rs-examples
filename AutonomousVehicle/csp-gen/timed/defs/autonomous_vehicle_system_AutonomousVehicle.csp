					-- END
					
					-- Memory
					-- Memory variables
					Memory_newPowertrain(newPowertrain) =
						get_newPowertrain!newPowertrain -> Memory_newPowertrain(newPowertrain)
						[]
						set_newPowertrain?x__ -> Memory_newPowertrain(x__)
						[]
						terminate -> SKIP
					Memory_newIndicator(newIndicator) =
						get_newIndicator!newIndicator -> Memory_newIndicator(newIndicator)
						[]
						set_newIndicator?x__ -> Memory_newIndicator(x__)
						[]
						terminate -> SKIP
					Memory_newPodstate(newPodstate) =
						get_newPodstate!newPodstate -> Memory_newPodstate(newPodstate)
						[]
						set_newPodstate?x__ -> Memory_newPodstate(x__)
						[]
						terminate -> SKIP
					
					-- varMemory process
					varMemory(id__) = Memory_newPowertrain((0,true,true,true))
					[| { terminate } |] (
					Memory_newIndicator((true,true))
					[| { terminate } |] (
					Memory_newPodstate((0,true,true))
					)
					)
					
					getsetLocalChannels = {|get_newPowertrain,set_newPowertrain,get_newIndicator,set_newIndicator,get_newPodstate,set_newPodstate|}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__) = STM_VS_O(id__) \ localClockResets
					D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
					O__(id__) = dbisim(D__(id__))
					VS__(id__) = FVS__(id__)
					VS_O__(id__) = dbisim(FVS__(id__))
					HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
					FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
					HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
					
