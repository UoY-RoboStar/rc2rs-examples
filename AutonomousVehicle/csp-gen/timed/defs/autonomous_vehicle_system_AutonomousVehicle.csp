					-- Nodes --
					-- declaring all nodes
					
					----------------------------------------------------------------------
					-- State: TranslateLocation
					module TranslateLocation
					
					enterSS = {}
					
					enteredSS = {}
					
					exports
					
						--  Declarations
						
						channel enter, entered, interrupt
