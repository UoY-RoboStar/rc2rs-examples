				CLID_CheckPriority_clock_type(id__,
						          const_bacs_ControlSwitch_ControlSwitch_ZERO_VEHICLE_DEMAND,
						          const_bacs_ControlSwitch_ControlSwitch_MAX_TIME_BETWEEN_DEMAND) = 
					let
						max = (clock_type_max(Union({
