							VS_O__(id__,
									    const_bacs_ControlSwitch_ControlSwitch_ZERO_VEHICLE_DEMAND,
									    const_bacs_ControlSwitch_ControlSwitch_MAX_TIME_BETWEEN_DEMAND) = D__(id__,
