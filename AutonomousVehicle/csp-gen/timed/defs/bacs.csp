					----------------------------------------------------------------------
					-- Initial: i0
					module i0
					exports
					
						channel enter, interrupt
						
						Timed(OneStep) {
							D__(id__,
									    const_bacs_ControlSwitch_ControlSwitch_ZERO_VEHICLE_DEMAND,
									    const_bacs_ControlSwitch_ControlSwitch_MAX_TIME_BETWEEN_DEMAND) = 
								dbisim(let
									Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
									
									Termination = terminate -> SKIP
									
									Active 		= share__choice(interrupt -> SKIP) ; Inactive
								within
