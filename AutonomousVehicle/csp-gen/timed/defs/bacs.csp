			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_Initialise|
			              NID_Spin|
			              NID_GpsCallback|
			              NID_i0
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			channel get_currentConfiguration, set_currentConfiguration, setL_currentConfiguration, setR_currentConfiguration: ConfigGeofence
			channel get_msg, set_msg, setL_msg, setR_msg: LatLngHeadingFix
			channel get_speedLimit, set_speedLimit, setL_speedLimit, setR_speedLimit: SpeedLimit
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel latlng__: NIDS.InOut.LatLngHeadingFix
			channel latlng: InOut.LatLngHeadingFix
			channel geofence_limit__: NIDS.InOut.SpeedLimit
			channel geofence_limit: InOut.SpeedLimit
			channel configuration__: NIDS.InOut.ConfigGeofence
			channel configuration: InOut.ConfigGeofence
			
			-- Declaring call and ret events for undefined operations
			
			enterSS = {|
			Initialise::enter,
			Spin::enter,
			GpsCallback::enter,
			i0::enter
			|}
			
			enteredSS = 	{|
			Initialise::entered,
			Spin::entered,
			GpsCallback::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	latlng,
				geofence_limit,
				configuration
				|}
			
			channel clockReset, clockResetL, clockResetR 
			
			localClockResets = {||}
			
			
			channel get_CLID_Spin : core_clock_type 
			channel get_CLID_Initialise : core_clock_type 
			channel get_CLID_GpsCallback : core_clock_type 
			--channel increment__
			
			CLID_Spin_clock_type(id__) = 
				let
					max = (clock_type_max(Union({
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			CLID_Initialise_clock_type(id__) = 
				let
					max = (clock_type_max(Union({
			}))+1)
				ctype = {0..max}
			within
