			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			channel get_geographic, set_geographic, setL_geographic, setR_geographic: LatLngHeadingFix
			channel get_local, set_local, setL_local, setR_local: Pose2DStamped
			channel get_configuredOrigin, set_configuredOrigin, setL_configuredOrigin, setR_configuredOrigin: GpsPathPoint
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel latlng__: NIDS.InOut.LatLngHeadingFix
			channel latlng: InOut.LatLngHeadingFix
			channel location1__: NIDS.InOut.Pose2DStamped
			channel location1: InOut.Pose2DStamped
			channel location2__: NIDS.InOut.Pose2DStamped
			channel location2: InOut.Pose2DStamped
