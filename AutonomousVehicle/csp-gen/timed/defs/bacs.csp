						[]
						terminate -> SKIP,Clock_CLID_Spin(id__,clock_type_plus(x__,1,CLID_Spin_clock_type(id__))))
				
				StateClocks(id__) = dbisim(Clock_CLID_DemandCallback(id__,0))
				[| { terminate } |] (
				dbisim(Clock_CLID_Initialise(id__,0))
				[| { terminate } |] (
				dbisim(Clock_CLID_Spin(id__,0))
				)
				)
				
