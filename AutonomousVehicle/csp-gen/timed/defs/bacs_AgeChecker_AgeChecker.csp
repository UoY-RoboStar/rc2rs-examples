						 								)[[setL_age <- set_age,setL_ageToStartRamp <- set_ageToStartRamp,setL_ageToStop <- set_ageToStop]]
						 								)
						 							)
						 							 \ hideSet)
						 							[[
						 								pod_demand_limited__.x____ <- pod_demand_limited,
						 								pod_demand_age_checked__.x____ <- pod_demand_age_checked,
						 								config__.x____ <- config
						 								| x____ <- NIDS
						 							]]
						 						)
						 						[| {|get_CLID_PrepareNewDemand,PrepareNewDemand::entered,terminate|} |]
						 						dbisim(Clock_CLID_PrepareNewDemand(id__,0,
						 								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 								          const_bacs_AgeChecker_AgeChecker_RATE,
						 								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
						 					)\{|get_CLID_PrepareNewDemand|}
						 				)
						 				[| {|get_CLID_Stop,Stop::entered,terminate|} |]
						 				dbisim(Clock_CLID_Stop(id__,0,
						 						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 						          const_bacs_AgeChecker_AgeChecker_RATE,
						 						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
						 			)\{|get_CLID_Stop|}
						 		)
						 		[| {|get_CLID_RampDown,RampDown::entered,terminate|} |]
						 		dbisim(Clock_CLID_RampDown(id__,0,
						 				          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						 				          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						 				          const_bacs_AgeChecker_AgeChecker_RATE,
						 				          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						 				          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						 				          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						 				          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
						 	)\{|get_CLID_RampDown|}
						 )
						 ))
						  [[ share__ <- x__ | x__ <- {| share__,setR_ageToStartRamp,setR_newDemand,setR_ageToStop,clockResetR.CLID_messageHandling,setR_age,clockResetR.CLID_loop,setR_rate,setR_retrievedConfiguration,setR_executingCheckAge,setR_demand |} ]] 
						  [[set_age <- setL_age,clockReset.CLID_loop <- clockResetL.CLID_loop,set_ageToStartRamp <- setL_ageToStartRamp,set_newDemand <- setL_newDemand,set_ageToStop <- setL_ageToStop,clockReset.CLID_messageHandling <- clockResetL.CLID_messageHandling,set_rate <- setL_rate,set_retrievedConfiguration <- setL_retrievedConfiguration,set_executingCheckAge <- setL_executingCheckAge,set_demand <- setL_demand]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_age
						 			,clockResetL.CLID_loop
						 			,setL_ageToStartRamp
						 			,setL_newDemand
						 			,setL_ageToStop
						 			,clockResetL.CLID_messageHandling
						 			,setL_rate
						 			,setL_retrievedConfiguration
						 			,setL_executingCheckAge
						 			,setL_demand
						 			,setR_ageToStartRamp
						 			 			,setR_newDemand
						 			 			,setR_ageToStop
						 			 			,clockResetR.CLID_messageHandling
						 			 			,setR_age
						 			 			,clockResetR.CLID_loop
						 			 			,setR_rate
						 			 			,setR_retrievedConfiguration
						 			 			,setR_executingCheckAge
						 			 			,setR_demand
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_age,clockResetL.CLID_loop,setL_ageToStartRamp,setL_newDemand,setL_ageToStop,clockResetL.CLID_messageHandling,setL_rate,setL_retrievedConfiguration,setL_executingCheckAge,setL_demand |} ]]
						  [[set_ageToStartRamp <- setR_ageToStartRamp,set_newDemand <- setR_newDemand,set_ageToStop <- setR_ageToStop,clockReset.CLID_messageHandling <- clockResetR.CLID_messageHandling,set_age <- setR_age,clockReset.CLID_loop <- clockResetR.CLID_loop,set_rate <- setR_rate,set_retrievedConfiguration <- setR_retrievedConfiguration,set_executingCheckAge <- setR_executingCheckAge,set_demand <- setR_demand]]
						 )
						)[[setL_age <- set_age,clockResetL.CLID_loop <- clockReset.CLID_loop,setL_ageToStartRamp <- set_ageToStartRamp,setL_newDemand <- set_newDemand,setL_ageToStop <- set_ageToStop,clockResetL.CLID_messageHandling <- clockReset.CLID_messageHandling,setL_rate <- set_rate,setL_retrievedConfiguration <- set_retrievedConfiguration,setL_executingCheckAge <- set_executingCheckAge,setL_demand <- set_demand]]
						 [[setR_ageToStartRamp <- set_ageToStartRamp,setR_newDemand <- set_newDemand,setR_ageToStop <- set_ageToStop,clockResetR.CLID_messageHandling <- clockReset.CLID_messageHandling,setR_age <- set_age,clockResetR.CLID_loop <- clockReset.CLID_loop,setR_rate <- set_rate,setR_retrievedConfiguration <- set_retrievedConfiguration,setR_executingCheckAge <- set_executingCheckAge,setR_demand <- set_demand]]
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__,
						    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						    const_bacs_AgeChecker_AgeChecker_RATE,
						    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = ((let
					Trans = share__choice(get_age?age -> get_ageToStartRamp?ageToStartRamp -> get_ageToStop?ageToStop -> TimeOut_1(
						 (share__ -> SKIP
						 [] dbisim(((age>ageToStartRamp))&(internal__!NID_j0 -> SKIP ;  ((SKIP ; PrepareNewDemand::enter -> SKIP))))
						 [] dbisim((true)&(internal__!NID_RampDown -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; checkAgeOut::enter -> SKIP)))
						 [] dbisim((true)&(internal__!NID_Stop -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; checkAgeOut::enter -> SKIP)))
						 [] dbisim((true)&(internal__!NID_checkAgeOut -> SKIP ;  ((share__choice(get_newDemand?newDemand -> true&(share__choice(pod_demand_age_checked.out!newDemand -> SKIP))) ; j1::enter -> SKIP))))
						 [] dbisim(((age>=ageToStop))&(internal__!NID_PrepareNewDemand -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Stop::enter -> SKIP)))
						 [] dbisim(((not ((age>ageToStartRamp))))&(internal__!NID_j0 -> SKIP ;  ((SKIP ; j1::enter -> SKIP))))
						 [] dbisim((true)&(internal__!NID_initialCheckAge -> SKIP ;  ((SKIP ; j0::enter -> SKIP))))
						 [] dbisim((true)&(internal__!NID_j1 -> SKIP ;  ((share__choice(true & (share__choice(set_executingCheckAge!false -> SKIP))) ; finalCheckAge::enter -> SKIP))))
						 [] dbisim(((age<ageToStop))&(internal__!NID_PrepareNewDemand -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; RampDown::enter -> SKIP)))
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
						 )
					,SKIP);Trans
					)
				within
					Trans [|{terminate}|> SKIP
				)
				)
				
				
				-- Clocks
				Clock_CLID_RampDown(id__,x__,
						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						          const_bacs_AgeChecker_AgeChecker_RATE,
						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
					TimeOut_1(
						RampDown::entered -> Clock_CLID_RampDown(id__,0,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						[]
						get_CLID_RampDown!x__ -> Clock_CLID_RampDown(id__,x__,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						[]
						terminate -> SKIP,Clock_CLID_RampDown(id__,clock_type_plus(x__,1,CLID_RampDown_clock_type(id__,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)),
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
				Clock_CLID_Stop(id__,x__,
						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						          const_bacs_AgeChecker_AgeChecker_RATE,
						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
					TimeOut_1(
						Stop::entered -> Clock_CLID_Stop(id__,0,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						[]
						get_CLID_Stop!x__ -> Clock_CLID_Stop(id__,x__,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						[]
						terminate -> SKIP,Clock_CLID_Stop(id__,clock_type_plus(x__,1,CLID_Stop_clock_type(id__,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)),
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
				Clock_CLID_PrepareNewDemand(id__,x__,
						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						          const_bacs_AgeChecker_AgeChecker_RATE,
						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
					TimeOut_1(
						PrepareNewDemand::entered -> Clock_CLID_PrepareNewDemand(id__,0,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						[]
						get_CLID_PrepareNewDemand!x__ -> Clock_CLID_PrepareNewDemand(id__,x__,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
						[]
						terminate -> SKIP,Clock_CLID_PrepareNewDemand(id__,clock_type_plus(x__,1,CLID_PrepareNewDemand_clock_type(id__,
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER)),
								          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
								          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
								          const_bacs_AgeChecker_AgeChecker_RATE,
								          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
								          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
				
				StateClocks(id__,
						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						          const_bacs_AgeChecker_AgeChecker_RATE,
						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = dbisim(Clock_CLID_RampDown(id__,0,
						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						          const_bacs_AgeChecker_AgeChecker_RATE,
						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
				[| { terminate } |] (
				dbisim(Clock_CLID_Stop(id__,0,
						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						          const_bacs_AgeChecker_AgeChecker_RATE,
						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
				[| { terminate } |] (
				dbisim(Clock_CLID_PrepareNewDemand(id__,0,
						          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
						          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
						          const_bacs_AgeChecker_AgeChecker_RATE,
						          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
						          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
				)
				)
				
				stateClockSync = {|get_CLID_RampDown,RampDown::entered,get_CLID_Stop,Stop::entered,get_CLID_PrepareNewDemand,PrepareNewDemand::entered|}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: DemandCallback
		module DemandCallback
		
		enterSS = 
				{|			initialDemandCallback::enter,
					finalDemandCallback::enter,
					j0::enter,
					j1::enter
				|}
		enteredSS = 
				{|			finalDemandCallback::entered
				|}
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_initialDemandCallback|
			              NID_finalDemandCallback|
			              NID_j0|
			              NID_j1
			
			channel internal__ : NIDS
			channel pod_demand_limited__: NIDS.InOut.PodDemand
			channel pod_demand_age_checked__: NIDS.InOut.PodDemand
			channel config__: NIDS.InOut.ConfigAgeChecker
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: initialDemandCallback
			module initialDemandCallback
			exports
			
				channel enter, interrupt
				
				Timed(OneStep) {
					D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER)
				}
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Final state: finalDemandCallback
			module finalDemandCallback
			
			exports
			
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
				Timed(OneStep) {
					--	Rule: behaviours(Node)
					D__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
							    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
							
							Entering 	= entered -> SKIP ; Active
							Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
							Interrupted	= share__choice(exit -> exited -> Inactive)
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
							    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
							    const_bacs_AgeChecker_AgeChecker_RATE,
							    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
