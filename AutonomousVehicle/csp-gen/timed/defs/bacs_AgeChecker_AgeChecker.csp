				          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
				          const_bacs_AgeChecker_AgeChecker_RATE,
				          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
				          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
				          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
				          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
		[| { terminate } |] (
		dbisim(Clock_CLID_SpinOnce(id__,0,
				          const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
				          const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
				          const_bacs_AgeChecker_AgeChecker_RATE,
				          const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
				          const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
				          const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
				          const_bacs_AgeChecker_AgeChecker_ZERO_STEER))
		)
		)
		)
		)
		
		stateClockSync = {|get_CLID_DemandCallback,DemandCallback::entered,get_CLID_Initialise,Initialise::entered,get_CLID_CheckAge,CheckAge::entered,get_CLID_Sleep,Sleep::entered,get_CLID_SpinOnce,SpinOnce::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_bacs_AgeChecker_AgeChecker_DEFAULT_CONFIGURATION,
				    const_bacs_AgeChecker_AgeChecker_MESSAGE_HANDLING_DELAY,
				    const_bacs_AgeChecker_AgeChecker_RATE,
				    const_bacs_AgeChecker_AgeChecker_ZERO_SPEED,
				    const_bacs_AgeChecker_AgeChecker_MINIMIM_SPEED,
				    const_bacs_AgeChecker_AgeChecker_MAXIMUM_SPEED,
				    const_bacs_AgeChecker_AgeChecker_ZERO_STEER) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule
