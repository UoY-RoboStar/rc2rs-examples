						)[[setL_age <- set_age,clockResetL.CLID_loop <- clockReset.CLID_loop,setL_ageToStartRamp <- set_ageToStartRamp,setL_newDemand <- set_newDemand,setL_ageToStop <- set_ageToStop,clockResetL.CLID_messageHandling <- clockReset.CLID_messageHandling,setL_rate <- set_rate,setL_retrievedConfiguration <- set_retrievedConfiguration,setL_executingCheckAge <- set_executingCheckAge,setL_demand <- set_demand]]
						 [[setR_age <- set_age,clockResetR.CLID_loop <- clockReset.CLID_loop,setR_ageToStartRamp <- set_ageToStartRamp,setR_newDemand <- set_newDemand,setR_ageToStop <- set_ageToStop,clockResetR.CLID_messageHandling <- clockReset.CLID_messageHandling,setR_rate <- set_rate,setR_retrievedConfiguration <- set_retrievedConfiguration,setR_executingCheckAge <- set_executingCheckAge,setR_demand <- set_demand]]
