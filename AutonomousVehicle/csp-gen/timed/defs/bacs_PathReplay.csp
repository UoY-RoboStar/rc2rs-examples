									)
									[| {|get_goalConfig,set_goalConfig,terminate|} |]
									Memory_goalConfig((0,0))
								)\{|get_goalConfig,set_goalConfig|}
							)
							[| {|get_currentRoute,set_currentRoute,terminate|} |]
							Memory_currentRoute(<>)
						)\{|get_currentRoute,set_currentRoute|}
					)
					[| {|get_origin,set_origin,terminate|} |]
					Memory_origin(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
				)\{|get_origin,set_origin|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_origin(origin) =
			get_origin!origin -> Memory_origin(origin)
			[]
			set_origin?x__ -> Memory_origin(x__)
			[]
			terminate -> SKIP
		Memory_currentRoute(currentRoute) =
			get_currentRoute!currentRoute -> Memory_currentRoute(currentRoute)
			[]
			set_currentRoute?x__ -> Memory_currentRoute(x__)
			[]
			terminate -> SKIP
		Memory_goalConfig(goalConfig) =
			get_goalConfig!goalConfig -> Memory_goalConfig(goalConfig)
			[]
			set_goalConfig?x__ -> Memory_goalConfig(x__)
			[]
			terminate -> SKIP
		Memory_locationLatest(locationLatest) =
			get_locationLatest!locationLatest -> Memory_locationLatest(locationLatest)
			[]
			set_locationLatest?x__ -> Memory_locationLatest(x__)
			[]
			terminate -> SKIP
		Memory_goalPoint(goalPoint) =
			get_goalPoint!goalPoint -> Memory_goalPoint(goalPoint)
			[]
			set_goalPoint?x__ -> Memory_goalPoint(x__)
			[]
			terminate -> SKIP
		Memory_newObjective(newObjective) =
			get_newObjective!newObjective -> Memory_newObjective(newObjective)
			[]
			set_newObjective?x__ -> Memory_newObjective(x__)
			[]
			terminate -> SKIP
		Memory_goalAuxiliaries(goalAuxiliaries) =
			get_goalAuxiliaries!goalAuxiliaries -> Memory_goalAuxiliaries(goalAuxiliaries)
			[]
			set_goalAuxiliaries?x__ -> Memory_goalAuxiliaries(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__) = Memory_origin(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
		[| { terminate } |] (
		Memory_currentRoute(<>)
		[| { terminate } |] (
		Memory_goalConfig((0,0))
		[| { terminate } |] (
		Memory_locationLatest((0,0,0))
		[| { terminate } |] (
		Memory_goalPoint(((0,0,(0,0,"")),0,(true,true,true,0,(0,0,"")),0,0))
		[| { terminate } |] (
		Memory_newObjective((0,0,(0,0,0)))
		[| { terminate } |] (
		Memory_goalAuxiliaries((true,true,true,0,(0,0,"")))
		)
		)
		)
		)
		)
		)
		
		getsetLocalChannels = {|get_origin,set_origin,get_currentRoute,set_currentRoute,get_goalConfig,set_goalConfig,get_locationLatest,set_locationLatest,get_goalPoint,set_goalPoint,get_newObjective,set_newObjective,get_goalAuxiliaries,set_goalAuxiliaries|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__) = STM_VS_O(id__) \ localClockResets
		D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
		O__(id__) = dbisim(D__(id__))
		VS__(id__) = FVS__(id__)
		VS_O__(id__) = dbisim(FVS__(id__))
		HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
		FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
		HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Reset(id__,x__) = 
			TimeOut_1(
				Reset::entered -> Clock_CLID_Reset(id__,0)
				[]
				get_CLID_Reset!x__ -> Clock_CLID_Reset(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Reset(id__,clock_type_plus(x__,1,CLID_Reset_clock_type(id__))))
		Clock_CLID_Unconfigured(id__,x__) = 
			TimeOut_1(
				Unconfigured::entered -> Clock_CLID_Unconfigured(id__,0)
				[]
				get_CLID_Unconfigured!x__ -> Clock_CLID_Unconfigured(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Unconfigured(id__,clock_type_plus(x__,1,CLID_Unconfigured_clock_type(id__))))
		Clock_CLID_NextGoal(id__,x__) = 
			TimeOut_1(
				NextGoal::entered -> Clock_CLID_NextGoal(id__,0)
				[]
				get_CLID_NextGoal!x__ -> Clock_CLID_NextGoal(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_NextGoal(id__,clock_type_plus(x__,1,CLID_NextGoal_clock_type(id__))))
		Clock_CLID_WaitForRoute(id__,x__) = 
			TimeOut_1(
				WaitForRoute::entered -> Clock_CLID_WaitForRoute(id__,0)
				[]
				get_CLID_WaitForRoute!x__ -> Clock_CLID_WaitForRoute(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_WaitForRoute(id__,clock_type_plus(x__,1,CLID_WaitForRoute_clock_type(id__))))
		Clock_CLID_TranslateAuxiliaries(id__,x__) = 
			TimeOut_1(
				TranslateAuxiliaries::entered -> Clock_CLID_TranslateAuxiliaries(id__,0)
				[]
				get_CLID_TranslateAuxiliaries!x__ -> Clock_CLID_TranslateAuxiliaries(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_TranslateAuxiliaries(id__,clock_type_plus(x__,1,CLID_TranslateAuxiliaries_clock_type(id__))))
		Clock_CLID_CurrentGoal(id__,x__) = 
			TimeOut_1(
				CurrentGoal::entered -> Clock_CLID_CurrentGoal(id__,0)
				[]
				get_CLID_CurrentGoal!x__ -> Clock_CLID_CurrentGoal(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_CurrentGoal(id__,clock_type_plus(x__,1,CLID_CurrentGoal_clock_type(id__))))
		Clock_CLID_ConfigureOrigin(id__,x__) = 
			TimeOut_1(
				ConfigureOrigin::entered -> Clock_CLID_ConfigureOrigin(id__,0)
				[]
				get_CLID_ConfigureOrigin!x__ -> Clock_CLID_ConfigureOrigin(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_ConfigureOrigin(id__,clock_type_plus(x__,1,CLID_ConfigureOrigin_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_Reset(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Unconfigured(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_NextGoal(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_WaitForRoute(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_TranslateAuxiliaries(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_CurrentGoal(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_ConfigureOrigin(id__,0))
		)
		)
		)
		)
		)
		)
		
		stateClockSync = {|get_CLID_Reset,Reset::entered,get_CLID_Unconfigured,Unconfigured::entered,get_CLID_NextGoal,NextGoal::entered,get_CLID_WaitForRoute,WaitForRoute::entered,get_CLID_TranslateAuxiliaries,TranslateAuxiliaries::entered,get_CLID_CurrentGoal,CurrentGoal::entered,get_CLID_ConfigureOrigin,ConfigureOrigin::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule


endmodule
