																				[| {|get_CLID_EmergencyStop,EmergencyStop::entered,terminate|} |]
																				dbisim(Clock_CLID_EmergencyStop(id__,0))
																			)\{|get_CLID_EmergencyStop|}
																		)
																		[| {|get_CLID_Manual,Manual::entered,terminate|} |]
																		dbisim(Clock_CLID_Manual(id__,0))
																	)\{|get_CLID_Manual|}
																)
																[| {|get_CLID_Off,Off::entered,terminate|} |]
																dbisim(Clock_CLID_Off(id__,0))
															)\{|get_CLID_Off|}
														)
														[| {|get_CLID_NewSession,NewSession::entered,terminate|} |]
														dbisim(Clock_CLID_NewSession(id__,0))
													)\{|get_CLID_NewSession|}
												)
												[| {|get_CLID_UpdateSession,UpdateSession::entered,terminate|} |]
												dbisim(Clock_CLID_UpdateSession(id__,0))
											)\{|get_CLID_UpdateSession|}
										)
										[| {|get_CLID_UpdateUserInstruction,UpdateUserInstruction::entered,terminate|} |]
										dbisim(Clock_CLID_UpdateUserInstruction(id__,0))
									)\{|get_CLID_UpdateUserInstruction|}
								)
								[| {|get_CLID_NoSession,NoSession::entered,terminate|} |]
								dbisim(Clock_CLID_NoSession(id__,0))
							)\{|get_CLID_NoSession|}
						)
						[| {|get_CLID_Error,Error::entered,terminate|} |]
						dbisim(Clock_CLID_Error(id__,0))
					)\{|get_CLID_Error|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = 
			dbisim((let
				getsetLocalChannels = {|get_next,set_next,
				get_newInstruction,set_newInstruction,
				get_newReadyState,set_newReadyState,
				get_newInstructionAndSession,set_newInstructionAndSession|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,
							param_readyState,
							param_currentSession,
							param_podStatus,
							param_podPowertrain,
							param_podEps,
							param_podEpsInboard,
							param_podEpsOutboard,
							param_podParkBrake,
							param_podBattery,
							param_podControlCommand1,
							param_podHandshake) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 			param_readyState,
				 			param_currentSession,
				 			param_podStatus,
				 			param_podPowertrain,
				 			param_podEps,
				 			param_podEpsInboard,
				 			param_podEpsOutboard,
				 			param_podParkBrake,
				 			param_podBattery,
				 			param_podControlCommand1,
				 			param_podHandshake) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) =
			(dbisim(
				sbisim(
					dbisim(
						sbisim(
							dbisim(
								sbisim(
									dbisim(
										sbisim(
											IteratedBehaviour_VS_O(id__,
														param_readyState,
														param_currentSession,
														param_podStatus,
														param_podPowertrain,
														param_podEps,
														param_podEpsInboard,
														param_podEpsOutboard,
														param_podParkBrake,
														param_podBattery,
														param_podControlCommand1,
														param_podHandshake)
											[| {|get_newInstructionAndSession,set_newInstructionAndSession,terminate|} |]
											Memory_newInstructionAndSession((true,(UserCode_DRIVER_SEAT),(VehicleState_INVALID,0)))
										)\{|get_newInstructionAndSession,set_newInstructionAndSession|}
									)
									[| {|get_newReadyState,set_newReadyState,terminate|} |]
									Memory_newReadyState(VehicleReadyState_DRIVER_SEAT_ERROR)
								)\{|get_newReadyState,set_newReadyState|}
							)
							[| {|get_newInstruction,set_newInstruction,terminate|} |]
							Memory_newInstruction((true,(UserCode_DRIVER_SEAT)))
						)\{|get_newInstruction,set_newInstruction|}
					)
					[| {|get_next,set_next,terminate|} |]
					Memory_next((VehicleState_INVALID,0))
				)\{|get_next,set_next|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_next(next) =
			get_next!next -> Memory_next(next)
			[]
			set_next?x__ -> Memory_next(x__)
			[]
			terminate -> SKIP
		Memory_newInstruction(newInstruction) =
			get_newInstruction!newInstruction -> Memory_newInstruction(newInstruction)
			[]
			set_newInstruction?x__ -> Memory_newInstruction(x__)
			[]
			terminate -> SKIP
		Memory_newReadyState(newReadyState) =
			get_newReadyState!newReadyState -> Memory_newReadyState(newReadyState)
			[]
			set_newReadyState?x__ -> Memory_newReadyState(x__)
			[]
			terminate -> SKIP
		Memory_newInstructionAndSession(newInstructionAndSession) =
			get_newInstructionAndSession!newInstructionAndSession -> Memory_newInstructionAndSession(newInstructionAndSession)
			[]
			set_newInstructionAndSession?x__ -> Memory_newInstructionAndSession(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = Memory_next((VehicleState_INVALID,0))
		[| { terminate } |] (
		Memory_newInstruction((true,(UserCode_DRIVER_SEAT)))
		[| { terminate } |] (
		Memory_newReadyState(VehicleReadyState_DRIVER_SEAT_ERROR)
		[| { terminate } |] (
		Memory_newInstructionAndSession((true,(UserCode_DRIVER_SEAT),(VehicleState_INVALID,0)))
		)
		)
		)
		
		getsetLocalChannels = {|get_next,set_next,get_newInstruction,set_newInstruction,get_newReadyState,set_newReadyState,get_newInstructionAndSession,set_newInstructionAndSession|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = STM_VS_O(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) \ localClockResets
		D__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = timed_priority(STM(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) \ union(internal_events,localClockResets))
		O__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = dbisim(D__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake))
		VS__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = FVS__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake)
		VS_O__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = dbisim(FVS__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake))
		HEXT__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = O__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) [|shared_variable_events|] SKIP
		FVS_C__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = dbisim(timed_priority(STM(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) \ internal_events))
		HUP__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) = timed_priority(O__(id__,
					param_readyState,
					param_currentSession,
					param_podStatus,
					param_podPowertrain,
					param_podEps,
					param_podEpsInboard,
					param_podEpsOutboard,
					param_podParkBrake,
					param_podBattery,
					param_podControlCommand1,
					param_podHandshake) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Error(id__,x__) = 
			TimeOut_1(
				Error::entered -> Clock_CLID_Error(id__,0)
				[]
				get_CLID_Error!x__ -> Clock_CLID_Error(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Error(id__,clock_type_plus(x__,1,CLID_Error_clock_type(id__))))
		Clock_CLID_NoSession(id__,x__) = 
			TimeOut_1(
				NoSession::entered -> Clock_CLID_NoSession(id__,0)
				[]
				get_CLID_NoSession!x__ -> Clock_CLID_NoSession(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_NoSession(id__,clock_type_plus(x__,1,CLID_NoSession_clock_type(id__))))
		Clock_CLID_UpdateUserInstruction(id__,x__) = 
			TimeOut_1(
				UpdateUserInstruction::entered -> Clock_CLID_UpdateUserInstruction(id__,0)
				[]
				get_CLID_UpdateUserInstruction!x__ -> Clock_CLID_UpdateUserInstruction(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_UpdateUserInstruction(id__,clock_type_plus(x__,1,CLID_UpdateUserInstruction_clock_type(id__))))
		Clock_CLID_UpdateSession(id__,x__) = 
			TimeOut_1(
				UpdateSession::entered -> Clock_CLID_UpdateSession(id__,0)
				[]
				get_CLID_UpdateSession!x__ -> Clock_CLID_UpdateSession(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_UpdateSession(id__,clock_type_plus(x__,1,CLID_UpdateSession_clock_type(id__))))
		Clock_CLID_NewSession(id__,x__) = 
			TimeOut_1(
				NewSession::entered -> Clock_CLID_NewSession(id__,0)
				[]
				get_CLID_NewSession!x__ -> Clock_CLID_NewSession(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_NewSession(id__,clock_type_plus(x__,1,CLID_NewSession_clock_type(id__))))
		Clock_CLID_Off(id__,x__) = 
			TimeOut_1(
				Off::entered -> Clock_CLID_Off(id__,0)
				[]
				get_CLID_Off!x__ -> Clock_CLID_Off(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Off(id__,clock_type_plus(x__,1,CLID_Off_clock_type(id__))))
		Clock_CLID_Manual(id__,x__) = 
			TimeOut_1(
				Manual::entered -> Clock_CLID_Manual(id__,0)
				[]
				get_CLID_Manual!x__ -> Clock_CLID_Manual(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Manual(id__,clock_type_plus(x__,1,CLID_Manual_clock_type(id__))))
		Clock_CLID_EmergencyStop(id__,x__) = 
			TimeOut_1(
				EmergencyStop::entered -> Clock_CLID_EmergencyStop(id__,0)
				[]
				get_CLID_EmergencyStop!x__ -> Clock_CLID_EmergencyStop(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_EmergencyStop(id__,clock_type_plus(x__,1,CLID_EmergencyStop_clock_type(id__))))
		Clock_CLID_CheckSteeringCentered(id__,x__) = 
			TimeOut_1(
				CheckSteeringCentered::entered -> Clock_CLID_CheckSteeringCentered(id__,0)
				[]
				get_CLID_CheckSteeringCentered!x__ -> Clock_CLID_CheckSteeringCentered(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_CheckSteeringCentered(id__,clock_type_plus(x__,1,CLID_CheckSteeringCentered_clock_type(id__))))
		Clock_CLID_PrepareUserInstruction(id__,x__) = 
			TimeOut_1(
				PrepareUserInstruction::entered -> Clock_CLID_PrepareUserInstruction(id__,0)
				[]
				get_CLID_PrepareUserInstruction!x__ -> Clock_CLID_PrepareUserInstruction(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_PrepareUserInstruction(id__,clock_type_plus(x__,1,CLID_PrepareUserInstruction_clock_type(id__))))
		Clock_CLID_Ready(id__,x__) = 
			TimeOut_1(
				Ready::entered -> Clock_CLID_Ready(id__,0)
				[]
				get_CLID_Ready!x__ -> Clock_CLID_Ready(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Ready(id__,clock_type_plus(x__,1,CLID_Ready_clock_type(id__))))
		Clock_CLID_Autonomous(id__,x__) = 
			TimeOut_1(
				Autonomous::entered -> Clock_CLID_Autonomous(id__,0)
				[]
				get_CLID_Autonomous!x__ -> Clock_CLID_Autonomous(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Autonomous(id__,clock_type_plus(x__,1,CLID_Autonomous_clock_type(id__))))
		Clock_CLID_PrepareSession(id__,x__) = 
			TimeOut_1(
				PrepareSession::entered -> Clock_CLID_PrepareSession(id__,0)
				[]
				get_CLID_PrepareSession!x__ -> Clock_CLID_PrepareSession(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_PrepareSession(id__,clock_type_plus(x__,1,CLID_PrepareSession_clock_type(id__))))
		Clock_CLID_UpdateReadyState(id__,x__) = 
			TimeOut_1(
				UpdateReadyState::entered -> Clock_CLID_UpdateReadyState(id__,0)
				[]
				get_CLID_UpdateReadyState!x__ -> Clock_CLID_UpdateReadyState(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_UpdateReadyState(id__,clock_type_plus(x__,1,CLID_UpdateReadyState_clock_type(id__))))
		Clock_CLID_Override(id__,x__) = 
			TimeOut_1(
				Override::entered -> Clock_CLID_Override(id__,0)
				[]
				get_CLID_Override!x__ -> Clock_CLID_Override(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Override(id__,clock_type_plus(x__,1,CLID_Override_clock_type(id__))))
		Clock_CLID_SteeringCentering(id__,x__) = 
			TimeOut_1(
				SteeringCentering::entered -> Clock_CLID_SteeringCentering(id__,0)
				[]
				get_CLID_SteeringCentering!x__ -> Clock_CLID_SteeringCentering(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_SteeringCentering(id__,clock_type_plus(x__,1,CLID_SteeringCentering_clock_type(id__))))
		Clock_CLID_Primed(id__,x__) = 
			TimeOut_1(
				Primed::entered -> Clock_CLID_Primed(id__,0)
				[]
				get_CLID_Primed!x__ -> Clock_CLID_Primed(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Primed(id__,clock_type_plus(x__,1,CLID_Primed_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_Error(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_NoSession(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_UpdateUserInstruction(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_UpdateSession(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_NewSession(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Off(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Manual(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_EmergencyStop(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_CheckSteeringCentered(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_PrepareUserInstruction(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Ready(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Autonomous(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_PrepareSession(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_UpdateReadyState(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Override(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_SteeringCentering(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Primed(id__,0))
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		)
		
		stateClockSync = {|get_CLID_Error,Error::entered,get_CLID_NoSession,NoSession::entered,get_CLID_UpdateUserInstruction,UpdateUserInstruction::entered,get_CLID_UpdateSession,UpdateSession::entered,get_CLID_NewSession,NewSession::entered,get_CLID_Off,Off::entered,get_CLID_Manual,Manual::entered,get_CLID_EmergencyStop,EmergencyStop::entered,get_CLID_CheckSteeringCentered,CheckSteeringCentered::entered,get_CLID_PrepareUserInstruction,PrepareUserInstruction::entered,get_CLID_Ready,Ready::entered,get_CLID_Autonomous,Autonomous::entered,get_CLID_PrepareSession,PrepareSession::entered,get_CLID_UpdateReadyState,UpdateReadyState::entered,get_CLID_Override,Override::entered,get_CLID_SteeringCentering,SteeringCentering::entered,get_CLID_Primed,Primed::entered|}
		}
			endmodule

endmodule
