			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_Distribute|
			              NID_i0|
			              NID_Initialise
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
