						          const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY))
				[| { terminate } |] (
				dbisim(Clock_CLID_Initialise(id__,0,
						          const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						          const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						          const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						          const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						          const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY))
				[| { terminate } |] (
				dbisim(Clock_CLID_ApplyControl(id__,0,
						          const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						          const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
						          const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
						          const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
						          const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY))
				)
				)
				)
				
				stateClockSync = {|get_CLID_SpinOnce,SpinOnce::entered,get_CLID_Sleep,Sleep::entered,get_CLID_Initialise,Initialise::entered,get_CLID_ApplyControl,ApplyControl::entered|}
				
				-- Shared memory
				-- Shared memory variables
				
				-- sharedVarMemory process
				sharedVarMemory(id__,
						    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
						    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
