				STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__))
				)\sharedVarHide
				
				STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__))
				)\sharedVarHide
				
				-- Transitions
				Transitions(id__) = ((let
					Trans = TimeOut_1(
						 (share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((share__choice(share__choice(get_newIndicator?newIndicator -> true & (share__choice(set_newIndicator!update_Indicator_left(newIndicator,false) -> SKIP))));share__choice(share__choice(get_newIndicator?newIndicator -> true & (share__choice(set_newIndicator!update_Indicator_right(newIndicator,false) -> SKIP)))) ; Ready::enter -> SKIP))))
						 [] dbisim((true)&(powertrain__!NID_Ready.in?newPowertrain:{newPowertrain|newPowertrain <- Powertrain, true} -> share__choice(set_newPowertrain!newPowertrain -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; UpdateLutzState::enter -> SKIP)))
						 [] dbisim((true)&(internal__!NID_UpdateLutzState -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_newPodstate?newPodstate -> true&(share__choice(pod_state.out!newPodstate -> SKIP))) ; Ready::enter -> SKIP)))
						 [] dbisim((true)&(indicator__!NID_Ready.in?newIndicator:{newIndicator|newIndicator <- Indicator, true} -> share__choice(set_newIndicator!newIndicator -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Ready::enter -> SKIP)))
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
