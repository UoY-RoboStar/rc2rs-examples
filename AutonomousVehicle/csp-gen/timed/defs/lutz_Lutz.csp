							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   i0::D__(id__)
								   [| { share__, terminate } |] (
								   Ready::D__(id__)
								   [| { share__, terminate } |] (
								   UpdateLutzState::D__(id__)
								   )
								   )
								 )
								 [[Ready::interrupt <- x__ | x__ <- {|interrupt,powertrain__.NID_Ready.in,indicator__.NID_Ready.in|}]]
								 [[UpdateLutzState::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_UpdateLutzState|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__,setR_newIndicator,setR_newPowertrain |} ]] 
								 )
