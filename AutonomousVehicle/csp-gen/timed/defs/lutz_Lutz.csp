			channel powertrainIn: InOut.Powertrain
			channel powertrainOut1__: NIDS.InOut.Powertrain
			channel powertrainOut1: InOut.Powertrain
			channel powertrainOut2__: NIDS.InOut.Powertrain
			channel powertrainOut2: InOut.Powertrain
			
