								  [[clockReset.CLID_messageHandling <- clockResetR.CLID_messageHandling,set_podStatus <- setR_podStatus,set_sessionControl <- setR_sessionControl,clockReset.CLID_lastControlPeriod <- clockResetR.CLID_lastControlPeriod,set_auxDemand <- setR_auxDemand,set_executingApplyControl <- setR_executingApplyControl,set_podDemand <- setR_podDemand]]
