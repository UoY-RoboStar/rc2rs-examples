							Active 		= SKIP ; 
									 	  Behaviour ; 
									 	  share__choice(exit -> SKIP) ; SKIP ; 
									 	  share__choice(exited -> SKIP) ; Inactive
						
							Behaviour 	= entered -> During
							During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
						within
							Inactive [| {terminate} |> SKIP)
						
						
						-- Clocks
						
						StateClocks(id__) = terminate -> SKIP
						
						stateClockSync = {||}
					}
				
				endmodule
				----------------------------------------------------------------------
				
				-- END of Nodes --
				
				Timed(OneStep) {
				-- Operation calls --
				-- Only the undefined operations are declared here.
				-- If the state machine is in isolation, all required operations will be undefined.
				-- If it is in the context of a controller, the required operations not provided by the
				-- controller will be declared here, and the defined operations will be defined in the
				-- context of the Controller module, and therefore within scope of the state machine module.
				
				-- END of Operation calls --
			
				-- STM processes
				STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__))
				)\sharedVarHide
				
				STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__))
				)\sharedVarHide
				
				-- Transitions
				Transitions(id__) = ((let
					Trans = TimeOut_1(
						 (share__ -> SKIP
						 [] dbisim((true)&(statusStateIn__!NID_Distribute.in?currentStatusState:{currentStatusState|currentStatusState <- Status, true} -> share__choice(set_currentStatusState!currentStatusState -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
						 [] dbisim((true)&(statusStateIn__!NID_Initialise.in?currentStatusState:{currentStatusState|currentStatusState <- Status, true} -> share__choice(set_currentStatusState!currentStatusState -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
						 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
						 )
					,SKIP);Trans
				within
					Trans [|{terminate}|> SKIP
				)
				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__) = 
					dbisim((
					let
						finalNodesEntered = {||}
					within
						(dbisim((dbisim((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							Distribute::enter,
							i0::enter,
							Initialise::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|statusStateIn__.NID_Distribute.in,statusStateIn__.NID_Initialise.in,internal__.NID_i0|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   Distribute::D__(id__)
								   [| { share__, terminate } |] (
								   i0::D__(id__)
								   [| { share__, terminate } |] (
								   Initialise::D__(id__)
								   )
								   )
								 )
								 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Distribute.in|}]]
								 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Initialise.in|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__,setR_currentStatusState |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								 			,setR_currentStatusState
								 			|}) |]
								 ((i0::enter -> Transitions(id__))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								  [[set_currentStatusState <- setR_currentStatusState]]
								 )
								)
								 [[setR_currentStatusState <- set_currentStatusState]]
								)
							)
							 \ hideSet)
							[[
								statusStateIn__.x____ <- statusStateIn,
								statusStateOut1__.x____ <- statusStateOut1,
								statusStateOut2__.x____ <- statusStateOut2
								| x____ <- NIDS
							]]
						)
						)
						 [| union(stateClockSync,{terminate}) |]
						 StateClocks(id__)
						)\diff(stateClockSync,enteredSS))
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__) = 
					dbisim((let
						stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
					 within
						(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
					)
					)
				
				IteratedBehaviour(id__) = 
					dbisim((let
						stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
					 within
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										MachineBody(id__)
										[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
										dbisim(Clock_CLID_Initialise(id__,0))
									)\{|get_CLID_Initialise|}
								)
								[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
								dbisim(Clock_CLID_Distribute(id__,0))
							)\{|get_CLID_Distribute|}
						)
						) \ union(stateClockSync,enteredSS)
					)
					)
				
				Stateful(id__) = 
					((let
						getsetLocalChannels = {|get_currentStatusState,set_currentStatusState|}
						clockSync = {||}
					within
						(Behaviour(id__) 
						 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
						 (varMemory(id__) [| {terminate} |] Clocks(id__))
					 	)\union(getsetLocalChannels,clockSync)
					)
					)
				
				IteratedStateful(id__) =
					(dbisim(
						sbisim(
							IteratedBehaviour(id__)
							[| {|get_currentStatusState,set_currentStatusState,terminate|} |]
							Memory_currentStatusState((VehicleState_INVALID,true,true,true,true,Seats_EMPTY,Seats_EMPTY,0,0,0))
						)\{|get_currentStatusState,set_currentStatusState|}
					)
					)
				
				-- Visible counterparts
				MachineBody_VS_O(id__) = 
					dbisim((
					let
						finalNodesEntered = {||}
					within
						(dbisim((dbisim((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							Distribute::enter,
							i0::enter,
							Initialise::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|statusStateIn__.NID_Distribute.in,statusStateIn__.NID_Initialise.in,internal__.NID_i0|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   Distribute::VS_O__(id__)
								   [| { share__, terminate } |] (
								   i0::VS_O__(id__)
								   [| { share__, terminate } |] (
								   Initialise::VS_O__(id__)
								   )
								   )
								 )
								 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Distribute.in|}]]
								 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Initialise.in|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__,setR_currentStatusState |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								 			,setR_currentStatusState
								 			|}) |]
								 ((i0::enter -> Transitions(id__))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								  [[set_currentStatusState <- setR_currentStatusState]]
								 )
								)
								 [[setR_currentStatusState <- set_currentStatusState]]
								)
							)
							 \ hideSet)
							[[
								statusStateIn__.x____ <- statusStateIn,
								statusStateOut1__.x____ <- statusStateOut1,
								statusStateOut2__.x____ <- statusStateOut2
								| x____ <- NIDS
							]]
						)
						)
						 [| union(stateClockSync,{terminate}) |]
						 StateClocks(id__)
						)\diff(stateClockSync,enteredSS))
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__) = 
					dbisim((let
						stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
					 within
						(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
					)
					)
				
				IteratedBehaviour_VS_O(id__) = 
					dbisim((let
						stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
					 within
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										MachineBody_VS_O(id__)
										[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
										dbisim(Clock_CLID_Initialise(id__,0))
									)\{|get_CLID_Initialise|}
								)
								[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
								dbisim(Clock_CLID_Distribute(id__,0))
							)\{|get_CLID_Distribute|}
						)
						) \ diff(union(stateClockSync,enteredSS),enteredSS)
					)
					)
				
				Stateful_VS_O(id__) = 
					dbisim((let
						getsetLocalChannels = {|get_currentStatusState,set_currentStatusState|}
						clockSync = {||}
					within
						(Behaviour_VS_O(id__) 
						 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
						 (varMemory(id__) [| {terminate} |] Clocks(id__))
					 	)\union(getsetLocalChannels,clockSync)
					)
					)
				
				IteratedStateful_VS_O(id__) =
					(dbisim(
						sbisim(
							IteratedBehaviour_VS_O(id__)
							[| {|get_currentStatusState,set_currentStatusState,terminate|} |]
							Memory_currentStatusState((VehicleState_INVALID,true,true,true,true,Seats_EMPTY,Seats_EMPTY,0,0,0))
						)\{|get_currentStatusState,set_currentStatusState|}
					)
					)
				
				-- END
				
				-- Memory
				-- Memory variables
				Memory_currentStatusState(currentStatusState) =
					get_currentStatusState!currentStatusState -> Memory_currentStatusState(currentStatusState)
					[]
					set_currentStatusState?x__ -> Memory_currentStatusState(x__)
					[]
					terminate -> SKIP
				
				-- varMemory process
				varMemory(id__) = Memory_currentStatusState((VehicleState_INVALID,true,true,true,true,Seats_EMPTY,Seats_EMPTY,0,0,0))
				
				getsetLocalChannels = {|get_currentStatusState,set_currentStatusState|}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__) = STM_VS_O(id__) \ localClockResets
				D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
				O__(id__) = dbisim(D__(id__))
				VS__(id__) = FVS__(id__)
				VS_O__(id__) = dbisim(FVS__(id__))
				HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
				FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
				HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
				
				-- Clocks
				
				Clocks(id__) = terminate -> SKIP
				
				clockSync = {||}
				
				Clock_CLID_Distribute(id__,x__) = 
					TimeOut_1(
						Distribute::entered -> Clock_CLID_Distribute(id__,0)
						[]
						get_CLID_Distribute!x__ -> Clock_CLID_Distribute(id__,x__)
						[]
						terminate -> SKIP,Clock_CLID_Distribute(id__,clock_type_plus(x__,1,CLID_Distribute_clock_type(id__))))
				Clock_CLID_Initialise(id__,x__) = 
					TimeOut_1(
						Initialise::entered -> Clock_CLID_Initialise(id__,0)
						[]
						get_CLID_Initialise!x__ -> Clock_CLID_Initialise(id__,x__)
						[]
						terminate -> SKIP,Clock_CLID_Initialise(id__,clock_type_plus(x__,1,CLID_Initialise_clock_type(id__))))
				
				StateClocks(id__) = dbisim(Clock_CLID_Distribute(id__,0))
				[| { terminate } |] (
				dbisim(Clock_CLID_Initialise(id__,0))
				)
				
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
				
				-- Shared memory
				-- Shared memory variables
				
				-- sharedVarMemory process
				sharedVarMemory(id__) = terminate -> SKIP
				
				sharedVarSync = {||}
				
				sharedVarHide = {||}
				}
		endmodule
		
		Timed(OneStep) {
				-- undefined operations
				CALL__setParkingBrake(id__,
						    param_brake) 	= setParkingBrakeCall.param_brake -> SKIP
				CALL__setFrontSteering(id__,
						    param_degrees) 	= setFrontSteeringCall.param_degrees -> SKIP
				CALL__sendHandshakeResponse(id__,
						    param_message) 	= sendHandshakeResponseCall.param_message -> SKIP
				CALL__setSpeed(id__,
						    param_kilometersPerHour) 	= setSpeedCall.param_kilometersPerHour -> SKIP
				CALL__requestState(id__,
						    param_newState) 	= requestStateCall.param_newState -> SKIP
				CALL__setRearSteering(id__,
						    param_degrees) 	= setRearSteeringCall.param_degrees -> SKIP
				CALL__setAuxiliaries(id__,
						    param_newState) 	= setAuxiliariesCall.param_newState -> SKIP
				
				-- declaring controller memory
				Memory(id__) = SKIP
				
				D__(id__,
						    const_lutz_Lutz_stm_ref0_ZERO_VEHICLE_DEMAND,
						    const_lutz_Lutz_stm_ref0_ZERO_AUXILIARY_DEMAND,
						    const_lutz_Lutz_stm_ref0_ZERO_SESSION_REQUEST,
						    const_lutz_Lutz_stm_ref0_CONTROL_PERIOD,
						    const_lutz_Lutz_stm_ref0_MESSAGE_HANDLING_DELAY,
						    const_lutz_Lutz_stm_ref1_SESSION_CONTROL_PERIOD,
						    const_lutz_Lutz_stm_ref2_HANDSHAKE_RESPONSE_KEYS,
						    const_lutz_Lutz_stm_ref2_HANDSHAKE_CHECK_PERIOD,
						    const_lutz_Lutz_stm_ref2_HANDSHAKE_TIMEOUT) = prioritise(	((
						(
							let
								const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND = const_lutz_Lutz_stm_ref0_ZERO_VEHICLE_DEMAND
								const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND = const_lutz_Lutz_stm_ref0_ZERO_AUXILIARY_DEMAND
								const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST = const_lutz_Lutz_stm_ref0_ZERO_SESSION_REQUEST
								const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD = const_lutz_Lutz_stm_ref0_CONTROL_PERIOD
								const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY = const_lutz_Lutz_stm_ref0_MESSAGE_HANDLING_DELAY
							within 
							stm_ref0::D__(id__,
									    const_lutz_VehicleControl_VehicleControl_ZERO_VEHICLE_DEMAND,
									    const_lutz_VehicleControl_VehicleControl_ZERO_AUXILIARY_DEMAND,
									    const_lutz_VehicleControl_VehicleControl_ZERO_SESSION_REQUEST,
									    const_lutz_VehicleControl_VehicleControl_CONTROL_PERIOD,
									    const_lutz_VehicleControl_VehicleControl_MESSAGE_HANDLING_DELAY)[[
								stm_ref0::terminate <- terminate,
								stm_ref0::session_control.in <- stm_ref1::session_control.out,
								stm_ref0::session_control.out <- stm_ref1::session_control.in,
								stm_ref0::output_pod_demand <- output_pod_demand,
								stm_ref0::auxiliary_demand <- auxiliary_demand,
								stm_ref0::podstatus.in <- stm_ref5::statusStateOut1.out,
								stm_ref0::podstatus.out <- stm_ref5::statusStateOut1.in,
								stm_ref0::setParkingBrakeCall <- setParkingBrakeCall,
								stm_ref0::setFrontSteeringCall <- setFrontSteeringCall,
								stm_ref0::sendHandshakeResponseCall <- sendHandshakeResponseCall,
								stm_ref0::setSpeedCall <- setSpeedCall,
								stm_ref0::requestStateCall <- requestStateCall,
								stm_ref0::setRearSteeringCall <- setRearSteeringCall,
								stm_ref0::setAuxiliariesCall <- setAuxiliariesCall
							]]
						)
							[|{|terminate, stm_ref1::session_control, stm_ref0::control_command1, stm_ref5::statusStateOut1|}|]
						(
							(
								let
									const_lutz_SessionControl_SSessionControl_SESSION_CONTROL_PERIOD = const_lutz_Lutz_stm_ref1_SESSION_CONTROL_PERIOD
								within 
								stm_ref1::D__(id__,
										    const_lutz_SessionControl_SSessionControl_SESSION_CONTROL_PERIOD)[[
									stm_ref1::terminate <- terminate,
									stm_ref1::pod_demand.in <- stm_ref0::control_command1.out,
									stm_ref1::pod_demand.out <- stm_ref0::control_command1.in,
									stm_ref1::ui_code <- instruction,
									stm_ref1::eps <- eps,
									stm_ref1::eps_inboard <- eps_inboard,
									stm_ref1::eps_outboard <- eps_outboard,
									stm_ref1::epb <- epb,
									stm_ref1::battery <- battery,
									stm_ref1::control_command1 <- control_command1,
									stm_ref1::powertrain.in <- stm_ref4::powertrainOut1.out,
									stm_ref1::powertrain.out <- stm_ref4::powertrainOut1.in,
									stm_ref1::quality.in <- stm_ref2::quality.out,
									stm_ref1::quality.out <- stm_ref2::quality.in,
									stm_ref1::status.in <- stm_ref5::statusStateOut2.out,
									stm_ref1::status.out <- stm_ref5::statusStateOut2.in
								]]
								\ {|
									stm_ref1::updatedSession,
									stm_ref1::updatedReadyness,
									stm_ref1::instruction,
									stm_ref1::readyStateOut,
									stm_ref1::session
								|}
							)
								[|{|terminate, stm_ref4::powertrainOut1, stm_ref2::quality, stm_ref5::statusStateOut2|}|]
							(
								(
									let
										const_lutz_FaultDetection_SHandshake_HANDSHAKE_RESPONSE_KEYS = const_lutz_Lutz_stm_ref2_HANDSHAKE_RESPONSE_KEYS
										const_lutz_FaultDetection_SHandshake_HANDSHAKE_CHECK_PERIOD = const_lutz_Lutz_stm_ref2_HANDSHAKE_CHECK_PERIOD
										const_lutz_FaultDetection_SHandshake_HANDSHAKE_TIMEOUT = const_lutz_Lutz_stm_ref2_HANDSHAKE_TIMEOUT
									within 
									stm_ref2::D__(id__,
											    const_lutz_FaultDetection_SHandshake_HANDSHAKE_RESPONSE_KEYS,
											    const_lutz_FaultDetection_SHandshake_HANDSHAKE_CHECK_PERIOD,
											    const_lutz_FaultDetection_SHandshake_HANDSHAKE_TIMEOUT)[[
										stm_ref2::terminate <- terminate,
										stm_ref2::acs_handshake <- acs_handshake,
										stm_ref2::sendHandshakeResponseCall <- sendHandshakeResponseCall
									]]
								)
									[|{|terminate|}|]
								(
									(
										stm_ref3::D__(id__)[[
											stm_ref3::terminate <- terminate,
											stm_ref3::pod_state <- pod_state,
											stm_ref3::indicator <- indicator,
											stm_ref3::powertrain.in <- stm_ref4::powertrainOut2.out,
											stm_ref3::powertrain.out <- stm_ref4::powertrainOut2.in
										]]
									)
										[|{|terminate, stm_ref4::powertrainOut2|}|]
									(
										(
											stm_ref4::D__(id__)[[
												stm_ref4::terminate <- terminate,
												stm_ref4::powertrainIn <- powertrain
											]]
										)
											[|{|terminate|}|]
										(
											stm_ref5::D__(id__)[[
												stm_ref5::terminate <- terminate,
												stm_ref5::statusStateIn <- status
											]]
										)
									)
									\diff(
										{|terminate|},
										{|terminate|}
									)
								)
								\diff(
									{|terminate, stm_ref4::powertrainOut2|},
									{|terminate|}
								)
							)
							\diff(
								{|terminate|},
								{|terminate|}
							)
						)
						\diff(
							{|terminate, stm_ref4::powertrainOut1, stm_ref2::quality, stm_ref5::statusStateOut2|},
							{|terminate|}
						)
					)
					\diff(
						{|terminate, stm_ref1::session_control, stm_ref0::control_command1, stm_ref5::statusStateOut1|},
						{|terminate|}
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>)
				
				-- VS version
				VS__(id__,
						    const_lutz_Lutz_stm_ref0_ZERO_VEHICLE_DEMAND,
						    const_lutz_Lutz_stm_ref0_ZERO_AUXILIARY_DEMAND,
						    const_lutz_Lutz_stm_ref0_ZERO_SESSION_REQUEST,
						    const_lutz_Lutz_stm_ref0_CONTROL_PERIOD,
						    const_lutz_Lutz_stm_ref0_MESSAGE_HANDLING_DELAY,
						    const_lutz_Lutz_stm_ref1_SESSION_CONTROL_PERIOD,
