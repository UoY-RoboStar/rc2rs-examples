								 [[clockResetR.CLID_messageHandling <- clockReset.CLID_messageHandling,setR_podStatus <- set_podStatus,setR_sessionControl <- set_sessionControl,clockResetR.CLID_lastControlPeriod <- clockReset.CLID_lastControlPeriod,setR_auxDemand <- set_auxDemand,setR_executingApplyControl <- set_executingApplyControl,setR_podDemand <- set_podDemand]]
