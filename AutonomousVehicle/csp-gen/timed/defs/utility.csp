	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_Distribute|
	              NID_i0|
	              NID_Initialise
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_currentLocation, set_currentLocation, setL_currentLocation, setR_currentLocation: LatLngHeadingFix
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel locationIn__: NIDS.InOut.LatLngHeadingFix
	channel locationIn: InOut.LatLngHeadingFix
	channel locationOut1__: NIDS.InOut.LatLngHeadingFix
	channel locationOut1: InOut.LatLngHeadingFix
	channel locationOut2__: NIDS.InOut.LatLngHeadingFix
	channel locationOut2: InOut.LatLngHeadingFix
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	Distribute::enter,
	i0::enter,
	Initialise::enter
	|}
	
	enteredSS = 	{|
	Distribute::entered,
	Initialise::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	locationIn,
		locationOut1,
		locationOut2
		|}
	
	channel clockReset, clockResetL, clockResetR 
	
	localClockResets = {||}
	
	
	channel get_CLID_Distribute : core_clock_type 
	channel get_CLID_Initialise : core_clock_type 
	--channel increment__
	
	CLID_Distribute_clock_type(id__) = 
		let
			max = (clock_type_max(Union({
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_Initialise_clock_type(id__) = 
		let
			max = (clock_type_max(Union({
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	

		-- Nodes --
		-- declaring all nodes
		
		----------------------------------------------------------------------
		-- State: Distribute
		module Distribute
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_currentLocation?currentLocation -> true&(share__choice(locationOut1.out!currentLocation -> SKIP)));share__choice(get_currentLocation?currentLocation -> true&(share__choice(locationOut2.out!currentLocation -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_currentLocation?currentLocation -> true&(share__choice(locationOut1.out!currentLocation -> SKIP)));share__choice(get_currentLocation?currentLocation -> true&(share__choice(locationOut2.out!currentLocation -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- Initial: i0
		module i0
		exports
		
			channel enter, interrupt
			
			Timed(OneStep) {
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__) = D__(id__)
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: Initialise
		module Initialise
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		-- END of Nodes --
		
		Timed(OneStep) {
		-- Operation calls --
		-- Only the undefined operations are declared here.
		-- If the state machine is in isolation, all required operations will be undefined.
		-- If it is in the context of a controller, the required operations not provided by the
		-- controller will be declared here, and the defined operations will be defined in the
		-- context of the Controller module, and therefore within scope of the state machine module.
		
		-- END of Operation calls --
	
		-- STM processes
		STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {||} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__))
		)\sharedVarHide
		
		STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {||} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__))
		)\sharedVarHide
		
		-- Transitions
		Transitions(id__) = ((let
			Trans = TimeOut_1(
				 (share__ -> SKIP
				 [] dbisim((true)&(locationIn__!NID_Distribute.in?currentLocation:{currentLocation|currentLocation <- LatLngHeadingFix, true} -> share__choice(set_currentLocation!currentLocation -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
				 [] dbisim((true)&(locationIn__!NID_Initialise.in?currentLocation:{currentLocation|currentLocation <- LatLngHeadingFix, true} -> share__choice(set_currentLocation!currentLocation -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
				 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
				 []
				 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
				 []
				 terminate -> SKIP
				 )
			,SKIP);Trans
		within
			Trans [|{terminate}|> SKIP
		)
		)
		
		-- Stateful
		-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
		
		-- Named process definitions
		MachineBody(id__) = 
			dbisim((
			let
				finalNodesEntered = {||}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					Distribute::enter,
					i0::enter,
					Initialise::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited,interrupt|})
						transSync = {|locationIn__.NID_Distribute.in,locationIn__.NID_Initialise.in,internal__.NID_i0|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   Distribute::D__(id__)
						   [| { share__, terminate } |] (
						   i0::D__(id__)
						   [| { share__, terminate } |] (
						   Initialise::D__(id__)
						   )
						   )
						 )
						 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,locationIn__.NID_Distribute.in|}]]
						 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,locationIn__.NID_Initialise.in|}]]
						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_currentLocation |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_currentLocation
						 			|}) |]
						 ((i0::enter -> Transitions(id__))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_currentLocation <- setR_currentLocation]]
						 )
						)
						 [[setR_currentLocation <- set_currentLocation]]
						)
					)
					 \ hideSet)
					[[
						locationIn__.x____ <- locationIn,
						locationOut1__.x____ <- locationOut1,
						locationOut2__.x____ <- locationOut2
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
			)
			)
		
		IteratedBehaviour(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody(id__)
								[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
								dbisim(Clock_CLID_Initialise(id__,0))
							)\{|get_CLID_Initialise|}
						)
						[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
						dbisim(Clock_CLID_Distribute(id__,0))
					)\{|get_CLID_Distribute|}
				)
				) \ union(stateClockSync,enteredSS)
			)
			)
		
		Stateful(id__) = 
			((let
				getsetLocalChannels = {|get_currentLocation,set_currentLocation|}
				clockSync = {||}
			within
				(Behaviour(id__) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful(id__) =
			(dbisim(
				sbisim(
					IteratedBehaviour(id__)
					[| {|get_currentLocation,set_currentLocation,terminate|} |]
					Memory_currentLocation((0,0,(0,0,"")))
				)\{|get_currentLocation,set_currentLocation|}
			)
			)
		
		-- Visible counterparts
		MachineBody_VS_O(id__) = 
			dbisim((
			let
				finalNodesEntered = {||}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					Distribute::enter,
					i0::enter,
					Initialise::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited,interrupt|})
						transSync = {|locationIn__.NID_Distribute.in,locationIn__.NID_Initialise.in,internal__.NID_i0|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   Distribute::VS_O__(id__)
						   [| { share__, terminate } |] (
						   i0::VS_O__(id__)
						   [| { share__, terminate } |] (
						   Initialise::VS_O__(id__)
						   )
						   )
						 )
						 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,locationIn__.NID_Distribute.in|}]]
						 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,locationIn__.NID_Initialise.in|}]]
						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_currentLocation |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_currentLocation
						 			|}) |]
						 ((i0::enter -> Transitions(id__))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_currentLocation <- setR_currentLocation]]
						 )
						)
						 [[setR_currentLocation <- set_currentLocation]]
						)
					)
					 \ hideSet)
					[[
						locationIn__.x____ <- locationIn,
						locationOut1__.x____ <- locationOut1,
						locationOut2__.x____ <- locationOut2
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour_VS_O(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody_VS_O(id__)
								[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
								dbisim(Clock_CLID_Initialise(id__,0))
							)\{|get_CLID_Initialise|}
						)
						[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
						dbisim(Clock_CLID_Distribute(id__,0))
					)\{|get_CLID_Distribute|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__) = 
			dbisim((let
				getsetLocalChannels = {|get_currentLocation,set_currentLocation|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__) =
			(dbisim(
				sbisim(
					IteratedBehaviour_VS_O(id__)
					[| {|get_currentLocation,set_currentLocation,terminate|} |]
					Memory_currentLocation((0,0,(0,0,"")))
				)\{|get_currentLocation,set_currentLocation|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_currentLocation(currentLocation) =
			get_currentLocation!currentLocation -> Memory_currentLocation(currentLocation)
			[]
			set_currentLocation?x__ -> Memory_currentLocation(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__) = Memory_currentLocation((0,0,(0,0,"")))
		
		getsetLocalChannels = {|get_currentLocation,set_currentLocation|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__) = STM_VS_O(id__) \ localClockResets
		D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
		O__(id__) = dbisim(D__(id__))
		VS__(id__) = FVS__(id__)
		VS_O__(id__) = dbisim(FVS__(id__))
		HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
		FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
		HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Distribute(id__,x__) = 
			TimeOut_1(
				Distribute::entered -> Clock_CLID_Distribute(id__,0)
				[]
				get_CLID_Distribute!x__ -> Clock_CLID_Distribute(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Distribute(id__,clock_type_plus(x__,1,CLID_Distribute_clock_type(id__))))
		Clock_CLID_Initialise(id__,x__) = 
			TimeOut_1(
				Initialise::entered -> Clock_CLID_Initialise(id__,0)
				[]
				get_CLID_Initialise!x__ -> Clock_CLID_Initialise(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Initialise(id__,clock_type_plus(x__,1,CLID_Initialise_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_Distribute(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Initialise(id__,0))
		)
		
		stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule
module PowerTrainStateDistributor
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_Distribute|
	              NID_i0|
	              NID_Initialise
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_currentPowertrainState, set_currentPowertrainState, setL_currentPowertrainState, setR_currentPowertrainState: Powertrain
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel powertrainIn__: NIDS.InOut.Powertrain
	channel powertrainIn: InOut.Powertrain
	channel powertrainOut1__: NIDS.InOut.Powertrain
	channel powertrainOut1: InOut.Powertrain
	channel powertrainOut2__: NIDS.InOut.Powertrain
	channel powertrainOut2: InOut.Powertrain
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	Distribute::enter,
	i0::enter,
	Initialise::enter
	|}
	
	enteredSS = 	{|
	Distribute::entered,
	Initialise::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	powertrainIn,
		powertrainOut1,
		powertrainOut2
		|}
	
	channel clockReset, clockResetL, clockResetR 
	
	localClockResets = {||}
	
	
	channel get_CLID_Distribute : core_clock_type 
	channel get_CLID_Initialise : core_clock_type 
	--channel increment__
	
	CLID_Distribute_clock_type(id__) = 
		let
			max = (clock_type_max(Union({
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_Initialise_clock_type(id__) = 
		let
			max = (clock_type_max(Union({
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	

		-- Nodes --
		-- declaring all nodes
		
		----------------------------------------------------------------------
		-- State: Distribute
		module Distribute
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_currentPowertrainState?currentPowertrainState -> true&(share__choice(powertrainOut1.out!currentPowertrainState -> SKIP)));share__choice(get_currentPowertrainState?currentPowertrainState -> true&(share__choice(powertrainOut2.out!currentPowertrainState -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_currentPowertrainState?currentPowertrainState -> true&(share__choice(powertrainOut1.out!currentPowertrainState -> SKIP)));share__choice(get_currentPowertrainState?currentPowertrainState -> true&(share__choice(powertrainOut2.out!currentPowertrainState -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- Initial: i0
		module i0
		exports
		
			channel enter, interrupt
			
			Timed(OneStep) {
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__) = D__(id__)
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: Initialise
		module Initialise
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		-- END of Nodes --
		
		Timed(OneStep) {
		-- Operation calls --
		-- Only the undefined operations are declared here.
		-- If the state machine is in isolation, all required operations will be undefined.
		-- If it is in the context of a controller, the required operations not provided by the
		-- controller will be declared here, and the defined operations will be defined in the
		-- context of the Controller module, and therefore within scope of the state machine module.
		
		-- END of Operation calls --
	
		-- STM processes
		STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {||} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__))
		)\sharedVarHide
		
		STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {||} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__))
		)\sharedVarHide
		
		-- Transitions
		Transitions(id__) = ((let
			Trans = TimeOut_1(
				 (share__ -> SKIP
				 [] dbisim((true)&(powertrainIn__!NID_Distribute.in?currentPowertrainState:{currentPowertrainState|currentPowertrainState <- Powertrain, true} -> share__choice(set_currentPowertrainState!currentPowertrainState -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
				 [] dbisim((true)&(powertrainIn__!NID_Initialise.in?currentPowertrainState:{currentPowertrainState|currentPowertrainState <- Powertrain, true} -> share__choice(set_currentPowertrainState!currentPowertrainState -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
				 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
				 []
				 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
				 []
				 terminate -> SKIP
				 )
			,SKIP);Trans
		within
			Trans [|{terminate}|> SKIP
		)
		)
		
		-- Stateful
		-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
		
		-- Named process definitions
		MachineBody(id__) = 
			dbisim((
			let
				finalNodesEntered = {||}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					Distribute::enter,
					i0::enter,
					Initialise::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited,interrupt|})
						transSync = {|powertrainIn__.NID_Distribute.in,powertrainIn__.NID_Initialise.in,internal__.NID_i0|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   Distribute::D__(id__)
						   [| { share__, terminate } |] (
						   i0::D__(id__)
						   [| { share__, terminate } |] (
						   Initialise::D__(id__)
						   )
						   )
						 )
						 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,powertrainIn__.NID_Distribute.in|}]]
						 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,powertrainIn__.NID_Initialise.in|}]]
						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_currentPowertrainState |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_currentPowertrainState
						 			|}) |]
						 ((i0::enter -> Transitions(id__))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_currentPowertrainState <- setR_currentPowertrainState]]
						 )
						)
						 [[setR_currentPowertrainState <- set_currentPowertrainState]]
						)
					)
					 \ hideSet)
					[[
						powertrainIn__.x____ <- powertrainIn,
						powertrainOut1__.x____ <- powertrainOut1,
						powertrainOut2__.x____ <- powertrainOut2
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
			)
			)
		
		IteratedBehaviour(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody(id__)
								[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
								dbisim(Clock_CLID_Initialise(id__,0))
							)\{|get_CLID_Initialise|}
						)
						[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
						dbisim(Clock_CLID_Distribute(id__,0))
					)\{|get_CLID_Distribute|}
				)
				) \ union(stateClockSync,enteredSS)
			)
			)
		
		Stateful(id__) = 
			((let
				getsetLocalChannels = {|get_currentPowertrainState,set_currentPowertrainState|}
				clockSync = {||}
			within
				(Behaviour(id__) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful(id__) =
			(dbisim(
				sbisim(
					IteratedBehaviour(id__)
					[| {|get_currentPowertrainState,set_currentPowertrainState,terminate|} |]
					Memory_currentPowertrainState((0,true,true,true))
				)\{|get_currentPowertrainState,set_currentPowertrainState|}
			)
			)
		
		-- Visible counterparts
		MachineBody_VS_O(id__) = 
			dbisim((
			let
				finalNodesEntered = {||}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					Distribute::enter,
					i0::enter,
					Initialise::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited,interrupt|})
						transSync = {|powertrainIn__.NID_Distribute.in,powertrainIn__.NID_Initialise.in,internal__.NID_i0|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   Distribute::VS_O__(id__)
						   [| { share__, terminate } |] (
						   i0::VS_O__(id__)
						   [| { share__, terminate } |] (
						   Initialise::VS_O__(id__)
						   )
						   )
						 )
						 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,powertrainIn__.NID_Distribute.in|}]]
						 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,powertrainIn__.NID_Initialise.in|}]]
						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_currentPowertrainState |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_currentPowertrainState
						 			|}) |]
						 ((i0::enter -> Transitions(id__))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_currentPowertrainState <- setR_currentPowertrainState]]
						 )
						)
						 [[setR_currentPowertrainState <- set_currentPowertrainState]]
						)
					)
					 \ hideSet)
					[[
						powertrainIn__.x____ <- powertrainIn,
						powertrainOut1__.x____ <- powertrainOut1,
						powertrainOut2__.x____ <- powertrainOut2
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour_VS_O(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody_VS_O(id__)
								[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
								dbisim(Clock_CLID_Initialise(id__,0))
							)\{|get_CLID_Initialise|}
						)
						[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
						dbisim(Clock_CLID_Distribute(id__,0))
					)\{|get_CLID_Distribute|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__) = 
			dbisim((let
				getsetLocalChannels = {|get_currentPowertrainState,set_currentPowertrainState|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__) =
			(dbisim(
				sbisim(
					IteratedBehaviour_VS_O(id__)
					[| {|get_currentPowertrainState,set_currentPowertrainState,terminate|} |]
					Memory_currentPowertrainState((0,true,true,true))
				)\{|get_currentPowertrainState,set_currentPowertrainState|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_currentPowertrainState(currentPowertrainState) =
			get_currentPowertrainState!currentPowertrainState -> Memory_currentPowertrainState(currentPowertrainState)
			[]
			set_currentPowertrainState?x__ -> Memory_currentPowertrainState(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__) = Memory_currentPowertrainState((0,true,true,true))
		
		getsetLocalChannels = {|get_currentPowertrainState,set_currentPowertrainState|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__) = STM_VS_O(id__) \ localClockResets
		D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
		O__(id__) = dbisim(D__(id__))
		VS__(id__) = FVS__(id__)
		VS_O__(id__) = dbisim(FVS__(id__))
		HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
		FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
		HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Distribute(id__,x__) = 
			TimeOut_1(
				Distribute::entered -> Clock_CLID_Distribute(id__,0)
				[]
				get_CLID_Distribute!x__ -> Clock_CLID_Distribute(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Distribute(id__,clock_type_plus(x__,1,CLID_Distribute_clock_type(id__))))
		Clock_CLID_Initialise(id__,x__) = 
			TimeOut_1(
				Initialise::entered -> Clock_CLID_Initialise(id__,0)
				[]
				get_CLID_Initialise!x__ -> Clock_CLID_Initialise(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Initialise(id__,clock_type_plus(x__,1,CLID_Initialise_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_Distribute(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Initialise(id__,0))
		)
		
		stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule
module StatusStateDistributor
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_Distribute|
	              NID_i0|
	              NID_Initialise
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_currentStatusState, set_currentStatusState, setL_currentStatusState, setR_currentStatusState: Status
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel statusStateIn__: NIDS.InOut.Status
	channel statusStateIn: InOut.Status
	channel statusStateOut1__: NIDS.InOut.Status
	channel statusStateOut1: InOut.Status
	channel statusStateOut2__: NIDS.InOut.Status
	channel statusStateOut2: InOut.Status
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	Distribute::enter,
	i0::enter,
	Initialise::enter
	|}
	
	enteredSS = 	{|
	Distribute::entered,
	Initialise::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	statusStateIn,
		statusStateOut1,
		statusStateOut2
		|}
	
	channel clockReset, clockResetL, clockResetR 
	
	localClockResets = {||}
	
	
	channel get_CLID_Distribute : core_clock_type 
	channel get_CLID_Initialise : core_clock_type 
	--channel increment__
	
	CLID_Distribute_clock_type(id__) = 
		let
			max = (clock_type_max(Union({
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	CLID_Initialise_clock_type(id__) = 
		let
			max = (clock_type_max(Union({
	}))+1)
		ctype = {0..max}
	within
		if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
	
	

		-- Nodes --
		-- declaring all nodes
		
		----------------------------------------------------------------------
		-- State: Distribute
		module Distribute
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_currentStatusState?currentStatusState -> true&(share__choice(statusStateOut1.out!currentStatusState -> SKIP)));share__choice(get_currentStatusState?currentStatusState -> true&(share__choice(statusStateOut2.out!currentStatusState -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_currentStatusState?currentStatusState -> true&(share__choice(statusStateOut1.out!currentStatusState -> SKIP)));share__choice(get_currentStatusState?currentStatusState -> true&(share__choice(statusStateOut2.out!currentStatusState -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- Initial: i0
		module i0
		exports
		
			channel enter, interrupt
			
			Timed(OneStep) {
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__) = D__(id__)
			}
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: Initialise
		module Initialise
		
		enterSS = {}
		
		enteredSS = {}
		
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			
			--channel increment__
			
			
			--	Nodes
			-- declaring all nodes
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
		endmodule
		----------------------------------------------------------------------
		
		-- END of Nodes --
		
		Timed(OneStep) {
		-- Operation calls --
		-- Only the undefined operations are declared here.
		-- If the state machine is in isolation, all required operations will be undefined.
		-- If it is in the context of a controller, the required operations not provided by the
		-- controller will be declared here, and the defined operations will be defined in the
		-- context of the Controller module, and therefore within scope of the state machine module.
		
		-- END of Operation calls --
	
		-- STM processes
		STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {||} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__))
		)\sharedVarHide
		
		STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		( 
			(
				(
					(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
				 	[[ share__ <- x__ | x__ <- {||} ]]
				)
			[| {share__} |]
			SKIP
			)
			[| union(sharedVarSync,{terminate}) |]
			dbisim(sharedVarMemory(id__))
		)\sharedVarHide
		
		-- Transitions
		Transitions(id__) = ((let
			Trans = TimeOut_1(
				 (share__ -> SKIP
				 [] dbisim((true)&(statusStateIn__!NID_Distribute.in?currentStatusState:{currentStatusState|currentStatusState <- Status, true} -> share__choice(set_currentStatusState!currentStatusState -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
				 [] dbisim((true)&(statusStateIn__!NID_Initialise.in?currentStatusState:{currentStatusState|currentStatusState <- Status, true} -> share__choice(set_currentStatusState!currentStatusState -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Distribute::enter -> SKIP)))
				 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Initialise::enter -> SKIP))))
				 []
				 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
				 []
				 terminate -> SKIP
				 )
			,SKIP);Trans
		within
			Trans [|{terminate}|> SKIP
		)
		)
		
		-- Stateful
		-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
		
		-- Named process definitions
		MachineBody(id__) = 
			dbisim((
			let
				finalNodesEntered = {||}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					Distribute::enter,
					i0::enter,
					Initialise::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited,interrupt|})
						transSync = {|statusStateIn__.NID_Distribute.in,statusStateIn__.NID_Initialise.in,internal__.NID_i0|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   Distribute::D__(id__)
						   [| { share__, terminate } |] (
						   i0::D__(id__)
						   [| { share__, terminate } |] (
						   Initialise::D__(id__)
						   )
						   )
						 )
						 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Distribute.in|}]]
						 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Initialise.in|}]]
						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_currentStatusState |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_currentStatusState
						 			|}) |]
						 ((i0::enter -> Transitions(id__))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_currentStatusState <- setR_currentStatusState]]
						 )
						)
						 [[setR_currentStatusState <- set_currentStatusState]]
						)
					)
					 \ hideSet)
					[[
						statusStateIn__.x____ <- statusStateIn,
						statusStateOut1__.x____ <- statusStateOut1,
						statusStateOut2__.x____ <- statusStateOut2
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
			)
			)
		
		IteratedBehaviour(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody(id__)
								[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
								dbisim(Clock_CLID_Initialise(id__,0))
							)\{|get_CLID_Initialise|}
						)
						[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
						dbisim(Clock_CLID_Distribute(id__,0))
					)\{|get_CLID_Distribute|}
				)
				) \ union(stateClockSync,enteredSS)
			)
			)
		
		Stateful(id__) = 
			((let
				getsetLocalChannels = {|get_currentStatusState,set_currentStatusState|}
				clockSync = {||}
			within
				(Behaviour(id__) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful(id__) =
			(dbisim(
				sbisim(
					IteratedBehaviour(id__)
					[| {|get_currentStatusState,set_currentStatusState,terminate|} |]
					Memory_currentStatusState((VehicleState_INVALID,true,true,true,true,Seats_EMPTY,Seats_EMPTY,0,0,0))
				)\{|get_currentStatusState,set_currentStatusState|}
			)
			)
		
		-- Visible counterparts
		MachineBody_VS_O(id__) = 
			dbisim((
			let
				finalNodesEntered = {||}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					Distribute::enter,
					i0::enter,
					Initialise::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited,interrupt|})
						transSync = {|statusStateIn__.NID_Distribute.in,statusStateIn__.NID_Initialise.in,internal__.NID_i0|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   Distribute::VS_O__(id__)
						   [| { share__, terminate } |] (
						   i0::VS_O__(id__)
						   [| { share__, terminate } |] (
						   Initialise::VS_O__(id__)
						   )
						   )
						 )
						 [[Distribute::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Distribute.in|}]]
						 [[Initialise::interrupt <- x__ | x__ <- {|interrupt,statusStateIn__.NID_Initialise.in|}]]
						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_currentStatusState |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_currentStatusState
						 			|}) |]
						 ((i0::enter -> Transitions(id__))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_currentStatusState <- setR_currentStatusState]]
						 )
						)
						 [[setR_currentStatusState <- set_currentStatusState]]
						)
					)
					 \ hideSet)
					[[
						statusStateIn__.x____ <- statusStateIn,
						statusStateOut1__.x____ <- statusStateOut1,
						statusStateOut2__.x____ <- statusStateOut2
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour_VS_O(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__) = 
			dbisim((let
				stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody_VS_O(id__)
								[| {|get_CLID_Initialise,Initialise::entered,terminate|} |]
								dbisim(Clock_CLID_Initialise(id__,0))
							)\{|get_CLID_Initialise|}
						)
						[| {|get_CLID_Distribute,Distribute::entered,terminate|} |]
						dbisim(Clock_CLID_Distribute(id__,0))
					)\{|get_CLID_Distribute|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__) = 
			dbisim((let
				getsetLocalChannels = {|get_currentStatusState,set_currentStatusState|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__) =
			(dbisim(
				sbisim(
					IteratedBehaviour_VS_O(id__)
					[| {|get_currentStatusState,set_currentStatusState,terminate|} |]
					Memory_currentStatusState((VehicleState_INVALID,true,true,true,true,Seats_EMPTY,Seats_EMPTY,0,0,0))
				)\{|get_currentStatusState,set_currentStatusState|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_currentStatusState(currentStatusState) =
			get_currentStatusState!currentStatusState -> Memory_currentStatusState(currentStatusState)
			[]
			set_currentStatusState?x__ -> Memory_currentStatusState(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__) = Memory_currentStatusState((VehicleState_INVALID,true,true,true,true,Seats_EMPTY,Seats_EMPTY,0,0,0))
		
		getsetLocalChannels = {|get_currentStatusState,set_currentStatusState|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__) = STM_VS_O(id__) \ localClockResets
		D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
		O__(id__) = dbisim(D__(id__))
		VS__(id__) = FVS__(id__)
		VS_O__(id__) = dbisim(FVS__(id__))
		HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
		FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
		HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Distribute(id__,x__) = 
			TimeOut_1(
				Distribute::entered -> Clock_CLID_Distribute(id__,0)
				[]
				get_CLID_Distribute!x__ -> Clock_CLID_Distribute(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Distribute(id__,clock_type_plus(x__,1,CLID_Distribute_clock_type(id__))))
		Clock_CLID_Initialise(id__,x__) = 
			TimeOut_1(
				Initialise::entered -> Clock_CLID_Initialise(id__,0)
				[]
				get_CLID_Initialise!x__ -> Clock_CLID_Initialise(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Initialise(id__,clock_type_plus(x__,1,CLID_Initialise_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_Distribute(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_Initialise(id__,0))
		)
		
		stateClockSync = {|get_CLID_Distribute,Distribute::entered,get_CLID_Initialise,Initialise::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule


endmodule
