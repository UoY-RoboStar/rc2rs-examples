					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: Disarmed
	module Disarmed
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME) = D__(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: GoingHome
	module GoingHome
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&CALL__fcGoHomeCall(
						id__,
					    const_Flight_CLIMB_LIFT,
					    const_Flight_DELAY_DISARM,
					    const_Flight_HOME
					) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&CALL__fcGoHomeCall(
						id__,
					    const_Flight_CLIMB_LIFT,
					    const_Flight_DELAY_DISARM,
					    const_Flight_HOME
					) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__fcMoveRelativeCall(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME,
				param_movement) 	= fcMoveRelativeCallCall.param_movement -> SKIP
	CALL__fcTakeoffCall(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) 	= fcTakeoffCallCall -> SKIP
	CALL__fcLandCall(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) 	= fcLandCallCall -> SKIP
	CALL__fcGoHomeCall(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) 	= fcGoHomeCallCall -> SKIP
	CALL__fcWaypointCall(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME,
				param_pos) 	= fcWaypointCallCall.param_pos -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_Flight_CLIMB_LIFT,
						    const_Flight_DELAY_DISARM,
						    const_Flight_HOME) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_Flight_CLIMB_LIFT,
						    const_Flight_DELAY_DISARM,
						    const_Flight_HOME) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = ((let
		Trans = share__choice(get_gotStart?gotStart -> get_cmd?cmd -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Connect::enter -> SKIP))))
			 	 [] dbisim((true)&(fcControlAuth__!NID_Connect.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(uavStatus.out!AircraftStatus_Connected -> SKIP)) ; Waiting::enter -> SKIP)))
			 	 [] dbisim((true)&(waypoint__!NID_Waiting.in?wp:{wp|wp <- Position, true} -> share__choice(set_wp!wp -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Waypoint::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Waypoint -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Waiting::enter -> SKIP)))
			 	 [] dbisim((true)&(fcWaypointFinishedMission__!NID_Waiting.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(uavStatus.out!AircraftStatus_AtWaypoint -> SKIP)) ; Waiting::enter -> SKIP)))
			 	 [] dbisim((true)&(visualPosition__!NID_Waiting.in?vp:{vp|vp <- RelativeMotion, true} -> share__choice(set_vp!vp -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Relative::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Relative -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Waiting::enter -> SKIP)))
			 	 [] dbisim((true)&(navCommand__!NID_Waiting.in?cmd:{cmd|cmd <- NavCommand, true} -> share__choice(set_cmd!cmd -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; ProcessingCommand::enter -> SKIP)))
			 	 [] dbisim(((cmd==NavCommand_TakeOff))&(internal__!NID_ProcessingCommand -> SKIP ;  ((SKIP ; TakingOff::enter -> SKIP))))
			 	 [] dbisim(((cmd==NavCommand_GoHome))&(internal__!NID_ProcessingCommand -> SKIP ;  ((SKIP ; GoHome::enter -> SKIP))))
			 	 [] dbisim(((cmd==NavCommand_Land))&(internal__!NID_ProcessingCommand -> SKIP ;  ((SKIP ; Landing::enter -> SKIP))))
			 	 [] dbisim((true)&(fcTakeoffRet__!NID_TakingOff.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(uavStatus.out!AircraftStatus_TakenOff -> SKIP)) ; Climbing::enter -> SKIP)))
			 	 [] dbisim((true)&(fcWaypointFinishedMission__!NID_Climbing.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(uavStatus.out!AircraftStatus_AtAltitude -> SKIP)) ; Waiting::enter -> SKIP)))
			 	 [] dbisim((gotStart)&(internal__!NID_GoHome -> SKIP ;  ((SKIP ; BackToStart::enter -> SKIP))))
			 	 [] dbisim(((not (gotStart)))&(internal__!NID_GoHome -> SKIP ;  ((SKIP ; GoingHome::enter -> SKIP))))
			 	 [] dbisim((true)&(fcWaypointFinishedMission__!NID_BackToStart.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; GoingHome::enter -> SKIP)))
			 	 [] dbisim((true)&(fcLandRet__!NID_Landing.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(uavStatus.out!AircraftStatus_Landed -> SKIP));SKIP;true&(share__choice(uavStatus.out!AircraftStatus_Disarmed -> SKIP)) ; Disarmed::enter -> SKIP)))
			 	 [] dbisim((true)&(fcWaypointFinishedMission__!NID_GoingHome.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(uavStatus.out!AircraftStatus_AtHome -> SKIP)) ; Waiting::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		dbisim((
		let
			finalNodesEntered = {|Disarmed::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Connect::enter,
				Waiting::enter,
				ProcessingCommand::enter,
				Waypoint::enter,
				Relative::enter,
				TakingOff::enter,
				Climbing::enter,
				GoHome::enter,
				BackToStart::enter,
				Landing::enter,
				Disarmed::enter,
				GoingHome::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,fcControlAuth__.NID_Connect.in,waypoint__.NID_Waiting.in,internal__.NID_Waypoint,fcWaypointFinishedMission__.NID_Waiting.in,visualPosition__.NID_Waiting.in,internal__.NID_Relative,navCommand__.NID_Waiting.in,internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand,fcTakeoffRet__.NID_TakingOff.in,fcWaypointFinishedMission__.NID_Climbing.in,internal__.NID_GoHome,internal__.NID_GoHome,fcWaypointFinishedMission__.NID_BackToStart.in,fcLandRet__.NID_Landing.in,fcWaypointFinishedMission__.NID_GoingHome.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Connect::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Waiting::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   ProcessingCommand::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Waypoint::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Relative::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   TakingOff::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Climbing::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   GoHome::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   BackToStart::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Landing::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Disarmed::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   GoingHome::D__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					 )
					 [[Connect::interrupt <- x__ | x__ <- {|interrupt,fcControlAuth__.NID_Connect.in|}]]
					 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,waypoint__.NID_Waiting.in,fcWaypointFinishedMission__.NID_Waiting.in,visualPosition__.NID_Waiting.in,navCommand__.NID_Waiting.in|}]]
					 [[Waypoint::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Waypoint|}]]
					 [[Relative::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Relative|}]]
					 [[TakingOff::interrupt <- x__ | x__ <- {|interrupt,fcTakeoffRet__.NID_TakingOff.in|}]]
					 [[Climbing::interrupt <- x__ | x__ <- {|interrupt,fcWaypointFinishedMission__.NID_Climbing.in|}]]
					 [[BackToStart::interrupt <- x__ | x__ <- {|interrupt,fcWaypointFinishedMission__.NID_BackToStart.in|}]]
					 [[Landing::interrupt <- x__ | x__ <- {|interrupt,fcLandRet__.NID_Landing.in|}]]
					 [[Disarmed::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[GoingHome::interrupt <- x__ | x__ <- {|interrupt,fcWaypointFinishedMission__.NID_GoingHome.in|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 [[ProcessingCommand::interrupt <- x__ | x__ <- {|internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand|}]]
					 [[GoHome::interrupt <- x__ | x__ <- {|internal__.NID_GoHome,internal__.NID_GoHome|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_vp,setR_wp,setR_cmd |} ]] 
					  [[set_gotStart <- setL_gotStart,set_cmd <- setL_cmd]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_gotStart
					 			,setL_cmd
					 			,setR_vp
					 			 			,setR_wp
					 			 			,setR_cmd
					 			|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_Flight_CLIMB_LIFT,
					 		    const_Flight_DELAY_DISARM,
					 		    const_Flight_HOME))
					  [[ share__ <- x__ | x__ <- {| share__,setL_gotStart,setL_cmd |} ]]
					  [[set_vp <- setR_vp,set_wp <- setR_wp,set_cmd <- setR_cmd]]
					 )
					)[[setL_gotStart <- set_gotStart,setL_cmd <- set_cmd]]
					 [[setR_vp <- set_vp,setR_wp <- set_wp,setR_cmd <- set_cmd]]
					)
				)
				 \ hideSet)
				[[
					fcControlAuth__.x____ <- fcControlAuth,
					fcTakeoffRet__.x____ <- fcTakeoffRet,
					fcGoHomeRet__.x____ <- fcGoHomeRet,
					fcLandRet__.x____ <- fcLandRet,
					fcWaypointFinishedMission__.x____ <- fcWaypointFinishedMission,
					fcMoveRelativeRet__.x____ <- fcMoveRelativeRet,
					navCommand__.x____ <- navCommand,
					waypoint__.x____ <- waypoint,
					uavStatus__.x____ <- uavStatus,
					visualPosition__.x____ <- visualPosition
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		dbisim((MachineBody(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		dbisim((MachineBody(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME)\ enteredSS)
		)
	
	Stateful(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		((
			(Behaviour(id__,
					    const_Flight_CLIMB_LIFT,
					    const_Flight_DELAY_DISARM,
					    const_Flight_HOME) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_Flight_CLIMB_LIFT,
					    const_Flight_DELAY_DISARM,
					    const_Flight_HOME))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												dbisim(
													sbisim(
														Behaviour(id__,
																    const_Flight_CLIMB_LIFT,
																    const_Flight_DELAY_DISARM,
																    const_Flight_HOME)
														[| {|get_gotStart,set_gotStart,terminate|} |]
														Memory_gotStart(false)
													)\{|get_gotStart,set_gotStart|}
												)
												[| {|get_start,set_start,terminate|} |]
												Memory_start((0,0,0,0))
											)\{|get_start,set_start|}
										)
										[| {|get_wp,set_wp,terminate|} |]
										Memory_wp((0,0,0,0))
									)\{|get_wp,set_wp|}
								)
								[| {|get_vp,set_vp,terminate|} |]
								Memory_vp((0,0,0,0))
							)\{|get_vp,set_vp|}
						)
						[| {|get_cmd,set_cmd,terminate|} |]
						Memory_cmd(NavCommand_TakeOff)
					)\{|get_cmd,set_cmd|}
				)
				[| {|get_h,set_h,terminate|} |]
				Memory_h(0)
			)\{|get_h,set_h|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		dbisim((
		let
			finalNodesEntered = {|Disarmed::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Connect::enter,
				Waiting::enter,
				ProcessingCommand::enter,
				Waypoint::enter,
				Relative::enter,
				TakingOff::enter,
				Climbing::enter,
				GoHome::enter,
				BackToStart::enter,
				Landing::enter,
				Disarmed::enter,
				GoingHome::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,fcControlAuth__.NID_Connect.in,waypoint__.NID_Waiting.in,internal__.NID_Waypoint,fcWaypointFinishedMission__.NID_Waiting.in,visualPosition__.NID_Waiting.in,internal__.NID_Relative,navCommand__.NID_Waiting.in,internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand,fcTakeoffRet__.NID_TakingOff.in,fcWaypointFinishedMission__.NID_Climbing.in,internal__.NID_GoHome,internal__.NID_GoHome,fcWaypointFinishedMission__.NID_BackToStart.in,fcLandRet__.NID_Landing.in,fcWaypointFinishedMission__.NID_GoingHome.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Connect::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Waiting::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   ProcessingCommand::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Waypoint::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Relative::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   TakingOff::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Climbing::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   GoHome::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   BackToStart::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Landing::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   Disarmed::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   [| { share__, terminate } |] (
					   GoingHome::VS_O__(id__,
					   		    const_Flight_CLIMB_LIFT,
					   		    const_Flight_DELAY_DISARM,
					   		    const_Flight_HOME)
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					 )
					 [[Connect::interrupt <- x__ | x__ <- {|interrupt,fcControlAuth__.NID_Connect.in|}]]
					 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,waypoint__.NID_Waiting.in,fcWaypointFinishedMission__.NID_Waiting.in,visualPosition__.NID_Waiting.in,navCommand__.NID_Waiting.in|}]]
					 [[Waypoint::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Waypoint|}]]
					 [[Relative::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Relative|}]]
					 [[TakingOff::interrupt <- x__ | x__ <- {|interrupt,fcTakeoffRet__.NID_TakingOff.in|}]]
					 [[Climbing::interrupt <- x__ | x__ <- {|interrupt,fcWaypointFinishedMission__.NID_Climbing.in|}]]
					 [[BackToStart::interrupt <- x__ | x__ <- {|interrupt,fcWaypointFinishedMission__.NID_BackToStart.in|}]]
					 [[Landing::interrupt <- x__ | x__ <- {|interrupt,fcLandRet__.NID_Landing.in|}]]
					 [[Disarmed::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[GoingHome::interrupt <- x__ | x__ <- {|interrupt,fcWaypointFinishedMission__.NID_GoingHome.in|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 [[ProcessingCommand::interrupt <- x__ | x__ <- {|internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand,internal__.NID_ProcessingCommand|}]]
					 [[GoHome::interrupt <- x__ | x__ <- {|internal__.NID_GoHome,internal__.NID_GoHome|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_vp,setR_wp,setR_cmd |} ]] 
					  [[set_gotStart <- setL_gotStart,set_cmd <- setL_cmd]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_gotStart
					 			,setL_cmd
					 			,setR_vp
					 			 			,setR_wp
					 			 			,setR_cmd
					 			|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_Flight_CLIMB_LIFT,
					 		    const_Flight_DELAY_DISARM,
					 		    const_Flight_HOME))
					  [[ share__ <- x__ | x__ <- {| share__,setL_gotStart,setL_cmd |} ]]
					  [[set_vp <- setR_vp,set_wp <- setR_wp,set_cmd <- setR_cmd]]
					 )
					)[[setL_gotStart <- set_gotStart,setL_cmd <- set_cmd]]
					 [[setR_vp <- set_vp,setR_wp <- set_wp,setR_cmd <- set_cmd]]
					)
				)
				 \ hideSet)
				[[
					fcControlAuth__.x____ <- fcControlAuth,
					fcTakeoffRet__.x____ <- fcTakeoffRet,
					fcGoHomeRet__.x____ <- fcGoHomeRet,
					fcLandRet__.x____ <- fcLandRet,
					fcWaypointFinishedMission__.x____ <- fcWaypointFinishedMission,
					fcMoveRelativeRet__.x____ <- fcMoveRelativeRet,
					navCommand__.x____ <- navCommand,
					waypoint__.x____ <- waypoint,
					uavStatus__.x____ <- uavStatus,
					visualPosition__.x____ <- visualPosition
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		dbisim((MachineBody_VS_O(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		dbisim((MachineBody_VS_O(id__,
				    const_Flight_CLIMB_LIFT,
				    const_Flight_DELAY_DISARM,
				    const_Flight_HOME))
		)
	
	Stateful_VS_O(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_Flight_CLIMB_LIFT,
					    const_Flight_DELAY_DISARM,
					    const_Flight_HOME) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_Flight_CLIMB_LIFT,
					    const_Flight_DELAY_DISARM,
					    const_Flight_HOME))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												dbisim(
													sbisim(
														Behaviour_VS_O(id__,
																    const_Flight_CLIMB_LIFT,
																    const_Flight_DELAY_DISARM,
																    const_Flight_HOME)
														[| {|get_gotStart,set_gotStart,terminate|} |]
														Memory_gotStart(false)
													)\{|get_gotStart,set_gotStart|}
												)
												[| {|get_start,set_start,terminate|} |]
												Memory_start((0,0,0,0))
											)\{|get_start,set_start|}
										)
										[| {|get_wp,set_wp,terminate|} |]
										Memory_wp((0,0,0,0))
									)\{|get_wp,set_wp|}
								)
								[| {|get_vp,set_vp,terminate|} |]
								Memory_vp((0,0,0,0))
							)\{|get_vp,set_vp|}
						)
						[| {|get_cmd,set_cmd,terminate|} |]
						Memory_cmd(NavCommand_TakeOff)
					)\{|get_cmd,set_cmd|}
				)
				[| {|get_h,set_h,terminate|} |]
				Memory_h(0)
			)\{|get_h,set_h|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_h(h) =
		get_h!h -> Memory_h(h)
		[]
		set_h?x__ -> Memory_h(x__)
		[]
		terminate -> SKIP
	Memory_cmd(cmd) =
		get_cmd!cmd -> Memory_cmd(cmd)
		[]
		set_cmd?x__ -> Memory_cmd(x__)
		[]
		terminate -> SKIP
	Memory_vp(vp) =
		get_vp!vp -> Memory_vp(vp)
		[]
		set_vp?x__ -> Memory_vp(x__)
		[]
		terminate -> SKIP
	Memory_wp(wp) =
		get_wp!wp -> Memory_wp(wp)
		[]
		set_wp?x__ -> Memory_wp(x__)
		[]
		terminate -> SKIP
	Memory_start(start) =
		get_start!start -> Memory_start(start)
		[]
		set_start?x__ -> Memory_start(x__)
		[]
		terminate -> SKIP
	Memory_gotStart(gotStart) =
		get_gotStart!gotStart -> Memory_gotStart(gotStart)
		[]
		set_gotStart?x__ -> Memory_gotStart(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = Memory_h(0)
	[| { terminate } |] (
	Memory_cmd(NavCommand_TakeOff)
	[| { terminate } |] (
	Memory_vp((0,0,0,0))
	[| { terminate } |] (
	Memory_wp((0,0,0,0))
	[| { terminate } |] (
	Memory_start((0,0,0,0))
	[| { terminate } |] (
	Memory_gotStart(false)
	)
	)
	)
	)
	)
	
	getsetLocalChannels = {|get_h,set_h,get_cmd,set_cmd,get_vp,set_vp,get_wp,set_wp,get_start,set_start,get_gotStart,set_gotStart|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = STM_VS_O(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME)
	
	D__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = STM(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) \ internal_events
	O__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = sbisim(diamond(D__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME)))
	VS__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = FVS__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME)
	VS_O__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = sbisim(diamond(FVS__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME)))
	HEXT__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = O__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = O__(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_Flight_CLIMB_LIFT,
			    const_Flight_DELAY_DISARM,
			    const_Flight_HOME) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
