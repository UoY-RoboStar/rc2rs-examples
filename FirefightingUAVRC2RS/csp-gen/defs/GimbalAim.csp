		)
	
	Behaviour(id__,
			    const_GimbalAim_TRACK_DIST) = 
		dbisim((MachineBody(id__,
				    const_GimbalAim_TRACK_DIST)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_GimbalAim_TRACK_DIST) = 
		dbisim((MachineBody(id__,
				    const_GimbalAim_TRACK_DIST)\ enteredSS)
		)
	
	Stateful(id__,
			    const_GimbalAim_TRACK_DIST) = 
		((
			(Behaviour(id__,
					    const_GimbalAim_TRACK_DIST) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_GimbalAim_TRACK_DIST))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_GimbalAim_TRACK_DIST) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												dbisim(
													sbisim(
														dbisim(
															sbisim(
																dbisim(
																	sbisim(
																		Behaviour(id__,
																				    const_GimbalAim_TRACK_DIST)
																		[| {|get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE,terminate|} |]
																		Memory_PITCH_DEAD_ZONE(0)
																	)\{|get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE|}
																)
																[| {|get_YAW_DEAD_ZONE,set_YAW_DEAD_ZONE,terminate|} |]
																Memory_YAW_DEAD_ZONE(0)
															)\{|get_YAW_DEAD_ZONE,set_YAW_DEAD_ZONE|}
														)
														[| {|get_cPitch,set_cPitch,terminate|} |]
														Memory_cPitch(0)
													)\{|get_cPitch,set_cPitch|}
												)
												[| {|get_cYaw,set_cYaw,terminate|} |]
												Memory_cYaw(0)
											)\{|get_cYaw,set_cYaw|}
										)
										[| {|get_tracking,set_tracking,terminate|} |]
										Memory_tracking(false)
									)\{|get_tracking,set_tracking|}
								)
								[| {|get_pitch,set_pitch,terminate|} |]
								Memory_pitch(0)
							)\{|get_pitch,set_pitch|}
						)
						[| {|get_yaw,set_yaw,terminate|} |]
						Memory_yaw(0)
					)\{|get_yaw,set_yaw|}
				)
				[| {|get_tgt,set_tgt,terminate|} |]
				Memory_tgt((FireStatus_NoFire,0,0,0))
			)\{|get_tgt,set_tgt|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_GimbalAim_TRACK_DIST) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Waiting::enter,
				Calculate::enter,
				Yaw::enter,
				Pitch::enter,
				IsValid::enter,
				Clamp::enter,
				MaybeAimed::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,fgSeenFire__.NID_Waiting.in,internal__.NID_Calculate,gimbalYawAck__.NID_Yaw.in,gimbalPitchAck__.NID_Pitch.in,internal__.NID_IsValid,internal__.NID_IsValid,internal__.NID_Clamp,internal__.NID_MaybeAimed,internal__.NID_MaybeAimed|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   [| { share__, terminate } |] (
					   Waiting::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   [| { share__, terminate } |] (
					   Calculate::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   [| { share__, terminate } |] (
					   Yaw::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   [| { share__, terminate } |] (
					   Pitch::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   [| { share__, terminate } |] (
					   IsValid::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   [| { share__, terminate } |] (
					   Clamp::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   [| { share__, terminate } |] (
					   MaybeAimed::VS_O__(id__,
					   		    const_GimbalAim_TRACK_DIST)
					   )
					   )
					   )
					   )
					   )
					   )
					   )
					 )
					 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,fgSeenFire__.NID_Waiting.in|}]]
					 [[Calculate::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Calculate|}]]
					 [[Yaw::interrupt <- x__ | x__ <- {|interrupt,gimbalYawAck__.NID_Yaw.in|}]]
					 [[Pitch::interrupt <- x__ | x__ <- {|interrupt,gimbalPitchAck__.NID_Pitch.in|}]]
					 [[Clamp::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Clamp|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 [[IsValid::interrupt <- x__ | x__ <- {|internal__.NID_IsValid,internal__.NID_IsValid|}]]
					 [[MaybeAimed::interrupt <- x__ | x__ <- {|internal__.NID_MaybeAimed,internal__.NID_MaybeAimed|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_tgt |} ]] 
					  [[set_yaw <- setL_yaw,set_tgt <- setL_tgt,set_cPitch <- setL_cPitch,set_cYaw <- setL_cYaw,set_pitch <- setL_pitch]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_yaw
					 			,setL_tgt
					 			,setL_cPitch
					 			,setL_cYaw
					 			,setL_pitch
					 			,setR_tgt
					 			|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_GimbalAim_TRACK_DIST))
					  [[ share__ <- x__ | x__ <- {| share__,setL_yaw,setL_tgt,setL_cPitch,setL_cYaw,setL_pitch |} ]]
					  [[set_tgt <- setR_tgt]]
					 )
					)[[setL_yaw <- set_yaw,setL_tgt <- set_tgt,setL_cPitch <- set_cPitch,setL_cYaw <- set_cYaw,setL_pitch <- set_pitch]]
					 [[setR_tgt <- set_tgt]]
					)
				)
				 \ hideSet)
				[[
					fgSeenFire__.x____ <- fgSeenFire,
					gimbalYaw__.x____ <- gimbalYaw,
					gimbalPitch__.x____ <- gimbalPitch,
					gimbalYawAck__.x____ <- gimbalYawAck,
					gimbalPitchAck__.x____ <- gimbalPitchAck,
					gimbalAimed__.x____ <- gimbalAimed
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_GimbalAim_TRACK_DIST) = 
		dbisim((MachineBody_VS_O(id__,
				    const_GimbalAim_TRACK_DIST))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_GimbalAim_TRACK_DIST) = 
		dbisim((MachineBody_VS_O(id__,
				    const_GimbalAim_TRACK_DIST))
		)
	
	Stateful_VS_O(id__,
			    const_GimbalAim_TRACK_DIST) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_GimbalAim_TRACK_DIST) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_GimbalAim_TRACK_DIST))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_GimbalAim_TRACK_DIST) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												dbisim(
													sbisim(
														dbisim(
															sbisim(
																dbisim(
																	sbisim(
																		Behaviour_VS_O(id__,
																				    const_GimbalAim_TRACK_DIST)
																		[| {|get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE,terminate|} |]
																		Memory_PITCH_DEAD_ZONE(0)
																	)\{|get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE|}
																)
																[| {|get_YAW_DEAD_ZONE,set_YAW_DEAD_ZONE,terminate|} |]
																Memory_YAW_DEAD_ZONE(0)
															)\{|get_YAW_DEAD_ZONE,set_YAW_DEAD_ZONE|}
														)
														[| {|get_cPitch,set_cPitch,terminate|} |]
														Memory_cPitch(0)
													)\{|get_cPitch,set_cPitch|}
												)
												[| {|get_cYaw,set_cYaw,terminate|} |]
												Memory_cYaw(0)
											)\{|get_cYaw,set_cYaw|}
										)
										[| {|get_tracking,set_tracking,terminate|} |]
										Memory_tracking(false)
									)\{|get_tracking,set_tracking|}
								)
								[| {|get_pitch,set_pitch,terminate|} |]
								Memory_pitch(0)
							)\{|get_pitch,set_pitch|}
						)
						[| {|get_yaw,set_yaw,terminate|} |]
						Memory_yaw(0)
					)\{|get_yaw,set_yaw|}
				)
				[| {|get_tgt,set_tgt,terminate|} |]
				Memory_tgt((FireStatus_NoFire,0,0,0))
			)\{|get_tgt,set_tgt|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_tgt(tgt) =
		get_tgt!tgt -> Memory_tgt(tgt)
		[]
		set_tgt?x__ -> Memory_tgt(x__)
		[]
		terminate -> SKIP
	Memory_yaw(yaw) =
		get_yaw!yaw -> Memory_yaw(yaw)
		[]
		set_yaw?x__ -> Memory_yaw(x__)
		[]
		terminate -> SKIP
	Memory_pitch(pitch) =
		get_pitch!pitch -> Memory_pitch(pitch)
		[]
		set_pitch?x__ -> Memory_pitch(x__)
		[]
		terminate -> SKIP
	Memory_tracking(tracking) =
		get_tracking!tracking -> Memory_tracking(tracking)
		[]
		set_tracking?x__ -> Memory_tracking(x__)
		[]
		terminate -> SKIP
	Memory_cYaw(cYaw) =
		get_cYaw!cYaw -> Memory_cYaw(cYaw)
		[]
		set_cYaw?x__ -> Memory_cYaw(x__)
		[]
		terminate -> SKIP
	Memory_cPitch(cPitch) =
		get_cPitch!cPitch -> Memory_cPitch(cPitch)
		[]
		set_cPitch?x__ -> Memory_cPitch(x__)
		[]
		terminate -> SKIP
	Memory_YAW_DEAD_ZONE(YAW_DEAD_ZONE) =
		get_YAW_DEAD_ZONE!YAW_DEAD_ZONE -> Memory_YAW_DEAD_ZONE(YAW_DEAD_ZONE)
		[]
		set_YAW_DEAD_ZONE?x__ -> Memory_YAW_DEAD_ZONE(x__)
		[]
		terminate -> SKIP
	Memory_PITCH_DEAD_ZONE(PITCH_DEAD_ZONE) =
		get_PITCH_DEAD_ZONE!PITCH_DEAD_ZONE -> Memory_PITCH_DEAD_ZONE(PITCH_DEAD_ZONE)
		[]
		set_PITCH_DEAD_ZONE?x__ -> Memory_PITCH_DEAD_ZONE(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_GimbalAim_TRACK_DIST) = Memory_tgt((FireStatus_NoFire,0,0,0))
	[| { terminate } |] (
	Memory_yaw(0)
	[| { terminate } |] (
	Memory_pitch(0)
	[| { terminate } |] (
	Memory_tracking(false)
	[| { terminate } |] (
	Memory_cYaw(0)
	[| { terminate } |] (
	Memory_cPitch(0)
	[| { terminate } |] (
	Memory_YAW_DEAD_ZONE(0)
	[| { terminate } |] (
	Memory_PITCH_DEAD_ZONE(0)
	)
	)
	)
	)
	)
	)
	)
	
	getsetLocalChannels = {|get_tgt,set_tgt,get_yaw,set_yaw,get_pitch,set_pitch,get_tracking,set_tracking,get_cYaw,set_cYaw,get_cPitch,set_cPitch,get_YAW_DEAD_ZONE,set_YAW_DEAD_ZONE,get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_GimbalAim_TRACK_DIST) = STM_VS_O(id__,
			    const_GimbalAim_TRACK_DIST)
	
	D__(id__,
			    const_GimbalAim_TRACK_DIST) = STM(id__,
			    const_GimbalAim_TRACK_DIST) \ internal_events
	O__(id__,
			    const_GimbalAim_TRACK_DIST) = sbisim(diamond(D__(id__,
			    const_GimbalAim_TRACK_DIST)))
	VS__(id__,
			    const_GimbalAim_TRACK_DIST) = FVS__(id__,
			    const_GimbalAim_TRACK_DIST)
	VS_O__(id__,
			    const_GimbalAim_TRACK_DIST) = sbisim(diamond(FVS__(id__,
			    const_GimbalAim_TRACK_DIST)))
	HEXT__(id__,
			    const_GimbalAim_TRACK_DIST) = O__(id__,
			    const_GimbalAim_TRACK_DIST) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_GimbalAim_TRACK_DIST) = O__(id__,
			    const_GimbalAim_TRACK_DIST) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_GimbalAim_TRACK_DIST) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
