					channel vnavDisable__: NIDS.InOut
					
					--	Nodes
					-- declaring all nodes
					
					----------------------------------------------------------------------
					-- Initial: I
					module I
					exports
					
						channel enter, interrupt
						
						D__(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
