				 		   )
				 		   )
				 		   )
				 		   )
				 		 )
				 		 [[TakeOffAndClimb::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_TakeOffAndClimb|}]]
				 		 [[Mission::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Mission,batteryLow__.NID_Mission.in,waterEmpty__.NID_Mission.in|}]]
