						 	  share__choice(exit -> SKIP) ; SKIP ; 
						 	  share__choice(exited -> SKIP) ; Inactive
			
				Behaviour 	= entered -> During
				During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
			within
				Inactive [| {terminate} |> SKIP)
			
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- Junction: Commit
		module Commit
		exports
		
			channel enter, interrupt
			
			D__(id__,
					    const_VisualNav_TRACK_DIST,
					    const_VisualNav_SCAN_DIST) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Active 		= share__choice(interrupt -> SKIP) ; Inactive
				within
					Inactive [| {terminate} |> SKIP)
				
			VS_O__(id__,
					    const_VisualNav_TRACK_DIST,
					    const_VisualNav_SCAN_DIST) = D__(id__,
					    const_VisualNav_TRACK_DIST,
					    const_VisualNav_SCAN_DIST)
		
		endmodule
		----------------------------------------------------------------------
		
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
		
			Behaviour 	= dbisim(
				((
				 (((let
				 	-- IMPLEMENTATION NOTE:
				 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				 	-- modules for defining the semantics of each node.
				 	enterSS = {|
				 	I::enter,
				 	Waiting::enter,
				 	Wall::enter,
				 	FIsValid::enter,
				 	Fire::enter,
				 	NoFire::enter,
				 	Commit::enter
				 	|}
				 	hideSet = union(enterSS,{|exit,exited,internal__|})
				 within 
				 	((let
				 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
				 		-- because CSPM modules are used for the semantics of Node.
				 		flowevts = union(enterSS,{|exit,exited,interrupt|})
				 		transSync = {|internal__.NID_I,wallMetrics__.NID_Waiting.in,fvSeenFire__.NID_Wall.in,internal__.NID_FIsValid,internal__.NID_FIsValid,internal__.NID_Fire,internal__.NID_NoFire,internal__.NID_Commit|}
				 	within
				 		((
				 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
				 		   I::D__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Waiting::D__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Wall::D__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   FIsValid::D__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Fire::D__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   NoFire::D__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Commit::D__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   )
				 		   )
				 		   )
				 		   )
				 		   )
				 		   )
				 		 )
				 		 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,wallMetrics__.NID_Waiting.in|}]]
				 		 [[Wall::interrupt <- x__ | x__ <- {|interrupt,fvSeenFire__.NID_Wall.in|}]]
				 		 [[Fire::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Fire|}]]
				 		 [[NoFire::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_NoFire|}]]
				 		 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
				 		 [[FIsValid::interrupt <- x__ | x__ <- {|internal__.NID_FIsValid,internal__.NID_FIsValid|}]]
				 		 [[Commit::interrupt <- x__ | x__ <- {|internal__.NID_Commit|}]]
				 		 )
				 		  [[ share__ <- x__ | x__ <- {| share__,setR_wm,setR_tgt |} ]] 
				 		  [[set_tgt <- setL_tgt]]
				 		 )
				 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
				 		 			,setL_tgt
				 		 			,setR_wm
				 		 			 			,setR_tgt
				 		 			|}) |]
				 		 ((I::enter -> Transitions(id__,
				 		 		    const_VisualNav_TRACK_DIST,
				 		 		    const_VisualNav_SCAN_DIST))
				 		  [[ share__ <- x__ | x__ <- {| share__,setL_tgt |} ]]
				 		  [[set_wm <- setR_wm,set_tgt <- setR_tgt]]
				 		 )
				 		)[[setL_tgt <- set_tgt]]
				 		 [[setR_wm <- set_wm,setR_tgt <- set_tgt]]
				 		)
				 	)
				 	 \ hideSet)
				 	[[
				 		wallMetrics__.x____ <- wallMetrics,
				 		fvSeenFire__.x____ <- fvSeenFire,
				 		visualPosition__.x____ <- visualPosition,
				 		vnavEnable__.x____ <- vnavEnable,
				 		vnavDisable__.x____ <- vnavDisable
				 		| x____ <- NIDS
				 	]]
				 )
				 )
				  [[ share__ <- x__ | x__ <- {| share__,setR_movement,setR_wm,setR_tgt |} ]] 
				  [[set_movement <- setL_movement,set_wm <- setL_wm,set_tgt <- setL_tgt]]
				 )
				 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
				 			,setL_movement
				 			,setL_wm
				 			,setL_tgt
				 			,setR_movement
				 			 			,setR_wm
				 			 			,setR_tgt
				 			|}) |]
				 ((During)
				  [[ share__ <- x__ | x__ <- {| share__,setL_movement,setL_wm,setL_tgt |} ]]
				  [[set_movement <- setR_movement,set_wm <- setR_wm,set_tgt <- setR_tgt]]
				 )
				)[[setL_movement <- set_movement,setL_wm <- set_wm,setL_tgt <- set_tgt]]
				 [[setR_movement <- set_movement,setR_wm <- set_wm,setR_tgt <- set_tgt]]
				)\union(enteredSS,{terminate}) 
			)
			During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
					 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
		
			Behaviour 	= dbisim(
				((
				 (((let
				 	-- IMPLEMENTATION NOTE:
				 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				 	-- modules for defining the semantics of each node.
				 	enterSS = {|
				 	I::enter,
				 	Waiting::enter,
				 	Wall::enter,
				 	FIsValid::enter,
				 	Fire::enter,
				 	NoFire::enter,
				 	Commit::enter
				 	|}
				 	hideSet = union(enterSS,{|exit,exited,internal__|})
				 within 
				 	((let
				 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
				 		-- because CSPM modules are used for the semantics of Node.
				 		flowevts = union(enterSS,{|exit,exited,interrupt|})
				 		transSync = {|internal__.NID_I,wallMetrics__.NID_Waiting.in,fvSeenFire__.NID_Wall.in,internal__.NID_FIsValid,internal__.NID_FIsValid,internal__.NID_Fire,internal__.NID_NoFire,internal__.NID_Commit|}
				 	within
				 		((
				 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
				 		   I::VS_O__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Waiting::VS_O__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Wall::VS_O__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   FIsValid::VS_O__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Fire::VS_O__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   NoFire::VS_O__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   [| { share__, terminate } |] (
				 		   Commit::VS_O__(id__,
				 		   		    const_VisualNav_TRACK_DIST,
				 		   		    const_VisualNav_SCAN_DIST)
				 		   )
				 		   )
				 		   )
				 		   )
				 		   )
				 		   )
				 		 )
				 		 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,wallMetrics__.NID_Waiting.in|}]]
				 		 [[Wall::interrupt <- x__ | x__ <- {|interrupt,fvSeenFire__.NID_Wall.in|}]]
				 		 [[Fire::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Fire|}]]
				 		 [[NoFire::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_NoFire|}]]
				 		 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
				 		 [[FIsValid::interrupt <- x__ | x__ <- {|internal__.NID_FIsValid,internal__.NID_FIsValid|}]]
				 		 [[Commit::interrupt <- x__ | x__ <- {|internal__.NID_Commit|}]]
				 		 )
				 		  [[ share__ <- x__ | x__ <- {| share__,setR_wm,setR_tgt |} ]] 
				 		  [[set_tgt <- setL_tgt]]
				 		 )
				 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
				 		 			,setL_tgt
				 		 			,setR_wm
				 		 			 			,setR_tgt
				 		 			|}) |]
				 		 ((I::enter -> Transitions(id__,
				 		 		    const_VisualNav_TRACK_DIST,
				 		 		    const_VisualNav_SCAN_DIST))
				 		  [[ share__ <- x__ | x__ <- {| share__,setL_tgt |} ]]
				 		  [[set_wm <- setR_wm,set_tgt <- setR_tgt]]
				 		 )
				 		)[[setL_tgt <- set_tgt]]
				 		 [[setR_wm <- set_wm,setR_tgt <- set_tgt]]
				 		)
				 	)
				 	 \ hideSet)
				 	[[
				 		wallMetrics__.x____ <- wallMetrics,
				 		fvSeenFire__.x____ <- fvSeenFire,
				 		visualPosition__.x____ <- visualPosition,
				 		vnavEnable__.x____ <- vnavEnable,
				 		vnavDisable__.x____ <- vnavDisable
				 		| x____ <- NIDS
				 	]]
				 )
				 )
				  [[ share__ <- x__ | x__ <- {| share__,setR_movement,setR_wm,setR_tgt |} ]] 
				  [[set_movement <- setL_movement,set_wm <- setL_wm,set_tgt <- setL_tgt]]
				 )
				 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
				 			,setL_movement
				 			,setL_wm
				 			,setL_tgt
				 			,setR_movement
				 			 			,setR_wm
				 			 			,setR_tgt
				 			|}) |]
				 ((During)
				  [[ share__ <- x__ | x__ <- {| share__,setL_movement,setL_wm,setL_tgt |} ]]
				  [[set_movement <- setR_movement,set_wm <- setR_wm,set_tgt <- setR_tgt]]
				 )
				)[[setL_movement <- set_movement,setL_wm <- set_wm,setL_tgt <- set_tgt]]
				 [[setR_movement <- set_movement,setR_wm <- set_wm,setR_tgt <- set_tgt]]
				)\{terminate} 
			)
			During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
					 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
		within
			Inactive [| {terminate} |> SKIP)
		
		Transitions(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST) = ((let
			Trans = share__choice(get_tgt?tgt -> (
				((share__ -> SKIP
				 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
				 	 [] dbisim((true)&(wallMetrics__!NID_Waiting.in?wm:{wm|wm <- WallMetrics, true} -> share__choice(set_wm!wm -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Wall::enter -> SKIP)))
				 	 [] dbisim((true)&(fvSeenFire__!NID_Wall.in?tgt:{tgt|tgt <- FireTarget, true} -> share__choice(set_tgt!tgt -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FIsValid::enter -> SKIP)))
				 	 [] dbisim(((FireTarget_status(tgt)==FireStatus_Tracked))&(internal__!NID_FIsValid -> SKIP ;  ((SKIP ; Fire::enter -> SKIP))))
				 	 [] dbisim(((FireTarget_status(tgt)!=FireStatus_Tracked))&(internal__!NID_FIsValid -> SKIP ;  ((SKIP ; NoFire::enter -> SKIP))))
				 	 [] dbisim((true)&(internal__!NID_Fire -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Commit::enter -> SKIP)))
				 	 [] dbisim((true)&(internal__!NID_NoFire -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Commit::enter -> SKIP)))
				 	 [] dbisim((true)&(internal__!NID_Commit -> SKIP ;  ((share__choice(get_movement?movement -> true&(share__choice(visualPosition.out!movement -> SKIP))) ; Waiting::enter -> SKIP))))
				 ) ; Trans)
				 []
				 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
				 []
				 terminate -> SKIP
			)
			)
		within
			Trans
		)
		)
		
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_VisualNav_TRACK_DIST,
						    const_VisualNav_SCAN_DIST) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_VisualNav_TRACK_DIST,
						    const_VisualNav_SCAN_DIST) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Inactive::enter -> SKIP))))
			 	 [] dbisim((true)&(vnavEnable__!NID_Inactive.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Active::enter -> SKIP)))
			 	 [] dbisim((true)&(vnavDisable__!NID_Active.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Inactive::enter -> SKIP)))
			 	 [] dbisim((true)&(vnavDisable__!NID_Inactive.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Inactive::enter -> SKIP)))
			 	 [] dbisim((true)&(wallMetrics__!NID_Inactive.in?wm:{wm|wm <- WallMetrics, true} -> share__choice(set_wm!wm -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Inactive::enter -> SKIP)))
			 	 [] dbisim((true)&(fvSeenFire__!NID_Inactive.in?tgt:{tgt|tgt <- FireTarget, true} -> share__choice(set_tgt!tgt -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Inactive::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Inactive::enter,
				Active::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Active.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::D__(id__,
					   		    const_VisualNav_TRACK_DIST,
					   		    const_VisualNav_SCAN_DIST)
					   [| { share__, terminate } |] (
					   Inactive::D__(id__,
					   		    const_VisualNav_TRACK_DIST,
					   		    const_VisualNav_SCAN_DIST)
					   [| { share__, terminate } |] (
					   Active::D__(id__,
					   		    const_VisualNav_TRACK_DIST,
					   		    const_VisualNav_SCAN_DIST)
					   )
					   )
					 )
					 [[Inactive::interrupt <- x__ | x__ <- {|interrupt,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}]]
					 [[Active::interrupt <- x__ | x__ <- {|interrupt,vnavDisable__.NID_Active.in|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_wm,setR_tgt |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_wm
					 			 			,setR_tgt
					 			|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_VisualNav_TRACK_DIST,
					 		    const_VisualNav_SCAN_DIST))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_wm <- setR_wm,set_tgt <- setR_tgt]]
					 )
					)
					 [[setR_wm <- set_wm,setR_tgt <- set_tgt]]
					)
				)
				 \ hideSet)
				[[
					wallMetrics__.x____ <- wallMetrics,
					fvSeenFire__.x____ <- fvSeenFire,
					visualPosition__.x____ <- visualPosition,
					vnavEnable__.x____ <- vnavEnable,
					vnavDisable__.x____ <- vnavDisable
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		dbisim((MachineBody(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		dbisim((MachineBody(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST)\ enteredSS)
		)
	
	Stateful(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		((
			(Behaviour(id__,
					    const_VisualNav_TRACK_DIST,
					    const_VisualNav_SCAN_DIST) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_VisualNav_TRACK_DIST,
					    const_VisualNav_SCAN_DIST))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								Behaviour(id__,
										    const_VisualNav_TRACK_DIST,
										    const_VisualNav_SCAN_DIST)
								[| {|get_movement,set_movement,terminate|} |]
								Memory_movement((0,0,0,0))
							)\{|get_movement,set_movement|}
						)
						[| {|get_wm,set_wm,terminate|} |]
						Memory_wm((0,0,0))
					)\{|get_wm,set_wm|}
				)
				[| {|get_tgt,set_tgt,terminate|} |]
				Memory_tgt((FireStatus_NoFire,0,0,0))
			)\{|get_tgt,set_tgt|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Inactive::enter,
				Active::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Active.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__,
					   		    const_VisualNav_TRACK_DIST,
					   		    const_VisualNav_SCAN_DIST)
					   [| { share__, terminate } |] (
					   Inactive::VS_O__(id__,
					   		    const_VisualNav_TRACK_DIST,
					   		    const_VisualNav_SCAN_DIST)
					   [| { share__, terminate } |] (
					   Active::VS_O__(id__,
					   		    const_VisualNav_TRACK_DIST,
					   		    const_VisualNav_SCAN_DIST)
					   )
					   )
					 )
					 [[Inactive::interrupt <- x__ | x__ <- {|interrupt,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}]]
					 [[Active::interrupt <- x__ | x__ <- {|interrupt,vnavDisable__.NID_Active.in|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_wm,setR_tgt |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_wm
					 			 			,setR_tgt
					 			|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_VisualNav_TRACK_DIST,
					 		    const_VisualNav_SCAN_DIST))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_wm <- setR_wm,set_tgt <- setR_tgt]]
					 )
					)
					 [[setR_wm <- set_wm,setR_tgt <- set_tgt]]
					)
				)
				 \ hideSet)
				[[
					wallMetrics__.x____ <- wallMetrics,
					fvSeenFire__.x____ <- fvSeenFire,
					visualPosition__.x____ <- visualPosition,
					vnavEnable__.x____ <- vnavEnable,
					vnavDisable__.x____ <- vnavDisable
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		dbisim((MachineBody_VS_O(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		dbisim((MachineBody_VS_O(id__,
				    const_VisualNav_TRACK_DIST,
				    const_VisualNav_SCAN_DIST))
		)
	
	Stateful_VS_O(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_VisualNav_TRACK_DIST,
					    const_VisualNav_SCAN_DIST) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_VisualNav_TRACK_DIST,
					    const_VisualNav_SCAN_DIST))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								Behaviour_VS_O(id__,
										    const_VisualNav_TRACK_DIST,
										    const_VisualNav_SCAN_DIST)
								[| {|get_movement,set_movement,terminate|} |]
								Memory_movement((0,0,0,0))
							)\{|get_movement,set_movement|}
						)
						[| {|get_wm,set_wm,terminate|} |]
						Memory_wm((0,0,0))
					)\{|get_wm,set_wm|}
				)
				[| {|get_tgt,set_tgt,terminate|} |]
				Memory_tgt((FireStatus_NoFire,0,0,0))
			)\{|get_tgt,set_tgt|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_tgt(tgt) =
		get_tgt!tgt -> Memory_tgt(tgt)
		[]
		set_tgt?x__ -> Memory_tgt(x__)
		[]
		terminate -> SKIP
	Memory_wm(wm) =
		get_wm!wm -> Memory_wm(wm)
		[]
		set_wm?x__ -> Memory_wm(x__)
		[]
		terminate -> SKIP
	Memory_movement(movement) =
		get_movement!movement -> Memory_movement(movement)
		[]
		set_movement?x__ -> Memory_movement(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = Memory_tgt((FireStatus_NoFire,0,0,0))
	[| { terminate } |] (
	Memory_wm((0,0,0))
	[| { terminate } |] (
	Memory_movement((0,0,0,0))
	)
	)
	
	getsetLocalChannels = {|get_tgt,set_tgt,get_wm,set_wm,get_movement,set_movement|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = STM_VS_O(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST)
	
	D__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = STM(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) \ internal_events
	O__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = sbisim(diamond(D__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST)))
	VS__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = FVS__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST)
	VS_O__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = sbisim(diamond(FVS__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST)))
	HEXT__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = O__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = O__(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_VisualNav_TRACK_DIST,
			    const_VisualNav_SCAN_DIST) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
module GimbalAim
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I|
	              NID_Waiting|
	              NID_Calculate|
	              NID_Yaw|
	              NID_Pitch|
	              NID_IsValid|
	              NID_Clamp|
	              NID_MaybeAimed
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_tgt, set_tgt, setL_tgt, setR_tgt: FireTarget
	channel get_yaw, set_yaw, setL_yaw, setR_yaw: core_nat
	channel get_pitch, set_pitch, setL_pitch, setR_pitch: core_nat
	channel get_tracking, set_tracking, setL_tracking, setR_tracking: core_boolean
	channel get_cYaw, set_cYaw, setL_cYaw, setR_cYaw: core_nat
	channel get_cPitch, set_cPitch, setL_cPitch, setR_cPitch: core_nat
	channel get_YAW_DEAD_ZONE, set_YAW_DEAD_ZONE, setL_YAW_DEAD_ZONE, setR_YAW_DEAD_ZONE: core_nat
	channel get_PITCH_DEAD_ZONE, set_PITCH_DEAD_ZONE, setL_PITCH_DEAD_ZONE, setR_PITCH_DEAD_ZONE: core_nat
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel fgSeenFire__: NIDS.InOut.FireTarget
	channel fgSeenFire: InOut.FireTarget
	channel gimbalYaw__: NIDS.InOut.core_nat
	channel gimbalYaw: InOut.core_nat
	channel gimbalPitch__: NIDS.InOut.core_nat
	channel gimbalPitch: InOut.core_nat
	channel gimbalYawAck__: NIDS.InOut
	channel gimbalYawAck: InOut
	channel gimbalPitchAck__: NIDS.InOut
	channel gimbalPitchAck: InOut
	channel gimbalAimed__: NIDS.InOut
	channel gimbalAimed: InOut
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	I::enter,
	Waiting::enter,
	Calculate::enter,
	Yaw::enter,
	Pitch::enter,
	IsValid::enter,
	Clamp::enter,
	MaybeAimed::enter
	|}
	
	enteredSS = 	{|
	Waiting::entered,
	Calculate::entered,
	Yaw::entered,
	Pitch::entered,
	Clamp::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	fgSeenFire,
		gimbalYaw,
		gimbalPitch,
		gimbalYawAck,
		gimbalPitchAck,
		gimbalAimed
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I
	module I
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_GimbalAim_TRACK_DIST) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_GimbalAim_TRACK_DIST) = D__(id__,
				    const_GimbalAim_TRACK_DIST)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Waiting
	module Waiting
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_GimbalAim_TRACK_DIST) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_GimbalAim_TRACK_DIST) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Calculate
