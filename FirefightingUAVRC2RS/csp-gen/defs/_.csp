	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Junction: IsValid
	module IsValid
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_GimbalAim_TRACK_DIST) = 
