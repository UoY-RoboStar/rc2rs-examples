						 		   GoHome::VS_O__(id__,
						 		   		    const_Planning_WALL_LOC,
						 		   		    const_Planning_FIRE_TO,
						 		   		    const_Planning_INIT_TO)
						 		   [| { share__, terminate } |] (
						 		   Land::VS_O__(id__,
						 		   		    const_Planning_WALL_LOC,
						 		   		    const_Planning_FIRE_TO,
						 		   		    const_Planning_INIT_TO)
						 		   [| { share__, terminate } |] (
						 		   Disarm::VS_O__(id__,
						 		   		    const_Planning_WALL_LOC,
						 		   		    const_Planning_FIRE_TO,
						 		   		    const_Planning_INIT_TO)
						 		   )
						 		   )
						 		   )
						 		   )
						 		   )
						 		 )
						 		 [[TakeOffAndClimb::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_TakeOffAndClimb|}]]
						 		 [[Mission::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Mission,batteryLow__.NID_Mission.in,waterEmpty__.NID_Mission.in|}]]
						 		 [[GoHome::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_GoHome|}]]
						 		 [[Land::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Land|}]]
						 		 [[Disarm::interrupt <- x__ | x__ <- {|interrupt|}]]
						 		 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 		 )
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 		  [[set_searchComplete <- setL_searchComplete,set_astatus <- setL_astatus]]
						 		 )
						 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 		 			,setL_searchComplete
						 		 			,setL_astatus
						 		|}) |]
						 		 ((I::enter -> Transitions(id__,
						 		 		    const_Planning_WALL_LOC,
						 		 		    const_Planning_FIRE_TO,
						 		 		    const_Planning_INIT_TO))
						 		  [[ share__ <- x__ | x__ <- {| share__,setL_searchComplete,setL_astatus |} ]]
						 		 )
						 		)[[setL_searchComplete <- set_searchComplete,setL_astatus <- set_astatus]]
						 		)
						 	)
						 	 \ hideSet)
						 	[[
						 		missionStatus__.x____ <- missionStatus,
						 		startSpray__.x____ <- startSpray,
						 		stopSpray__.x____ <- stopSpray,
						 		waterEmpty__.x____ <- waterEmpty,
						 		fireDetected__.x____ <- fireDetected,
						 		fireLost__.x____ <- fireLost,
						 		trackingGained__.x____ <- trackingGained,
						 		trackingLost__.x____ <- trackingLost,
						 		navCommand__.x____ <- navCommand,
						 		waypoint__.x____ <- waypoint,
						 		uavStatus__.x____ <- uavStatus,
						 		batteryLow__.x____ <- batteryLow,
						 		gimbalAimed__.x____ <- gimbalAimed,
						 		vnavEnable__.x____ <- vnavEnable,
						 		vnavDisable__.x____ <- vnavDisable
						 		| x____ <- NIDS
						 	]]
						 )
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_searchComplete,setR_astatus |} ]] 
						  [[set_searchComplete <- setL_searchComplete,set_astatus <- setL_astatus]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_searchComplete
						 			,setL_astatus
						 			,setR_searchComplete
						 			 			,setR_astatus
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_searchComplete,setL_astatus |} ]]
						  [[set_searchComplete <- setR_searchComplete,set_astatus <- setR_astatus]]
						 )
						)[[setL_searchComplete <- set_searchComplete,setL_astatus <- set_astatus]]
						 [[setR_searchComplete <- set_searchComplete,setR_astatus <- set_astatus]]
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = ((let
					Trans = share__choice(get_searchComplete?searchComplete -> get_astatus?astatus -> (
						((share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; TakeOffAndClimb::enter -> SKIP))))
						 	 [] dbisim(((astatus==AircraftStatus_AtAltitude))&(internal__!NID_TakeOffAndClimb -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Mission::enter -> SKIP)))
						 	 [] dbisim((searchComplete)&(internal__!NID_Mission -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_SearchComplete -> SKIP)) ; GoHome::enter -> SKIP)))
						 	 [] dbisim(((astatus==AircraftStatus_AtHome))&(internal__!NID_GoHome -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Land::enter -> SKIP)))
						 	 [] dbisim(((astatus==AircraftStatus_Landed))&(internal__!NID_Land -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Disarm::enter -> SKIP)))
						 	 [] dbisim((true)&(batteryLow__!NID_Mission.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_BatteryError -> SKIP)) ; GoHome::enter -> SKIP)))
						 	 [] dbisim((true)&(waterEmpty__!NID_Mission.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_WaterError -> SKIP)) ; GoHome::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
					)
				within
					Trans
				)
				)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Final state: SwitchedOff
			module SwitchedOff
			
			exports
			
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
				--	Rule: behaviours(Node)
				D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
						
						Entering 	= entered -> SKIP ; Active
						Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
						Interrupted	= share__choice(exit -> exited -> Inactive)
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO)
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			
			CALL__search(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) = (OP_search::O__(id__))
			-- END of Operation calls --
			
			-- STM processes
			STM(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO))
			)\sharedVarHide
			
			STM_VS_O(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful_VS_O(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) = ((let
				Trans = share__choice(get_astatus?astatus -> (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Connect::enter -> SKIP))))
					 	 [] dbisim(((astatus==AircraftStatus_Connected))&(internal__!NID_Connect -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_Connected -> SKIP)) ; Connected::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_Connect -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_ConnectTimeout -> SKIP)) ; SwitchedOff::enter -> SKIP)))
					 	 [] dbisim(((astatus==AircraftStatus_Disarmed))&(internal__!NID_Connected -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; SwitchedOff::enter -> SKIP)))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) = 
				dbisim((
				let
					finalNodesEntered = {|SwitchedOff::entered|}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						I::enter,
