		--	Rule: behaviours(Node)
		D__(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO) = D__(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__search(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) 	= searchCall -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = ((let
		Trans = share__choice(get_astatus?astatus -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Connect::enter -> SKIP))))
			 	 [] dbisim(((astatus==AircraftStatus_Connected))&(internal__!NID_Connect -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_Connected -> SKIP)) ; Connected::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Connect -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_ConnectTimeout -> SKIP)) ; SwitchedOff::enter -> SKIP)))
			 	 [] dbisim(((astatus==AircraftStatus_Disarmed))&(internal__!NID_Connected -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; SwitchedOff::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		dbisim((
		let
			finalNodesEntered = {|SwitchedOff::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Connect::enter,
				Connected::enter,
				SwitchedOff::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,internal__.NID_Connect,internal__.NID_Connect,internal__.NID_Connected|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::D__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   Connect::D__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   Connected::D__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   SwitchedOff::D__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   )
					   )
					   )
					 )
					 [[Connect::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Connect,internal__.NID_Connect|}]]
					 [[Connected::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Connected|}]]
					 [[SwitchedOff::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_astatus <- setL_astatus]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_astatus
					|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_Planning_WALL_LOC,
					 		    const_Planning_FIRE_TO,
					 		    const_Planning_INIT_TO))
					  [[ share__ <- x__ | x__ <- {| share__,setL_astatus |} ]]
					 )
					)[[setL_astatus <- set_astatus]]
					)
				)
				 \ hideSet)
				[[
					missionStatus__.x____ <- missionStatus,
					startSpray__.x____ <- startSpray,
					stopSpray__.x____ <- stopSpray,
					waterEmpty__.x____ <- waterEmpty,
					fireDetected__.x____ <- fireDetected,
					fireLost__.x____ <- fireLost,
					trackingGained__.x____ <- trackingGained,
					trackingLost__.x____ <- trackingLost,
					navCommand__.x____ <- navCommand,
					waypoint__.x____ <- waypoint,
					uavStatus__.x____ <- uavStatus,
					batteryLow__.x____ <- batteryLow,
					gimbalAimed__.x____ <- gimbalAimed,
					vnavEnable__.x____ <- vnavEnable,
					vnavDisable__.x____ <- vnavDisable
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		dbisim((MachineBody(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		dbisim((MachineBody(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO)\ enteredSS)
		)
	
	Stateful(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		((
			(Behaviour(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						Behaviour(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO)
						[| {|get_searchComplete,set_searchComplete,terminate|} |]
						Memory_searchComplete(true)
					)\{|get_searchComplete,set_searchComplete|}
				)
				[| {|get_astatus,set_astatus,terminate|} |]
				Memory_astatus(AircraftStatus_Connected)
			)\{|get_astatus,set_astatus|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		dbisim((
		let
			finalNodesEntered = {|SwitchedOff::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Connect::enter,
				Connected::enter,
				SwitchedOff::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,internal__.NID_Connect,internal__.NID_Connect,internal__.NID_Connected|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   Connect::VS_O__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   Connected::VS_O__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   SwitchedOff::VS_O__(id__,
					   		    const_Planning_WALL_LOC,
					   		    const_Planning_FIRE_TO,
					   		    const_Planning_INIT_TO)
					   )
					   )
					   )
					 )
					 [[Connect::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Connect,internal__.NID_Connect|}]]
					 [[Connected::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Connected|}]]
					 [[SwitchedOff::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_astatus <- setL_astatus]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_astatus
					|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_Planning_WALL_LOC,
					 		    const_Planning_FIRE_TO,
					 		    const_Planning_INIT_TO))
					  [[ share__ <- x__ | x__ <- {| share__,setL_astatus |} ]]
					 )
					)[[setL_astatus <- set_astatus]]
					)
				)
				 \ hideSet)
				[[
					missionStatus__.x____ <- missionStatus,
					startSpray__.x____ <- startSpray,
					stopSpray__.x____ <- stopSpray,
					waterEmpty__.x____ <- waterEmpty,
					fireDetected__.x____ <- fireDetected,
					fireLost__.x____ <- fireLost,
					trackingGained__.x____ <- trackingGained,
					trackingLost__.x____ <- trackingLost,
					navCommand__.x____ <- navCommand,
					waypoint__.x____ <- waypoint,
					uavStatus__.x____ <- uavStatus,
					batteryLow__.x____ <- batteryLow,
					gimbalAimed__.x____ <- gimbalAimed,
					vnavEnable__.x____ <- vnavEnable,
					vnavDisable__.x____ <- vnavDisable
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		dbisim((MachineBody_VS_O(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		dbisim((MachineBody_VS_O(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO))
		)
	
	Stateful_VS_O(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						Behaviour_VS_O(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO)
						[| {|get_searchComplete,set_searchComplete,terminate|} |]
						Memory_searchComplete(true)
					)\{|get_searchComplete,set_searchComplete|}
				)
				[| {|get_astatus,set_astatus,terminate|} |]
				Memory_astatus(AircraftStatus_Connected)
			)\{|get_astatus,set_astatus|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_astatus(astatus) =
		get_astatus!astatus -> Memory_astatus(astatus)
		[]
		set_astatus?x__ -> Memory_astatus(x__)
		[]
		terminate -> SKIP
	Memory_searchComplete(searchComplete) =
		get_searchComplete!searchComplete -> Memory_searchComplete(searchComplete)
		[]
		set_searchComplete?x__ -> Memory_searchComplete(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = Memory_astatus(AircraftStatus_Connected)
	[| { terminate } |] (
	Memory_searchComplete(true)
	)
	
	getsetLocalChannels = {|get_astatus,set_astatus,get_searchComplete,set_searchComplete|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = STM_VS_O(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO)
	
	D__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = STM(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) \ internal_events
	O__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = sbisim(diamond(D__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO)))
	VS__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = FVS__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO)
	VS_O__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = sbisim(diamond(FVS__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO)))
	HEXT__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = O__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = O__(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_Planning_WALL_LOC,
			    const_Planning_FIRE_TO,
			    const_Planning_INIT_TO) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
module FireDetect
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I|
	              NID_Idle|
	              NID_Superimpose|
	              NID_CheckFire|
	              NID_CheckWall
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_fp, set_fp, setL_fp, setR_fp: FireTarget
	channel get_fs, set_fs, setL_fs, setR_fs: FireStatus
	channel get_wm, set_wm, setL_wm, setR_wm: WallMetrics
	channel get_checkDone, set_checkDone, setL_checkDone, setR_checkDone: core_boolean
	channel get_gotD, set_gotD, setL_gotD, setR_gotD: core_boolean
	channel get_gotH, set_gotH, setL_gotH, setR_gotH: core_boolean
	channel get_gotR, set_gotR, setL_gotR, setR_gotR: core_boolean
	channel get_rgb, set_rgb, setL_rgb, setR_rgb: RgbFrame
	channel get_d, set_d, setL_d, setR_d: Frame
	channel get_t, set_t, setL_t, setR_t: Frame
	channel get_super, set_super, setL_super, setR_super: SuperimposedFrame
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel mlxHeatmap__: NIDS.InOut.Frame
	channel mlxHeatmap: InOut.Frame
	channel rsDepthFrame__: NIDS.InOut.Frame
	channel rsDepthFrame: InOut.Frame
	channel rsRgbFrame__: NIDS.InOut.RgbFrame
	channel rsRgbFrame: InOut.RgbFrame
	channel wallMetrics__: NIDS.InOut.WallMetrics
	channel wallMetrics: InOut.WallMetrics
	channel fvSeenFire__: NIDS.InOut.FireTarget
	channel fvSeenFire: InOut.FireTarget
	channel fgSeenFire__: NIDS.InOut.FireTarget
	channel fgSeenFire: InOut.FireTarget
	channel fireDetected__: NIDS.InOut
	channel fireDetected: InOut
	channel fireLost__: NIDS.InOut
	channel fireLost: InOut
	channel trackingGained__: NIDS.InOut
	channel trackingGained: InOut
	channel trackingLost__: NIDS.InOut
	channel trackingLost: InOut
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	I::enter,
	Idle::enter,
	Superimpose::enter,
	CheckFire::enter,
	CheckWall::enter
	|}
	
	enteredSS = 	{|
	Idle::entered,
	Superimpose::entered,
	CheckFire::entered,
	CheckWall::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	mlxHeatmap,
		rsDepthFrame,
		rsRgbFrame,
		wallMetrics,
		fvSeenFire,
		fgSeenFire,
		fireDetected,
		fireLost,
		trackingGained,
		trackingLost
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I
	module I
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_FireDetect_LEFT_X,
				    const_FireDetect_CENTRE_X,
				    const_FireDetect_RIGHT_X,
				    const_FireDetect_CENTRE_Y) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_FireDetect_LEFT_X,
				    const_FireDetect_CENTRE_X,
				    const_FireDetect_RIGHT_X,
				    const_FireDetect_CENTRE_Y) = D__(id__,
				    const_FireDetect_LEFT_X,
				    const_FireDetect_CENTRE_X,
				    const_FireDetect_RIGHT_X,
				    const_FireDetect_CENTRE_Y)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Idle
	module Idle
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_FireDetect_LEFT_X,
				    const_FireDetect_CENTRE_X,
				    const_FireDetect_RIGHT_X,
				    const_FireDetect_CENTRE_Y) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
