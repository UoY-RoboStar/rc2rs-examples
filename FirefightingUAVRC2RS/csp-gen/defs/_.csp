	Stateful_VS_O(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
					    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
					    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
						    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)
				[| {|get_battery,set_battery,terminate|} |]
				Memory_battery((0))
			)\{|get_battery,set_battery|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_battery(battery) =
		get_battery!battery -> Memory_battery(battery)
		[]
		set_battery?x__ -> Memory_battery(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = Memory_battery((0))
	
	getsetLocalChannels = {|get_battery,set_battery|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = STM_VS_O(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)
	
	D__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = STM(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) \ internal_events
	O__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = sbisim(diamond(D__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)))
	VS__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = FVS__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)
	VS_O__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = sbisim(diamond(FVS__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)))
	HEXT__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = O__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = O__(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
			    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
module Aim
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I|
	              NID_Waiting|
	              NID_SetYaw|
	              NID_SetPitch
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_angle, set_angle, setL_angle, setR_angle: core_nat
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel gimbalYaw__: NIDS.InOut.core_nat
	channel gimbalYaw: InOut.core_nat
	channel gimbalPitch__: NIDS.InOut.core_nat
	channel gimbalPitch: InOut.core_nat
	channel gimbalYawAck__: NIDS.InOut
	channel gimbalYawAck: InOut
	channel gimbalPitchAck__: NIDS.InOut
	channel gimbalPitchAck: InOut
	
	-- Declaring call and ret events for undefined operations
	channel gimbalWritePanCall: core_int
	channel gimbalWriteTiltCall: core_int
	
	enterSS = {|
	I::enter,
	Waiting::enter,
	SetYaw::enter,
	SetPitch::enter
	|}
	
	enteredSS = 	{|
	Waiting::entered,
	SetYaw::entered,
	SetPitch::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	gimbalYaw,
		gimbalPitch,
		gimbalYawAck,
		gimbalPitchAck
	,	gimbalWritePanCall,
		gimbalWriteTiltCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I
	module I
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = D__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Waiting
	module Waiting
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: SetYaw
	module SetYaw
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_angle?angle -> true&CALL__gimbalWritePan(
						id__,
					    const_Aim_GIMBAL_FLOOD_DELAY,
						angle
					));SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_angle?angle -> true&CALL__gimbalWritePan(
						id__,
					    const_Aim_GIMBAL_FLOOD_DELAY,
						angle
					));SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: SetPitch
	module SetPitch
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_angle?angle -> true&CALL__gimbalWriteTilt(
						id__,
					    const_Aim_GIMBAL_FLOOD_DELAY,
						angle
					));SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_angle?angle -> true&CALL__gimbalWriteTilt(
						id__,
					    const_Aim_GIMBAL_FLOOD_DELAY,
						angle
					));SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__gimbalWritePan(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY,
				param_angle) 	= gimbalWritePanCall.param_angle -> SKIP
	CALL__gimbalWriteTilt(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY,
				param_angle) 	= gimbalWriteTiltCall.param_angle -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_Aim_GIMBAL_FLOOD_DELAY) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_Aim_GIMBAL_FLOOD_DELAY) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
			 	 [] dbisim((true)&(gimbalYaw__!NID_Waiting.in?angle:{angle|angle <- core_nat, true} -> share__choice(set_angle!angle -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; SetYaw::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_SetYaw -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(gimbalYawAck.out -> SKIP)) ; Waiting::enter -> SKIP)))
			 	 [] dbisim((true)&(gimbalPitch__!NID_Waiting.in?angle:{angle|angle <- core_nat, true} -> share__choice(set_angle!angle -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; SetPitch::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_SetPitch -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(gimbalPitchAck.out -> SKIP)) ; Waiting::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Waiting::enter,
				SetYaw::enter,
				SetPitch::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,gimbalYaw__.NID_Waiting.in,internal__.NID_SetYaw,gimbalPitch__.NID_Waiting.in,internal__.NID_SetPitch|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::D__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   [| { share__, terminate } |] (
					   Waiting::D__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   [| { share__, terminate } |] (
					   SetYaw::D__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   [| { share__, terminate } |] (
					   SetPitch::D__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   )
					   )
					   )
					 )
					 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,gimbalYaw__.NID_Waiting.in,gimbalPitch__.NID_Waiting.in|}]]
					 [[SetYaw::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_SetYaw|}]]
					 [[SetPitch::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_SetPitch|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_angle |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_angle
					 			|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_Aim_GIMBAL_FLOOD_DELAY))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_angle <- setR_angle]]
					 )
					)
					 [[setR_angle <- set_angle]]
					)
				)
				 \ hideSet)
				[[
					gimbalYaw__.x____ <- gimbalYaw,
					gimbalPitch__.x____ <- gimbalPitch,
					gimbalYawAck__.x____ <- gimbalYawAck,
					gimbalPitchAck__.x____ <- gimbalPitchAck
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((MachineBody(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((MachineBody(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY)\ enteredSS)
		)
	
	Stateful(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		((
			(Behaviour(id__,
					    const_Aim_GIMBAL_FLOOD_DELAY) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_Aim_GIMBAL_FLOOD_DELAY))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) =
		(dbisim(
			sbisim(
				Behaviour(id__,
						    const_Aim_GIMBAL_FLOOD_DELAY)
				[| {|get_angle,set_angle,terminate|} |]
				Memory_angle(0)
			)\{|get_angle,set_angle|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Waiting::enter,
				SetYaw::enter,
				SetPitch::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,gimbalYaw__.NID_Waiting.in,internal__.NID_SetYaw,gimbalPitch__.NID_Waiting.in,internal__.NID_SetPitch|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   [| { share__, terminate } |] (
					   Waiting::VS_O__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   [| { share__, terminate } |] (
					   SetYaw::VS_O__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   [| { share__, terminate } |] (
					   SetPitch::VS_O__(id__,
					   		    const_Aim_GIMBAL_FLOOD_DELAY)
					   )
					   )
					   )
					 )
					 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,gimbalYaw__.NID_Waiting.in,gimbalPitch__.NID_Waiting.in|}]]
					 [[SetYaw::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_SetYaw|}]]
					 [[SetPitch::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_SetPitch|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_angle |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_angle
					 			|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_Aim_GIMBAL_FLOOD_DELAY))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_angle <- setR_angle]]
					 )
					)
					 [[setR_angle <- set_angle]]
					)
				)
				 \ hideSet)
				[[
					gimbalYaw__.x____ <- gimbalYaw,
					gimbalPitch__.x____ <- gimbalPitch,
					gimbalYawAck__.x____ <- gimbalYawAck,
					gimbalPitchAck__.x____ <- gimbalPitchAck
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((MachineBody_VS_O(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((MachineBody_VS_O(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY))
		)
	
	Stateful_VS_O(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_Aim_GIMBAL_FLOOD_DELAY) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_Aim_GIMBAL_FLOOD_DELAY))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_Aim_GIMBAL_FLOOD_DELAY)
				[| {|get_angle,set_angle,terminate|} |]
				Memory_angle(0)
			)\{|get_angle,set_angle|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_angle(angle) =
		get_angle!angle -> Memory_angle(angle)
		[]
		set_angle?x__ -> Memory_angle(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = Memory_angle(0)
	
	getsetLocalChannels = {|get_angle,set_angle|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = STM_VS_O(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY)
	
	D__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = STM(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) \ internal_events
	O__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = sbisim(diamond(D__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY)))
	VS__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = FVS__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY)
	VS_O__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = sbisim(diamond(FVS__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY)))
	HEXT__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = O__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = O__(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_Aim_GIMBAL_FLOOD_DELAY) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
module Spray
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I|
	              NID_Off|
	              NID_On|
	              NID_Out
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel monitorOn__: NIDS.InOut
	channel monitorOn: InOut
	channel monitorOff__: NIDS.InOut
	channel monitorOff: InOut
	channel monitorEmpty__: NIDS.InOut
	channel monitorEmpty: InOut
	channel startSpray__: NIDS.InOut
	channel startSpray: InOut
	channel stopSpray__: NIDS.InOut
	channel stopSpray: InOut
	channel waterEmpty__: NIDS.InOut
	channel waterEmpty: InOut
	
	-- Declaring call and ret events for undefined operations
	channel pumpOffCall
	channel pumpOnCall
	
	enterSS = {|
	I::enter,
	Off::enter,
	On::enter,
	Out::enter
	|}
	
	enteredSS = 	{|
	Off::entered,
	On::entered,
	Out::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	monitorOn,
		monitorOff,
		monitorEmpty,
		startSpray,
		stopSpray,
		waterEmpty
	,	pumpOffCall,
		pumpOnCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I
	module I
	exports
	
		channel enter, interrupt
		
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Off
	module Off
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: On
	module On
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: Out
	module Out
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__pumpOff(id__) 	= pumpOffCall -> SKIP
	CALL__pumpOn(id__) 	= pumpOnCall -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Off::enter -> SKIP))))
			 	 [] dbisim((true)&(startSpray__!NID_Off.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&CALL__pumpOn(
			 			id__
			 		);true&(share__choice(monitorOn.out -> SKIP)) ; On::enter -> SKIP)))
			 	 [] dbisim((true)&(monitorEmpty__!NID_On.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(waterEmpty.out -> SKIP));true&CALL__pumpOff(
			 			id__
			 		) ; Out::enter -> SKIP)))
			 	 [] dbisim((true)&(stopSpray__!NID_On.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(monitorOff.out -> SKIP));true&CALL__pumpOff(
			 			id__
			 		) ; Off::enter -> SKIP)))
			 	 [] dbisim((true)&(monitorEmpty__!NID_Off.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(waterEmpty.out -> SKIP)) ; Out::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {|Out::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Off::enter,
				On::enter,
				Out::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,startSpray__.NID_Off.in,monitorEmpty__.NID_On.in,stopSpray__.NID_On.in,monitorEmpty__.NID_Off.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::D__(id__)
					   [| { share__, terminate } |] (
					   Off::D__(id__)
					   [| { share__, terminate } |] (
					   On::D__(id__)
					   [| { share__, terminate } |] (
					   Out::D__(id__)
					   )
					   )
					   )
					 )
					 [[Off::interrupt <- x__ | x__ <- {|interrupt,startSpray__.NID_Off.in,monitorEmpty__.NID_Off.in|}]]
					 [[On::interrupt <- x__ | x__ <- {|interrupt,monitorEmpty__.NID_On.in,stopSpray__.NID_On.in|}]]
					 [[Out::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((I::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					monitorOn__.x____ <- monitorOn,
					monitorOff__.x____ <- monitorOff,
					monitorEmpty__.x____ <- monitorEmpty,
					startSpray__.x____ <- startSpray,
					stopSpray__.x____ <- stopSpray,
					waterEmpty__.x____ <- waterEmpty
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	Stateful(id__) = 
		((
			(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__) =
		(Behaviour(id__))
	
	-- Visible counterparts
	MachineBody_VS_O(id__) = 
		dbisim((
		let
			finalNodesEntered = {|Out::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Off::enter,
				On::enter,
				Out::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,startSpray__.NID_Off.in,monitorEmpty__.NID_On.in,stopSpray__.NID_On.in,monitorEmpty__.NID_Off.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__)
					   [| { share__, terminate } |] (
					   Off::VS_O__(id__)
					   [| { share__, terminate } |] (
					   On::VS_O__(id__)
					   [| { share__, terminate } |] (
					   Out::VS_O__(id__)
					   )
					   )
					   )
					 )
					 [[Off::interrupt <- x__ | x__ <- {|interrupt,startSpray__.NID_Off.in,monitorEmpty__.NID_Off.in|}]]
					 [[On::interrupt <- x__ | x__ <- {|interrupt,monitorEmpty__.NID_On.in,stopSpray__.NID_On.in|}]]
					 [[Out::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((I::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					monitorOn__.x____ <- monitorOn,
					monitorOff__.x____ <- monitorOff,
					monitorEmpty__.x____ <- monitorEmpty,
					startSpray__.x____ <- startSpray,
					stopSpray__.x____ <- stopSpray,
					waterEmpty__.x____ <- waterEmpty
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	IteratedBehaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	Stateful_VS_O(id__) = 
		dbisim((
			(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__) =
		(Behaviour_VS_O(id__))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__) = STM_VS_O(id__)
	
	D__(id__) = STM(id__) \ internal_events
	O__(id__) = sbisim(diamond(D__(id__)))
	VS__(id__) = FVS__(id__)
	VS_O__(id__) = sbisim(diamond(FVS__(id__)))
	HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
	HUP__(id__) = O__(id__) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
module WaterMonitor
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I|
	              NID_Off|
	              NID_On|
	              NID_F
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_water, set_water, setL_water, setR_water: core_real
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel monitorOn__: NIDS.InOut
	channel monitorOn: InOut
	channel monitorOff__: NIDS.InOut
	channel monitorOff: InOut
	channel monitorEmpty__: NIDS.InOut
	channel monitorEmpty: InOut
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	I::enter,
	Off::enter,
	On::enter,
	F::enter
	|}
	
	enteredSS = 	{|
	Off::entered,
	On::entered,
	F::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	monitorOn,
		monitorOff,
		monitorEmpty
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I
	module I
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Off
	module Off
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: On
	module On
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: F
	module F
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_WaterMonitor_WATER_FLOW,
						    const_WaterMonitor_TIME_PER_UNIT) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_WaterMonitor_WATER_FLOW,
						    const_WaterMonitor_TIME_PER_UNIT) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = ((let
		Trans = share__choice(get_water?water -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Off::enter -> SKIP))))
			 	 [] dbisim(((0<water))&(monitorOn__!NID_Off.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; On::enter -> SKIP)))
			 	 [] dbisim((true)&(monitorOff__!NID_On.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Off::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_On -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(share__choice(get_water?water -> true & (share__choice(set_water!Minus(water, const_WaterMonitor_WATER_FLOW, core_real) -> SKIP)))) ; On::enter -> SKIP)))
			 	 [] dbisim(((water<=0))&(internal__!NID_On -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(monitorEmpty.out -> SKIP)) ; F::enter -> SKIP)))
			 	 [] dbisim(((water<=0))&(internal__!NID_Off -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(monitorEmpty.out -> SKIP)) ; F::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim((
		let
			finalNodesEntered = {|F::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Off::enter,
				On::enter,
				F::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,monitorOn__.NID_Off.in,monitorOff__.NID_On.in,internal__.NID_On,internal__.NID_On,internal__.NID_Off|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::D__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   [| { share__, terminate } |] (
					   Off::D__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   [| { share__, terminate } |] (
					   On::D__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   [| { share__, terminate } |] (
					   F::D__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   )
					   )
					   )
					 )
					 [[Off::interrupt <- x__ | x__ <- {|interrupt,monitorOn__.NID_Off.in,internal__.NID_Off|}]]
					 [[On::interrupt <- x__ | x__ <- {|interrupt,monitorOff__.NID_On.in,internal__.NID_On,internal__.NID_On|}]]
					 [[F::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_water <- setL_water]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_water
					|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_WaterMonitor_WATER_FLOW,
					 		    const_WaterMonitor_TIME_PER_UNIT))
					  [[ share__ <- x__ | x__ <- {| share__,setL_water |} ]]
					 )
					)[[setL_water <- set_water]]
					)
				)
				 \ hideSet)
				[[
					monitorOn__.x____ <- monitorOn,
					monitorOff__.x____ <- monitorOff,
					monitorEmpty__.x____ <- monitorEmpty
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim((MachineBody(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim((MachineBody(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT)\ enteredSS)
		)
	
	Stateful(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		((
			(Behaviour(id__,
					    const_WaterMonitor_WATER_FLOW,
					    const_WaterMonitor_TIME_PER_UNIT) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_WaterMonitor_WATER_FLOW,
					    const_WaterMonitor_TIME_PER_UNIT))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) =
		(dbisim(
			sbisim(
				Behaviour(id__,
						    const_WaterMonitor_WATER_FLOW,
						    const_WaterMonitor_TIME_PER_UNIT)
				[| {|get_water,set_water,terminate|} |]
				Memory_water(1)
			)\{|get_water,set_water|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim((
		let
			finalNodesEntered = {|F::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Off::enter,
				On::enter,
				F::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,monitorOn__.NID_Off.in,monitorOff__.NID_On.in,internal__.NID_On,internal__.NID_On,internal__.NID_Off|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   [| { share__, terminate } |] (
					   Off::VS_O__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   [| { share__, terminate } |] (
					   On::VS_O__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   [| { share__, terminate } |] (
					   F::VS_O__(id__,
					   		    const_WaterMonitor_WATER_FLOW,
					   		    const_WaterMonitor_TIME_PER_UNIT)
					   )
					   )
					   )
					 )
					 [[Off::interrupt <- x__ | x__ <- {|interrupt,monitorOn__.NID_Off.in,internal__.NID_Off|}]]
					 [[On::interrupt <- x__ | x__ <- {|interrupt,monitorOff__.NID_On.in,internal__.NID_On,internal__.NID_On|}]]
					 [[F::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_water <- setL_water]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_water
					|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_WaterMonitor_WATER_FLOW,
					 		    const_WaterMonitor_TIME_PER_UNIT))
					  [[ share__ <- x__ | x__ <- {| share__,setL_water |} ]]
					 )
					)[[setL_water <- set_water]]
					)
				)
				 \ hideSet)
				[[
					monitorOn__.x____ <- monitorOn,
					monitorOff__.x____ <- monitorOff,
					monitorEmpty__.x____ <- monitorEmpty
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim((MachineBody_VS_O(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim((MachineBody_VS_O(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT))
		)
	
	Stateful_VS_O(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_WaterMonitor_WATER_FLOW,
					    const_WaterMonitor_TIME_PER_UNIT) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_WaterMonitor_WATER_FLOW,
					    const_WaterMonitor_TIME_PER_UNIT))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_WaterMonitor_WATER_FLOW,
						    const_WaterMonitor_TIME_PER_UNIT)
				[| {|get_water,set_water,terminate|} |]
				Memory_water(1)
			)\{|get_water,set_water|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_water(water) =
		get_water!water -> Memory_water(water)
		[]
		set_water?x__ -> Memory_water(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = Memory_water(1)
	
	getsetLocalChannels = {|get_water,set_water|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = STM_VS_O(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT)
	
	D__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = STM(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) \ internal_events
	O__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = sbisim(diamond(D__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT)))
	VS__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = FVS__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT)
	VS_O__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = sbisim(diamond(FVS__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT)))
	HEXT__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = O__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = O__(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_WaterMonitor_WATER_FLOW,
			    const_WaterMonitor_TIME_PER_UNIT) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
module Planning
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I|
	              NID_Connect|
	              NID_Connected|
	              NID_SwitchedOff
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_astatus, set_astatus, setL_astatus, setR_astatus: AircraftStatus
	channel get_searchComplete, set_searchComplete, setL_searchComplete, setR_searchComplete: core_boolean
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel missionStatus__: NIDS.InOut.MissionStatus
	channel missionStatus: InOut.MissionStatus
	channel startSpray__: NIDS.InOut
	channel startSpray: InOut
	channel stopSpray__: NIDS.InOut
	channel stopSpray: InOut
	channel waterEmpty__: NIDS.InOut
	channel waterEmpty: InOut
	channel fireDetected__: NIDS.InOut
	channel fireDetected: InOut
	channel fireLost__: NIDS.InOut
	channel fireLost: InOut
	channel trackingGained__: NIDS.InOut
	channel trackingGained: InOut
	channel trackingLost__: NIDS.InOut
	channel trackingLost: InOut
	channel navCommand__: NIDS.InOut.NavCommand
	channel navCommand: InOut.NavCommand
	channel waypoint__: NIDS.InOut.Position
	channel waypoint: InOut.Position
	channel uavStatus__: NIDS.InOut.AircraftStatus
	channel uavStatus: InOut.AircraftStatus
	channel batteryLow__: NIDS.InOut
	channel batteryLow: InOut
	channel gimbalAimed__: NIDS.InOut
	channel gimbalAimed: InOut
	channel vnavEnable__: NIDS.InOut
	channel vnavEnable: InOut
	channel vnavDisable__: NIDS.InOut
	channel vnavDisable: InOut
	
	-- Declaring call and ret events for undefined operations
	channel searchCall
	
	enterSS = {|
	I::enter,
	Connect::enter,
	Connected::enter,
	SwitchedOff::enter
	|}
	
	enteredSS = 	{|
	Connect::entered,
	Connected::entered,
	SwitchedOff::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	missionStatus,
		startSpray,
		stopSpray,
		waterEmpty,
		fireDetected,
		fireLost,
		trackingGained,
		trackingLost,
		navCommand,
		waypoint,
		uavStatus,
		batteryLow,
		gimbalAimed,
		vnavEnable,
		vnavDisable
	,	searchCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I
	module I
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO) = D__(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO)
	
	endmodule
