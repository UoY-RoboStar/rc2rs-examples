				)[[setL_gotR <- set_gotR,setL_fs <- set_fs,setL_super <- set_super,setL_wm <- set_wm,setL_checkDone <- set_checkDone,setL_fp <- set_fp,setL_gotD <- set_gotD,setL_d <- set_d,setL_gotH <- set_gotH,setL_t <- set_t,setL_rgb <- set_rgb]]
				 [[setR_gotR <- set_gotR,setR_fs <- set_fs,setR_super <- set_super,setR_wm <- set_wm,setR_checkDone <- set_checkDone,setR_fp <- set_fp,setR_gotD <- set_gotD,setR_d <- set_d,setR_gotH <- set_gotH,setR_t <- set_t,setR_rgb <- set_rgb]]
