				  [[set_gotR <- setR_gotR,set_fs <- setR_fs,set_super <- setR_super,set_wm <- setR_wm,set_checkDone <- setR_checkDone,set_fp <- setR_fp,set_gotD <- setR_gotD,set_d <- setR_d,set_gotH <- setR_gotH,set_t <- setR_t,set_rgb <- setR_rgb]]
