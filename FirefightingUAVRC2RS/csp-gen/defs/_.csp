					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_GimbalAim_TRACK_DIST) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_pitch?pitch -> true&(share__choice(gimbalPitch.out!pitch -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: IsValid
			module IsValid
			exports
			
				channel enter, interrupt
				
				D__(id__,
						    const_GimbalAim_TRACK_DIST) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_GimbalAim_TRACK_DIST) = D__(id__,
						    const_GimbalAim_TRACK_DIST)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Clamp
			module Clamp
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_GimbalAim_TRACK_DIST) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(share__choice(get_YAW_DEAD_ZONE?YAW_DEAD_ZONE -> share__choice(get_yaw?yaw -> true & (share__choice(set_cYaw!clamp(yaw,YAW_DEAD_ZONE) -> SKIP)))));share__choice(share__choice(get_PITCH_DEAD_ZONE?PITCH_DEAD_ZONE -> share__choice(get_pitch?pitch -> true & (share__choice(set_cPitch!clamp(pitch,PITCH_DEAD_ZONE) -> SKIP))))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_GimbalAim_TRACK_DIST) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(share__choice(get_YAW_DEAD_ZONE?YAW_DEAD_ZONE -> share__choice(get_yaw?yaw -> true & (share__choice(set_cYaw!clamp(yaw,YAW_DEAD_ZONE) -> SKIP)))));share__choice(share__choice(get_PITCH_DEAD_ZONE?PITCH_DEAD_ZONE -> share__choice(get_pitch?pitch -> true & (share__choice(set_cPitch!clamp(pitch,PITCH_DEAD_ZONE) -> SKIP))))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: MaybeAimed
			module MaybeAimed
			exports
			
				channel enter, interrupt
				
				D__(id__,
						    const_GimbalAim_TRACK_DIST) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_GimbalAim_TRACK_DIST) = D__(id__,
						    const_GimbalAim_TRACK_DIST)
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			
			-- END of Operation calls --
			
			-- STM processes
			STM(id__,
					    const_GimbalAim_TRACK_DIST) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful(id__,
								    const_GimbalAim_TRACK_DIST) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__,
						    const_GimbalAim_TRACK_DIST))
			)\sharedVarHide
			
			STM_VS_O(id__,
					    const_GimbalAim_TRACK_DIST) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful_VS_O(id__,
								    const_GimbalAim_TRACK_DIST) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__,
						    const_GimbalAim_TRACK_DIST))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__,
					    const_GimbalAim_TRACK_DIST) = ((let
				Trans = share__choice(get_yaw?yaw -> get_tgt?tgt -> get_cPitch?cPitch -> get_cYaw?cYaw -> get_pitch?pitch -> (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((share__choice(share__choice(get_tgt?tgt -> true & (share__choice(set_tgt!update_FireTarget_status(tgt,FireStatus_NoFire) -> SKIP)))) ; Waiting::enter -> SKIP))))
					 	 [] dbisim((true)&(fgSeenFire__!NID_Waiting.in?tgt:{tgt|tgt <- FireTarget, true} -> share__choice(set_tgt!tgt -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; IsValid::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_Calculate -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Clamp::enter -> SKIP)))
					 	 [] dbisim((true)&(gimbalYawAck__!NID_Yaw.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Pitch::enter -> SKIP)))
					 	 [] dbisim((true)&(gimbalPitchAck__!NID_Pitch.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; MaybeAimed::enter -> SKIP)))
					 	 [] dbisim(((FireTarget_status(tgt)==FireStatus_Tracked))&(internal__!NID_IsValid -> SKIP ;  ((SKIP ; Calculate::enter -> SKIP))))
					 	 [] dbisim(((FireTarget_status(tgt)!=FireStatus_Tracked))&(internal__!NID_IsValid -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_Clamp -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Yaw::enter -> SKIP)))
					 	 [] dbisim((((cYaw==yaw) and (cPitch==pitch)))&(internal__!NID_MaybeAimed -> SKIP ;  ((true&(share__choice(gimbalAimed.out -> SKIP)) ; Waiting::enter -> SKIP))))
					 	 [] dbisim((((cYaw!=yaw) or (cPitch!=pitch)))&(internal__!NID_MaybeAimed -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__,
					    const_GimbalAim_TRACK_DIST) = 
