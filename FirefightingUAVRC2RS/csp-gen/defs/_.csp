module Flight
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I|
	              NID_Connect|
	              NID_Waiting|
	              NID_ProcessingCommand|
	              NID_Waypoint|
	              NID_Relative|
	              NID_TakingOff|
	              NID_Climbing|
	              NID_GoHome|
	              NID_BackToStart|
	              NID_Landing|
	              NID_Disarmed|
	              NID_GoingHome
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_h, set_h, setL_h, setR_h: core_real
	channel get_cmd, set_cmd, setL_cmd, setR_cmd: NavCommand
	channel get_vp, set_vp, setL_vp, setR_vp: RelativeMotion
	channel get_wp, set_wp, setL_wp, setR_wp: Position
	channel get_start, set_start, setL_start, setR_start: Position
	channel get_gotStart, set_gotStart, setL_gotStart, setR_gotStart: core_boolean
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel fcControlAuth__: NIDS.InOut
	channel fcControlAuth: InOut
	channel fcTakeoffRet__: NIDS.InOut
	channel fcTakeoffRet: InOut
	channel fcGoHomeRet__: NIDS.InOut
	channel fcGoHomeRet: InOut
	channel fcLandRet__: NIDS.InOut
	channel fcLandRet: InOut
	channel fcWaypointFinishedMission__: NIDS.InOut
	channel fcWaypointFinishedMission: InOut
	channel fcMoveRelativeRet__: NIDS.InOut
	channel fcMoveRelativeRet: InOut
	channel navCommand__: NIDS.InOut.NavCommand
	channel navCommand: InOut.NavCommand
	channel waypoint__: NIDS.InOut.Position
	channel waypoint: InOut.Position
	channel uavStatus__: NIDS.InOut.AircraftStatus
	channel uavStatus: InOut.AircraftStatus
	channel visualPosition__: NIDS.InOut.RelativeMotion
	channel visualPosition: InOut.RelativeMotion
	
	-- Declaring call and ret events for undefined operations
	channel fcMoveRelativeCallCall: RelativeMotion
	channel fcTakeoffCallCall
	channel fcLandCallCall
	channel fcGoHomeCallCall
	channel fcWaypointCallCall: Position
	
	enterSS = {|
	I::enter,
	Connect::enter,
	Waiting::enter,
	ProcessingCommand::enter,
	Waypoint::enter,
	Relative::enter,
	TakingOff::enter,
	Climbing::enter,
	GoHome::enter,
	BackToStart::enter,
	Landing::enter,
	Disarmed::enter,
	GoingHome::enter
	|}
	
	enteredSS = 	{|
	Connect::entered,
	Waiting::entered,
	Waypoint::entered,
	Relative::entered,
	TakingOff::entered,
	Climbing::entered,
	BackToStart::entered,
	Landing::entered,
	Disarmed::entered,
	GoingHome::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	fcControlAuth,
		fcTakeoffRet,
		fcGoHomeRet,
		fcLandRet,
		fcWaypointFinishedMission,
		fcMoveRelativeRet,
		navCommand,
		waypoint,
		uavStatus,
		visualPosition
