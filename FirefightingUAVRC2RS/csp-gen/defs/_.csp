																						    const_GimbalAim_TRACK_DIST)
																				[| {|get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE,terminate|} |]
																				Memory_PITCH_DEAD_ZONE(0)
																			)\{|get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE|}
																		)
																		[| {|get_YAW_DEAD_ZONE,set_YAW_DEAD_ZONE,terminate|} |]
																		Memory_YAW_DEAD_ZONE(0)
