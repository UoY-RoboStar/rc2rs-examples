				 )
				  [[ share__ <- x__ | x__ <- {| share__,setR_searchComplete,setR_astatus |} ]] 
				  [[set_searchComplete <- setL_searchComplete,set_astatus <- setL_astatus]]
				 )
				 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
				 			,setL_searchComplete
				 			,setL_astatus
				 			,setR_searchComplete
				 			 			,setR_astatus
				 			|}) |]
				 ((During)
				  [[ share__ <- x__ | x__ <- {| share__,setL_searchComplete,setL_astatus |} ]]
				  [[set_searchComplete <- setR_searchComplete,set_astatus <- setR_astatus]]
				 )
				)[[setL_searchComplete <- set_searchComplete,setL_astatus <- set_astatus]]
				 [[setR_searchComplete <- set_searchComplete,setR_astatus <- set_astatus]]
				)\union(enteredSS,{terminate}) 
