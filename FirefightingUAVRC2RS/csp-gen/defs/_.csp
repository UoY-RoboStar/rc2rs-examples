	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Clamp
	module Clamp
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_GimbalAim_TRACK_DIST) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(share__choice(get_YAW_DEAD_ZONE?YAW_DEAD_ZONE -> share__choice(get_yaw?yaw -> true & (share__choice(set_cYaw!clamp(yaw,YAW_DEAD_ZONE) -> SKIP)))));share__choice(share__choice(get_PITCH_DEAD_ZONE?PITCH_DEAD_ZONE -> share__choice(get_pitch?pitch -> true & (share__choice(set_cPitch!clamp(pitch,PITCH_DEAD_ZONE) -> SKIP))))) ; 
					 	  Behaviour ; 
