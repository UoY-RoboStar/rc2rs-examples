			 	 [] dbisim((true)&(fgSeenFire__!NID_Waiting.in?tgt:{tgt|tgt <- FireTarget, true} -> share__choice(set_tgt!tgt -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; IsValid::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Calculate -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Clamp::enter -> SKIP)))
