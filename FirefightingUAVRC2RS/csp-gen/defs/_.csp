					 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
		within
			Inactive [| {terminate} |> SKIP)
		
		Transitions(id__,
				    const_Planning_WALL_LOC,
				    const_Planning_FIRE_TO,
				    const_Planning_INIT_TO) = ((let
			Trans = share__choice(get_searchComplete?searchComplete -> get_astatus?astatus -> (
				((share__ -> SKIP
				 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; TakeOffAndClimb::enter -> SKIP))))
				 	 [] dbisim(((astatus==AircraftStatus_AtAltitude))&(internal__!NID_TakeOffAndClimb -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Mission::enter -> SKIP)))
				 	 [] dbisim((searchComplete)&(internal__!NID_Mission -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_SearchComplete -> SKIP)) ; GoHome::enter -> SKIP)))
				 	 [] dbisim(((astatus==AircraftStatus_AtHome))&(internal__!NID_GoHome -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Land::enter -> SKIP)))
				 	 [] dbisim(((astatus==AircraftStatus_Landed))&(internal__!NID_Land -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Disarm::enter -> SKIP)))
				 	 [] dbisim((true)&(batteryLow__!NID_Mission.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_BatteryError -> SKIP)) ; GoHome::enter -> SKIP)))
				 	 [] dbisim((true)&(waterEmpty__!NID_Mission.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(missionStatus.out!MissionStatus_WaterError -> SKIP)) ; GoHome::enter -> SKIP)))
				 ) ; Trans)
				 []
				 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
				 []
				 terminate -> SKIP
			)
			)
		within
			Trans
		)
		)
		
	
	endmodule
