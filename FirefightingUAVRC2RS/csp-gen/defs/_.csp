		Transitions(id__,
				    const_FireDetect_LEFT_X,
				    const_FireDetect_CENTRE_X,
				    const_FireDetect_RIGHT_X,
				    const_FireDetect_CENTRE_Y) = ((let
			Trans = share__choice(get_fs?fs -> (
				((share__ -> SKIP
				 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Algorithm::enter -> SKIP))))
				 	 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_Algorithm -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WasNoFire::enter -> SKIP)))
				 	 [] dbisim(((fs==FireStatus_Detected))&(internal__!NID_Algorithm -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WasDetected::enter -> SKIP)))
				 	 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_Algorithm -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WasTracked::enter -> SKIP)))
				 	 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_WasNoFire -> SKIP ;  ((SKIP ; Done::enter -> SKIP))))
				 	 [] dbisim(((fs==FireStatus_Detected))&(internal__!NID_WasDetected -> SKIP ;  ((SKIP ; Done::enter -> SKIP))))
				 	 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_WasTracked -> SKIP ;  ((SKIP ; Done::enter -> SKIP))))
				 	 [] dbisim(((fs!=FireStatus_Tracked))&(internal__!NID_FGain -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
				 	 [] dbisim((true)&(internal__!NID_TGain -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
				 	 [] dbisim(((fs!=FireStatus_NoFire))&(internal__!NID_TLoss -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
				 	 [] dbisim((true)&(internal__!NID_FLoss -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
				 	 [] dbisim(((fs!=FireStatus_NoFire))&(internal__!NID_WasNoFire -> SKIP ;  ((SKIP ; FGain::enter -> SKIP))))
				 	 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_FGain -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TGain::enter -> SKIP)))
				 	 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_WasDetected -> SKIP ;  ((SKIP ; TGain::enter -> SKIP))))
				 	 [] dbisim(((fs!=FireStatus_Tracked))&(internal__!NID_WasTracked -> SKIP ;  ((SKIP ; TLoss::enter -> SKIP))))
				 	 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_TLoss -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FLoss::enter -> SKIP)))
				 	 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_WasDetected -> SKIP ;  ((SKIP ; FLoss::enter -> SKIP))))
				 ) ; Trans)
				 []
				 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
				 []
				 terminate -> SKIP
			)
			)
		within
			Trans
		)
		)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: CheckWall
	module CheckWall
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_FireDetect_LEFT_X,
				    const_FireDetect_CENTRE_X,
				    const_FireDetect_RIGHT_X,
				    const_FireDetect_CENTRE_Y) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(share__choice(get_wm?wm -> true & (share__choice(set_wm!update_WallMetrics_leftDist(wm,1) -> SKIP))));share__choice(share__choice(get_wm?wm -> true & (share__choice(set_wm!update_WallMetrics_centreDist(wm,1) -> SKIP))));share__choice(share__choice(get_wm?wm -> true & (share__choice(set_wm!update_WallMetrics_rightDist(wm,1) -> SKIP))));share__choice(get_wm?wm -> true&(share__choice(wallMetrics.out!wm -> SKIP))) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
