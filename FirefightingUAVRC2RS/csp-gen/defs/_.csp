							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = ((let
						Trans = share__choice(get_astatus?astatus -> (
							((share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; FlyToWall::enter -> SKIP))))
							 	 [] dbisim(((astatus==AircraftStatus_AtWaypoint))&(internal__!NID_FlyToWall -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Search::enter -> SKIP)))
							 	 [] dbisim((true)&(fireDetected__!NID_Search.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(vnavEnable.out -> SKIP)) ; TrackFire::enter -> SKIP)))
