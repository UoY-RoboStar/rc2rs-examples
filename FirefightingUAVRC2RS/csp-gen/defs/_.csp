			    const_FireDetect_CENTRE_Y) \ internal_events
	O__(id__,
			    const_FireDetect_LEFT_X,
			    const_FireDetect_CENTRE_X,
			    const_FireDetect_RIGHT_X,
			    const_FireDetect_CENTRE_Y) = sbisim(diamond(D__(id__,
			    const_FireDetect_LEFT_X,
			    const_FireDetect_CENTRE_X,
			    const_FireDetect_RIGHT_X,
			    const_FireDetect_CENTRE_Y)))
	VS__(id__,
			    const_FireDetect_LEFT_X,
			    const_FireDetect_CENTRE_X,
			    const_FireDetect_RIGHT_X,
			    const_FireDetect_CENTRE_Y) = FVS__(id__,
