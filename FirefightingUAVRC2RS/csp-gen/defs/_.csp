							 		 [[Search::interrupt <- x__ | x__ <- {|interrupt,fireDetected__.NID_Search.in|}]]
							 		 [[TrackFire::interrupt <- x__ | x__ <- {|interrupt,fireLost__.NID_TrackFire.in,trackingGained__.NID_TrackFire.in|}]]
