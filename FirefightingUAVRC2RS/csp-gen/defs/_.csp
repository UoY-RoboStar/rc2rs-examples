					Active 		= share__choice(share__choice(get_tgt?tgt -> true & (share__choice(set_yaw!calcGimbalAxis(FireTarget_distance(tgt),FireTarget_dx(tgt)) -> SKIP))));share__choice(share__choice(get_tgt?tgt -> true & (share__choice(set_pitch!calcGimbalAxis(FireTarget_distance(tgt),FireTarget_dy(tgt)) -> SKIP)))) ; 
