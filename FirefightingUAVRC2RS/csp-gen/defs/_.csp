														[| {|get_cYaw,set_cYaw,terminate|} |]
														Memory_cYaw(0)
													)\{|get_cYaw,set_cYaw|}
												)
												[| {|get_tracking,set_tracking,terminate|} |]
												Memory_tracking(false)
											)\{|get_tracking,set_tracking|}
										)
										[| {|get_pitch,set_pitch,terminate|} |]
										Memory_pitch(0)
									)\{|get_pitch,set_pitch|}
								)
								[| {|get_yaw,set_yaw,terminate|} |]
								Memory_yaw(0)
							)\{|get_yaw,set_yaw|}
						)
						[| {|get_tgt,set_tgt,terminate|} |]
						Memory_tgt((FireStatus_NoFire,0,0,0))
					)\{|get_tgt,set_tgt|}
				)
				)
			
			-- END
			
			-- Memory
			-- Memory variables
			Memory_tgt(tgt) =
				get_tgt!tgt -> Memory_tgt(tgt)
				[]
				set_tgt?x__ -> Memory_tgt(x__)
				[]
				terminate -> SKIP
			Memory_yaw(yaw) =
				get_yaw!yaw -> Memory_yaw(yaw)
				[]
				set_yaw?x__ -> Memory_yaw(x__)
				[]
				terminate -> SKIP
			Memory_pitch(pitch) =
				get_pitch!pitch -> Memory_pitch(pitch)
				[]
				set_pitch?x__ -> Memory_pitch(x__)
				[]
				terminate -> SKIP
			Memory_tracking(tracking) =
				get_tracking!tracking -> Memory_tracking(tracking)
				[]
				set_tracking?x__ -> Memory_tracking(x__)
				[]
				terminate -> SKIP
			Memory_cYaw(cYaw) =
				get_cYaw!cYaw -> Memory_cYaw(cYaw)
				[]
				set_cYaw?x__ -> Memory_cYaw(x__)
				[]
				terminate -> SKIP
			Memory_cPitch(cPitch) =
				get_cPitch!cPitch -> Memory_cPitch(cPitch)
				[]
				set_cPitch?x__ -> Memory_cPitch(x__)
				[]
				terminate -> SKIP
			Memory_YAW_DEAD_ZONE(YAW_DEAD_ZONE) =
				get_YAW_DEAD_ZONE!YAW_DEAD_ZONE -> Memory_YAW_DEAD_ZONE(YAW_DEAD_ZONE)
				[]
				set_YAW_DEAD_ZONE?x__ -> Memory_YAW_DEAD_ZONE(x__)
				[]
				terminate -> SKIP
			Memory_PITCH_DEAD_ZONE(PITCH_DEAD_ZONE) =
				get_PITCH_DEAD_ZONE!PITCH_DEAD_ZONE -> Memory_PITCH_DEAD_ZONE(PITCH_DEAD_ZONE)
				[]
				set_PITCH_DEAD_ZONE?x__ -> Memory_PITCH_DEAD_ZONE(x__)
				[]
				terminate -> SKIP
			
			-- varMemory process
			varMemory(id__,
					    const_GimbalAim_TRACK_DIST) = Memory_tgt((FireStatus_NoFire,0,0,0))
			[| { terminate } |] (
			Memory_yaw(0)
			[| { terminate } |] (
			Memory_pitch(0)
			[| { terminate } |] (
			Memory_tracking(false)
			[| { terminate } |] (
			Memory_cYaw(0)
			[| { terminate } |] (
			Memory_cPitch(0)
			[| { terminate } |] (
			Memory_YAW_DEAD_ZONE(0)
			[| { terminate } |] (
			Memory_PITCH_DEAD_ZONE(0)
			)
			)
			)
			)
			)
			)
			)
			
			getsetLocalChannels = {|get_tgt,set_tgt,get_yaw,set_yaw,get_pitch,set_pitch,get_tracking,set_tracking,get_cYaw,set_cYaw,get_cPitch,set_cPitch,get_YAW_DEAD_ZONE,set_YAW_DEAD_ZONE,get_PITCH_DEAD_ZONE,set_PITCH_DEAD_ZONE|}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
					    const_GimbalAim_TRACK_DIST) = STM_VS_O(id__,
					    const_GimbalAim_TRACK_DIST)
			
			D__(id__,
					    const_GimbalAim_TRACK_DIST) = STM(id__,
					    const_GimbalAim_TRACK_DIST) \ internal_events
			O__(id__,
					    const_GimbalAim_TRACK_DIST) = sbisim(diamond(D__(id__,
					    const_GimbalAim_TRACK_DIST)))
			VS__(id__,
					    const_GimbalAim_TRACK_DIST) = FVS__(id__,
					    const_GimbalAim_TRACK_DIST)
			VS_O__(id__,
					    const_GimbalAim_TRACK_DIST) = sbisim(diamond(FVS__(id__,
					    const_GimbalAim_TRACK_DIST)))
			HEXT__(id__,
					    const_GimbalAim_TRACK_DIST) = O__(id__,
					    const_GimbalAim_TRACK_DIST) [|shared_variable_events|] SKIP
			HUP__(id__,
					    const_GimbalAim_TRACK_DIST) = O__(id__,
					    const_GimbalAim_TRACK_DIST) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__,
					    const_GimbalAim_TRACK_DIST) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		module CPlanning
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_I|
			              NID_Connect|
			              NID_Connected|
			              NID_SwitchedOff
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			channel get_astatus, set_astatus, setL_astatus, setR_astatus: AircraftStatus
			channel get_searchComplete, set_searchComplete, setL_searchComplete, setR_searchComplete: core_boolean
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel missionStatus__: NIDS.InOut.MissionStatus
			channel missionStatus: InOut.MissionStatus
			channel startSpray__: NIDS.InOut
			channel startSpray: InOut
			channel stopSpray__: NIDS.InOut
			channel stopSpray: InOut
			channel waterEmpty__: NIDS.InOut
			channel waterEmpty: InOut
			channel fireDetected__: NIDS.InOut
			channel fireDetected: InOut
			channel fireLost__: NIDS.InOut
			channel fireLost: InOut
			channel trackingGained__: NIDS.InOut
			channel trackingGained: InOut
			channel trackingLost__: NIDS.InOut
			channel trackingLost: InOut
			channel navCommand__: NIDS.InOut.NavCommand
			channel navCommand: InOut.NavCommand
			channel waypoint__: NIDS.InOut.Position
			channel waypoint: InOut.Position
			channel uavStatus__: NIDS.InOut.AircraftStatus
			channel uavStatus: InOut.AircraftStatus
			channel batteryLow__: NIDS.InOut
			channel batteryLow: InOut
			channel gimbalAimed__: NIDS.InOut
			channel gimbalAimed: InOut
			channel vnavEnable__: NIDS.InOut
			channel vnavEnable: InOut
			channel vnavDisable__: NIDS.InOut
			channel vnavDisable: InOut
			
			-- Declaring call and ret events for undefined operations
			
			enterSS = {|
			I::enter,
			Connect::enter,
			Connected::enter,
			SwitchedOff::enter
			|}
			
			enteredSS = 	{|
			Connect::entered,
			Connected::entered,
			SwitchedOff::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	missionStatus,
				startSpray,
				stopSpray,
				waterEmpty,
				fireDetected,
				fireLost,
				trackingGained,
				trackingLost,
				navCommand,
				waypoint,
				uavStatus,
				batteryLow,
				gimbalAimed,
				vnavEnable,
				vnavDisable
				|}
		
			-- Nodes --
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: I
			module I
			exports
			
				channel enter, interrupt
				
				D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Connect
			module Connect
			
			enterSS = 
					{|			I::enter,
						Waiting::enter
					|}
			enteredSS = 
					{|			Waiting::entered
					|}
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I|
				              NID_Waiting
				
				channel internal__ : NIDS
				channel missionStatus__: NIDS.InOut.MissionStatus
				channel startSpray__: NIDS.InOut
				channel stopSpray__: NIDS.InOut
				channel waterEmpty__: NIDS.InOut
				channel fireDetected__: NIDS.InOut
				channel fireLost__: NIDS.InOut
				channel trackingGained__: NIDS.InOut
				channel trackingLost__: NIDS.InOut
				channel navCommand__: NIDS.InOut.NavCommand
				channel waypoint__: NIDS.InOut.Position
				channel uavStatus__: NIDS.InOut.AircraftStatus
				channel batteryLow__: NIDS.InOut
				channel gimbalAimed__: NIDS.InOut
				channel vnavEnable__: NIDS.InOut
				channel vnavDisable__: NIDS.InOut
				
				--	Nodes
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: I
				module I
				exports
				
					channel enter, interrupt
					
					D__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = D__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Waiting
				module Waiting
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((let
						 	-- IMPLEMENTATION NOTE:
						 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 	-- modules for defining the semantics of each node.
						 	enterSS = {|
						 	I::enter,
						 	Waiting::enter
						 	|}
						 	hideSet = union(enterSS,{|exit,exited,internal__|})
						 within 
						 	((let
						 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 		-- because CSPM modules are used for the semantics of Node.
						 		flowevts = union(enterSS,{|exit,exited,interrupt|})
						 		transSync = {|internal__.NID_I,uavStatus__.NID_Waiting.in|}
						 	within
						 		((
						 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 		   I::D__(id__,
						 		   		    const_Planning_WALL_LOC,
						 		   		    const_Planning_FIRE_TO,
						 		   		    const_Planning_INIT_TO)
						 		   [| { share__, terminate } |] (
						 		   Waiting::D__(id__,
						 		   		    const_Planning_WALL_LOC,
						 		   		    const_Planning_FIRE_TO,
						 		   		    const_Planning_INIT_TO)
						 		   )
						 		 )
						 		 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,uavStatus__.NID_Waiting.in|}]]
						 		 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 		 )
						 		  [[ share__ <- x__ | x__ <- {| share__,setR_astatus |} ]] 
						 		 )
						 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 		 			,setR_astatus
						 		 			|}) |]
						 		 ((I::enter -> Transitions(id__,
						 		 		    const_Planning_WALL_LOC,
						 		 		    const_Planning_FIRE_TO,
						 		 		    const_Planning_INIT_TO))
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						 		  [[set_astatus <- setR_astatus]]
						 		 )
						 		)
						 		 [[setR_astatus <- set_astatus]]
						 		)
						 	)
						 	 \ hideSet)
						 	[[
						 		missionStatus__.x____ <- missionStatus,
						 		startSpray__.x____ <- startSpray,
						 		stopSpray__.x____ <- stopSpray,
						 		waterEmpty__.x____ <- waterEmpty,
						 		fireDetected__.x____ <- fireDetected,
						 		fireLost__.x____ <- fireLost,
						 		trackingGained__.x____ <- trackingGained,
						 		trackingLost__.x____ <- trackingLost,
						 		navCommand__.x____ <- navCommand,
						 		waypoint__.x____ <- waypoint,
						 		uavStatus__.x____ <- uavStatus,
						 		batteryLow__.x____ <- batteryLow,
						 		gimbalAimed__.x____ <- gimbalAimed,
						 		vnavEnable__.x____ <- vnavEnable,
						 		vnavDisable__.x____ <- vnavDisable
						 		| x____ <- NIDS
						 	]]
						 )
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_searchComplete,setR_astatus |} ]] 
						  [[set_searchComplete <- setL_searchComplete,set_astatus <- setL_astatus]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_searchComplete
						 			,setL_astatus
						 			,setR_searchComplete
						 			 			,setR_astatus
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_searchComplete,setL_astatus |} ]]
						  [[set_searchComplete <- setR_searchComplete,set_astatus <- setR_astatus]]
						 )
						)[[setL_searchComplete <- set_searchComplete,setL_astatus <- set_astatus]]
						 [[setR_searchComplete <- set_searchComplete,setR_astatus <- set_astatus]]
						)\union(enteredSS,{terminate}) 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((let
						 	-- IMPLEMENTATION NOTE:
						 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 	-- modules for defining the semantics of each node.
						 	enterSS = {|
						 	I::enter,
						 	Waiting::enter
						 	|}
						 	hideSet = union(enterSS,{|exit,exited,internal__|})
						 within 
						 	((let
						 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 		-- because CSPM modules are used for the semantics of Node.
						 		flowevts = union(enterSS,{|exit,exited,interrupt|})
						 		transSync = {|internal__.NID_I,uavStatus__.NID_Waiting.in|}
						 	within
						 		((
						 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 		   I::VS_O__(id__,
						 		   		    const_Planning_WALL_LOC,
						 		   		    const_Planning_FIRE_TO,
						 		   		    const_Planning_INIT_TO)
						 		   [| { share__, terminate } |] (
						 		   Waiting::VS_O__(id__,
						 		   		    const_Planning_WALL_LOC,
						 		   		    const_Planning_FIRE_TO,
						 		   		    const_Planning_INIT_TO)
						 		   )
						 		 )
						 		 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,uavStatus__.NID_Waiting.in|}]]
						 		 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 		 )
						 		  [[ share__ <- x__ | x__ <- {| share__,setR_astatus |} ]] 
						 		 )
						 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 		 			,setR_astatus
						 		 			|}) |]
						 		 ((I::enter -> Transitions(id__,
						 		 		    const_Planning_WALL_LOC,
						 		 		    const_Planning_FIRE_TO,
						 		 		    const_Planning_INIT_TO))
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						 		  [[set_astatus <- setR_astatus]]
						 		 )
						 		)
						 		 [[setR_astatus <- set_astatus]]
						 		)
						 	)
						 	 \ hideSet)
						 	[[
						 		missionStatus__.x____ <- missionStatus,
						 		startSpray__.x____ <- startSpray,
						 		stopSpray__.x____ <- stopSpray,
						 		waterEmpty__.x____ <- waterEmpty,
						 		fireDetected__.x____ <- fireDetected,
						 		fireLost__.x____ <- fireLost,
						 		trackingGained__.x____ <- trackingGained,
						 		trackingLost__.x____ <- trackingLost,
						 		navCommand__.x____ <- navCommand,
						 		waypoint__.x____ <- waypoint,
						 		uavStatus__.x____ <- uavStatus,
						 		batteryLow__.x____ <- batteryLow,
						 		gimbalAimed__.x____ <- gimbalAimed,
						 		vnavEnable__.x____ <- vnavEnable,
						 		vnavDisable__.x____ <- vnavDisable
						 		| x____ <- NIDS
						 	]]
						 )
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_searchComplete,setR_astatus |} ]] 
						  [[set_searchComplete <- setL_searchComplete,set_astatus <- setL_astatus]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_searchComplete
						 			,setL_astatus
						 			,setR_searchComplete
						 			 			,setR_astatus
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_searchComplete,setL_astatus |} ]]
						  [[set_searchComplete <- setR_searchComplete,set_astatus <- setR_astatus]]
						 )
						)[[setL_searchComplete <- set_searchComplete,setL_astatus <- set_astatus]]
						 [[setR_searchComplete <- set_searchComplete,setR_astatus <- set_astatus]]
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = ((let
					Trans = (
						((share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
						 	 [] dbisim((true)&(uavStatus__!NID_Waiting.in?astatus:{astatus|astatus <- AircraftStatus, true} -> share__choice(set_astatus!astatus -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Waiting::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
				within
					Trans
				)
				)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Connected
			module Connected
			
			enterSS = 
					{|			I::enter,
						TakeOffAndClimb::enter,
						Mission::enter,
						GoHome::enter,
						Land::enter,
						Disarm::enter
					|}
			enteredSS = 
					{|			TakeOffAndClimb::entered,
						Mission::entered,
						GoHome::entered,
						Land::entered,
						Disarm::entered
					|}
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I|
				              NID_TakeOffAndClimb|
				              NID_Mission|
				              NID_GoHome|
				              NID_Land|
				              NID_Disarm
				
				channel internal__ : NIDS
				channel missionStatus__: NIDS.InOut.MissionStatus
				channel startSpray__: NIDS.InOut
				channel stopSpray__: NIDS.InOut
				channel waterEmpty__: NIDS.InOut
				channel fireDetected__: NIDS.InOut
				channel fireLost__: NIDS.InOut
				channel trackingGained__: NIDS.InOut
				channel trackingLost__: NIDS.InOut
				channel navCommand__: NIDS.InOut.NavCommand
				channel waypoint__: NIDS.InOut.Position
				channel uavStatus__: NIDS.InOut.AircraftStatus
				channel batteryLow__: NIDS.InOut
				channel gimbalAimed__: NIDS.InOut
				channel vnavEnable__: NIDS.InOut
				channel vnavDisable__: NIDS.InOut
				
				--	Nodes
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: I
				module I
				exports
				
					channel enter, interrupt
					
					D__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = D__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: TakeOffAndClimb
				module TakeOffAndClimb
				
				enterSS = 
						{|			I::enter,
							Waiting::enter
						|}
				enteredSS = 
						{|			Waiting::entered
						|}
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					-- declaring identifiers of transitions
					datatype NIDS = 
					              NID_I|
					              NID_Waiting
					
					channel internal__ : NIDS
					channel missionStatus__: NIDS.InOut.MissionStatus
					channel startSpray__: NIDS.InOut
					channel stopSpray__: NIDS.InOut
					channel waterEmpty__: NIDS.InOut
					channel fireDetected__: NIDS.InOut
					channel fireLost__: NIDS.InOut
					channel trackingGained__: NIDS.InOut
					channel trackingLost__: NIDS.InOut
					channel navCommand__: NIDS.InOut.NavCommand
					channel waypoint__: NIDS.InOut.Position
					channel uavStatus__: NIDS.InOut.AircraftStatus
					channel batteryLow__: NIDS.InOut
					channel gimbalAimed__: NIDS.InOut
					channel vnavEnable__: NIDS.InOut
					channel vnavDisable__: NIDS.InOut
					
					--	Nodes
					-- declaring all nodes
					
					----------------------------------------------------------------------
					-- Initial: I
					module I
					exports
					
						channel enter, interrupt
						
						D__(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO) = 
							dbisim(let
								Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
								
								Termination = terminate -> SKIP
								
								Active 		= share__choice(interrupt -> SKIP) ; Inactive
							within
								Inactive [| {terminate} |> SKIP)
						
						VS_O__(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO) = D__(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO)
					
					endmodule
					----------------------------------------------------------------------
					
					
					----------------------------------------------------------------------
					-- State: Waiting
					module Waiting
					
					enterSS = {}
					
					enteredSS = {}
					
					exports
					
						--  Declarations
						
						channel enter, entered, interrupt
						channel enteredL, enteredR
						
										
						
						--	Nodes
						-- declaring all nodes
						
						
						--	Rule: behaviours(Node)
						--  Note that FDR has problems with efficiently compiling the process below
						-- 	if using a different recursion pattern.
						D__(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO) = 
						dbisim(let
							-- IMPLEMENTATION NOTE: 
							-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
							-- however FDR struggles with that form in certain cases. So we use the exception operator
							-- instead to 'terminate'.
							
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= SKIP ; 
									 	  Behaviour ; 
									 	  share__choice(exit -> SKIP) ; SKIP ; 
									 	  share__choice(exited -> SKIP) ; Inactive
						
							Behaviour 	= entered -> During
							During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
						within
							Inactive [| {terminate} |> SKIP)
							
						VS_O__(id__,
								    const_Planning_WALL_LOC,
								    const_Planning_FIRE_TO,
								    const_Planning_INIT_TO) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= SKIP ; 
									 	  Behaviour ; 
									 	  share__choice(exit -> SKIP) ; SKIP ; 
									 	  share__choice(exited -> SKIP) ; Inactive
						
							Behaviour 	= entered -> During
							During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
						within
							Inactive [| {terminate} |> SKIP)
						
					
					endmodule
					----------------------------------------------------------------------
					
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&(share__choice(missionStatus.out!MissionStatus_TakingOff -> SKIP));true&(share__choice(navCommand.out!NavCommand_TakeOff -> SKIP)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
					
						Behaviour 	= dbisim(
							((
							 (((let
							 	-- IMPLEMENTATION NOTE:
							 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							 	-- modules for defining the semantics of each node.
							 	enterSS = {|
							 	I::enter,
							 	Waiting::enter
							 	|}
							 	hideSet = union(enterSS,{|exit,exited,internal__|})
							 within 
							 	((let
							 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							 		-- because CSPM modules are used for the semantics of Node.
							 		flowevts = union(enterSS,{|exit,exited,interrupt|})
							 		transSync = {|internal__.NID_I,uavStatus__.NID_Waiting.in|}
							 	within
							 		((
							 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							 		   I::D__(id__,
							 		   		    const_Planning_WALL_LOC,
							 		   		    const_Planning_FIRE_TO,
							 		   		    const_Planning_INIT_TO)
							 		   [| { share__, terminate } |] (
							 		   Waiting::D__(id__,
							 		   		    const_Planning_WALL_LOC,
							 		   		    const_Planning_FIRE_TO,
							 		   		    const_Planning_INIT_TO)
							 		   )
							 		 )
							 		 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,uavStatus__.NID_Waiting.in|}]]
							 		 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
							 		 )
							 		  [[ share__ <- x__ | x__ <- {| share__,setR_astatus |} ]] 
							 		 )
							 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 		 			,setR_astatus
							 		 			|}) |]
							 		 ((I::enter -> Transitions(id__,
							 		 		    const_Planning_WALL_LOC,
							 		 		    const_Planning_FIRE_TO,
							 		 		    const_Planning_INIT_TO))
							 		  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 		  [[set_astatus <- setR_astatus]]
							 		 )
							 		)
							 		 [[setR_astatus <- set_astatus]]
							 		)
							 	)
							 	 \ hideSet)
							 	[[
							 		missionStatus__.x____ <- missionStatus,
							 		startSpray__.x____ <- startSpray,
							 		stopSpray__.x____ <- stopSpray,
							 		waterEmpty__.x____ <- waterEmpty,
							 		fireDetected__.x____ <- fireDetected,
							 		fireLost__.x____ <- fireLost,
							 		trackingGained__.x____ <- trackingGained,
							 		trackingLost__.x____ <- trackingLost,
							 		navCommand__.x____ <- navCommand,
							 		waypoint__.x____ <- waypoint,
							 		uavStatus__.x____ <- uavStatus,
							 		batteryLow__.x____ <- batteryLow,
							 		gimbalAimed__.x____ <- gimbalAimed,
							 		vnavEnable__.x____ <- vnavEnable,
							 		vnavDisable__.x____ <- vnavDisable
							 		| x____ <- NIDS
							 	]]
							 )
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_searchComplete,setR_astatus |} ]] 
							  [[set_searchComplete <- setL_searchComplete,set_astatus <- setL_astatus]]
							 )
							 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
							 			,setL_searchComplete
							 			,setL_astatus
							 			,setR_searchComplete
							 			 			,setR_astatus
							 			|}) |]
							 ((During)
							  [[ share__ <- x__ | x__ <- {| share__,setL_searchComplete,setL_astatus |} ]]
							  [[set_searchComplete <- setR_searchComplete,set_astatus <- setR_astatus]]
							 )
							)[[setL_searchComplete <- set_searchComplete,setL_astatus <- set_astatus]]
							 [[setR_searchComplete <- set_searchComplete,setR_astatus <- set_astatus]]
							)\union(enteredSS,{terminate}) 
						)
						During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
								 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&(share__choice(missionStatus.out!MissionStatus_TakingOff -> SKIP));true&(share__choice(navCommand.out!NavCommand_TakeOff -> SKIP)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
					
						Behaviour 	= dbisim(
							((
							 (((let
							 	-- IMPLEMENTATION NOTE:
							 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							 	-- modules for defining the semantics of each node.
							 	enterSS = {|
							 	I::enter,
							 	Waiting::enter
							 	|}
							 	hideSet = union(enterSS,{|exit,exited,internal__|})
							 within 
							 	((let
							 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							 		-- because CSPM modules are used for the semantics of Node.
							 		flowevts = union(enterSS,{|exit,exited,interrupt|})
							 		transSync = {|internal__.NID_I,uavStatus__.NID_Waiting.in|}
							 	within
							 		((
							 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							 		   I::VS_O__(id__,
							 		   		    const_Planning_WALL_LOC,
							 		   		    const_Planning_FIRE_TO,
							 		   		    const_Planning_INIT_TO)
							 		   [| { share__, terminate } |] (
							 		   Waiting::VS_O__(id__,
							 		   		    const_Planning_WALL_LOC,
							 		   		    const_Planning_FIRE_TO,
							 		   		    const_Planning_INIT_TO)
							 		   )
							 		 )
							 		 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,uavStatus__.NID_Waiting.in|}]]
							 		 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
							 		 )
							 		  [[ share__ <- x__ | x__ <- {| share__,setR_astatus |} ]] 
							 		 )
							 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 		 			,setR_astatus
							 		 			|}) |]
							 		 ((I::enter -> Transitions(id__,
							 		 		    const_Planning_WALL_LOC,
							 		 		    const_Planning_FIRE_TO,
							 		 		    const_Planning_INIT_TO))
							 		  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 		  [[set_astatus <- setR_astatus]]
							 		 )
							 		)
							 		 [[setR_astatus <- set_astatus]]
							 		)
							 	)
							 	 \ hideSet)
							 	[[
							 		missionStatus__.x____ <- missionStatus,
							 		startSpray__.x____ <- startSpray,
							 		stopSpray__.x____ <- stopSpray,
							 		waterEmpty__.x____ <- waterEmpty,
							 		fireDetected__.x____ <- fireDetected,
							 		fireLost__.x____ <- fireLost,
							 		trackingGained__.x____ <- trackingGained,
							 		trackingLost__.x____ <- trackingLost,
							 		navCommand__.x____ <- navCommand,
							 		waypoint__.x____ <- waypoint,
							 		uavStatus__.x____ <- uavStatus,
							 		batteryLow__.x____ <- batteryLow,
							 		gimbalAimed__.x____ <- gimbalAimed,
							 		vnavEnable__.x____ <- vnavEnable,
							 		vnavDisable__.x____ <- vnavDisable
							 		| x____ <- NIDS
							 	]]
							 )
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_searchComplete,setR_astatus |} ]] 
							  [[set_searchComplete <- setL_searchComplete,set_astatus <- setL_astatus]]
							 )
							 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
							 			,setL_searchComplete
							 			,setL_astatus
							 			,setR_searchComplete
							 			 			,setR_astatus
							 			|}) |]
							 ((During)
							  [[ share__ <- x__ | x__ <- {| share__,setL_searchComplete,setL_astatus |} ]]
							  [[set_searchComplete <- setR_searchComplete,set_astatus <- setR_astatus]]
							 )
							)[[setL_searchComplete <- set_searchComplete,setL_astatus <- set_astatus]]
							 [[setR_searchComplete <- set_searchComplete,setR_astatus <- set_astatus]]
							)\{terminate} 
						)
						During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
								 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
					within
						Inactive [| {terminate} |> SKIP)
					
					Transitions(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = ((let
						Trans = (
							((share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
							 	 [] dbisim((true)&(uavStatus__!NID_Waiting.in?astatus:{astatus|astatus <- AircraftStatus, true} -> share__choice(set_astatus!astatus -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Waiting::enter -> SKIP)))
							 ) ; Trans)
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
						)
					within
						Trans
					)
					)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Mission
				module Mission
				
				enterSS = 
						{|			I::enter,
							FlyToWall::enter,
							Search::enter,
							TrackFire::enter,
							Spray::enter,
							LosingFire::enter
						|}
				enteredSS = 
						{|			FlyToWall::entered,
							Search::entered,
							TrackFire::entered,
							Spray::entered,
							LosingFire::entered
						|}
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					-- declaring identifiers of transitions
					datatype NIDS = 
					              NID_I|
					              NID_FlyToWall|
					              NID_Search|
					              NID_TrackFire|
					              NID_Spray|
					              NID_LosingFire
					
					channel internal__ : NIDS
					channel missionStatus__: NIDS.InOut.MissionStatus
					channel startSpray__: NIDS.InOut
