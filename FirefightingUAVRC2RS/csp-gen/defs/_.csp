			( 
				(
					(
						(IteratedStateful_VS_O(id__,
								    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
								    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) \ {terminate} ; share__choice(terminate -> SKIP))
