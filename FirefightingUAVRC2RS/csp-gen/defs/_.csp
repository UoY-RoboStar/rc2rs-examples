			Transitions(id__,
					    const_Planning_WALL_LOC,
					    const_Planning_FIRE_TO,
					    const_Planning_INIT_TO) = ((let
				Trans = share__choice(get_astatus?astatus -> (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; FlyToWall::enter -> SKIP))))
					 	 [] dbisim(((astatus==AircraftStatus_AtWaypoint))&(internal__!NID_FlyToWall -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Search::enter -> SKIP)))
					 	 [] dbisim((true)&(fireDetected__!NID_Search.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(vnavEnable.out -> SKIP)) ; TrackFire::enter -> SKIP)))
					 	 [] dbisim((true)&(fireLost__!NID_TrackFire.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; LosingFire::enter -> SKIP)))
					 	 [] dbisim((true)&(trackingGained__!NID_TrackFire.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Spray::enter -> SKIP)))
					 	 [] dbisim((true)&(trackingLost__!NID_Spray.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TrackFire::enter -> SKIP)))
					 	 [] dbisim((true)&(fireDetected__!NID_LosingFire.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TrackFire::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_LosingFire -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(vnavDisable.out -> SKIP)) ; Search::enter -> SKIP)))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
				)
			within
				Trans
			)
			)
			
		
		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: GoHome
		module GoHome
		
		enterSS = 
				{|			I::enter,
					Waiting::enter
				|}
		enteredSS = 
				{|			Waiting::entered
				|}
		exports
		
			--  Declarations
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_I|
			              NID_Waiting
			
			channel internal__ : NIDS
			channel missionStatus__: NIDS.InOut.MissionStatus
			channel startSpray__: NIDS.InOut
			channel stopSpray__: NIDS.InOut
			channel waterEmpty__: NIDS.InOut
			channel fireDetected__: NIDS.InOut
			channel fireLost__: NIDS.InOut
			channel trackingGained__: NIDS.InOut
			channel trackingLost__: NIDS.InOut
			channel navCommand__: NIDS.InOut.NavCommand
			channel waypoint__: NIDS.InOut.Position
			channel uavStatus__: NIDS.InOut.AircraftStatus
			channel batteryLow__: NIDS.InOut
			channel gimbalAimed__: NIDS.InOut
			channel vnavEnable__: NIDS.InOut
			channel vnavDisable__: NIDS.InOut
			
			--	Nodes
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: I
			module I
			exports
			
				channel enter, interrupt
				
				D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Waiting
			module Waiting
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_Planning_WALL_LOC,
						    const_Planning_FIRE_TO,
						    const_Planning_INIT_TO) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
