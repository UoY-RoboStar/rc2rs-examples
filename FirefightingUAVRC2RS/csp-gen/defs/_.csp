				Active 		= share__choice(share__choice(get_movement?movement -> share__choice(get_tgt?tgt -> true & (share__choice(set_movement!update_RelativeMotion_dx(movement,Minus(FireTarget_distance(tgt), const_VisualNav_SCAN_DIST, core_real)) -> SKIP)))));share__choice(share__choice(get_movement?movement -> true & (share__choice(set_movement!update_RelativeMotion_dy(movement,0) -> SKIP))));share__choice(share__choice(get_movement?movement -> true & (share__choice(set_movement!update_RelativeMotion_dz(movement,0) -> SKIP)))) ; 
