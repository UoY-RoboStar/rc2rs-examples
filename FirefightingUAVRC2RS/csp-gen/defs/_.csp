						During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
								 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
					within
						Inactive [| {terminate} |> SKIP)
					
					Transitions(id__,
							    const_Planning_WALL_LOC,
							    const_Planning_FIRE_TO,
							    const_Planning_INIT_TO) = ((let
						Trans = (
							((share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
