						    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__,
					    const_BatteryMonitor_BATTERY_LOW_THRESHOLD,
					    const_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = ((let
				Trans = (
					((share__ -> SKIP
