																		Memory_rgb((0))
																	)\{|get_rgb,set_rgb|}
																)
																[| {|get_gotR,set_gotR,terminate|} |]
																Memory_gotR(true)
															)\{|get_gotR,set_gotR|}
														)
														[| {|get_gotH,set_gotH,terminate|} |]
														Memory_gotH(true)
													)\{|get_gotH,set_gotH|}
												)
												[| {|get_gotD,set_gotD,terminate|} |]
												Memory_gotD(true)
											)\{|get_gotD,set_gotD|}
										)
										[| {|get_checkDone,set_checkDone,terminate|} |]
										Memory_checkDone(true)
									)\{|get_checkDone,set_checkDone|}
								)
								[| {|get_wm,set_wm,terminate|} |]
								Memory_wm((0,0,0))
							)\{|get_wm,set_wm|}
						)
						[| {|get_fs,set_fs,terminate|} |]
						Memory_fs(FireStatus_NoFire)
					)\{|get_fs,set_fs|}
				)
				[| {|get_fp,set_fp,terminate|} |]
				Memory_fp((FireStatus_NoFire,0,0,0))
			)\{|get_fp,set_fp|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_fp(fp) =
		get_fp!fp -> Memory_fp(fp)
		[]
		set_fp?x__ -> Memory_fp(x__)
		[]
		terminate -> SKIP
	Memory_fs(fs) =
		get_fs!fs -> Memory_fs(fs)
		[]
		set_fs?x__ -> Memory_fs(x__)
		[]
		terminate -> SKIP
	Memory_wm(wm) =
		get_wm!wm -> Memory_wm(wm)
		[]
		set_wm?x__ -> Memory_wm(x__)
		[]
		terminate -> SKIP
	Memory_checkDone(checkDone) =
		get_checkDone!checkDone -> Memory_checkDone(checkDone)
		[]
		set_checkDone?x__ -> Memory_checkDone(x__)
		[]
		terminate -> SKIP
	Memory_gotD(gotD) =
		get_gotD!gotD -> Memory_gotD(gotD)
		[]
		set_gotD?x__ -> Memory_gotD(x__)
		[]
		terminate -> SKIP
	Memory_gotH(gotH) =
		get_gotH!gotH -> Memory_gotH(gotH)
		[]
		set_gotH?x__ -> Memory_gotH(x__)
		[]
		terminate -> SKIP
	Memory_gotR(gotR) =
		get_gotR!gotR -> Memory_gotR(gotR)
		[]
		set_gotR?x__ -> Memory_gotR(x__)
		[]
		terminate -> SKIP
	Memory_rgb(rgb) =
		get_rgb!rgb -> Memory_rgb(rgb)
		[]
		set_rgb?x__ -> Memory_rgb(x__)
		[]
		terminate -> SKIP
	Memory_d(d) =
		get_d!d -> Memory_d(d)
		[]
		set_d?x__ -> Memory_d(x__)
		[]
		terminate -> SKIP
	Memory_t(t) =
		get_t!t -> Memory_t(t)
		[]
		set_t?x__ -> Memory_t(x__)
		[]
		terminate -> SKIP
	Memory_super(super) =
		get_super!super -> Memory_super(super)
		[]
		set_super?x__ -> Memory_super(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_FireDetect_LEFT_X,
			    const_FireDetect_CENTRE_X,
			    const_FireDetect_RIGHT_X,
			    const_FireDetect_CENTRE_Y) = Memory_fp((FireStatus_NoFire,0,0,0))
	[| { terminate } |] (
	Memory_fs(FireStatus_NoFire)
	[| { terminate } |] (
	Memory_wm((0,0,0))
	[| { terminate } |] (
	Memory_checkDone(true)
	[| { terminate } |] (
	Memory_gotD(true)
	[| { terminate } |] (
	Memory_gotH(true)
	[| { terminate } |] (
	Memory_gotR(true)
	[| { terminate } |] (
	Memory_rgb((0))
	[| { terminate } |] (
	Memory_d((0))
	[| { terminate } |] (
	Memory_t((0))
	[| { terminate } |] (
	Memory_super((0))
	)
	)
	)
	)
	)
	)
	)
	)
	)
	)
	
	getsetLocalChannels = {|get_fp,set_fp,get_fs,set_fs,get_wm,set_wm,get_checkDone,set_checkDone,get_gotD,set_gotD,get_gotH,set_gotH,get_gotR,set_gotR,get_rgb,set_rgb,get_d,set_d,get_t,set_t,get_super,set_super|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_FireDetect_LEFT_X,
			    const_FireDetect_CENTRE_X,
			    const_FireDetect_RIGHT_X,
			    const_FireDetect_CENTRE_Y) = STM_VS_O(id__,
