			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_I|
			              NID_Waiting|
			              NID_Calculate|
			              NID_Yaw|
			              NID_Pitch|
			              NID_IsValid|
			              NID_Clamp|
			              NID_MaybeAimed
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
