				    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY))
		)
	
	Stateful_VS_O(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY)
				[| {|get_angle,set_angle,terminate|} |]
				Memory_angle(0)
			)\{|get_angle,set_angle|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_angle(angle) =
		get_angle!angle -> Memory_angle(angle)
		[]
		set_angle?x__ -> Memory_angle(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = Memory_angle(0)
	
	getsetLocalChannels = {|get_angle,set_angle|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = STM_VS_O(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY)
	
	D__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = STM(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) \ internal_events
	O__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = sbisim(diamond(D__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY)))
	VS__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = FVS__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY)
	VS_O__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = sbisim(diamond(FVS__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY)))
	HEXT__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = O__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = O__(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_pre_pkg__Aim_GIMBAL_FLOOD_DELAY) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
