							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i::D__(id__)
							   [| { share__, terminate } |] (
							   sStop::D__(id__)
							   )
							 )
							 [[sStop::interrupt <- x__ | x__ <- {|interrupt|}]]
