												    const_pre_pkg__Planning_WALL_LOC,
												    const_pre_pkg__Planning_FIRE_TO,
												    const_pre_pkg__Planning_INIT_TO)
										[| {|get_inact_Planning_Connect,set_inact_Planning_Connect,terminate|} |]
										Memory_inact_Planning_Connect(true)
									)\{|get_inact_Planning_Connect,set_inact_Planning_Connect|}
								)
								[| {|get_inact_Planning_Connected_Mission_LosingFire,set_inact_Planning_Connected_Mission_LosingFire,terminate|} |]
								Memory_inact_Planning_Connected_Mission_LosingFire(true)
							)\{|get_inact_Planning_Connected_Mission_LosingFire,set_inact_Planning_Connected_Mission_LosingFire|}
						)
						[| {|get_searchComplete,set_searchComplete,terminate|} |]
						Memory_searchComplete(true)
					)\{|get_searchComplete,set_searchComplete|}
				)
				[| {|get_astatus,set_astatus,terminate|} |]
				Memory_astatus(AircraftStatus_Connected)
			)\{|get_astatus,set_astatus|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = 
		dbisim((
		let
			finalNodesEntered = {|SwitchedOff::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I::enter,
				Connect::enter,
				Connected::enter,
				SwitchedOff::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I,internal__.NID_Connect,internal__.NID_Connect,internal__.NID_Connected|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I::VS_O__(id__,
					   		    const_pre_pkg__Planning_WALL_LOC,
					   		    const_pre_pkg__Planning_FIRE_TO,
					   		    const_pre_pkg__Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   Connect::VS_O__(id__,
					   		    const_pre_pkg__Planning_WALL_LOC,
					   		    const_pre_pkg__Planning_FIRE_TO,
					   		    const_pre_pkg__Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   Connected::VS_O__(id__,
					   		    const_pre_pkg__Planning_WALL_LOC,
					   		    const_pre_pkg__Planning_FIRE_TO,
					   		    const_pre_pkg__Planning_INIT_TO)
					   [| { share__, terminate } |] (
					   SwitchedOff::VS_O__(id__,
					   		    const_pre_pkg__Planning_WALL_LOC,
					   		    const_pre_pkg__Planning_FIRE_TO,
					   		    const_pre_pkg__Planning_INIT_TO)
					   )
					   )
					   )
					 )
					 [[Connect::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Connect,internal__.NID_Connect|}]]
					 [[Connected::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Connected|}]]
					 [[SwitchedOff::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_astatus <- setL_astatus]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_astatus
					|}) |]
					 ((I::enter -> Transitions(id__,
					 		    const_pre_pkg__Planning_WALL_LOC,
					 		    const_pre_pkg__Planning_FIRE_TO,
					 		    const_pre_pkg__Planning_INIT_TO))
					  [[ share__ <- x__ | x__ <- {| share__,setL_astatus |} ]]
					 )
					)[[setL_astatus <- set_astatus]]
					)
				)
				 \ hideSet)
				[[
					missionStatus__.x____ <- missionStatus,
					startSpray__.x____ <- startSpray,
					stopSpray__.x____ <- stopSpray,
					waterEmpty__.x____ <- waterEmpty,
					fireDetected__.x____ <- fireDetected,
					fireLost__.x____ <- fireLost,
					trackingGained__.x____ <- trackingGained,
					trackingLost__.x____ <- trackingLost,
					navCommand__.x____ <- navCommand,
					waypoint__.x____ <- waypoint,
					uavStatus__.x____ <- uavStatus,
					batteryLow__.x____ <- batteryLow,
					gimbalAimed__.x____ <- gimbalAimed,
					vnavEnable__.x____ <- vnavEnable,
					vnavDisable__.x____ <- vnavDisable
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = 
		dbisim((MachineBody_VS_O(id__,
				    const_pre_pkg__Planning_WALL_LOC,
				    const_pre_pkg__Planning_FIRE_TO,
				    const_pre_pkg__Planning_INIT_TO))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = 
		dbisim((MachineBody_VS_O(id__,
				    const_pre_pkg__Planning_WALL_LOC,
				    const_pre_pkg__Planning_FIRE_TO,
				    const_pre_pkg__Planning_INIT_TO))
		)
	
	Stateful_VS_O(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_pre_pkg__Planning_WALL_LOC,
					    const_pre_pkg__Planning_FIRE_TO,
					    const_pre_pkg__Planning_INIT_TO) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_pre_pkg__Planning_WALL_LOC,
					    const_pre_pkg__Planning_FIRE_TO,
					    const_pre_pkg__Planning_INIT_TO))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										Behaviour_VS_O(id__,
												    const_pre_pkg__Planning_WALL_LOC,
												    const_pre_pkg__Planning_FIRE_TO,
												    const_pre_pkg__Planning_INIT_TO)
										[| {|get_inact_Planning_Connect,set_inact_Planning_Connect,terminate|} |]
										Memory_inact_Planning_Connect(true)
									)\{|get_inact_Planning_Connect,set_inact_Planning_Connect|}
								)
								[| {|get_inact_Planning_Connected_Mission_LosingFire,set_inact_Planning_Connected_Mission_LosingFire,terminate|} |]
								Memory_inact_Planning_Connected_Mission_LosingFire(true)
							)\{|get_inact_Planning_Connected_Mission_LosingFire,set_inact_Planning_Connected_Mission_LosingFire|}
						)
						[| {|get_searchComplete,set_searchComplete,terminate|} |]
						Memory_searchComplete(true)
					)\{|get_searchComplete,set_searchComplete|}
				)
				[| {|get_astatus,set_astatus,terminate|} |]
				Memory_astatus(AircraftStatus_Connected)
			)\{|get_astatus,set_astatus|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_astatus(astatus) =
		get_astatus!astatus -> Memory_astatus(astatus)
		[]
		set_astatus?x__ -> Memory_astatus(x__)
		[]
		terminate -> SKIP
	Memory_searchComplete(searchComplete) =
		get_searchComplete!searchComplete -> Memory_searchComplete(searchComplete)
		[]
		set_searchComplete?x__ -> Memory_searchComplete(x__)
		[]
		terminate -> SKIP
	Memory_inact_Planning_Connected_Mission_LosingFire(inact_Planning_Connected_Mission_LosingFire) =
		get_inact_Planning_Connected_Mission_LosingFire!inact_Planning_Connected_Mission_LosingFire -> Memory_inact_Planning_Connected_Mission_LosingFire(inact_Planning_Connected_Mission_LosingFire)
		[]
		set_inact_Planning_Connected_Mission_LosingFire?x__ -> Memory_inact_Planning_Connected_Mission_LosingFire(x__)
		[]
		terminate -> SKIP
	Memory_inact_Planning_Connect(inact_Planning_Connect) =
		get_inact_Planning_Connect!inact_Planning_Connect -> Memory_inact_Planning_Connect(inact_Planning_Connect)
		[]
		set_inact_Planning_Connect?x__ -> Memory_inact_Planning_Connect(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = Memory_astatus(AircraftStatus_Connected)
	[| { terminate } |] (
	Memory_searchComplete(true)
	[| { terminate } |] (
	Memory_inact_Planning_Connected_Mission_LosingFire(true)
	[| { terminate } |] (
	Memory_inact_Planning_Connect(true)
	)
	)
	)
	
	getsetLocalChannels = {|get_astatus,set_astatus,get_searchComplete,set_searchComplete,get_inact_Planning_Connected_Mission_LosingFire,set_inact_Planning_Connected_Mission_LosingFire,get_inact_Planning_Connect,set_inact_Planning_Connect|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = STM_VS_O(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO)
	
	D__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = STM(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) \ internal_events
	O__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = sbisim(diamond(D__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO)))
	VS__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = FVS__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO)
	VS_O__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = sbisim(diamond(FVS__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO)))
	HEXT__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = O__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = O__(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_pre_pkg__Planning_WALL_LOC,
			    const_pre_pkg__Planning_FIRE_TO,
			    const_pre_pkg__Planning_INIT_TO) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
