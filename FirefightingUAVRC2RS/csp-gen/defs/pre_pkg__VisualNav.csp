					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_tgt <- setR_tgt,set_wm <- setR_wm]]
					 )
					)
					 [[setR_tgt <- set_tgt,setR_wm <- set_wm]]
					)
				)
				 \ hideSet)
				[[
					wallMetrics__.x____ <- wallMetrics,
					fvSeenFire__.x____ <- fvSeenFire,
					visualPosition__.x____ <- visualPosition,
					vnavEnable__.x____ <- vnavEnable,
					vnavDisable__.x____ <- vnavDisable
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = 
		dbisim((MachineBody_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = 
		dbisim((MachineBody_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST))
		)
	
	Stateful_VS_O(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_pre_pkg__VisualNav_TRACK_DIST,
					    const_pre_pkg__VisualNav_SCAN_DIST) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_pre_pkg__VisualNav_TRACK_DIST,
					    const_pre_pkg__VisualNav_SCAN_DIST))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								Behaviour_VS_O(id__,
										    const_pre_pkg__VisualNav_TRACK_DIST,
										    const_pre_pkg__VisualNav_SCAN_DIST)
								[| {|get_movement,set_movement,terminate|} |]
								Memory_movement((0,0,0,0))
							)\{|get_movement,set_movement|}
						)
						[| {|get_wm,set_wm,terminate|} |]
						Memory_wm((0,0,0))
					)\{|get_wm,set_wm|}
				)
				[| {|get_tgt,set_tgt,terminate|} |]
				Memory_tgt((FireStatus_NoFire,0,0,0))
			)\{|get_tgt,set_tgt|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_tgt(tgt) =
		get_tgt!tgt -> Memory_tgt(tgt)
		[]
		set_tgt?x__ -> Memory_tgt(x__)
		[]
		terminate -> SKIP
	Memory_wm(wm) =
		get_wm!wm -> Memory_wm(wm)
		[]
		set_wm?x__ -> Memory_wm(x__)
		[]
		terminate -> SKIP
	Memory_movement(movement) =
		get_movement!movement -> Memory_movement(movement)
		[]
		set_movement?x__ -> Memory_movement(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = Memory_tgt((FireStatus_NoFire,0,0,0))
	[| { terminate } |] (
	Memory_wm((0,0,0))
	[| { terminate } |] (
	Memory_movement((0,0,0,0))
	)
	)
	
	getsetLocalChannels = {|get_tgt,set_tgt,get_wm,set_wm,get_movement,set_movement|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = STM_VS_O(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST)
	
	D__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = STM(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) \ internal_events
	O__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = sbisim(diamond(D__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST)))
	VS__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = FVS__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST)
	VS_O__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = sbisim(diamond(FVS__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST)))
	HEXT__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = O__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = O__(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_pre_pkg__VisualNav_TRACK_DIST,
			    const_pre_pkg__VisualNav_SCAN_DIST) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule
