					SetYaw::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited|})
						transSync = {|internal__.NID_I,internal__.NID_Waiting,internal__.NID_Waiting,internal__.NID_SetPitch,internal__.NID_SetYaw|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   I::VS_O__(id__,cycle_pre_pkg__sim_Aim_Aim,
						   		    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
						   [| { share__, terminate } |] (
						   Waiting::VS_O__(id__,cycle_pre_pkg__sim_Aim_Aim,
						   		    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
						   [| { share__, terminate } |] (
						   SetPitch::VS_O__(id__,cycle_pre_pkg__sim_Aim_Aim,
						   		    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
						   [| { share__, terminate } |] (
						   SetYaw::VS_O__(id__,cycle_pre_pkg__sim_Aim_Aim,
						   		    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
						   )
						   )
						   )
						 )
						 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Waiting,internal__.NID_Waiting|}]]
						 [[SetPitch::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_SetPitch|}]]
						 [[SetYaw::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_SetYaw|}]]
						 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						  [[set_gimbalYawF <- setL_gimbalYawF,set_gimbalPitchF <- setL_gimbalPitchF]]
						 )
						 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
						 			,setL_gimbalYawF
						 			,setL_gimbalPitchF
						|}) |]
						 ((I::enter -> Transitions(id__,cycle_pre_pkg__sim_Aim_Aim,
						 		    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
						  [[ share__ <- x__ | x__ <- {| share__,setL_gimbalYawF,setL_gimbalPitchF |} ]]
						 )
						)[[setL_gimbalYawF <- set_gimbalYawF,setL_gimbalPitchF <- set_gimbalPitchF]]
						)
					)
					 \ hideSet)
					[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
					[[ endexec_action <- endexec ]]
					[[ startexec_action <- startexec ]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__,
				 		          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = 
			dbisim((let
				stateClockSync = {|get_CLID_SetYaw,SetYaw::entered,get_CLID_SetPitch,SetPitch::entered,get_CLID_Waiting,Waiting::entered|}
			 within
				(MachineBody_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
						    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = 
			dbisim((let
				stateClockSync = {|get_CLID_SetYaw,SetYaw::entered,get_CLID_SetPitch,SetPitch::entered,get_CLID_Waiting,Waiting::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										MachineBody_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
												    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
										[| {|get_CLID_Waiting,Waiting::entered,terminate|} |]
										dbisim(Clock_CLID_Waiting(id__,0,
												          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
									)\{|get_CLID_Waiting|}
								)
								[| {|get_CLID_SetPitch,SetPitch::entered,terminate|} |]
								dbisim(Clock_CLID_SetPitch(id__,0,
										          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
							)\{|get_CLID_SetPitch|}
						)
						[| {|get_CLID_SetYaw,SetYaw::entered,terminate|} |]
						dbisim(Clock_CLID_SetYaw(id__,0,
								          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
					)\{|get_CLID_SetYaw|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = 
			dbisim((let
				getsetLocalChannels = {|get_angle,set_angle,
				get_gimbalYawF,set_gimbalYawF,
				get_gimbalPitchF,set_gimbalPitchF|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
						    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,cycle_pre_pkg__sim_Aim_Aim,
				 		    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) [| {terminate} |] Clocks(id__,
				 		          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) =
			(dbisim(
				sbisim(
					dbisim(
						sbisim(
							dbisim(
								sbisim(
									IteratedBehaviour_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
											    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
									[| {|get_gimbalPitchF,set_gimbalPitchF,terminate|} |]
									Memory_gimbalPitchF(true)
								)\{|get_gimbalPitchF,set_gimbalPitchF|}
							)
							[| {|get_gimbalYawF,set_gimbalYawF,terminate|} |]
							Memory_gimbalYawF(true)
						)\{|get_gimbalYawF,set_gimbalYawF|}
					)
					[| {|get_angle,set_angle,terminate|} |]
					Memory_angle(0)
				)\{|get_angle,set_angle|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_angle(angle) =
			get_angle!angle -> Memory_angle(angle)
			[]
			set_angle?x__ -> Memory_angle(x__)
			[]
			terminate -> SKIP
		Memory_gimbalYawF(gimbalYawF) =
			get_gimbalYawF!gimbalYawF -> Memory_gimbalYawF(gimbalYawF)
			[]
			set_gimbalYawF?x__ -> Memory_gimbalYawF(x__)
			[]
			terminate -> SKIP
		Memory_gimbalPitchF(gimbalPitchF) =
			get_gimbalPitchF!gimbalPitchF -> Memory_gimbalPitchF(gimbalPitchF)
			[]
			set_gimbalPitchF?x__ -> Memory_gimbalPitchF(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = Memory_angle(0)
		[| { terminate } |] (
		Memory_gimbalYawF(true)
		[| { terminate } |] (
		Memory_gimbalPitchF(true)
		)
		)
		
		getsetLocalChannels = {|get_angle,set_angle,get_gimbalYawF,set_gimbalYawF,get_gimbalPitchF,set_gimbalPitchF|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = STM_VS_O(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) \ localClockResets
		D__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = timed_priority(STM(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) \ union(internal_events,localClockResets))
		O__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = dbisim(D__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		VS__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = FVS__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
		VS_O__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = dbisim(FVS__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		HEXT__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = O__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) [|shared_variable_events|] SKIP
		FVS_C__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = dbisim(timed_priority(STM(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) \ internal_events))
		HUP__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = timed_priority(O__(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_SetYaw(id__,x__,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = 
			TimeOut_1(
				SetYaw::entered -> Clock_CLID_SetYaw(id__,0,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				[]
				get_CLID_SetYaw!x__ -> Clock_CLID_SetYaw(id__,x__,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				[]
				terminate -> SKIP,Clock_CLID_SetYaw(id__,clock_type_plus(x__,1,CLID_SetYaw_clock_type(id__,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)),
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		Clock_CLID_SetPitch(id__,x__,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = 
			TimeOut_1(
				SetPitch::entered -> Clock_CLID_SetPitch(id__,0,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				[]
				get_CLID_SetPitch!x__ -> Clock_CLID_SetPitch(id__,x__,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				[]
				terminate -> SKIP,Clock_CLID_SetPitch(id__,clock_type_plus(x__,1,CLID_SetPitch_clock_type(id__,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)),
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		Clock_CLID_Waiting(id__,x__,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = 
			TimeOut_1(
				Waiting::entered -> Clock_CLID_Waiting(id__,0,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				[]
				get_CLID_Waiting!x__ -> Clock_CLID_Waiting(id__,x__,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				[]
				terminate -> SKIP,Clock_CLID_Waiting(id__,clock_type_plus(x__,1,CLID_Waiting_clock_type(id__,
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)),
						          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		
		StateClocks(id__,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = dbisim(Clock_CLID_SetYaw(id__,0,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		[| { terminate } |] (
		dbisim(Clock_CLID_SetPitch(id__,0,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		[| { terminate } |] (
		dbisim(Clock_CLID_Waiting(id__,0,
				          const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY))
		)
		)
		
		stateClockSync = {|get_CLID_SetYaw,SetYaw::entered,get_CLID_SetPitch,SetPitch::entered,get_CLID_Waiting,Waiting::entered|}
		
		
		-- Shared memory
		-- Shared memory variables
		
		Memory_gimbalYaw(x__) = (
			get_gimbalYaw!x__ -> Memory_gimbalYaw(x__)
			[]
			registerRead.i_gimbalYaw?x__ -> Memory_gimbalYaw(x__)
			[]
			terminate -> SKIP
		)
		Memory_gimbalPitch(x__) = (
			get_gimbalPitch!x__ -> Memory_gimbalPitch(x__)
			[]
			registerRead.i_gimbalPitch?x__ -> Memory_gimbalPitch(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_pre_pkg__sim_Aim_Aim,
				    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_gimbalYaw(false.0)
		 [| { terminate } |] (
		 Memory_gimbalPitch(false.0)
		 )
		 )
		)
		
		sharedVarSync = union({|get_gimbalYaw,
		get_gimbalPitch|},
			  {||}
			 )
		
		sharedVarHide = union({|get_gimbalYaw,
		get_gimbalPitch|},
			  {||}
			 )
		
		}
endmodule
