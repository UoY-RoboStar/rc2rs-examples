	endmodule
	module AWaterMonitor
	exports
		transparent diamond
		transparent sbisim
		transparent dbisim
		transparent chase
	
		-- Transition identifiers
		-- declaring identifiers of transitions
		datatype NIDS = 
		              NID_I|
		              NID_Off|
		              NID_On|
		              NID_F
		
		channel internal__ : NIDS
		
		-- Flow channels		
		channel interrupt
		channel exited
		channel exit
		channel terminate
		
		-- Variable channels
		channel get_water, set_water, setL_water, setR_water: core_real
		channel get_inact_WaterMonitor_On, set_inact_WaterMonitor_On, setL_inact_WaterMonitor_On, setR_inact_WaterMonitor_On: core_boolean
		channel get_monitorOffF, set_monitorOffF, setL_monitorOffF, setR_monitorOffF: core_boolean
		channel get_monitorOnF, set_monitorOnF, setL_monitorOnF, setR_monitorOnF: core_boolean
		
		-- Shared variable channels
		
		-- Local variable channels for defined operations that are required by the state machine
		
		-- Declaring state machine events
		
		-- Declaring call and ret events for undefined operations
		
		enterSS = {|
		I::enter,
		Off::enter,
		On::enter,
		F::enter
		|}
		
		enteredSS = 	{|
		Off::entered,
		On::entered,
		F::entered
		|}
		
		internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
		
		shared_variable_events = {|
		|}
		
		datatype ClockSet = 
			CLID_clk_WaterMonitor_On
		
		channel clockReset, clockResetL, clockResetR : ClockSet
		
		localClockResets = {|clockReset.CLID_clk_WaterMonitor_On|}
		
		
		channel get_CLID_On : core_clock_type 
		channel get_CLID_F : core_clock_type 
		channel get_CLID_Off : core_clock_type 
		channel get_CLID_clk_WaterMonitor_On : core_clock_type 
		--channel increment__
		
		CLID_On_clock_type(id__,
				          const_pre_pkg__sim_WaterMonitor_WATER_FLOW,
				          const_pre_pkg__sim_WaterMonitor_TIME_PER_UNIT) = 
			let
				max = (clock_type_max(Union({
		{}
		}))+1)
