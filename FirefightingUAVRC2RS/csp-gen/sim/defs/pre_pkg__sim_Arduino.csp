								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
					
						Behaviour 	= dbisim(
							((
							 (((dbisim(
							 	sbisim(
							 		(let
							 			-- IMPLEMENTATION NOTE:
							 			-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							 			-- modules for defining the semantics of each node.
							 			enterSS = {|
							 			i::enter,
							 			EmptyCycle::enter
							 			|}
							 			hideSet = union(enterSS,{|exit,exited,internal__|})
							 		within 
							 			((let
							 				-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							 				-- because CSPM modules are used for the semantics of Node.
							 				flowevts = union(enterSS,{|exit,exited|})
							 				transSync = {|internal__.NID_i,internal__.NID_EmptyCycle|}
							 			within
							 				((
							 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							 				   i::D__(id__,
							 				   			param_i)
							 				   [| { share__, terminate } |] (
							 				   EmptyCycle::D__(id__,
							 				   			param_i)
							 				   )
							 				 )
							 				 [[EmptyCycle::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_EmptyCycle|}]]
							 				 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
							 				 )
							 				  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 				  [[clockReset.CLID_C <- clockResetL.CLID_C]]
							 				 )
							 				 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
							 				 			,clockResetL.CLID_C
							 				|}) |]
							 				 ((i::enter -> Transitions(id__,
							 				 			param_i))
							 				  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_C |} ]]
							 				 )
							 				)[[clockResetL.CLID_C <- clockReset.CLID_C]]
							 				)
							 			)
							 			 \ hideSet)
							 			[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
							 			[[ endexec_action <- endexec ]]
							 			[[ startexec_action <- startexec ]]
							 		)
							 		[| {|get_CLID_EmptyCycle,EmptyCycle::entered,terminate|} |]
							 		dbisim(Clock_CLID_EmptyCycle(id__,0))
							 	)\{|get_CLID_EmptyCycle|}
							 )
							 ))
							  [[ share__ <- x__ | x__ <- {| share__,clockResetR.CLID_C,setR_gimbalYawF,setR_gimbalPitchF |} ]] 
							  [[clockReset.CLID_C <- clockResetL.CLID_C,set_gimbalYawF <- setL_gimbalYawF,set_gimbalPitchF <- setL_gimbalPitchF]]
							 )
							 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
							 			,clockResetL.CLID_C
							 			,setL_gimbalYawF
							 			,setL_gimbalPitchF
							 			,clockResetR.CLID_C
							 			 			,setR_gimbalYawF
							 			 			,setR_gimbalPitchF
							 			|}) |]
							 ((During)
							  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_C,setL_gimbalYawF,setL_gimbalPitchF |} ]]
							  [[clockReset.CLID_C <- clockResetR.CLID_C,set_gimbalYawF <- setR_gimbalYawF,set_gimbalPitchF <- setR_gimbalPitchF]]
							 )
							)[[clockResetL.CLID_C <- clockReset.CLID_C,setL_gimbalYawF <- set_gimbalYawF,setL_gimbalPitchF <- set_gimbalPitchF]]
							 [[clockResetR.CLID_C <- clockReset.CLID_C,setR_gimbalYawF <- set_gimbalYawF,setR_gimbalPitchF <- set_gimbalPitchF]]
							)\union(enteredSS,{terminate}) 
						)
						During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
								 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_i) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
					
						Behaviour 	= dbisim(
							((
							 (((dbisim(
							 	sbisim(
							 		(let
							 			-- IMPLEMENTATION NOTE:
							 			-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							 			-- modules for defining the semantics of each node.
							 			enterSS = {|
							 			i::enter,
							 			EmptyCycle::enter
							 			|}
							 			hideSet = union(enterSS,{|exit,exited,internal__|})
							 		within 
							 			((let
							 				-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							 				-- because CSPM modules are used for the semantics of Node.
							 				flowevts = union(enterSS,{|exit,exited|})
							 				transSync = {|internal__.NID_i,internal__.NID_EmptyCycle|}
							 			within
							 				((
							 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							 				   i::VS_O__(id__,
							 				   			param_i)
							 				   [| { share__, terminate } |] (
							 				   EmptyCycle::VS_O__(id__,
							 				   			param_i)
							 				   )
							 				 )
							 				 [[EmptyCycle::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_EmptyCycle|}]]
							 				 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
							 				 )
							 				  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 				  [[clockReset.CLID_C <- clockResetL.CLID_C]]
							 				 )
							 				 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
							 				 			,clockResetL.CLID_C
							 				|}) |]
							 				 ((i::enter -> Transitions(id__,
							 				 			param_i))
							 				  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_C |} ]]
							 				 )
							 				)[[clockResetL.CLID_C <- clockReset.CLID_C]]
							 				)
							 			)
							 			 \ hideSet)
							 			[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
							 			[[ endexec_action <- endexec ]]
							 			[[ startexec_action <- startexec ]]
							 		)
							 		[| {|get_CLID_EmptyCycle,EmptyCycle::entered,terminate|} |]
							 		dbisim(Clock_CLID_EmptyCycle(id__,0))
							 	)\{|get_CLID_EmptyCycle|}
							 )
							 ))
							  [[ share__ <- x__ | x__ <- {| share__,clockResetR.CLID_C,setR_gimbalYawF,setR_gimbalPitchF |} ]] 
							  [[clockReset.CLID_C <- clockResetL.CLID_C,set_gimbalYawF <- setL_gimbalYawF,set_gimbalPitchF <- setL_gimbalPitchF]]
							 )
							 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
							 			,clockResetL.CLID_C
							 			,setL_gimbalYawF
							 			,setL_gimbalPitchF
							 			,clockResetR.CLID_C
							 			 			,setR_gimbalYawF
							 			 			,setR_gimbalPitchF
							 			|}) |]
							 ((During)
							  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_C,setL_gimbalYawF,setL_gimbalPitchF |} ]]
							  [[clockReset.CLID_C <- clockResetR.CLID_C,set_gimbalYawF <- setR_gimbalYawF,set_gimbalPitchF <- setR_gimbalPitchF]]
							 )
							)[[clockResetL.CLID_C <- clockReset.CLID_C,setL_gimbalYawF <- set_gimbalYawF,setL_gimbalPitchF <- set_gimbalPitchF]]
							 [[clockResetR.CLID_C <- clockReset.CLID_C,setR_gimbalYawF <- set_gimbalYawF,setR_gimbalPitchF <- set_gimbalPitchF]]
							)\{terminate} 
						)
						During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
								 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
					within
						Inactive [| {terminate} |> SKIP)
					
					Transitions(id__,
								param_i) = ((let
						Trans = share__choice(get_CLID_C?C -> TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_i -> SKIP ;  ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; EmptyCycle::enter -> SKIP))))
							 [] dbisim(((not (((C==param_i)))))&(internal__!NID_EmptyCycle -> SKIP ;  share__choice(exit -> SKIP) ; ((let 
							 	X = share__choice(exited -> SKIP [] endexec -> Y)
							 	Y = share__choice(exited -> SKIP [] startexec -> X)
							  within
							  	X) ; ((endexec -> startexec -> SKIP;share__choice(true & (share__choice(set_gimbalPitchF!true -> SKIP)));share__choice(true & (share__choice(set_gimbalYawF!true -> SKIP))))[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; EmptyCycle::enter -> SKIP)))
							 []
							 (exit -> SKIP ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
							 []
							 (endexec -> SKIP ; share__choice(startexec -> SKIP))
							 )
						,SKIP);Trans
						)
					within
						Trans [|{terminate}|> SKIP
					)
					)
					
					
					-- Clocks
					Clock_CLID_EmptyCycle(id__,x__) = 
						TimeOut_1(
							EmptyCycle::entered -> Clock_CLID_EmptyCycle(id__,0)
							[]
							get_CLID_EmptyCycle!x__ -> Clock_CLID_EmptyCycle(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_EmptyCycle(id__,clock_type_plus(x__,1,CLID_EmptyCycle_clock_type(id__))))
					
					StateClocks(id__) = dbisim(Clock_CLID_EmptyCycle(id__,0))
					
					stateClockSync = {|get_CLID_EmptyCycle,EmptyCycle::entered|}
				}
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Final state: f
			module f
			
			exports
			
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
				Timed(OneStep) {
					--	Rule: behaviours(Node)
					D__(id__,
								param_i) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
							
							Entering 	= entered -> SKIP ; Active
							Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
							Interrupted	= share__choice(exit -> exited -> Inactive)
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_i) = D__(id__,
								param_i)
				}
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			Timed(OneStep) {
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			
			-- END of Operation calls --
		
			-- STM processes
			STM(id__,
						param_i) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__,
						param_i) \ {terminate}
			
			STM_VS_O(id__,
						param_i) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__,
						param_i) \ {terminate}
			
			-- Transitions
			Transitions(id__,
						param_i) = ((let
				Trans = share__choice(get_CLID_C?C:CLID_C_clock_type(id__) -> TimeOut_1(
					 (share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((((share__choice(clockReset.CLID_C -> SKIP))[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; Waiting::enter -> SKIP))))
					 [] dbisim(((C==param_i))&(internal__!NID_Waiting -> SKIP ;  share__choice(exit -> SKIP) ; ((let 
					 	X = share__choice(exited -> SKIP [] endexec -> Y)
					 	Y = share__choice(exited -> SKIP [] startexec -> X)
					  within
					  	X) ; ((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; f::enter -> SKIP)))
					 []
					 (exit -> SKIP ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
					 []
					 (endexec -> SKIP ; share__choice(startexec -> SKIP))
					 )
				,SKIP);Trans
				)
			within
				Trans [|{terminate}|> SKIP
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__,
						param_i) = 
				dbisim((
				let
					finalNodesEntered = {|f::entered|}
				within
					(dbisim((dbisim((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						Waiting::enter,
						f::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited|})
							transSync = {|internal__.NID_i0,internal__.NID_Waiting|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::D__(id__,
							   			param_i)
							   [| { share__, terminate } |] (
							   Waiting::D__(id__,
							   			param_i)
							   [| { share__, terminate } |] (
							   f::D__(id__,
							   			param_i)
							   )
							   )
							 )
							 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Waiting|}]]
							 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							  [[clockReset.CLID_C <- clockResetL.CLID_C]]
							 )
							 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
							 			,clockResetL.CLID_C
							|}) |]
							 ((i0::enter -> Transitions(id__,
							 			param_i))
							  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_C |} ]]
							 )
							)[[clockResetL.CLID_C <- clockReset.CLID_C]]
							)
						)
						 \ hideSet)
						[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
						[[ endexec_action <- endexec ]]
						[[ startexec_action <- startexec ]]
					)
					)
					 [| union(stateClockSync,{terminate}) |]
					 StateClocks(id__)
					)\diff(stateClockSync,enteredSS))
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__,
						param_i) = 
				dbisim((let
					stateClockSync = {|get_CLID_Waiting,Waiting::entered|}
				 within
					(MachineBody(id__,
								param_i) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
				)
				)
			
			
			Stateful(id__,
						param_i) = 
				((let
					getsetLocalChannels = {||}
					clockSync = {|get_CLID_C,clockReset.CLID_C|}
				within
					(Behaviour(id__,
								param_i) 
					 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
					 (varMemory(id__,
					 			param_i) [| {terminate} |] Clocks(id__))
				 	)\union(getsetLocalChannels,clockSync)
				)
				)
			
			
			-- Visible counterparts
			MachineBody_VS_O(id__,
						param_i) = 
				dbisim((
				let
					finalNodesEntered = {|f::entered|}
				within
					(dbisim((dbisim((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						Waiting::enter,
						f::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited|})
							transSync = {|internal__.NID_i0,internal__.NID_Waiting|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::VS_O__(id__,
							   			param_i)
							   [| { share__, terminate } |] (
							   Waiting::VS_O__(id__,
							   			param_i)
							   [| { share__, terminate } |] (
							   f::VS_O__(id__,
							   			param_i)
							   )
							   )
							 )
							 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Waiting|}]]
							 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							  [[clockReset.CLID_C <- clockResetL.CLID_C]]
							 )
							 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
							 			,clockResetL.CLID_C
							|}) |]
							 ((i0::enter -> Transitions(id__,
							 			param_i))
							  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_C |} ]]
							 )
							)[[clockResetL.CLID_C <- clockReset.CLID_C]]
							)
						)
						 \ hideSet)
						[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
						[[ endexec_action <- endexec ]]
						[[ startexec_action <- startexec ]]
					)
					)
					 [| union(stateClockSync,{terminate}) |]
					 StateClocks(id__)
					)\diff(stateClockSync,enteredSS))
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__,
						param_i) = 
				dbisim((let
					stateClockSync = {|get_CLID_Waiting,Waiting::entered|}
				 within
					(MachineBody_VS_O(id__,
								param_i) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
				)
				)
			
			
			Stateful_VS_O(id__,
						param_i) = 
				dbisim((let
					getsetLocalChannels = {||}
					clockSync = {|get_CLID_C,clockReset.CLID_C|}
				within
					(Behaviour_VS_O(id__,
								param_i) 
					 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
					 (varMemory(id__,
					 			param_i) [| {terminate} |] Clocks(id__))
				 	)\union(getsetLocalChannels,clockSync)
				)
				)
			
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__,
						param_i) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
						param_i) = STM_VS_O(id__,
						param_i) \ localClockResets
			D__(id__,
						param_i) = timed_priority(STM(id__,
						param_i) \ union(internal_events,localClockResets))
			O__(id__,
						param_i) = dbisim(D__(id__,
						param_i))
			VS__(id__,
						param_i) = FVS__(id__,
						param_i)
			VS_O__(id__,
						param_i) = dbisim(FVS__(id__,
						param_i))
			HEXT__(id__,
						param_i) = O__(id__,
						param_i) [|shared_variable_events|] SKIP
			FVS_C__(id__,
						param_i) = dbisim(timed_priority(STM(id__,
						param_i) \ internal_events))
			HUP__(id__,
						param_i) = timed_priority(O__(id__,
						param_i) [|{share__}|] SKIP)
			
			-- Clocks
			Clock_CLID_C(id__,x__) = 
				TimeOut_1(
					clockReset.CLID_C -> Clock_CLID_C(id__,0)
					[]
					get_CLID_C!x__ -> Clock_CLID_C(id__,x__)
					[]
					terminate -> SKIP,Clock_CLID_C(id__,clock_type_plus(x__,1,CLID_C_clock_type(id__))))
			
			Clocks(id__) = dbisim(Clock_CLID_C(id__,0))
			
			clockSync = {|get_CLID_C,clockReset.CLID_C|}
			
			Clock_CLID_Waiting(id__,x__) = 
				TimeOut_1(
					Waiting::entered -> Clock_CLID_Waiting(id__,0)
					[]
					get_CLID_Waiting!x__ -> Clock_CLID_Waiting(id__,x__)
					[]
					terminate -> SKIP,Clock_CLID_Waiting(id__,clock_type_plus(x__,1,CLID_Waiting_clock_type(id__))))
			
			StateClocks(id__) = dbisim(Clock_CLID_Waiting(id__,0))
			
			stateClockSync = {|get_CLID_Waiting,Waiting::entered|}
			
			}
				endmodule
	
	Timed(OneStep) {
	-- (Rule 8) cycleController(...) : CSPProcess
	datatype SOutputEvents = SOutput_gimbalYawAck
		| SOutput_pumpOn
		| SOutput_gimbalWriteTilt
		| SOutput_pumpOff
		| SOutput_gimbalWritePan
		| SOutput_gimbalPitchAck
		| SOutput_monitorOn
		| SOutput_waterEmpty
		| SOutput_monitorOff
		| SOutput_monitorEmpty
	
	DVarsEvents = {}
	
	nametype EVarsEvents = {|SOutput_monitorOn
		, SOutput_monitorOff
		, SOutput_monitorEmpty|}	
	
	cycleController(id__,cycle_pre_pkg__sim_Arduino_Arduino,
			    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT) =
	let
				
		project_AAim(AAim::o_gimbalYawAck) = SOutput_gimbalYawAck
		project_AAim(AAim::o_gimbalWriteTilt.x__) = SOutput_gimbalWriteTilt
		project_AAim(AAim::o_gimbalWritePan.x__) = SOutput_gimbalWritePan
		project_AAim(AAim::o_gimbalPitchAck) = SOutput_gimbalPitchAck
		project_ASpray(ASpray::o_pumpOn) = SOutput_pumpOn
		project_ASpray(ASpray::o_pumpOff) = SOutput_pumpOff
		project_ASpray(ASpray::o_monitorOn) = SOutput_monitorOn
		project_ASpray(ASpray::o_waterEmpty) = SOutput_waterEmpty
		project_ASpray(ASpray::o_monitorOff) = SOutput_monitorOff
		project_AWaterMonitor(AWaterMonitor::o_monitorEmpty) = SOutput_monitorEmpty
	
		connected_AAim(AAim::o_gimbalYawAck) = true
		connected_AAim(AAim::o_gimbalWriteTilt.x__) = true
		connected_AAim(AAim::o_gimbalWritePan.x__) = true
		connected_AAim(AAim::o_gimbalPitchAck) = true
		connected_AAim(_) = false
		connected_ASpray(ASpray::o_pumpOn) = true
		connected_ASpray(ASpray::o_pumpOff) = true
		connected_ASpray(ASpray::o_monitorOn) = true
		connected_ASpray(ASpray::o_waterEmpty) = true
		connected_ASpray(ASpray::o_monitorOff) = true
		connected_ASpray(_) = false
		connected_AWaterMonitor(AWaterMonitor::o_monitorEmpty) = true
		connected_AWaterMonitor(_) = false
	
		lift_AAim(AAim::o_gimbalYawAck) = o_gimbalYawAck
		lift_AAim(AAim::o_gimbalWriteTilt.x__) = o_gimbalWriteTilt.x__
		lift_AAim(AAim::o_gimbalWritePan.x__) = o_gimbalWritePan.x__
		lift_AAim(AAim::o_gimbalPitchAck) = o_gimbalPitchAck
		lift_ASpray(ASpray::o_pumpOn) = o_pumpOn
		lift_ASpray(ASpray::o_pumpOff) = o_pumpOff
		lift_ASpray(ASpray::o_waterEmpty) = o_waterEmpty
		
		CycleController =
			Deadline(
			-- read inputs from the controller and pass to state machines
			(
			((registerRead.i_gimbalYaw?x__ ->
				((AAim::registerRead.AAim::i_gimbalYaw!x__ -> SKIP)))
				|||
			(registerRead.i_startSpray?x__ ->
				((ASpray::registerRead.ASpray::i_startSpray!x__ -> SKIP)))
				|||
			(registerRead.i_stopSpray?x__ ->
				((ASpray::registerRead.ASpray::i_stopSpray!x__ -> SKIP)))
				|||
			(registerRead.i_gimbalPitch?x__ ->
				((AAim::registerRead.AAim::i_gimbalPitch!x__ -> SKIP))))
			-- ensure state machines read the values being communicated via evars
			||| ((AWaterMonitor::registerRead.AWaterMonitor::i_monitorOn?x__ -> SKIP)
				|||
			
	(AWaterMonitor::registerRead.AWaterMonitor::i_monitorOff?x__ -> SKIP)
				|||
			
	(ASpray::registerRead.ASpray::i_monitorEmpty?x__ -> SKIP)
	)		);
			-- synchronize on events related to evars to erase memory
			((registerWriteE.e_monitorOn -> SKIP)
				|||
			(registerWriteE.e_monitorOff -> SKIP)
				|||
			(registerWriteE.e_monitorEmpty -> SKIP));
			-- collect outputs, and monitor termination of the cycle, by all controllers
			(CollectOutputs(SOutputEvents) [| {endexec} |] Monitor),0);
			-- wait for the cycleDef period
			TimeOut_1(terminate -> SKIP,WAIT(cycle_pre_pkg__sim_Arduino_Arduino-1));
			-- recurse
			CycleController
			
									
		CollectOutputs(sout) =
			(AAim::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- AAim::RegisterDataOutput, connected_AAim(outp), project_AAim(outp) == outc}
					-> registerWrite!lift_AAim(outp)
						-> CollectOutputs(diff(sout,{project_AAim(outp)}))
			[]
			ASpray::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- ASpray::RegisterDataOutput, connected_ASpray(outp), project_ASpray(outp) == outc}
					-> registerWrite!lift_ASpray(outp)
						-> CollectOutputs(diff(sout,{project_ASpray(outp)}))
			[]
			ASpray::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- ASpray::RegisterDataOutput, connected_ASpray(outp), project_ASpray(outp) == outc}
					-> CollectOutputs(diff(sout,{project_ASpray(outp)}))
			[]
			AWaterMonitor::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- AWaterMonitor::RegisterDataOutput, connected_AWaterMonitor(outp), project_AWaterMonitor(outp) == outc}
					-> CollectOutputs(diff(sout,{project_AWaterMonitor(outp)}))
			[]
			endexec -> SKIP
			)
	
		Monitor = 
			(	 (ASpray::endexec -> SKIP)
			|||	 (AAim::endexec -> SKIP)
			|||	 (AWaterMonitor::endexec -> SKIP)); endexec -> SKIP
	within
		CycleController
	
	-- (Rule 5) memoryComp(...) : CSPProcess
	memoryComp(id__,
			    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT) = (
		Memory_monitorOn(false)
		||| Memory_monitorOff(false)
		||| Memory_monitorEmpty(false)
		)
	
	Memory_monitorOn(x__) = (
		registerWriteE.e_monitorOn -> Memory_monitorOn(false)
		[]
		ASpray::registerWrite.ASpray::o_monitorOn -> Memory_monitorOn(true)
		[]
		AWaterMonitor::registerRead.AWaterMonitor::i_monitorOn!x__ -> Memory_monitorOn(x__)
	)
	Memory_monitorOff(x__) = (
		registerWriteE.e_monitorOff -> Memory_monitorOff(false)
		[]
		ASpray::registerWrite.ASpray::o_monitorOff -> Memory_monitorOff(true)
		[]
		AWaterMonitor::registerRead.AWaterMonitor::i_monitorOff!x__ -> Memory_monitorOff(x__)
	)
	Memory_monitorEmpty(x__) = (
		registerWriteE.e_monitorEmpty -> Memory_monitorEmpty(false)
		[]
		AWaterMonitor::registerWrite.AWaterMonitor::o_monitorEmpty -> Memory_monitorEmpty(true)
		[]
		ASpray::registerRead.ASpray::i_monitorEmpty!x__ -> Memory_monitorEmpty(x__)
	)
	
	-- (Rule 7) [[ c : Controller ]]_C : CSPProcess
	D__(id__,cycle_pre_pkg__sim_Arduino_Arduino,
			    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT) =
	timed_priority(
		(
			(
				(
					(
					dbisim(cycleController(id__,cycle_pre_pkg__sim_Arduino_Arduino,
							    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
							    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
							    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT))
				 	 [| Union({{||},
				 	 		  {|registerWriteE|},
				 	 		  {|AWaterMonitor::registerRead.AWaterMonitor::i_monitorOn,
				 	 		  	AWaterMonitor::registerRead.AWaterMonitor::i_monitorOff,
				 	 		  	ASpray::registerRead.ASpray::i_monitorEmpty|},
				 	 		  {|ASpray::registerWrite.ASpray::o_monitorOn,
				 	 		  	ASpray::registerWrite.ASpray::o_monitorOff,
				 	 		  	AWaterMonitor::registerWrite.AWaterMonitor::o_monitorEmpty|}}) |]
				 	memoryComp(id__,
				 			    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
				 			    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
				 			    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT)
				 	)\{|registerWriteE|}
					[| {| 	terminate,tock,
							ASpray::endexec,ASpray::registerRead,ASpray::registerWrite,
							AAim::endexec,AAim::registerRead,AAim::registerWrite,
							AWaterMonitor::endexec,AWaterMonitor::registerRead,AWaterMonitor::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((
				 		(let
				 			cycle_pre_pkg__sim_Spray_Spray = cycle_pre_pkg__sim_Arduino_Arduino
				 		within
				 			(ASpray::D__(id__,cycle_pre_pkg__sim_Spray_Spray)
				 			\{| |})
				 			[[ASpray::terminate <- terminate]]
				 		)
				 		[|{tock,terminate}|]
				 		(
				 			(let
				 				const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY = const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY
				 				cycle_pre_pkg__sim_Aim_Aim = cycle_pre_pkg__sim_Arduino_Arduino
				 			within
				 				(AAim::D__(id__,cycle_pre_pkg__sim_Aim_Aim,
				 						    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				 				\{| |})
				 				[[AAim::terminate <- terminate]]
				 			)
				 			[|{tock,terminate}|]
				 			(let
				 				const_pre_pkg__sim_WaterMonitor_WATER_FLOW = const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW
				 				const_pre_pkg__sim_WaterMonitor_TIME_PER_UNIT = 1
				 				cycle_pre_pkg__sim_WaterMonitor_WaterMonitor = cycle_pre_pkg__sim_Arduino_Arduino
				 			within
				 				(AWaterMonitor::D__(id__,cycle_pre_pkg__sim_WaterMonitor_WaterMonitor,
				 						    const_pre_pkg__sim_WaterMonitor_WATER_FLOW,
				 						    const_pre_pkg__sim_WaterMonitor_TIME_PER_UNIT)
				 				\{| |})
				 				[[AWaterMonitor::terminate <- terminate]]
				 			)
				 		)
				 	)
				 	)
				) \ {|	ASpray::endexec,ASpray::registerRead,ASpray::registerWrite,
						AAim::endexec,AAim::registerRead,AAim::registerWrite,
						AWaterMonitor::endexec,AWaterMonitor::registerRead,AWaterMonitor::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	
	O__(id__,cycle_pre_pkg__sim_Arduino_Arduino,
			    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
			    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT) = 
	timed_priority(
		dbisim(
			(
				(
					(
					dbisim(cycleController(id__,cycle_pre_pkg__sim_Arduino_Arduino,
							    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
							    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
							    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT))
				 	 [| Union({{||},
				 	 		  {|registerWriteE|},
				 	 		  {|AWaterMonitor::registerRead.AWaterMonitor::i_monitorOn,
				 	 		  	AWaterMonitor::registerRead.AWaterMonitor::i_monitorOff,
				 	 		  	ASpray::registerRead.ASpray::i_monitorEmpty|},
				 	 		  {|ASpray::registerWrite.ASpray::o_monitorOn,
				 	 		  	ASpray::registerWrite.ASpray::o_monitorOff,
				 	 		  	AWaterMonitor::registerWrite.AWaterMonitor::o_monitorEmpty|}}) |]
				 	memoryComp(id__,
				 			    const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY,
				 			    const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW,
				 			    const_pre_pkg__sim_Arduino_AWaterMonitor_TIME_PER_UNIT)
				 	)\{|registerWriteE|}
					[| {| 	terminate,tock,
							ASpray::endexec,ASpray::registerRead,ASpray::registerWrite,
							AAim::endexec,AAim::registerRead,AAim::registerWrite,
							AWaterMonitor::endexec,AWaterMonitor::registerRead,AWaterMonitor::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((
				 		(let
				 			cycle_pre_pkg__sim_Spray_Spray = cycle_pre_pkg__sim_Arduino_Arduino
				 		within
				 			(ASpray::O__(id__,cycle_pre_pkg__sim_Spray_Spray)
				 			\{| |})
				 			[[ASpray::terminate <- terminate]]
				 		)
				 		[|{tock,terminate}|]
				 		(
				 			(let
				 				const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY = const_pre_pkg__sim_Arduino_AAim_GIMBAL_FLOOD_DELAY
				 				cycle_pre_pkg__sim_Aim_Aim = cycle_pre_pkg__sim_Arduino_Arduino
				 			within
				 				(AAim::O__(id__,cycle_pre_pkg__sim_Aim_Aim,
				 						    const_pre_pkg__sim_Aim_GIMBAL_FLOOD_DELAY)
				 				\{| |})
				 				[[AAim::terminate <- terminate]]
				 			)
				 			[|{tock,terminate}|]
				 			(let
				 				const_pre_pkg__sim_WaterMonitor_WATER_FLOW = const_pre_pkg__sim_Arduino_AWaterMonitor_WATER_FLOW
				 				const_pre_pkg__sim_WaterMonitor_TIME_PER_UNIT = 1
				 				cycle_pre_pkg__sim_WaterMonitor_WaterMonitor = cycle_pre_pkg__sim_Arduino_Arduino
				 			within
				 				(AWaterMonitor::O__(id__,cycle_pre_pkg__sim_WaterMonitor_WaterMonitor,
				 						    const_pre_pkg__sim_WaterMonitor_WATER_FLOW,
				 						    const_pre_pkg__sim_WaterMonitor_TIME_PER_UNIT)
				 				\{| |})
				 				[[AWaterMonitor::terminate <- terminate]]
				 			)
				 		)
				 	)
				 	)
				) \ {|	ASpray::endexec,ASpray::registerRead,ASpray::registerWrite,
						AAim::endexec,AAim::registerRead,AAim::registerWrite,
						AWaterMonitor::endexec,AWaterMonitor::registerRead,AWaterMonitor::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	}
endmodule
