				    const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = timed_priority(O__(id__,cycle_pre_pkg__sim_BatteryMonitor_BatteryMonitor,
				    const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
				    const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Monitoring(id__,x__,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = 
			TimeOut_1(
				Monitoring::entered -> Clock_CLID_Monitoring(id__,0,
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)
				[]
				get_CLID_Monitoring!x__ -> Clock_CLID_Monitoring(id__,x__,
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)
				[]
				terminate -> SKIP,Clock_CLID_Monitoring(id__,clock_type_plus(x__,1,CLID_Monitoring_clock_type(id__,
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)),
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
						          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD))
		
		StateClocks(id__,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = dbisim(Clock_CLID_Monitoring(id__,0,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
				          const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD))
		
		stateClockSync = {|get_CLID_Monitoring,Monitoring::entered|}
		
		
		-- Shared memory
		-- Shared memory variables
		
		Memory_batteryInfo(x__) = (
			get_batteryInfo!x__ -> Memory_batteryInfo(x__)
			[]
			registerRead.i_batteryInfo?x__ -> Memory_batteryInfo(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_pre_pkg__sim_BatteryMonitor_BatteryMonitor,
				    const_pre_pkg__sim_BatteryMonitor_BATTERY_LOW_THRESHOLD,
				    const_pre_pkg__sim_BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_batteryInfo(false.(0))
		 )
		)
		
		sharedVarSync = union({|get_batteryInfo|},
			  {||}
			 )
		
		sharedVarHide = union({|get_batteryInfo|},
			  {||}
			 )
		
		}
endmodule
