				Yaw::entered -> Clock_CLID_Yaw(id__,0,
						          const_pre_pkg__sim_GimbalAim_TRACK_DIST)
				[]
				get_CLID_Yaw!x__ -> Clock_CLID_Yaw(id__,x__,
						          const_pre_pkg__sim_GimbalAim_TRACK_DIST)
				[]
				terminate -> SKIP,Clock_CLID_Yaw(id__,clock_type_plus(x__,1,CLID_Yaw_clock_type(id__,
						          const_pre_pkg__sim_GimbalAim_TRACK_DIST)),
						          const_pre_pkg__sim_GimbalAim_TRACK_DIST))
		
		StateClocks(id__,
				          const_pre_pkg__sim_GimbalAim_TRACK_DIST) = dbisim(Clock_CLID_Calculate(id__,0,
				          const_pre_pkg__sim_GimbalAim_TRACK_DIST))
		[| { terminate } |] (
		dbisim(Clock_CLID_Clamp(id__,0,
				          const_pre_pkg__sim_GimbalAim_TRACK_DIST))
		[| { terminate } |] (
		dbisim(Clock_CLID_Pitch(id__,0,
				          const_pre_pkg__sim_GimbalAim_TRACK_DIST))
		[| { terminate } |] (
		dbisim(Clock_CLID_Waiting(id__,0,
				          const_pre_pkg__sim_GimbalAim_TRACK_DIST))
		[| { terminate } |] (
		dbisim(Clock_CLID_Yaw(id__,0,
				          const_pre_pkg__sim_GimbalAim_TRACK_DIST))
		)
		)
		)
		)
		
		stateClockSync = {|get_CLID_Calculate,Calculate::entered,get_CLID_Clamp,Clamp::entered,get_CLID_Pitch,Pitch::entered,get_CLID_Waiting,Waiting::entered,get_CLID_Yaw,Yaw::entered|}
		
		
		-- Shared memory
		-- Shared memory variables
		
		Memory_fgSeenFire(x__) = (
			get_fgSeenFire!x__ -> Memory_fgSeenFire(x__)
			[]
			registerRead.i_fgSeenFire?x__ -> Memory_fgSeenFire(x__)
			[]
			terminate -> SKIP
		)
		Memory_gimbalYawAck(x__) = (
			get_gimbalYawAck!x__ -> Memory_gimbalYawAck(x__)
			[]
			registerRead.i_gimbalYawAck?x__ -> Memory_gimbalYawAck(x__)
			[]
			terminate -> SKIP
		)
		Memory_gimbalPitchAck(x__) = (
			get_gimbalPitchAck!x__ -> Memory_gimbalPitchAck(x__)
			[]
			registerRead.i_gimbalPitchAck?x__ -> Memory_gimbalPitchAck(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_pre_pkg__sim_GimbalAim_GimbalAim,
				    const_pre_pkg__sim_GimbalAim_TRACK_DIST) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_fgSeenFire(false.(FireStatus_NoFire,0,0,0))
		 [| { terminate } |] (
		 Memory_gimbalYawAck(false)
		 [| { terminate } |] (
		 Memory_gimbalPitchAck(false)
		 )
		 )
		 )
		)
		
		sharedVarSync = union({|get_fgSeenFire,
		get_gimbalYawAck,
		get_gimbalPitchAck|},
			  {||}
			 )
		
		sharedVarHide = union({|get_fgSeenFire,
		get_gimbalYawAck,
		get_gimbalPitchAck|},
			  {||}
			 )
		
		}
endmodule
