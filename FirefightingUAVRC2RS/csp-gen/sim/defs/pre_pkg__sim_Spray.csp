			let
				finalNodesEntered = {|Out::entered|}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					I::enter,
					Off::enter,
					Out::enter,
					On::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited|})
						transSync = {|internal__.NID_I,internal__.NID_Off,internal__.NID_Off,internal__.NID_On,internal__.NID_On|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   I::VS_O__(id__,cycle_pre_pkg__sim_Spray_Spray)
						   [| { share__, terminate } |] (
						   Off::VS_O__(id__,cycle_pre_pkg__sim_Spray_Spray)
						   [| { share__, terminate } |] (
						   Out::VS_O__(id__,cycle_pre_pkg__sim_Spray_Spray)
						   [| { share__, terminate } |] (
						   On::VS_O__(id__,cycle_pre_pkg__sim_Spray_Spray)
						   )
						   )
						   )
						 )
						 [[Off::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Off,internal__.NID_Off|}]]
						 [[Out::interrupt <- x__ | x__ <- {|interrupt|}]]
						 [[On::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_On,internal__.NID_On|}]]
						 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						  [[set_stopSprayF <- setL_stopSprayF,set_startSprayF <- setL_startSprayF,set_monitorEmptyF <- setL_monitorEmptyF]]
						 )
						 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
						 			,setL_stopSprayF
						 			,setL_startSprayF
						 			,setL_monitorEmptyF
						|}) |]
						 ((I::enter -> Transitions(id__,cycle_pre_pkg__sim_Spray_Spray))
						  [[ share__ <- x__ | x__ <- {| share__,setL_stopSprayF,setL_startSprayF,setL_monitorEmptyF |} ]]
						 )
						)[[setL_stopSprayF <- set_stopSprayF,setL_startSprayF <- set_startSprayF,setL_monitorEmptyF <- set_monitorEmptyF]]
						)
					)
					 \ hideSet)
					[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
					[[ endexec_action <- endexec ]]
					[[ startexec_action <- startexec ]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray) = 
			dbisim((let
				stateClockSync = {|get_CLID_Off,Off::entered,get_CLID_On,On::entered|}
			 within
				(MachineBody_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray) = 
			dbisim((let
				stateClockSync = {|get_CLID_Off,Off::entered,get_CLID_On,On::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray)
								[| {|get_CLID_On,On::entered,terminate|} |]
								dbisim(Clock_CLID_On(id__,0))
							)\{|get_CLID_On|}
						)
						[| {|get_CLID_Off,Off::entered,terminate|} |]
						dbisim(Clock_CLID_Off(id__,0))
					)\{|get_CLID_Off|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray) = 
			dbisim((let
				getsetLocalChannels = {|get_stopSprayF,set_stopSprayF,
				get_monitorEmptyF,set_monitorEmptyF,
				get_startSprayF,set_startSprayF|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,cycle_pre_pkg__sim_Spray_Spray) [| {terminate} |] Clocks(id__))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray) =
			(dbisim(
				sbisim(
					dbisim(
						sbisim(
							dbisim(
								sbisim(
									IteratedBehaviour_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray)
									[| {|get_startSprayF,set_startSprayF,terminate|} |]
									Memory_startSprayF(true)
								)\{|get_startSprayF,set_startSprayF|}
							)
							[| {|get_monitorEmptyF,set_monitorEmptyF,terminate|} |]
							Memory_monitorEmptyF(true)
						)\{|get_monitorEmptyF,set_monitorEmptyF|}
					)
					[| {|get_stopSprayF,set_stopSprayF,terminate|} |]
					Memory_stopSprayF(true)
				)\{|get_stopSprayF,set_stopSprayF|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_stopSprayF(stopSprayF) =
			get_stopSprayF!stopSprayF -> Memory_stopSprayF(stopSprayF)
			[]
			set_stopSprayF?x__ -> Memory_stopSprayF(x__)
			[]
			terminate -> SKIP
		Memory_monitorEmptyF(monitorEmptyF) =
			get_monitorEmptyF!monitorEmptyF -> Memory_monitorEmptyF(monitorEmptyF)
			[]
			set_monitorEmptyF?x__ -> Memory_monitorEmptyF(x__)
			[]
			terminate -> SKIP
		Memory_startSprayF(startSprayF) =
			get_startSprayF!startSprayF -> Memory_startSprayF(startSprayF)
			[]
			set_startSprayF?x__ -> Memory_startSprayF(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,cycle_pre_pkg__sim_Spray_Spray) = Memory_stopSprayF(true)
		[| { terminate } |] (
		Memory_monitorEmptyF(true)
		[| { terminate } |] (
		Memory_startSprayF(true)
		)
		)
		
		getsetLocalChannels = {|get_stopSprayF,set_stopSprayF,get_monitorEmptyF,set_monitorEmptyF,get_startSprayF,set_startSprayF|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,cycle_pre_pkg__sim_Spray_Spray) = STM_VS_O(id__,cycle_pre_pkg__sim_Spray_Spray) \ localClockResets
		D__(id__,cycle_pre_pkg__sim_Spray_Spray) = timed_priority(STM(id__,cycle_pre_pkg__sim_Spray_Spray) \ union(internal_events,localClockResets))
		O__(id__,cycle_pre_pkg__sim_Spray_Spray) = dbisim(D__(id__,cycle_pre_pkg__sim_Spray_Spray))
		VS__(id__,cycle_pre_pkg__sim_Spray_Spray) = FVS__(id__,cycle_pre_pkg__sim_Spray_Spray)
		VS_O__(id__,cycle_pre_pkg__sim_Spray_Spray) = dbisim(FVS__(id__,cycle_pre_pkg__sim_Spray_Spray))
		HEXT__(id__,cycle_pre_pkg__sim_Spray_Spray) = O__(id__,cycle_pre_pkg__sim_Spray_Spray) [|shared_variable_events|] SKIP
		FVS_C__(id__,cycle_pre_pkg__sim_Spray_Spray) = dbisim(timed_priority(STM(id__,cycle_pre_pkg__sim_Spray_Spray) \ internal_events))
		HUP__(id__,cycle_pre_pkg__sim_Spray_Spray) = timed_priority(O__(id__,cycle_pre_pkg__sim_Spray_Spray) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Off(id__,x__) = 
			TimeOut_1(
				Off::entered -> Clock_CLID_Off(id__,0)
				[]
				get_CLID_Off!x__ -> Clock_CLID_Off(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Off(id__,clock_type_plus(x__,1,CLID_Off_clock_type(id__))))
		Clock_CLID_On(id__,x__) = 
			TimeOut_1(
				On::entered -> Clock_CLID_On(id__,0)
				[]
				get_CLID_On!x__ -> Clock_CLID_On(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_On(id__,clock_type_plus(x__,1,CLID_On_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_Off(id__,0))
		[| { terminate } |] (
		dbisim(Clock_CLID_On(id__,0))
		)
		
		stateClockSync = {|get_CLID_Off,Off::entered,get_CLID_On,On::entered|}
		
		
		-- Shared memory
		-- Shared memory variables
		
		Memory_monitorEmpty(x__) = (
			get_monitorEmpty!x__ -> Memory_monitorEmpty(x__)
			[]
			registerRead.i_monitorEmpty?x__ -> Memory_monitorEmpty(x__)
			[]
			terminate -> SKIP
		)
		Memory_startSpray(x__) = (
			get_startSpray!x__ -> Memory_startSpray(x__)
			[]
			registerRead.i_startSpray?x__ -> Memory_startSpray(x__)
			[]
			terminate -> SKIP
		)
		Memory_stopSpray(x__) = (
			get_stopSpray!x__ -> Memory_stopSpray(x__)
			[]
			registerRead.i_stopSpray?x__ -> Memory_stopSpray(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_pre_pkg__sim_Spray_Spray) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_monitorEmpty(false)
		 [| { terminate } |] (
		 Memory_startSpray(false)
		 [| { terminate } |] (
		 Memory_stopSpray(false)
		 )
		 )
		 )
		)
		
		sharedVarSync = union({|get_monitorEmpty,
		get_startSpray,
		get_stopSpray|},
			  {||}
			 )
		
		sharedVarHide = union({|get_monitorEmpty,
		get_startSpray,
		get_stopSpray|},
			  {||}
			 )
		
		}
endmodule
