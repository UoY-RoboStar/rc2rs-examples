		connected_ARaspberryPi(ARaspberryPi::o_fcLandCall) = true
		connected_ARaspberryPi(ARaspberryPi::o_fcMoveRelativeCall.x__) = true
		connected_ARaspberryPi(ARaspberryPi::o_fcGoHomeCall) = true
