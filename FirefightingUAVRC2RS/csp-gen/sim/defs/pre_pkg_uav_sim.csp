	-- declaring inputs and outputs of the module
	
	Timed(OneStep) {
	-- (Rule 3) cycleModule(...) : CSPProcess
	
	datatype COutputEvents = COutput_fcWaypointCall
		| COutput_gimbalWriteTilt
		| COutput_gimbalWritePan
		| COutput_pumpOn
		| COutput_gimbalYaw
		| COutput_gimbalPitch
		| COutput_missionStatus
		| COutput_waterEmpty
