		lift_ARaspberryPi(ARaspberryPi::o_fcLandCall) = o_fcLandCall
		lift_ARaspberryPi(ARaspberryPi::o_fcMoveRelativeCall.x__) = o_fcMoveRelativeCall.x__
		lift_ARaspberryPi(ARaspberryPi::o_missionStatus.x__) = o_missionStatus.x__
		lift_ARaspberryPi(ARaspberryPi::o_fcGoHomeCall) = o_fcGoHomeCall
