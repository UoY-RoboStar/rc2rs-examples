				-- END of Operation calls --
			
				datatype SOutputEvents = SOutput_missionStatus
					| SOutput_stopSpray
					| SOutput_startSpray
					| SOutput_navCommand
					| SOutput_waypoint
					| SOutput_vnavEnable
					| SOutput_vnavDisable
				
				cycle(cycle_pre_pkg__sim_Planning_Planning) =
					let
						project(o_missionStatus.x__) = SOutput_missionStatus
						project(o_stopSpray) = SOutput_stopSpray
						project(o_startSpray) = SOutput_startSpray
						project(o_navCommand.x__) = SOutput_navCommand
						project(o_waypoint.x__) = SOutput_waypoint
						project(o_vnavEnable) = SOutput_vnavEnable
						project(o_vnavDisable) = SOutput_vnavDisable
				
						Cycle =
							Deadline(
								(registerRead.i_uavStatus?x__ -> SKIP
									||| registerRead.i_trackingGained?x__ -> SKIP
									||| registerRead.i_trackingLost?x__ -> SKIP
									||| registerRead.i_batteryLow?x__ -> SKIP
									||| registerRead.i_fireLost?x__ -> SKIP
									||| registerRead.i_gimbalAimed?x__ -> SKIP
