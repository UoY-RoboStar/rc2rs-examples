						(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
					)
					)
				
				
				Stateful_VS_O(id__) = 
					dbisim((let
						getsetLocalChannels = {||}
						clockSync = {||}
					within
						(Behaviour_VS_O(id__) 
						 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
						 (varMemory(id__) [| {terminate} |] Clocks(id__))
					 	)\union(getsetLocalChannels,clockSync)
					)
					)
				
				
				-- END
				
				-- Memory
				-- Memory variables
				
				-- varMemory process
				varMemory(id__) = terminate -> SKIP
				
				getsetLocalChannels = {||}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__) = STM_VS_O(id__) \ localClockResets
				D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
				O__(id__) = dbisim(D__(id__))
				VS__(id__) = FVS__(id__)
				VS_O__(id__) = dbisim(FVS__(id__))
				HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
				FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
				HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
				
				-- Clocks
				
				Clocks(id__) = terminate -> SKIP
				
				clockSync = {||}
				
				
				StateClocks(id__) = terminate -> SKIP
				
				stateClockSync = {||}
				
				}
					endmodule
		
		Timed(OneStep) {
		-- (Rule 8) cycleController(...) : CSPProcess
		datatype SOutputEvents = SOutput_missionStatus
			| SOutput_fcMoveRelativeCall
			| SOutput_trackingGained
			| SOutput_fcWaypointCall
			| SOutput_fireDetected
			| SOutput_navCommand
			| SOutput_startSpray
			| SOutput_fvSeenFire
			| SOutput_fireLost
			| SOutput_trackingLost
			| SOutput_gimbalYaw
			| SOutput_waypoint
			| SOutput_gimbalAimed
			| SOutput_gimbalPitch
			| SOutput_wallMetrics
			| SOutput_stopSpray
			| SOutput_vnavDisable
			| SOutput_fcGoHomeCall
			| SOutput_fcTakeoffCall
			| SOutput_uavStatus
			| SOutput_visualPosition
			| SOutput_fgSeenFire
			| SOutput_fcLandCall
			| SOutput_vnavEnable
			| SOutput_batteryLow
		
		DVarsEvents = {}
		
		nametype EVarsEvents = {|SOutput_waypoint
			, SOutput_gimbalAimed
			, SOutput_wallMetrics
			, SOutput_trackingGained
			, SOutput_fireDetected
			, SOutput_navCommand
			, SOutput_vnavDisable
			, SOutput_uavStatus
			, SOutput_fvSeenFire
			, SOutput_fireLost
			, SOutput_visualPosition
			, SOutput_fgSeenFire
			, SOutput_trackingLost
			, SOutput_vnavEnable
			, SOutput_batteryLow|}	
		
		cycleController(id__,cycle_pre_pkg__sim_RaspberryPi_RaspberryPi,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_LEFT_X,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_CENTRE_X,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_RIGHT_X,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_CENTRE_Y,
				    const_pre_pkg__sim_RaspberryPi_CVisualNav_TRACK_DIST,
				    const_pre_pkg__sim_RaspberryPi_CVisualNav_SCAN_DIST,
				    const_pre_pkg__sim_RaspberryPi_CFlight_CLIMB_LIFT,
				    const_pre_pkg__sim_RaspberryPi_CFlight_DELAY_DISARM,
				    const_pre_pkg__sim_RaspberryPi_CFlight_HOME,
				    const_pre_pkg__sim_RaspberryPi_CBatteryMonitor_BATTERY_LOW_THRESHOLD,
				    const_pre_pkg__sim_RaspberryPi_CBatteryMonitor_BATTERY_UNSAFE_THRESHOLD,
				    const_pre_pkg__sim_RaspberryPi_CGimbalAim_TRACK_DIST,
				    const_pre_pkg__sim_RaspberryPi_CPlanning_WALL_LOC,
				    const_pre_pkg__sim_RaspberryPi_CPlanning_FIRE_TO,
				    const_pre_pkg__sim_RaspberryPi_CPlanning_INIT_TO) =
		let
					
			project_CPlanning(CPlanning::o_missionStatus.x__) = SOutput_missionStatus
			project_CPlanning(CPlanning::o_navCommand.x__) = SOutput_navCommand
			project_CPlanning(CPlanning::o_startSpray) = SOutput_startSpray
			project_CPlanning(CPlanning::o_waypoint.x__) = SOutput_waypoint
			project_CPlanning(CPlanning::o_stopSpray) = SOutput_stopSpray
			project_CPlanning(CPlanning::o_vnavDisable) = SOutput_vnavDisable
			project_CPlanning(CPlanning::o_vnavEnable) = SOutput_vnavEnable
			project_CFlight(CFlight::o_fcMoveRelativeCall.x__) = SOutput_fcMoveRelativeCall
			project_CFlight(CFlight::o_fcWaypointCall.x__) = SOutput_fcWaypointCall
			project_CFlight(CFlight::o_fcGoHomeCall) = SOutput_fcGoHomeCall
			project_CFlight(CFlight::o_fcTakeoffCall) = SOutput_fcTakeoffCall
			project_CFlight(CFlight::o_uavStatus.x__) = SOutput_uavStatus
			project_CFlight(CFlight::o_fcLandCall) = SOutput_fcLandCall
			project_CFireDetect(CFireDetect::o_trackingGained) = SOutput_trackingGained
			project_CFireDetect(CFireDetect::o_fireDetected) = SOutput_fireDetected
			project_CFireDetect(CFireDetect::o_fvSeenFire.x__) = SOutput_fvSeenFire
			project_CFireDetect(CFireDetect::o_fireLost) = SOutput_fireLost
			project_CFireDetect(CFireDetect::o_trackingLost) = SOutput_trackingLost
			project_CFireDetect(CFireDetect::o_wallMetrics.x__) = SOutput_wallMetrics
			project_CFireDetect(CFireDetect::o_fgSeenFire.x__) = SOutput_fgSeenFire
			project_CGimbalAim(CGimbalAim::o_gimbalYaw.x__) = SOutput_gimbalYaw
			project_CGimbalAim(CGimbalAim::o_gimbalAimed) = SOutput_gimbalAimed
			project_CGimbalAim(CGimbalAim::o_gimbalPitch.x__) = SOutput_gimbalPitch
			project_CVisualNav(CVisualNav::o_visualPosition.x__) = SOutput_visualPosition
			project_CBatteryMonitor(CBatteryMonitor::o_batteryLow) = SOutput_batteryLow
		
			connected_CPlanning(CPlanning::o_missionStatus.x__) = true
			connected_CPlanning(CPlanning::o_navCommand.x__) = true
			connected_CPlanning(CPlanning::o_startSpray) = true
			connected_CPlanning(CPlanning::o_waypoint.x__) = true
			connected_CPlanning(CPlanning::o_stopSpray) = true
			connected_CPlanning(CPlanning::o_vnavDisable) = true
			connected_CPlanning(CPlanning::o_vnavEnable) = true
			connected_CPlanning(_) = false
			connected_CFlight(CFlight::o_fcMoveRelativeCall.x__) = true
			connected_CFlight(CFlight::o_fcWaypointCall.x__) = true
			connected_CFlight(CFlight::o_fcGoHomeCall) = true
			connected_CFlight(CFlight::o_fcTakeoffCall) = true
			connected_CFlight(CFlight::o_uavStatus.x__) = true
			connected_CFlight(CFlight::o_fcLandCall) = true
			connected_CFlight(_) = false
			connected_CFireDetect(CFireDetect::o_trackingGained) = true
			connected_CFireDetect(CFireDetect::o_fireDetected) = true
			connected_CFireDetect(CFireDetect::o_fvSeenFire.x__) = true
			connected_CFireDetect(CFireDetect::o_fireLost) = true
			connected_CFireDetect(CFireDetect::o_trackingLost) = true
			connected_CFireDetect(CFireDetect::o_wallMetrics.x__) = true
			connected_CFireDetect(CFireDetect::o_fgSeenFire.x__) = true
			connected_CFireDetect(_) = false
			connected_CGimbalAim(CGimbalAim::o_gimbalYaw.x__) = true
			connected_CGimbalAim(CGimbalAim::o_gimbalAimed) = true
			connected_CGimbalAim(CGimbalAim::o_gimbalPitch.x__) = true
			connected_CGimbalAim(_) = false
			connected_CVisualNav(CVisualNav::o_visualPosition.x__) = true
			connected_CVisualNav(_) = false
			connected_CBatteryMonitor(CBatteryMonitor::o_batteryLow) = true
			connected_CBatteryMonitor(_) = false
		
			lift_CPlanning(CPlanning::o_stopSpray) = o_stopSpray
			lift_CPlanning(CPlanning::o_missionStatus.x__) = o_missionStatus.x__
			lift_CPlanning(CPlanning::o_startSpray) = o_startSpray
			lift_CGimbalAim(CGimbalAim::o_gimbalPitch.x__) = o_gimbalPitch.x__
			lift_CGimbalAim(CGimbalAim::o_gimbalYaw.x__) = o_gimbalYaw.x__
			lift_CFlight(CFlight::o_fcGoHomeCall) = o_fcGoHomeCall
			lift_CFlight(CFlight::o_fcMoveRelativeCall.x__) = o_fcMoveRelativeCall.x__
			lift_CFlight(CFlight::o_fcTakeoffCall) = o_fcTakeoffCall
			lift_CFlight(CFlight::o_fcWaypointCall.x__) = o_fcWaypointCall.x__
			lift_CFlight(CFlight::o_fcLandCall) = o_fcLandCall
			
			CycleController =
				Deadline(
				-- read inputs from the controller and pass to state machines
				(
				((registerRead.i_waterEmpty?x__ ->
					((CPlanning::registerRead.CPlanning::i_waterEmpty!x__ -> SKIP)))
					|||
				(registerRead.i_fcWaypointFinishedMission?x__ ->
					((CFlight::registerRead.CFlight::i_fcWaypointFinishedMission!x__ -> SKIP)))
					|||
				(registerRead.i_fcLandRet?x__ ->
					((CFlight::registerRead.CFlight::i_fcLandRet!x__ -> SKIP)))
					|||
				(registerRead.i_batteryInfo?x__ ->
					((CBatteryMonitor::registerRead.CBatteryMonitor::i_batteryInfo!x__ -> SKIP)))
					|||
				(registerRead.i_fcMoveRelativeRet?x__ ->
					SKIP)
					|||
				(registerRead.i_mlxHeatmap?x__ ->
					((CFireDetect::registerRead.CFireDetect::i_mlxHeatmap!x__ -> SKIP)))
					|||
				(registerRead.i_fcControlAuth?x__ ->
					((CFlight::registerRead.CFlight::i_fcControlAuth!x__ -> SKIP)))
					|||
				(registerRead.i_fcTakeoffRet?x__ ->
					((CFlight::registerRead.CFlight::i_fcTakeoffRet!x__ -> SKIP)))
					|||
				(registerRead.i_gimbalPitchAck?x__ ->
					((CGimbalAim::registerRead.CGimbalAim::i_gimbalPitchAck!x__ -> SKIP)))
					|||
				(registerRead.i_rsRgbFrame?x__ ->
					((CFireDetect::registerRead.CFireDetect::i_rsRgbFrame!x__ -> SKIP)))
					|||
				(registerRead.i_gimbalYawAck?x__ ->
					((CGimbalAim::registerRead.CGimbalAim::i_gimbalYawAck!x__ -> SKIP)))
					|||
				(registerRead.i_rsDepthFrame?x__ ->
					((CFireDetect::registerRead.CFireDetect::i_rsDepthFrame!x__ -> SKIP)))
					|||
				(registerRead.i_fcGoHomeRet?x__ ->
					SKIP))
				-- ensure state machines read the values being communicated via evars
				||| ((CFlight::registerRead.CFlight::i_waypoint?x__ -> SKIP)
					|||
				
		(CPlanning::registerRead.CPlanning::i_gimbalAimed?x__ -> SKIP)
					|||
				
		(CVisualNav::registerRead.CVisualNav::i_wallMetrics?x__ -> SKIP)
					|||
				
		(CPlanning::registerRead.CPlanning::i_trackingGained?x__ -> SKIP)
					|||
				
		(CPlanning::registerRead.CPlanning::i_fireDetected?x__ -> SKIP)
					|||
				
		(CFlight::registerRead.CFlight::i_navCommand?x__ -> SKIP)
					|||
				
		(CVisualNav::registerRead.CVisualNav::i_vnavDisable?x__ -> SKIP)
					|||
				
		(CPlanning::registerRead.CPlanning::i_uavStatus?x__ -> SKIP)
					|||
				
		(CVisualNav::registerRead.CVisualNav::i_fvSeenFire?x__ -> SKIP)
					|||
				
		(CPlanning::registerRead.CPlanning::i_fireLost?x__ -> SKIP)
					|||
				
		(CFlight::registerRead.CFlight::i_visualPosition?x__ -> SKIP)
					|||
				
		(CGimbalAim::registerRead.CGimbalAim::i_fgSeenFire?x__ -> SKIP)
					|||
				
		(CPlanning::registerRead.CPlanning::i_trackingLost?x__ -> SKIP)
					|||
				
		(CVisualNav::registerRead.CVisualNav::i_vnavEnable?x__ -> SKIP)
					|||
				
		(CPlanning::registerRead.CPlanning::i_batteryLow?x__ -> SKIP)
		)		);
				-- synchronize on events related to evars to erase memory
				((registerWriteE.e_waypoint -> SKIP)
					|||
				(registerWriteE.e_gimbalAimed -> SKIP)
					|||
				(registerWriteE.e_wallMetrics -> SKIP)
					|||
				(registerWriteE.e_trackingGained -> SKIP)
					|||
				(registerWriteE.e_fireDetected -> SKIP)
					|||
				(registerWriteE.e_navCommand -> SKIP)
					|||
				(registerWriteE.e_vnavDisable -> SKIP)
					|||
				(registerWriteE.e_uavStatus -> SKIP)
					|||
				(registerWriteE.e_fvSeenFire -> SKIP)
					|||
				(registerWriteE.e_fireLost -> SKIP)
					|||
				(registerWriteE.e_visualPosition -> SKIP)
					|||
				(registerWriteE.e_fgSeenFire -> SKIP)
					|||
				(registerWriteE.e_trackingLost -> SKIP)
					|||
				(registerWriteE.e_vnavEnable -> SKIP)
					|||
				(registerWriteE.e_batteryLow -> SKIP));
				-- collect outputs, and monitor termination of the cycle, by all controllers
				(CollectOutputs(SOutputEvents) [| {endexec} |] Monitor),0);
				-- wait for the cycleDef period
				TimeOut_1(terminate -> SKIP,WAIT(cycle_pre_pkg__sim_RaspberryPi_RaspberryPi-1));
				-- recurse
				CycleController
				
										
			CollectOutputs(sout) =
				(CPlanning::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- CPlanning::RegisterDataOutput, connected_CPlanning(outp), project_CPlanning(outp) == outc}
						-> registerWrite!lift_CPlanning(outp)
							-> CollectOutputs(diff(sout,{project_CPlanning(outp)}))
				[]
				CGimbalAim::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- CGimbalAim::RegisterDataOutput, connected_CGimbalAim(outp), project_CGimbalAim(outp) == outc}
						-> registerWrite!lift_CGimbalAim(outp)
							-> CollectOutputs(diff(sout,{project_CGimbalAim(outp)}))
				[]
				CFlight::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- CFlight::RegisterDataOutput, connected_CFlight(outp), project_CFlight(outp) == outc}
						-> registerWrite!lift_CFlight(outp)
							-> CollectOutputs(diff(sout,{project_CFlight(outp)}))
				[]
				CPlanning::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- CPlanning::RegisterDataOutput, connected_CPlanning(outp), project_CPlanning(outp) == outc}
						-> CollectOutputs(diff(sout,{project_CPlanning(outp)}))
				[]
				CGimbalAim::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- CGimbalAim::RegisterDataOutput, connected_CGimbalAim(outp), project_CGimbalAim(outp) == outc}
						-> CollectOutputs(diff(sout,{project_CGimbalAim(outp)}))
				[]
				CFireDetect::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- CFireDetect::RegisterDataOutput, connected_CFireDetect(outp), project_CFireDetect(outp) == outc}
						-> CollectOutputs(diff(sout,{project_CFireDetect(outp)}))
				[]
				CFlight::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- CFlight::RegisterDataOutput, connected_CFlight(outp), project_CFlight(outp) == outc}
						-> CollectOutputs(diff(sout,{project_CFlight(outp)}))
				[]
				CVisualNav::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- CVisualNav::RegisterDataOutput, connected_CVisualNav(outp), project_CVisualNav(outp) == outc}
						-> CollectOutputs(diff(sout,{project_CVisualNav(outp)}))
				[]
				CBatteryMonitor::registerWrite?outp:{ outp | outc <- inter(sout,EVarsEvents), outp <- CBatteryMonitor::RegisterDataOutput, connected_CBatteryMonitor(outp), project_CBatteryMonitor(outp) == outc}
						-> CollectOutputs(diff(sout,{project_CBatteryMonitor(outp)}))
				[]
				endexec -> SKIP
				)
		
			Monitor = 
				(	 (CFireDetect::endexec -> SKIP)
				|||	 (CVisualNav::endexec -> SKIP)
				|||	 (CFlight::endexec -> SKIP)
				|||	 (CBatteryMonitor::endexec -> SKIP)
				|||	 (CGimbalAim::endexec -> SKIP)
				|||	 (CPlanning::endexec -> SKIP)); endexec -> SKIP
		within
			CycleController
		
		-- (Rule 5) memoryComp(...) : CSPProcess
		memoryComp(id__,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_LEFT_X,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_CENTRE_X,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_RIGHT_X,
				    const_pre_pkg__sim_RaspberryPi_CFireDetect_CENTRE_Y,
				    const_pre_pkg__sim_RaspberryPi_CVisualNav_TRACK_DIST,
				    const_pre_pkg__sim_RaspberryPi_CVisualNav_SCAN_DIST,
				    const_pre_pkg__sim_RaspberryPi_CFlight_CLIMB_LIFT,
				    const_pre_pkg__sim_RaspberryPi_CFlight_DELAY_DISARM,
				    const_pre_pkg__sim_RaspberryPi_CFlight_HOME,
				    const_pre_pkg__sim_RaspberryPi_CBatteryMonitor_BATTERY_LOW_THRESHOLD,
				    const_pre_pkg__sim_RaspberryPi_CBatteryMonitor_BATTERY_UNSAFE_THRESHOLD,
				    const_pre_pkg__sim_RaspberryPi_CGimbalAim_TRACK_DIST,
				    const_pre_pkg__sim_RaspberryPi_CPlanning_WALL_LOC,
				    const_pre_pkg__sim_RaspberryPi_CPlanning_FIRE_TO,
				    const_pre_pkg__sim_RaspberryPi_CPlanning_INIT_TO) = (
			Memory_waypoint(false.(0,0,0,0))
			||| Memory_gimbalAimed(false)
			||| Memory_wallMetrics(false.(0,0,0))
			||| Memory_trackingGained(false)
			||| Memory_fireDetected(false)
			||| Memory_navCommand(false.NavCommand_TakeOff)
			||| Memory_vnavDisable(false)
			||| Memory_uavStatus(false.AircraftStatus_Connected)
			||| Memory_fvSeenFire(false.(FireStatus_NoFire,0,0,0))
			||| Memory_fireLost(false)
			||| Memory_visualPosition(false.(0,0,0,0))
			||| Memory_fgSeenFire(false.(FireStatus_NoFire,0,0,0))
			||| Memory_trackingLost(false)
			||| Memory_vnavEnable(false)
			||| Memory_batteryLow(false)
			)
		
		Memory_waypoint(x__) = (
			registerWriteE.e_waypoint -> Memory_waypoint(false.(0,0,0,0))
			[]
			CPlanning::registerWrite.CPlanning::o_waypoint?x__ -> Memory_waypoint(true.x__)
			[]
			CFlight::registerRead.CFlight::i_waypoint!x__ -> Memory_waypoint(x__)
		)
		Memory_gimbalAimed(x__) = (
			registerWriteE.e_gimbalAimed -> Memory_gimbalAimed(false)
			[]
			CGimbalAim::registerWrite.CGimbalAim::o_gimbalAimed -> Memory_gimbalAimed(true)
			[]
			CPlanning::registerRead.CPlanning::i_gimbalAimed!x__ -> Memory_gimbalAimed(x__)
		)
		Memory_wallMetrics(x__) = (
			registerWriteE.e_wallMetrics -> Memory_wallMetrics(false.(0,0,0))
			[]
			CFireDetect::registerWrite.CFireDetect::o_wallMetrics?x__ -> Memory_wallMetrics(true.x__)
			[]
			CVisualNav::registerRead.CVisualNav::i_wallMetrics!x__ -> Memory_wallMetrics(x__)
		)
		Memory_trackingGained(x__) = (
			registerWriteE.e_trackingGained -> Memory_trackingGained(false)
			[]
			CFireDetect::registerWrite.CFireDetect::o_trackingGained -> Memory_trackingGained(true)
			[]
			CPlanning::registerRead.CPlanning::i_trackingGained!x__ -> Memory_trackingGained(x__)
		)
		Memory_fireDetected(x__) = (
			registerWriteE.e_fireDetected -> Memory_fireDetected(false)
			[]
			CFireDetect::registerWrite.CFireDetect::o_fireDetected -> Memory_fireDetected(true)
			[]
			CPlanning::registerRead.CPlanning::i_fireDetected!x__ -> Memory_fireDetected(x__)
		)
		Memory_navCommand(x__) = (
			registerWriteE.e_navCommand -> Memory_navCommand(false.NavCommand_TakeOff)
			[]
			CPlanning::registerWrite.CPlanning::o_navCommand?x__ -> Memory_navCommand(true.x__)
			[]
			CFlight::registerRead.CFlight::i_navCommand!x__ -> Memory_navCommand(x__)
		)
		Memory_vnavDisable(x__) = (
			registerWriteE.e_vnavDisable -> Memory_vnavDisable(false)
			[]
			CPlanning::registerWrite.CPlanning::o_vnavDisable -> Memory_vnavDisable(true)
			[]
			CVisualNav::registerRead.CVisualNav::i_vnavDisable!x__ -> Memory_vnavDisable(x__)
		)
		Memory_uavStatus(x__) = (
			registerWriteE.e_uavStatus -> Memory_uavStatus(false.AircraftStatus_Connected)
			[]
			CFlight::registerWrite.CFlight::o_uavStatus?x__ -> Memory_uavStatus(true.x__)
			[]
			CPlanning::registerRead.CPlanning::i_uavStatus!x__ -> Memory_uavStatus(x__)
		)
		Memory_fvSeenFire(x__) = (
			registerWriteE.e_fvSeenFire -> Memory_fvSeenFire(false.(FireStatus_NoFire,0,0,0))
			[]
			CFireDetect::registerWrite.CFireDetect::o_fvSeenFire?x__ -> Memory_fvSeenFire(true.x__)
			[]
			CVisualNav::registerRead.CVisualNav::i_fvSeenFire!x__ -> Memory_fvSeenFire(x__)
		)
		Memory_fireLost(x__) = (
			registerWriteE.e_fireLost -> Memory_fireLost(false)
			[]
			CFireDetect::registerWrite.CFireDetect::o_fireLost -> Memory_fireLost(true)
			[]
			CPlanning::registerRead.CPlanning::i_fireLost!x__ -> Memory_fireLost(x__)
		)
		Memory_visualPosition(x__) = (
			registerWriteE.e_visualPosition -> Memory_visualPosition(false.(0,0,0,0))
			[]
			CVisualNav::registerWrite.CVisualNav::o_visualPosition?x__ -> Memory_visualPosition(true.x__)
			[]
			CFlight::registerRead.CFlight::i_visualPosition!x__ -> Memory_visualPosition(x__)
		)
		Memory_fgSeenFire(x__) = (
			registerWriteE.e_fgSeenFire -> Memory_fgSeenFire(false.(FireStatus_NoFire,0,0,0))
			[]
			CFireDetect::registerWrite.CFireDetect::o_fgSeenFire?x__ -> Memory_fgSeenFire(true.x__)
			[]
			CGimbalAim::registerRead.CGimbalAim::i_fgSeenFire!x__ -> Memory_fgSeenFire(x__)
		)
		Memory_trackingLost(x__) = (
			registerWriteE.e_trackingLost -> Memory_trackingLost(false)
			[]
			CFireDetect::registerWrite.CFireDetect::o_trackingLost -> Memory_trackingLost(true)
			[]
			CPlanning::registerRead.CPlanning::i_trackingLost!x__ -> Memory_trackingLost(x__)
