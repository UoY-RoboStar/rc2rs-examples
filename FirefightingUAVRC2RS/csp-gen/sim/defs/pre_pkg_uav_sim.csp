		connected_AnArduino(AnArduino::o_gimbalWriteTilt.x__) = true
		connected_AnArduino(AnArduino::o_gimbalWritePan.x__) = true
		connected_AnArduino(AnArduino::o_pumpOn) = true
		connected_AnArduino(AnArduino::o_waterEmpty) = true
		connected_AnArduino(AnArduino::o_gimbalYawAck) = true
		connected_AnArduino(AnArduino::o_gimbalPitchAck) = true
		connected_AnArduino(AnArduino::o_pumpOff) = true
