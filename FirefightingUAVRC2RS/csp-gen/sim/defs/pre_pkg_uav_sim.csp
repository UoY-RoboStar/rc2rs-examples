				-> CollectOutputs(diff(sout,{project_ARaspberryPi(outp)}))
			[]
			endexec -> SKIP
			)
			
		Monitor = 
			(	 (AnArduino::endexec -> SKIP)
			|||	 (ARaspberryPi::endexec -> SKIP)); endexec -> SKIP
		
	within
		CycleModule 
	
	-- (Rule 5) memoryComp(...) : CSPProcess
	memoryComp(id__) = (
