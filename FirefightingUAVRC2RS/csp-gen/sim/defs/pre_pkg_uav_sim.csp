		| COutput_fcGoHomeCall
		| COutput_stopSpray
		| COutput_fcTakeoffCall
		| COutput_startSpray
		| COutput_pumpOff
	
	nametype EVarsEvents = {|COutput_gimbalYawAck
		, COutput_gimbalYaw
		, COutput_gimbalPitch
		, COutput_gimbalPitchAck
		, COutput_stopSpray
