				stateClockSync = {|get_CLID_SetPitch,SetPitch::entered,get_CLID_Waiting,Waiting::entered,get_CLID_SetYaw,SetYaw::entered|}
			 within
				(MachineBody_VS_O(id__,
						    const_Aim_GIMBAL_FLOOD_DELAY) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
						          const_Aim_GIMBAL_FLOOD_DELAY)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
			dbisim((let
				stateClockSync = {|get_CLID_SetPitch,SetPitch::entered,get_CLID_Waiting,Waiting::entered,get_CLID_SetYaw,SetYaw::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								dbisim(
									sbisim(
										MachineBody_VS_O(id__,
												    const_Aim_GIMBAL_FLOOD_DELAY)
										[| {|get_CLID_SetYaw,SetYaw::entered,terminate|} |]
										dbisim(Clock_CLID_SetYaw(id__,0,
												          const_Aim_GIMBAL_FLOOD_DELAY))
									)\{|get_CLID_SetYaw|}
								)
								[| {|get_CLID_Waiting,Waiting::entered,terminate|} |]
								dbisim(Clock_CLID_Waiting(id__,0,
										          const_Aim_GIMBAL_FLOOD_DELAY))
							)\{|get_CLID_Waiting|}
						)
						[| {|get_CLID_SetPitch,SetPitch::entered,terminate|} |]
						dbisim(Clock_CLID_SetPitch(id__,0,
								          const_Aim_GIMBAL_FLOOD_DELAY))
					)\{|get_CLID_SetPitch|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = 
			dbisim((let
				getsetLocalChannels = {|get_angle,set_angle|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,
						    const_Aim_GIMBAL_FLOOD_DELAY) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 		    const_Aim_GIMBAL_FLOOD_DELAY) [| {terminate} |] Clocks(id__,
				 		          const_Aim_GIMBAL_FLOOD_DELAY))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) =
			(dbisim(
				sbisim(
					IteratedBehaviour_VS_O(id__,
							    const_Aim_GIMBAL_FLOOD_DELAY)
					[| {|get_angle,set_angle,terminate|} |]
					Memory_angle(0)
				)\{|get_angle,set_angle|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_angle(angle) =
			get_angle!angle -> Memory_angle(angle)
			[]
			set_angle?x__ -> Memory_angle(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = Memory_angle(0)
		
		getsetLocalChannels = {|get_angle,set_angle|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = STM_VS_O(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) \ localClockResets
		D__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = timed_priority(STM(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) \ union(internal_events,localClockResets))
		O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = dbisim(D__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY))
		VS__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = FVS__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY)
		VS_O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = dbisim(FVS__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY))
		HEXT__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) [|shared_variable_events|] SKIP
		FVS_C__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = dbisim(timed_priority(STM(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) \ internal_events))
		HUP__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = timed_priority(O__(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_Aim_GIMBAL_FLOOD_DELAY) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_SetPitch(id__,x__,
				          const_Aim_GIMBAL_FLOOD_DELAY) = 
			TimeOut_1(
				SetPitch::entered -> Clock_CLID_SetPitch(id__,0,
						          const_Aim_GIMBAL_FLOOD_DELAY)
				[]
				get_CLID_SetPitch!x__ -> Clock_CLID_SetPitch(id__,x__,
						          const_Aim_GIMBAL_FLOOD_DELAY)
				[]
				terminate -> SKIP,Clock_CLID_SetPitch(id__,clock_type_plus(x__,1,CLID_SetPitch_clock_type(id__,
						          const_Aim_GIMBAL_FLOOD_DELAY)),
						          const_Aim_GIMBAL_FLOOD_DELAY))
		Clock_CLID_Waiting(id__,x__,
				          const_Aim_GIMBAL_FLOOD_DELAY) = 
			TimeOut_1(
				Waiting::entered -> Clock_CLID_Waiting(id__,0,
						          const_Aim_GIMBAL_FLOOD_DELAY)
				[]
				get_CLID_Waiting!x__ -> Clock_CLID_Waiting(id__,x__,
						          const_Aim_GIMBAL_FLOOD_DELAY)
				[]
				terminate -> SKIP,Clock_CLID_Waiting(id__,clock_type_plus(x__,1,CLID_Waiting_clock_type(id__,
						          const_Aim_GIMBAL_FLOOD_DELAY)),
						          const_Aim_GIMBAL_FLOOD_DELAY))
		Clock_CLID_SetYaw(id__,x__,
				          const_Aim_GIMBAL_FLOOD_DELAY) = 
			TimeOut_1(
				SetYaw::entered -> Clock_CLID_SetYaw(id__,0,
						          const_Aim_GIMBAL_FLOOD_DELAY)
				[]
				get_CLID_SetYaw!x__ -> Clock_CLID_SetYaw(id__,x__,
						          const_Aim_GIMBAL_FLOOD_DELAY)
				[]
				terminate -> SKIP,Clock_CLID_SetYaw(id__,clock_type_plus(x__,1,CLID_SetYaw_clock_type(id__,
						          const_Aim_GIMBAL_FLOOD_DELAY)),
						          const_Aim_GIMBAL_FLOOD_DELAY))
		
		StateClocks(id__,
				          const_Aim_GIMBAL_FLOOD_DELAY) = dbisim(Clock_CLID_SetPitch(id__,0,
				          const_Aim_GIMBAL_FLOOD_DELAY))
		[| { terminate } |] (
		dbisim(Clock_CLID_Waiting(id__,0,
				          const_Aim_GIMBAL_FLOOD_DELAY))
		[| { terminate } |] (
		dbisim(Clock_CLID_SetYaw(id__,0,
				          const_Aim_GIMBAL_FLOOD_DELAY))
		)
		)
		
		stateClockSync = {|get_CLID_SetPitch,SetPitch::entered,get_CLID_Waiting,Waiting::entered,get_CLID_SetYaw,SetYaw::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_Aim_GIMBAL_FLOOD_DELAY) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule
