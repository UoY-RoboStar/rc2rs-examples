			channel get_CLID_Off : core_clock_type 
			channel get_CLID_F : core_clock_type 
			--channel increment__
			
			CLID_On_clock_type(id__,
					          const_WaterMonitor_WATER_FLOW,
					          const_WaterMonitor_TIME_PER_UNIT) = 
				let
					max = (clock_type_max(Union({
			{},
			({const_WaterMonitor_TIME_PER_UNIT|TIME_PER_UNIT <- core_nat}),
			({const_WaterMonitor_TIME_PER_UNIT|TIME_PER_UNIT <- core_nat})
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			CLID_Off_clock_type(id__,
					          const_WaterMonitor_WATER_FLOW,
					          const_WaterMonitor_TIME_PER_UNIT) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			CLID_F_clock_type(id__,
					          const_WaterMonitor_WATER_FLOW,
					          const_WaterMonitor_TIME_PER_UNIT) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			
		
				-- Nodes --
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: I
				module I
				exports
				
					channel enter, interrupt
					
					Timed(OneStep) {
						D__(id__,
								    const_WaterMonitor_WATER_FLOW,
								    const_WaterMonitor_TIME_PER_UNIT) = 
							dbisim(let
								Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
								
								Termination = terminate -> SKIP
								
								Active 		= share__choice(interrupt -> SKIP) ; Inactive
							within
								Inactive [| {terminate} |> SKIP)
						
						VS_O__(id__,
								    const_WaterMonitor_WATER_FLOW,
								    const_WaterMonitor_TIME_PER_UNIT) = D__(id__,
								    const_WaterMonitor_WATER_FLOW,
								    const_WaterMonitor_TIME_PER_UNIT)
