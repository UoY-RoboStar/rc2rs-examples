			channel monitorOn__: NIDS.InOut
			channel monitorOn: InOut
			channel monitorOff__: NIDS.InOut
			channel monitorOff: InOut
			channel monitorEmpty__: NIDS.InOut
			channel monitorEmpty: InOut
			
