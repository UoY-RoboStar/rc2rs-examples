						    const_WaterMonitor_TIME_PER_UNIT) = 
					dbisim((let
						stateClockSync = {|get_CLID_On,On::entered,get_CLID_Off,Off::entered|}
					 within
						(MachineBody(id__,
								    const_WaterMonitor_WATER_FLOW,
								    const_WaterMonitor_TIME_PER_UNIT) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
								          const_WaterMonitor_WATER_FLOW,
								          const_WaterMonitor_TIME_PER_UNIT)) \ union(stateClockSync,enteredSS)
					)
