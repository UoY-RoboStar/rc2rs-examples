				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__,
						    const_WaterMonitor_WATER_FLOW,
						    const_WaterMonitor_TIME_PER_UNIT) = 
