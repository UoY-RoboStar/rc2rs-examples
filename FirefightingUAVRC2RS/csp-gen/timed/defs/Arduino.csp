									const_Aim_GIMBAL_FLOOD_DELAY = const_Arduino_AAim_GIMBAL_FLOOD_DELAY
								within 
								AAim::VS_O__(id__,
										    const_Aim_GIMBAL_FLOOD_DELAY)[[
									AAim::terminate <- terminate,
									AAim::gimbalYaw <- gimbalYaw,
									AAim::gimbalPitch <- gimbalPitch,
									AAim::gimbalYawAck <- gimbalYawAck,
									AAim::gimbalPitchAck <- gimbalPitchAck,
									AAim::gimbalWritePanCall <- gimbalWritePanCall,
									AAim::gimbalWriteTiltCall <- gimbalWriteTiltCall
								]]
							)
								[|{|terminate|}|]
							(
								let
									const_WaterMonitor_WATER_FLOW = const_Arduino_AWaterMonitor_WATER_FLOW
									const_WaterMonitor_TIME_PER_UNIT = 1
								within 
								AWaterMonitor::VS_O__(id__,
										    const_WaterMonitor_WATER_FLOW,
										    const_WaterMonitor_TIME_PER_UNIT)[[
									AWaterMonitor::terminate <- terminate,
									AWaterMonitor::monitorOn.in <- ASpray::monitorOn.out,
									AWaterMonitor::monitorOn.out <- ASpray::monitorOn.in,
									AWaterMonitor::monitorOff.in <- ASpray::monitorOff.out,
									AWaterMonitor::monitorOff.out <- ASpray::monitorOff.in
								]]
							)
						)
						\diff(
							{|terminate|},
							{|terminate|}
						)
					)
					\diff(
						{|terminate, ASpray::monitorOn, ASpray::monitorOff, AWaterMonitor::monitorEmpty|},
						{|terminate|}
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					dbisim(Memory(id__))
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>))
			
				HEXT(id__,
						    const_Arduino_AAim_GIMBAL_FLOOD_DELAY,
						    const_Arduino_AWaterMonitor_WATER_FLOW,
						    const_Arduino_AWaterMonitor_TIME_PER_UNIT) = O__(id__,
						    const_Arduino_AAim_GIMBAL_FLOOD_DELAY,
						    const_Arduino_AWaterMonitor_WATER_FLOW,
						    const_Arduino_AWaterMonitor_TIME_PER_UNIT) [|shared_variable_events|] SKIP			
		}

	endmodule
