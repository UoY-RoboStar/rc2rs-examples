						 [] dbisim(((0<water))&(monitorOn__!NID_Off.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; On::enter -> SKIP)))
						 [] dbisim(((On<const_WaterMonitor_TIME_PER_UNIT))&(monitorOff__!NID_On.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Off::enter -> SKIP)))
						 [] dbisim(((const_WaterMonitor_TIME_PER_UNIT<=On))&(internal__!NID_On -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(share__choice(get_water?water -> true & (share__choice(set_water!Minus(water, const_WaterMonitor_WATER_FLOW, core_real) -> SKIP)))) ; On::enter -> SKIP)))
						 [] dbisim(((water<=0))&(internal__!NID_On -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(monitorEmpty.out -> SKIP)) ; F::enter -> SKIP)))
						 [] dbisim(((water<=0))&(internal__!NID_Off -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(monitorEmpty.out -> SKIP)) ; F::enter -> SKIP)))
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
