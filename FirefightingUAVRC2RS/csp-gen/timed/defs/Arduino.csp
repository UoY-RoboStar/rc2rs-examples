				-- Transitions
				Transitions(id__,
						    const_WaterMonitor_WATER_FLOW,
						    const_WaterMonitor_TIME_PER_UNIT) = ((let
					Trans = share__choice(get_water?water -> get_CLID_On?On:CLID_On_clock_type(id__,
							          const_WaterMonitor_WATER_FLOW,
