									    const_WaterMonitor_WATER_FLOW,
									    const_WaterMonitor_TIME_PER_UNIT) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
