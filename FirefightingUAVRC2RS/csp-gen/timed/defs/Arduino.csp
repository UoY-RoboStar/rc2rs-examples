								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I,monitorOn__.NID_Off.in,monitorOff__.NID_On.in,internal__.NID_On,internal__.NID_On,internal__.NID_Off|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I::D__(id__,
								   		    const_WaterMonitor_WATER_FLOW,
								   		    const_WaterMonitor_TIME_PER_UNIT)
								   [| { share__, terminate } |] (
								   Off::D__(id__,
								   		    const_WaterMonitor_WATER_FLOW,
								   		    const_WaterMonitor_TIME_PER_UNIT)
								   [| { share__, terminate } |] (
								   On::D__(id__,
								   		    const_WaterMonitor_WATER_FLOW,
								   		    const_WaterMonitor_TIME_PER_UNIT)
								   [| { share__, terminate } |] (
