						 			 			,setR_fp
						 			 			,setR_gotH
						 			 			,setR_fs
						 			 			,setR_gotD
						 			 			,setR_d
						 			 			,setR_t
						 			 			,setR_rgb
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_gotR,setL_fs,setL_super,setL_wm,setL_checkDone,setL_fp,setL_gotD,setL_d,setL_gotH,setL_t,setL_rgb |} ]]
						  [[set_gotR <- setR_gotR,set_super <- setR_super,set_wm <- setR_wm,set_checkDone <- setR_checkDone,set_fp <- setR_fp,set_gotH <- setR_gotH,set_fs <- setR_fs,set_gotD <- setR_gotD,set_d <- setR_d,set_t <- setR_t,set_rgb <- setR_rgb]]
						 )
						)[[setL_gotR <- set_gotR,setL_fs <- set_fs,setL_super <- set_super,setL_wm <- set_wm,setL_checkDone <- set_checkDone,setL_fp <- set_fp,setL_gotD <- set_gotD,setL_d <- set_d,setL_gotH <- set_gotH,setL_t <- set_t,setL_rgb <- set_rgb]]
						 [[setR_gotR <- set_gotR,setR_super <- set_super,setR_wm <- set_wm,setR_checkDone <- set_checkDone,setR_fp <- set_fp,setR_gotH <- set_gotH,setR_fs <- set_fs,setR_gotD <- set_gotD,setR_d <- set_d,setR_t <- set_t,setR_rgb <- set_rgb]]
						)\union(enteredSS,{terminate}) 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_FireDetect_LEFT_X,
						    const_FireDetect_CENTRE_X,
						    const_FireDetect_RIGHT_X,
						    const_FireDetect_CENTRE_Y) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(true & (share__choice(set_checkDone!false -> SKIP))) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((dbisim(
						 	sbisim(
						 		dbisim(
						 			sbisim(
						 				dbisim(
						 					sbisim(
						 						dbisim(
						 							sbisim(
						 								dbisim(
						 									sbisim(
						 										dbisim(
						 											sbisim(
						 												(let
						 													-- IMPLEMENTATION NOTE:
						 													-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 													-- modules for defining the semantics of each node.
						 													enterSS = {|
						 													I::enter,
						 													Algorithm::enter,
						 													WasNoFire::enter,
						 													WasDetected::enter,
						 													WasTracked::enter,
						 													FGain::enter,
						 													TGain::enter,
						 													TLoss::enter,
						 													FLoss::enter,
						 													Done::enter
						 													|}
						 													hideSet = union(enterSS,{|exit,exited,internal__|})
						 												within 
						 													((let
						 														-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 														-- because CSPM modules are used for the semantics of Node.
						 														flowevts = union(enterSS,{|exit,exited,interrupt|})
						 														transSync = {|internal__.NID_I,internal__.NID_Algorithm,internal__.NID_Algorithm,internal__.NID_Algorithm,internal__.NID_WasNoFire,internal__.NID_WasDetected,internal__.NID_WasTracked,internal__.NID_FGain,internal__.NID_TGain,internal__.NID_TLoss,internal__.NID_FLoss,internal__.NID_WasNoFire,internal__.NID_FGain,internal__.NID_WasDetected,internal__.NID_WasTracked,internal__.NID_TLoss,internal__.NID_WasDetected|}
						 													within
						 														((
						 														 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 														   I::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   Algorithm::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   WasNoFire::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   WasDetected::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   WasTracked::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   FGain::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   TGain::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   TLoss::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   FLoss::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   [| { share__, terminate } |] (
						 														   Done::VS_O__(id__,
						 														   		    const_FireDetect_LEFT_X,
						 														   		    const_FireDetect_CENTRE_X,
						 														   		    const_FireDetect_RIGHT_X,
						 														   		    const_FireDetect_CENTRE_Y)
						 														   )
						 														   )
						 														   )
						 														   )
						 														   )
						 														   )
						 														   )
						 														   )
						 														   )
						 														 )
						 														 [[Algorithm::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Algorithm,internal__.NID_Algorithm,internal__.NID_Algorithm|}]]
						 														 [[FGain::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_FGain,internal__.NID_FGain|}]]
						 														 [[TGain::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_TGain|}]]
						 														 [[TLoss::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_TLoss,internal__.NID_TLoss|}]]
						 														 [[FLoss::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_FLoss|}]]
						 														 [[Done::interrupt <- x__ | x__ <- {|interrupt|}]]
						 														 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 														 [[WasNoFire::interrupt <- x__ | x__ <- {|internal__.NID_WasNoFire,internal__.NID_WasNoFire|}]]
						 														 [[WasDetected::interrupt <- x__ | x__ <- {|internal__.NID_WasDetected,internal__.NID_WasDetected,internal__.NID_WasDetected|}]]
						 														 [[WasTracked::interrupt <- x__ | x__ <- {|internal__.NID_WasTracked,internal__.NID_WasTracked|}]]
						 														 )
						 														  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 														  [[set_fs <- setL_fs]]
						 														 )
						 														 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 														 			,setL_fs
						 														|}) |]
						 														 ((I::enter -> Transitions(id__,
						 														 		    const_FireDetect_LEFT_X,
						 														 		    const_FireDetect_CENTRE_X,
						 														 		    const_FireDetect_RIGHT_X,
						 														 		    const_FireDetect_CENTRE_Y))
						 														  [[ share__ <- x__ | x__ <- {| share__,setL_fs |} ]]
						 														 )
						 														)[[setL_fs <- set_fs]]
						 														)
						 													)
						 													 \ hideSet)
						 													[[
						 														mlxHeatmap__.x____ <- mlxHeatmap,
						 														rsDepthFrame__.x____ <- rsDepthFrame,
						 														rsRgbFrame__.x____ <- rsRgbFrame,
						 														wallMetrics__.x____ <- wallMetrics,
						 														fvSeenFire__.x____ <- fvSeenFire,
						 														fgSeenFire__.x____ <- fgSeenFire,
						 														fireDetected__.x____ <- fireDetected,
						 														fireLost__.x____ <- fireLost,
						 														trackingGained__.x____ <- trackingGained,
						 														trackingLost__.x____ <- trackingLost
						 														| x____ <- NIDS
						 													]]
						 												)
						 												[| {|get_CLID_TGain,TGain::entered,terminate|} |]
						 												dbisim(Clock_CLID_TGain(id__,0,
						 														          const_FireDetect_LEFT_X,
						 														          const_FireDetect_CENTRE_X,
						 														          const_FireDetect_RIGHT_X,
						 														          const_FireDetect_CENTRE_Y))
						 											)\{|get_CLID_TGain|}
						 										)
						 										[| {|get_CLID_Done,Done::entered,terminate|} |]
						 										dbisim(Clock_CLID_Done(id__,0,
						 												          const_FireDetect_LEFT_X,
						 												          const_FireDetect_CENTRE_X,
						 												          const_FireDetect_RIGHT_X,
						 												          const_FireDetect_CENTRE_Y))
						 									)\{|get_CLID_Done|}
						 								)
						 								[| {|get_CLID_FLoss,FLoss::entered,terminate|} |]
						 								dbisim(Clock_CLID_FLoss(id__,0,
						 										          const_FireDetect_LEFT_X,
						 										          const_FireDetect_CENTRE_X,
						 										          const_FireDetect_RIGHT_X,
						 										          const_FireDetect_CENTRE_Y))
						 							)\{|get_CLID_FLoss|}
						 						)
						 						[| {|get_CLID_FGain,FGain::entered,terminate|} |]
						 						dbisim(Clock_CLID_FGain(id__,0,
						 								          const_FireDetect_LEFT_X,
						 								          const_FireDetect_CENTRE_X,
						 								          const_FireDetect_RIGHT_X,
						 								          const_FireDetect_CENTRE_Y))
						 					)\{|get_CLID_FGain|}
						 				)
						 				[| {|get_CLID_TLoss,TLoss::entered,terminate|} |]
						 				dbisim(Clock_CLID_TLoss(id__,0,
						 						          const_FireDetect_LEFT_X,
						 						          const_FireDetect_CENTRE_X,
						 						          const_FireDetect_RIGHT_X,
						 						          const_FireDetect_CENTRE_Y))
						 			)\{|get_CLID_TLoss|}
						 		)
						 		[| {|get_CLID_Algorithm,Algorithm::entered,terminate|} |]
						 		dbisim(Clock_CLID_Algorithm(id__,0,
						 				          const_FireDetect_LEFT_X,
						 				          const_FireDetect_CENTRE_X,
						 				          const_FireDetect_RIGHT_X,
						 				          const_FireDetect_CENTRE_Y))
						 	)\{|get_CLID_Algorithm|}
						 )
						 ))
						  [[ share__ <- x__ | x__ <- {| share__,setR_gotR,setR_super,setR_wm,setR_checkDone,setR_fp,setR_gotH,setR_fs,setR_gotD,setR_d,setR_t,setR_rgb |} ]] 
						  [[set_gotR <- setL_gotR,set_fs <- setL_fs,set_super <- setL_super,set_wm <- setL_wm,set_checkDone <- setL_checkDone,set_fp <- setL_fp,set_gotD <- setL_gotD,set_d <- setL_d,set_gotH <- setL_gotH,set_t <- setL_t,set_rgb <- setL_rgb]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_gotR
						 			,setL_fs
						 			,setL_super
						 			,setL_wm
						 			,setL_checkDone
						 			,setL_fp
						 			,setL_gotD
						 			,setL_d
						 			,setL_gotH
						 			,setL_t
						 			,setL_rgb
						 			,setR_gotR
						 			 			,setR_super
						 			 			,setR_wm
						 			 			,setR_checkDone
						 			 			,setR_fp
						 			 			,setR_gotH
						 			 			,setR_fs
						 			 			,setR_gotD
						 			 			,setR_d
						 			 			,setR_t
						 			 			,setR_rgb
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_gotR,setL_fs,setL_super,setL_wm,setL_checkDone,setL_fp,setL_gotD,setL_d,setL_gotH,setL_t,setL_rgb |} ]]
						  [[set_gotR <- setR_gotR,set_super <- setR_super,set_wm <- setR_wm,set_checkDone <- setR_checkDone,set_fp <- setR_fp,set_gotH <- setR_gotH,set_fs <- setR_fs,set_gotD <- setR_gotD,set_d <- setR_d,set_t <- setR_t,set_rgb <- setR_rgb]]
						 )
						)[[setL_gotR <- set_gotR,setL_fs <- set_fs,setL_super <- set_super,setL_wm <- set_wm,setL_checkDone <- set_checkDone,setL_fp <- set_fp,setL_gotD <- set_gotD,setL_d <- set_d,setL_gotH <- set_gotH,setL_t <- set_t,setL_rgb <- set_rgb]]
						 [[setR_gotR <- set_gotR,setR_super <- set_super,setR_wm <- set_wm,setR_checkDone <- set_checkDone,setR_fp <- set_fp,setR_gotH <- set_gotH,setR_fs <- set_fs,setR_gotD <- set_gotD,setR_d <- set_d,setR_t <- set_t,setR_rgb <- set_rgb]]
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__,
						    const_FireDetect_LEFT_X,
						    const_FireDetect_CENTRE_X,
						    const_FireDetect_RIGHT_X,
						    const_FireDetect_CENTRE_Y) = ((let
					Trans = share__choice(get_fs?fs -> TimeOut_1(
						 (share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Algorithm::enter -> SKIP))))
						 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_Algorithm -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WasNoFire::enter -> SKIP)))
						 [] dbisim(((fs==FireStatus_Detected))&(internal__!NID_Algorithm -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WasDetected::enter -> SKIP)))
						 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_Algorithm -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; WasTracked::enter -> SKIP)))
						 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_WasNoFire -> SKIP ;  ((SKIP ; Done::enter -> SKIP))))
						 [] dbisim(((fs==FireStatus_Detected))&(internal__!NID_WasDetected -> SKIP ;  ((SKIP ; Done::enter -> SKIP))))
						 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_WasTracked -> SKIP ;  ((SKIP ; Done::enter -> SKIP))))
						 [] dbisim(((fs!=FireStatus_Tracked))&(internal__!NID_FGain -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
						 [] dbisim((true)&(internal__!NID_TGain -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
						 [] dbisim(((fs!=FireStatus_NoFire))&(internal__!NID_TLoss -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
						 [] dbisim((true)&(internal__!NID_FLoss -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Done::enter -> SKIP)))
						 [] dbisim(((fs!=FireStatus_NoFire))&(internal__!NID_WasNoFire -> SKIP ;  ((SKIP ; FGain::enter -> SKIP))))
						 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_FGain -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; TGain::enter -> SKIP)))
						 [] dbisim(((fs==FireStatus_Tracked))&(internal__!NID_WasDetected -> SKIP ;  ((SKIP ; TGain::enter -> SKIP))))
						 [] dbisim(((fs!=FireStatus_Tracked))&(internal__!NID_WasTracked -> SKIP ;  ((SKIP ; TLoss::enter -> SKIP))))
						 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_TLoss -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; FLoss::enter -> SKIP)))
						 [] dbisim(((fs==FireStatus_NoFire))&(internal__!NID_WasDetected -> SKIP ;  ((SKIP ; FLoss::enter -> SKIP))))
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
						 )
					,SKIP);Trans
					)
				within
					Trans [|{terminate}|> SKIP
				)
				)
				
				
				-- Clocks
				Clock_CLID_Algorithm(id__,x__,
						          const_FireDetect_LEFT_X,
						          const_FireDetect_CENTRE_X,
						          const_FireDetect_RIGHT_X,
						          const_FireDetect_CENTRE_Y) = 
					TimeOut_1(
						Algorithm::entered -> Clock_CLID_Algorithm(id__,0,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						get_CLID_Algorithm!x__ -> Clock_CLID_Algorithm(id__,x__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						terminate -> SKIP,Clock_CLID_Algorithm(id__,clock_type_plus(x__,1,CLID_Algorithm_clock_type(id__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)),
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y))
				Clock_CLID_TLoss(id__,x__,
						          const_FireDetect_LEFT_X,
						          const_FireDetect_CENTRE_X,
						          const_FireDetect_RIGHT_X,
						          const_FireDetect_CENTRE_Y) = 
					TimeOut_1(
						TLoss::entered -> Clock_CLID_TLoss(id__,0,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						get_CLID_TLoss!x__ -> Clock_CLID_TLoss(id__,x__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						terminate -> SKIP,Clock_CLID_TLoss(id__,clock_type_plus(x__,1,CLID_TLoss_clock_type(id__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)),
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y))
				Clock_CLID_FGain(id__,x__,
						          const_FireDetect_LEFT_X,
						          const_FireDetect_CENTRE_X,
						          const_FireDetect_RIGHT_X,
						          const_FireDetect_CENTRE_Y) = 
					TimeOut_1(
						FGain::entered -> Clock_CLID_FGain(id__,0,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						get_CLID_FGain!x__ -> Clock_CLID_FGain(id__,x__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						terminate -> SKIP,Clock_CLID_FGain(id__,clock_type_plus(x__,1,CLID_FGain_clock_type(id__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)),
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y))
				Clock_CLID_FLoss(id__,x__,
						          const_FireDetect_LEFT_X,
						          const_FireDetect_CENTRE_X,
						          const_FireDetect_RIGHT_X,
						          const_FireDetect_CENTRE_Y) = 
					TimeOut_1(
						FLoss::entered -> Clock_CLID_FLoss(id__,0,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						get_CLID_FLoss!x__ -> Clock_CLID_FLoss(id__,x__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)
						[]
						terminate -> SKIP,Clock_CLID_FLoss(id__,clock_type_plus(x__,1,CLID_FLoss_clock_type(id__,
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y)),
								          const_FireDetect_LEFT_X,
								          const_FireDetect_CENTRE_X,
								          const_FireDetect_RIGHT_X,
								          const_FireDetect_CENTRE_Y))
				Clock_CLID_Done(id__,x__,
						          const_FireDetect_LEFT_X,
						          const_FireDetect_CENTRE_X,
						          const_FireDetect_RIGHT_X,
						          const_FireDetect_CENTRE_Y) = 
					TimeOut_1(
						Done::entered -> Clock_CLID_Done(id__,0,
