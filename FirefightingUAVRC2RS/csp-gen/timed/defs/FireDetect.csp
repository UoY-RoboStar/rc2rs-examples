						          const_FireDetect_CENTRE_Y)
				[]
				terminate -> SKIP,Clock_CLID_CheckWall(id__,clock_type_plus(x__,1,CLID_CheckWall_clock_type(id__,
						          const_FireDetect_LEFT_X,
						          const_FireDetect_CENTRE_X,
						          const_FireDetect_RIGHT_X,
						          const_FireDetect_CENTRE_Y)),
						          const_FireDetect_LEFT_X,
						          const_FireDetect_CENTRE_X,
						          const_FireDetect_RIGHT_X,
						          const_FireDetect_CENTRE_Y))
		
		StateClocks(id__,
				          const_FireDetect_LEFT_X,
				          const_FireDetect_CENTRE_X,
				          const_FireDetect_RIGHT_X,
				          const_FireDetect_CENTRE_Y) = dbisim(Clock_CLID_Superimpose(id__,0,
				          const_FireDetect_LEFT_X,
				          const_FireDetect_CENTRE_X,
				          const_FireDetect_RIGHT_X,
				          const_FireDetect_CENTRE_Y))
		[| { terminate } |] (
		dbisim(Clock_CLID_Idle(id__,0,
				          const_FireDetect_LEFT_X,
				          const_FireDetect_CENTRE_X,
				          const_FireDetect_RIGHT_X,
				          const_FireDetect_CENTRE_Y))
		[| { terminate } |] (
		dbisim(Clock_CLID_CheckFire(id__,0,
				          const_FireDetect_LEFT_X,
				          const_FireDetect_CENTRE_X,
				          const_FireDetect_RIGHT_X,
				          const_FireDetect_CENTRE_Y))
		[| { terminate } |] (
		dbisim(Clock_CLID_CheckWall(id__,0,
				          const_FireDetect_LEFT_X,
				          const_FireDetect_CENTRE_X,
				          const_FireDetect_RIGHT_X,
				          const_FireDetect_CENTRE_Y))
		)
		)
		)
		
		stateClockSync = {|get_CLID_Superimpose,Superimpose::entered,get_CLID_Idle,Idle::entered,get_CLID_CheckFire,CheckFire::entered,get_CLID_CheckWall,CheckWall::entered|}
		
		-- Shared memory
