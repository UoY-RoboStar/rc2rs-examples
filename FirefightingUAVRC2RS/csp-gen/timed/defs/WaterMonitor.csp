				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = 
			dbisim((let
				getsetLocalChannels = {|get_water,set_water|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,
						    const_WaterMonitor_WATER_FLOW,
						    const_WaterMonitor_TIME_PER_UNIT) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 		    const_WaterMonitor_WATER_FLOW,
				 		    const_WaterMonitor_TIME_PER_UNIT) [| {terminate} |] Clocks(id__,
				 		          const_WaterMonitor_WATER_FLOW,
				 		          const_WaterMonitor_TIME_PER_UNIT))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) =
			(dbisim(
				sbisim(
					IteratedBehaviour_VS_O(id__,
							    const_WaterMonitor_WATER_FLOW,
							    const_WaterMonitor_TIME_PER_UNIT)
					[| {|get_water,set_water,terminate|} |]
					Memory_water(1)
				)\{|get_water,set_water|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_water(water) =
			get_water!water -> Memory_water(water)
			[]
			set_water?x__ -> Memory_water(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = Memory_water(1)
		
		getsetLocalChannels = {|get_water,set_water|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = STM_VS_O(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) \ localClockResets
		D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = timed_priority(STM(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) \ union(internal_events,localClockResets))
		O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = dbisim(D__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT))
		VS__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = FVS__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT)
		VS_O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = dbisim(FVS__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT))
		HEXT__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) [|shared_variable_events|] SKIP
		FVS_C__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = dbisim(timed_priority(STM(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) \ internal_events))
		HUP__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = timed_priority(O__(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_WaterMonitor_WATER_FLOW,
				          const_WaterMonitor_TIME_PER_UNIT) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_On(id__,x__,
				          const_WaterMonitor_WATER_FLOW,
				          const_WaterMonitor_TIME_PER_UNIT) = 
			TimeOut_1(
				On::entered -> Clock_CLID_On(id__,0,
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT)
				[]
				get_CLID_On!x__ -> Clock_CLID_On(id__,x__,
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT)
				[]
				terminate -> SKIP,Clock_CLID_On(id__,clock_type_plus(x__,1,CLID_On_clock_type(id__,
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT)),
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT))
		Clock_CLID_Off(id__,x__,
				          const_WaterMonitor_WATER_FLOW,
				          const_WaterMonitor_TIME_PER_UNIT) = 
			TimeOut_1(
				Off::entered -> Clock_CLID_Off(id__,0,
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT)
				[]
				get_CLID_Off!x__ -> Clock_CLID_Off(id__,x__,
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT)
				[]
				terminate -> SKIP,Clock_CLID_Off(id__,clock_type_plus(x__,1,CLID_Off_clock_type(id__,
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT)),
						          const_WaterMonitor_WATER_FLOW,
						          const_WaterMonitor_TIME_PER_UNIT))
		
		StateClocks(id__,
				          const_WaterMonitor_WATER_FLOW,
				          const_WaterMonitor_TIME_PER_UNIT) = dbisim(Clock_CLID_On(id__,0,
				          const_WaterMonitor_WATER_FLOW,
				          const_WaterMonitor_TIME_PER_UNIT))
		[| { terminate } |] (
		dbisim(Clock_CLID_Off(id__,0,
				          const_WaterMonitor_WATER_FLOW,
				          const_WaterMonitor_TIME_PER_UNIT))
		)
		
		stateClockSync = {|get_CLID_On,On::entered,get_CLID_Off,Off::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_WaterMonitor_WATER_FLOW,
				    const_WaterMonitor_TIME_PER_UNIT) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule
