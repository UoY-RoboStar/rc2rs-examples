						)\diff(stateClockSync,enteredSS))
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__) = 
					dbisim((let
						stateClockSync = {|get_CLID_On,On::entered,get_CLID_Off,Off::entered|}
					 within
						(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
					)
					)
				
				IteratedBehaviour(id__) = 
					dbisim((let
						stateClockSync = {|get_CLID_On,On::entered,get_CLID_Off,Off::entered|}
					 within
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										MachineBody(id__)
										[| {|get_CLID_Off,Off::entered,terminate|} |]
										dbisim(Clock_CLID_Off(id__,0))
									)\{|get_CLID_Off|}
								)
								[| {|get_CLID_On,On::entered,terminate|} |]
								dbisim(Clock_CLID_On(id__,0))
