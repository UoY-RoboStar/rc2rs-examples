								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I,startSpray__.NID_Off.in,monitorEmpty__.NID_On.in,stopSpray__.NID_On.in,monitorEmpty__.NID_Off.in|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I::D__(id__)
								   [| { share__, terminate } |] (
								   Off::D__(id__)
								   [| { share__, terminate } |] (
								   On::D__(id__)
								   [| { share__, terminate } |] (
								   Out::D__(id__)
								   )
								   )
								   )
								 )
								 [[Off::interrupt <- x__ | x__ <- {|interrupt,startSpray__.NID_Off.in,monitorEmpty__.NID_Off.in|}]]
								 [[On::interrupt <- x__ | x__ <- {|interrupt,monitorEmpty__.NID_On.in,stopSpray__.NID_On.in|}]]
								 [[Out::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((I::enter -> Transitions(id__))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
							[[
								monitorOn__.x____ <- monitorOn,
								monitorOff__.x____ <- monitorOff,
								monitorEmpty__.x____ <- monitorEmpty,
								startSpray__.x____ <- startSpray,
								stopSpray__.x____ <- stopSpray,
