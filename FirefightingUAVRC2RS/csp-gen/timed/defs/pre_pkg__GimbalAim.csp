						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
					
					-- Clocks
					
					StateClocks(id__,
							          const_pre_pkg__GimbalAim_TRACK_DIST) = terminate -> SKIP
					
					stateClockSync = {||}
