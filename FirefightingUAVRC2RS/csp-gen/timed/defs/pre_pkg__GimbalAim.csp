						 [[setR_tgt <- set_tgt]]
						)
					)
					 \ hideSet)
					[[
						fgSeenFire__.x____ <- fgSeenFire,
						gimbalYaw__.x____ <- gimbalYaw,
						gimbalPitch__.x____ <- gimbalPitch,
