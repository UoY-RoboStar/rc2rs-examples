				stateClockSync = {|get_CLID_Pitch,Pitch::entered,get_CLID_Waiting,Waiting::entered,get_CLID_Calculate,Calculate::entered,get_CLID_Clamp,Clamp::entered,get_CLID_Yaw,Yaw::entered|}
