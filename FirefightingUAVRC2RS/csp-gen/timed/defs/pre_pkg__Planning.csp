		)
		
		clockSync = {|get_CLID_clk_Planning_Connected_Mission_LosingFire,clockReset.CLID_clk_Planning_Connected_Mission_LosingFire,get_CLID_clk_Planning_Connect,clockReset.CLID_clk_Planning_Connect|}
		
		Clock_CLID_Connect(id__,x__,
				          const_pre_pkg__Planning_WALL_LOC,
				          const_pre_pkg__Planning_FIRE_TO,
				          const_pre_pkg__Planning_INIT_TO) = 
			TimeOut_1(
				Connect::entered -> Clock_CLID_Connect(id__,0,
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO)
				[]
				get_CLID_Connect!x__ -> Clock_CLID_Connect(id__,x__,
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO)
				[]
				terminate -> SKIP,Clock_CLID_Connect(id__,clock_type_plus(x__,1,CLID_Connect_clock_type(id__,
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO)),
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO))
		Clock_CLID_Connected(id__,x__,
				          const_pre_pkg__Planning_WALL_LOC,
				          const_pre_pkg__Planning_FIRE_TO,
				          const_pre_pkg__Planning_INIT_TO) = 
			TimeOut_1(
				Connected::entered -> Clock_CLID_Connected(id__,0,
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO)
				[]
				get_CLID_Connected!x__ -> Clock_CLID_Connected(id__,x__,
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO)
				[]
				terminate -> SKIP,Clock_CLID_Connected(id__,clock_type_plus(x__,1,CLID_Connected_clock_type(id__,
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO)),
						          const_pre_pkg__Planning_WALL_LOC,
						          const_pre_pkg__Planning_FIRE_TO,
						          const_pre_pkg__Planning_INIT_TO))
		
		StateClocks(id__,
				          const_pre_pkg__Planning_WALL_LOC,
				          const_pre_pkg__Planning_FIRE_TO,
				          const_pre_pkg__Planning_INIT_TO) = dbisim(Clock_CLID_Connect(id__,0,
				          const_pre_pkg__Planning_WALL_LOC,
				          const_pre_pkg__Planning_FIRE_TO,
				          const_pre_pkg__Planning_INIT_TO))
		[| { terminate } |] (
		dbisim(Clock_CLID_Connected(id__,0,
				          const_pre_pkg__Planning_WALL_LOC,
				          const_pre_pkg__Planning_FIRE_TO,
				          const_pre_pkg__Planning_INIT_TO))
		)
		
		stateClockSync = {|get_CLID_Connect,Connect::entered,get_CLID_Connected,Connected::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_pre_pkg__Planning_WALL_LOC,
				    const_pre_pkg__Planning_FIRE_TO,
				    const_pre_pkg__Planning_INIT_TO) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule
