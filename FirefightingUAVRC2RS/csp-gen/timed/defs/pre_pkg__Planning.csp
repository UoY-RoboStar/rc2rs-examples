						 [] dbisim((searchComplete)&(internal__!NID_Mission -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&CALL__clone_normal_Planning_Connected_Mission_SPRT_op(
