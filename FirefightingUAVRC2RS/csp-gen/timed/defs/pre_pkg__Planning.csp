					----------------------------------------------------------------------
					-- State: Waiting
					module Waiting
					
					enterSS = 
							{|			i::enter,
								EmptyCycle::enter
							|}
					enteredSS = 
							{|			EmptyCycle::entered
							|}
					exports
					
						--  Declarations
						
						channel enter, entered, interrupt
						channel enteredL, enteredR
						
										
						-- declaring identifiers of transitions
						datatype NIDS = 
						              NID_i|
						              NID_EmptyCycle
						
						channel internal__ : NIDS
						channel missionStatus__: NIDS.InOut.MissionStatus
						channel startSpray__: NIDS.InOut
						channel stopSpray__: NIDS.InOut
						channel waterEmpty__: NIDS.InOut
						channel fireDetected__: NIDS.InOut
						channel fireLost__: NIDS.InOut
						channel trackingGained__: NIDS.InOut
						channel trackingLost__: NIDS.InOut
						channel navCommand__: NIDS.InOut.NavCommand
						channel waypoint__: NIDS.InOut.Position
						channel uavStatus__: NIDS.InOut.AircraftStatus
						channel batteryLow__: NIDS.InOut
						channel gimbalAimed__: NIDS.InOut
						channel vnavEnable__: NIDS.InOut
						channel vnavDisable__: NIDS.InOut
						
						channel get_CLID_EmptyCycle : core_clock_type 
						--channel increment__
						
						CLID_EmptyCycle_clock_type(id__,
								          const_pre_pkg__Planning_WALL_LOC,
								          const_pre_pkg__Planning_FIRE_TO,
								          const_pre_pkg__Planning_INIT_TO) = 
							let
								max = (clock_type_max(Union({
						}))+1)
							ctype = {0..max}
						within
							if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
						
						
						--	Nodes
						-- declaring all nodes
						
						----------------------------------------------------------------------
						-- Initial: i
						module i
						exports
						
							channel enter, interrupt
							
							Timed(OneStep) {
								D__(id__,
										    const_pre_pkg__Planning_WALL_LOC,
										    const_pre_pkg__Planning_FIRE_TO,
										    const_pre_pkg__Planning_INIT_TO) = 
									dbisim(let
										Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
										
										Termination = terminate -> SKIP
										
										Active 		= share__choice(interrupt -> SKIP) ; Inactive
									within
										Inactive [| {terminate} |> SKIP)
								
								VS_O__(id__,
										    const_pre_pkg__Planning_WALL_LOC,
										    const_pre_pkg__Planning_FIRE_TO,
										    const_pre_pkg__Planning_INIT_TO) = D__(id__,
										    const_pre_pkg__Planning_WALL_LOC,
										    const_pre_pkg__Planning_FIRE_TO,
										    const_pre_pkg__Planning_INIT_TO)
							}
						
						endmodule
						----------------------------------------------------------------------
						
						
						----------------------------------------------------------------------
						-- State: EmptyCycle
						module EmptyCycle
						
						enterSS = {}
						
						enteredSS = {}
						
						exports
						
							--  Declarations
							
							channel enter, entered, interrupt
							channel enteredL, enteredR
							
											
							
							--channel increment__
							
							
							--	Nodes
							-- declaring all nodes
							
							
							Timed(OneStep) {
								--	Rule: behaviours(Node)
								--  Note that FDR has problems with efficiently compiling the process below
								-- 	if using a different recursion pattern.
								D__(id__,
										    const_pre_pkg__Planning_WALL_LOC,
										    const_pre_pkg__Planning_FIRE_TO,
										    const_pre_pkg__Planning_INIT_TO) = 
								dbisim(let
									-- IMPLEMENTATION NOTE: 
									-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
									-- however FDR struggles with that form in certain cases. So we use the exception operator
									-- instead to 'terminate'.
									
									Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
									
									Termination = terminate -> SKIP
									
									Active 		= SKIP ; 
											 	  Behaviour ; 
											 	  share__choice(exit -> SKIP) ; SKIP ; 
											 	  share__choice(exited -> SKIP) ; Inactive
								
									Behaviour 	= entered -> During
									During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
								within
									Inactive [| {terminate} |> SKIP)
									
								VS_O__(id__,
										    const_pre_pkg__Planning_WALL_LOC,
										    const_pre_pkg__Planning_FIRE_TO,
										    const_pre_pkg__Planning_INIT_TO) = 
								dbisim(let
									Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
									
									Termination = terminate -> SKIP
									
									Active 		= SKIP ; 
											 	  Behaviour ; 
											 	  share__choice(exit -> SKIP) ; SKIP ; 
											 	  share__choice(exited -> SKIP) ; Inactive
								
									Behaviour 	= entered -> During
									During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
								within
									Inactive [| {terminate} |> SKIP)
								
								
								-- Clocks
								
								StateClocks(id__,
										          const_pre_pkg__Planning_WALL_LOC,
										          const_pre_pkg__Planning_FIRE_TO,
										          const_pre_pkg__Planning_INIT_TO) = terminate -> SKIP
								
								stateClockSync = {||}
							}
						
						endmodule
						----------------------------------------------------------------------
						
						
						
						Timed(OneStep) {
							--	Rule: behaviours(Node)
							--  Note that FDR has problems with efficiently compiling the process below
							-- 	if using a different recursion pattern.
							D__(id__,
									    const_pre_pkg__Planning_WALL_LOC,
									    const_pre_pkg__Planning_FIRE_TO,
									    const_pre_pkg__Planning_INIT_TO) = 
							dbisim(let
								-- IMPLEMENTATION NOTE: 
								-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
								-- however FDR struggles with that form in certain cases. So we use the exception operator
								-- instead to 'terminate'.
								
								Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
								
								Termination = terminate -> SKIP
								
								Active 		= SKIP ; 
										 	  Behaviour ; 
										 	  share__choice(exit -> SKIP) ; SKIP ; 
										 	  share__choice(exited -> SKIP) ; Inactive
							
							
								Behaviour 	= dbisim(
									((
									 (((dbisim(
									 	sbisim(
									 		(let
									 			-- IMPLEMENTATION NOTE:
									 			-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
									 			-- modules for defining the semantics of each node.
									 			enterSS = {|
									 			i::enter,
									 			EmptyCycle::enter
									 			|}
									 			hideSet = union(enterSS,{|exit,exited,internal__|})
									 		within 
