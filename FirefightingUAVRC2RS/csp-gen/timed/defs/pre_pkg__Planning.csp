							 				flowevts = union(enterSS,{|exit,exited,interrupt|})
							 				transSync = {|internal__.NID_I,uavStatus__.NID_Waiting.in|}
							 			within
							 				((
							 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							 				   I::VS_O__(id__,
							 				   		    const_pre_pkg__Planning_WALL_LOC,
							 				   		    const_pre_pkg__Planning_FIRE_TO,
							 				   		    const_pre_pkg__Planning_INIT_TO)
							 				   [| { share__, terminate } |] (
							 				   Waiting::VS_O__(id__,
							 				   		    const_pre_pkg__Planning_WALL_LOC,
							 				   		    const_pre_pkg__Planning_FIRE_TO,
							 				   		    const_pre_pkg__Planning_INIT_TO)
							 				   )
							 				 )
							 				 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,uavStatus__.NID_Waiting.in|}]]
							 				 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
							 				 )
							 				  [[ share__ <- x__ | x__ <- {| share__,setR_astatus |} ]] 
							 				 )
							 				 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 				 			,setR_astatus
							 				 			|}) |]
							 				 ((I::enter -> Transitions(id__,
							 				 		    const_pre_pkg__Planning_WALL_LOC,
							 				 		    const_pre_pkg__Planning_FIRE_TO,
							 				 		    const_pre_pkg__Planning_INIT_TO))
							 				  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 				  [[set_astatus <- setR_astatus]]
							 				 )
							 				)
							 				 [[setR_astatus <- set_astatus]]
							 				)
							 			)
							 			 \ hideSet)
							 			[[
							 				missionStatus__.x____ <- missionStatus,
							 				startSpray__.x____ <- startSpray,
							 				stopSpray__.x____ <- stopSpray,
							 				waterEmpty__.x____ <- waterEmpty,
							 				fireDetected__.x____ <- fireDetected,
							 				fireLost__.x____ <- fireLost,
							 				trackingGained__.x____ <- trackingGained,
							 				trackingLost__.x____ <- trackingLost,
							 				navCommand__.x____ <- navCommand,
							 				waypoint__.x____ <- waypoint,
							 				uavStatus__.x____ <- uavStatus,
							 				batteryLow__.x____ <- batteryLow,
							 				gimbalAimed__.x____ <- gimbalAimed,
							 				vnavEnable__.x____ <- vnavEnable,
							 				vnavDisable__.x____ <- vnavDisable
							 				| x____ <- NIDS
							 			]]
							 		)
							 		[| {|get_CLID_Waiting,Waiting::entered,terminate|} |]
							 		dbisim(Clock_CLID_Waiting(id__,0,
							 				          const_pre_pkg__Planning_WALL_LOC,
							 				          const_pre_pkg__Planning_FIRE_TO,
							 				          const_pre_pkg__Planning_INIT_TO))
							 	)\{|get_CLID_Waiting|}
							 )
							 ))
							  [[ share__ <- x__ | x__ <- {| share__,clockResetR.CLID_clk_Planning_Connected_Mission_LosingFire,setR_inact_Planning_Connect,setR_searchComplete,setR_inact_Planning_Connected_Mission_LosingFire,clockResetR.CLID_clk_Planning_Connect,setR_astatus |} ]] 
							  [[clockReset.CLID_clk_Planning_Connected_Mission_LosingFire <- clockResetL.CLID_clk_Planning_Connected_Mission_LosingFire,set_inact_Planning_Connect <- setL_inact_Planning_Connect,set_searchComplete <- setL_searchComplete,set_inact_Planning_Connected_Mission_LosingFire <- setL_inact_Planning_Connected_Mission_LosingFire,clockReset.CLID_clk_Planning_Connect <- clockResetL.CLID_clk_Planning_Connect,set_astatus <- setL_astatus]]
							 )
							 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
							 			,clockResetL.CLID_clk_Planning_Connected_Mission_LosingFire
							 			,setL_inact_Planning_Connect
							 			,setL_searchComplete
							 			,setL_inact_Planning_Connected_Mission_LosingFire
							 			,clockResetL.CLID_clk_Planning_Connect
							 			,setL_astatus
							 			,clockResetR.CLID_clk_Planning_Connected_Mission_LosingFire
							 			 			,setR_inact_Planning_Connect
							 			 			,setR_searchComplete
							 			 			,setR_inact_Planning_Connected_Mission_LosingFire
							 			 			,clockResetR.CLID_clk_Planning_Connect
							 			 			,setR_astatus
							 			|}) |]
							 ((During)
							  [[ share__ <- x__ | x__ <- {| share__,clockResetL.CLID_clk_Planning_Connected_Mission_LosingFire,setL_inact_Planning_Connect,setL_searchComplete,setL_inact_Planning_Connected_Mission_LosingFire,clockResetL.CLID_clk_Planning_Connect,setL_astatus |} ]]
							  [[clockReset.CLID_clk_Planning_Connected_Mission_LosingFire <- clockResetR.CLID_clk_Planning_Connected_Mission_LosingFire,set_inact_Planning_Connect <- setR_inact_Planning_Connect,set_searchComplete <- setR_searchComplete,set_inact_Planning_Connected_Mission_LosingFire <- setR_inact_Planning_Connected_Mission_LosingFire,clockReset.CLID_clk_Planning_Connect <- clockResetR.CLID_clk_Planning_Connect,set_astatus <- setR_astatus]]
							 )
							)[[clockResetL.CLID_clk_Planning_Connected_Mission_LosingFire <- clockReset.CLID_clk_Planning_Connected_Mission_LosingFire,setL_inact_Planning_Connect <- set_inact_Planning_Connect,setL_searchComplete <- set_searchComplete,setL_inact_Planning_Connected_Mission_LosingFire <- set_inact_Planning_Connected_Mission_LosingFire,clockResetL.CLID_clk_Planning_Connect <- clockReset.CLID_clk_Planning_Connect,setL_astatus <- set_astatus]]
							 [[clockResetR.CLID_clk_Planning_Connected_Mission_LosingFire <- clockReset.CLID_clk_Planning_Connected_Mission_LosingFire,setR_inact_Planning_Connect <- set_inact_Planning_Connect,setR_searchComplete <- set_searchComplete,setR_inact_Planning_Connected_Mission_LosingFire <- set_inact_Planning_Connected_Mission_LosingFire,clockResetR.CLID_clk_Planning_Connect <- clockReset.CLID_clk_Planning_Connect,setR_astatus <- set_astatus]]
							)\{terminate} 
						)
						During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
								 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
					within
						Inactive [| {terminate} |> SKIP)
					
					Transitions(id__,
							    const_pre_pkg__Planning_WALL_LOC,
							    const_pre_pkg__Planning_FIRE_TO,
							    const_pre_pkg__Planning_INIT_TO) = ((let
						Trans = TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; Waiting::enter -> SKIP))))
							 [] dbisim((true)&(uavStatus__!NID_Waiting.in?astatus:{astatus|astatus <- AircraftStatus, true} -> share__choice(set_astatus!astatus -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Waiting::enter -> SKIP)))
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
							 )
						,SKIP);Trans
					within
						Trans [|{terminate}|> SKIP
					)
					)
					
					
					-- Clocks
					Clock_CLID_Waiting(id__,x__,
							          const_pre_pkg__Planning_WALL_LOC,
							          const_pre_pkg__Planning_FIRE_TO,
							          const_pre_pkg__Planning_INIT_TO) = 
						TimeOut_1(
							Waiting::entered -> Clock_CLID_Waiting(id__,0,
									          const_pre_pkg__Planning_WALL_LOC,
									          const_pre_pkg__Planning_FIRE_TO,
									          const_pre_pkg__Planning_INIT_TO)
							[]
							get_CLID_Waiting!x__ -> Clock_CLID_Waiting(id__,x__,
									          const_pre_pkg__Planning_WALL_LOC,
									          const_pre_pkg__Planning_FIRE_TO,
									          const_pre_pkg__Planning_INIT_TO)
							[]
							terminate -> SKIP,Clock_CLID_Waiting(id__,clock_type_plus(x__,1,CLID_Waiting_clock_type(id__,
									          const_pre_pkg__Planning_WALL_LOC,
									          const_pre_pkg__Planning_FIRE_TO,
									          const_pre_pkg__Planning_INIT_TO)),
									          const_pre_pkg__Planning_WALL_LOC,
									          const_pre_pkg__Planning_FIRE_TO,
									          const_pre_pkg__Planning_INIT_TO))
					
					StateClocks(id__,
							          const_pre_pkg__Planning_WALL_LOC,
							          const_pre_pkg__Planning_FIRE_TO,
							          const_pre_pkg__Planning_INIT_TO) = dbisim(Clock_CLID_Waiting(id__,0,
							          const_pre_pkg__Planning_WALL_LOC,
							          const_pre_pkg__Planning_FIRE_TO,
							          const_pre_pkg__Planning_INIT_TO))
					
					stateClockSync = {|get_CLID_Waiting,Waiting::entered|}
				}
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Mission
			module Mission
			
			enterSS = 
					{|			I::enter,
						FlyToWall::enter,
						Search::enter,
						TrackFire::enter,
						Spray::enter,
						LosingFire::enter
					|}
			enteredSS = 
					{|			FlyToWall::entered,
						Search::entered,
						TrackFire::entered,
						Spray::entered,
						LosingFire::entered
					|}
			exports
			
				--  Declarations
				
