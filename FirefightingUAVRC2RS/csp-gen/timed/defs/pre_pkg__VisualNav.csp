						   )
						 )
						 [[Inactive::interrupt <- x__ | x__ <- {|interrupt,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}]]
						 [[Active::interrupt <- x__ | x__ <- {|interrupt,vnavDisable__.NID_Active.in|}]]
						 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_tgt,setR_wm |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_tgt
						 			 			,setR_wm
						 			|}) |]
						 ((I::enter -> Transitions(id__,
						 		    const_pre_pkg__VisualNav_TRACK_DIST,
						 		    const_pre_pkg__VisualNav_SCAN_DIST))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_tgt <- setR_tgt,set_wm <- setR_wm]]
						 )
						)
						 [[setR_tgt <- set_tgt,setR_wm <- set_wm]]
						)
					)
					 \ hideSet)
					[[
						wallMetrics__.x____ <- wallMetrics,
						fvSeenFire__.x____ <- fvSeenFire,
						visualPosition__.x____ <- visualPosition,
						vnavEnable__.x____ <- vnavEnable,
						vnavDisable__.x____ <- vnavDisable
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__,
				 		          const_pre_pkg__VisualNav_TRACK_DIST,
				 		          const_pre_pkg__VisualNav_SCAN_DIST)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = 
			dbisim((let
				stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
			 within
				(MachineBody(id__,
						    const_pre_pkg__VisualNav_TRACK_DIST,
						    const_pre_pkg__VisualNav_SCAN_DIST) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)) \ union(stateClockSync,enteredSS)
			)
			)
		
		IteratedBehaviour(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = 
			dbisim((let
				stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody(id__,
										    const_pre_pkg__VisualNav_TRACK_DIST,
										    const_pre_pkg__VisualNav_SCAN_DIST)
								[| {|get_CLID_Inactive,Inactive::entered,terminate|} |]
								dbisim(Clock_CLID_Inactive(id__,0,
										          const_pre_pkg__VisualNav_TRACK_DIST,
										          const_pre_pkg__VisualNav_SCAN_DIST))
							)\{|get_CLID_Inactive|}
						)
						[| {|get_CLID_Active,Active::entered,terminate|} |]
						dbisim(Clock_CLID_Active(id__,0,
								          const_pre_pkg__VisualNav_TRACK_DIST,
								          const_pre_pkg__VisualNav_SCAN_DIST))
					)\{|get_CLID_Active|}
				)
				) \ union(stateClockSync,enteredSS)
			)
			)
		
		Stateful(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = 
			((let
				getsetLocalChannels = {|get_tgt,set_tgt,
				get_wm,set_wm,
				get_movement,set_movement|}
				clockSync = {||}
			within
				(Behaviour(id__,
						    const_pre_pkg__VisualNav_TRACK_DIST,
						    const_pre_pkg__VisualNav_SCAN_DIST) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 		    const_pre_pkg__VisualNav_TRACK_DIST,
				 		    const_pre_pkg__VisualNav_SCAN_DIST) [| {terminate} |] Clocks(id__,
				 		          const_pre_pkg__VisualNav_TRACK_DIST,
				 		          const_pre_pkg__VisualNav_SCAN_DIST))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) =
			(dbisim(
				sbisim(
					dbisim(
						sbisim(
							dbisim(
								sbisim(
									IteratedBehaviour(id__,
											    const_pre_pkg__VisualNav_TRACK_DIST,
											    const_pre_pkg__VisualNav_SCAN_DIST)
									[| {|get_movement,set_movement,terminate|} |]
									Memory_movement((0,0,0,0))
								)\{|get_movement,set_movement|}
							)
							[| {|get_wm,set_wm,terminate|} |]
							Memory_wm((0,0,0))
						)\{|get_wm,set_wm|}
					)
					[| {|get_tgt,set_tgt,terminate|} |]
					Memory_tgt((FireStatus_NoFire,0,0,0))
				)\{|get_tgt,set_tgt|}
			)
			)
		
		-- Visible counterparts
		MachineBody_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = 
			dbisim((
			let
				finalNodesEntered = {||}
			within
				(dbisim((dbisim((let
					-- IMPLEMENTATION NOTE:
					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
					-- modules for defining the semantics of each node.
					enterSS = {|
					I::enter,
					Inactive::enter,
					Active::enter
					|}
					hideSet = union(enterSS,{|exit,exited,internal__|})
				within 
					((let
						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						-- because CSPM modules are used for the semantics of Node.
						flowevts = union(enterSS,{|exit,exited,interrupt|})
						transSync = {|internal__.NID_I,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Active.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}
					within
						((
						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						   I::VS_O__(id__,
						   		    const_pre_pkg__VisualNav_TRACK_DIST,
						   		    const_pre_pkg__VisualNav_SCAN_DIST)
						   [| { share__, terminate } |] (
						   Inactive::VS_O__(id__,
						   		    const_pre_pkg__VisualNav_TRACK_DIST,
						   		    const_pre_pkg__VisualNav_SCAN_DIST)
						   [| { share__, terminate } |] (
						   Active::VS_O__(id__,
						   		    const_pre_pkg__VisualNav_TRACK_DIST,
						   		    const_pre_pkg__VisualNav_SCAN_DIST)
						   )
						   )
						 )
						 [[Inactive::interrupt <- x__ | x__ <- {|interrupt,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}]]
						 [[Active::interrupt <- x__ | x__ <- {|interrupt,vnavDisable__.NID_Active.in|}]]
						 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
						 )
						  [[ share__ <- x__ | x__ <- {| share__,setR_tgt,setR_wm |} ]] 
						 )
						 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 			,setR_tgt
						 			 			,setR_wm
						 			|}) |]
						 ((I::enter -> Transitions(id__,
						 		    const_pre_pkg__VisualNav_TRACK_DIST,
						 		    const_pre_pkg__VisualNav_SCAN_DIST))
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						  [[set_tgt <- setR_tgt,set_wm <- setR_wm]]
						 )
						)
						 [[setR_tgt <- set_tgt,setR_wm <- set_wm]]
						)
					)
					 \ hideSet)
					[[
						wallMetrics__.x____ <- wallMetrics,
						fvSeenFire__.x____ <- fvSeenFire,
						visualPosition__.x____ <- visualPosition,
						vnavEnable__.x____ <- vnavEnable,
						vnavDisable__.x____ <- vnavDisable
						| x____ <- NIDS
					]]
				)
				)
				 [| union(stateClockSync,{terminate}) |]
				 StateClocks(id__,
				 		          const_pre_pkg__VisualNav_TRACK_DIST,
				 		          const_pre_pkg__VisualNav_SCAN_DIST)
				)\diff(stateClockSync,enteredSS))
				 [| {| interrupt |} |] SKIP)
			)
			)
		
		Behaviour_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = 
			dbisim((let
				stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
			 within
				(MachineBody_VS_O(id__,
						    const_pre_pkg__VisualNav_TRACK_DIST,
						    const_pre_pkg__VisualNav_SCAN_DIST) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		IteratedBehaviour_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = 
			dbisim((let
				stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
			 within
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								MachineBody_VS_O(id__,
										    const_pre_pkg__VisualNav_TRACK_DIST,
										    const_pre_pkg__VisualNav_SCAN_DIST)
								[| {|get_CLID_Inactive,Inactive::entered,terminate|} |]
								dbisim(Clock_CLID_Inactive(id__,0,
										          const_pre_pkg__VisualNav_TRACK_DIST,
										          const_pre_pkg__VisualNav_SCAN_DIST))
							)\{|get_CLID_Inactive|}
						)
						[| {|get_CLID_Active,Active::entered,terminate|} |]
						dbisim(Clock_CLID_Active(id__,0,
								          const_pre_pkg__VisualNav_TRACK_DIST,
								          const_pre_pkg__VisualNav_SCAN_DIST))
					)\{|get_CLID_Active|}
				)
				) \ diff(union(stateClockSync,enteredSS),enteredSS)
			)
			)
		
		Stateful_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = 
			dbisim((let
				getsetLocalChannels = {|get_tgt,set_tgt,
				get_wm,set_wm,
				get_movement,set_movement|}
				clockSync = {||}
			within
				(Behaviour_VS_O(id__,
						    const_pre_pkg__VisualNav_TRACK_DIST,
						    const_pre_pkg__VisualNav_SCAN_DIST) 
				 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
				 (varMemory(id__,
				 		    const_pre_pkg__VisualNav_TRACK_DIST,
				 		    const_pre_pkg__VisualNav_SCAN_DIST) [| {terminate} |] Clocks(id__,
				 		          const_pre_pkg__VisualNav_TRACK_DIST,
				 		          const_pre_pkg__VisualNav_SCAN_DIST))
			 	)\union(getsetLocalChannels,clockSync)
			)
			)
		
		IteratedStateful_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) =
			(dbisim(
				sbisim(
					dbisim(
						sbisim(
							dbisim(
								sbisim(
									IteratedBehaviour_VS_O(id__,
											    const_pre_pkg__VisualNav_TRACK_DIST,
											    const_pre_pkg__VisualNav_SCAN_DIST)
									[| {|get_movement,set_movement,terminate|} |]
									Memory_movement((0,0,0,0))
								)\{|get_movement,set_movement|}
							)
							[| {|get_wm,set_wm,terminate|} |]
							Memory_wm((0,0,0))
						)\{|get_wm,set_wm|}
					)
					[| {|get_tgt,set_tgt,terminate|} |]
					Memory_tgt((FireStatus_NoFire,0,0,0))
				)\{|get_tgt,set_tgt|}
			)
			)
		
		-- END
		
		-- Memory
		-- Memory variables
		Memory_tgt(tgt) =
			get_tgt!tgt -> Memory_tgt(tgt)
			[]
			set_tgt?x__ -> Memory_tgt(x__)
			[]
			terminate -> SKIP
		Memory_wm(wm) =
			get_wm!wm -> Memory_wm(wm)
			[]
			set_wm?x__ -> Memory_wm(x__)
			[]
			terminate -> SKIP
		Memory_movement(movement) =
			get_movement!movement -> Memory_movement(movement)
			[]
			set_movement?x__ -> Memory_movement(x__)
			[]
			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = Memory_tgt((FireStatus_NoFire,0,0,0))
		[| { terminate } |] (
		Memory_wm((0,0,0))
		[| { terminate } |] (
		Memory_movement((0,0,0,0))
		)
		)
		
		getsetLocalChannels = {|get_tgt,set_tgt,get_wm,set_wm,get_movement,set_movement|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = STM_VS_O(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) \ localClockResets
		D__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = timed_priority(STM(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) \ union(internal_events,localClockResets))
		O__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(D__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST))
		VS__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = FVS__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST)
		VS_O__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(FVS__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST))
		HEXT__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = O__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) [|shared_variable_events|] SKIP
		FVS_C__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(timed_priority(STM(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) \ internal_events))
		HUP__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = timed_priority(O__(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_pre_pkg__VisualNav_TRACK_DIST,
				          const_pre_pkg__VisualNav_SCAN_DIST) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Active(id__,x__,
				          const_pre_pkg__VisualNav_TRACK_DIST,
				          const_pre_pkg__VisualNav_SCAN_DIST) = 
			TimeOut_1(
				Active::entered -> Clock_CLID_Active(id__,0,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)
				[]
				get_CLID_Active!x__ -> Clock_CLID_Active(id__,x__,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)
				[]
				terminate -> SKIP,Clock_CLID_Active(id__,clock_type_plus(x__,1,CLID_Active_clock_type(id__,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)),
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST))
		Clock_CLID_Inactive(id__,x__,
				          const_pre_pkg__VisualNav_TRACK_DIST,
				          const_pre_pkg__VisualNav_SCAN_DIST) = 
			TimeOut_1(
				Inactive::entered -> Clock_CLID_Inactive(id__,0,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)
				[]
				get_CLID_Inactive!x__ -> Clock_CLID_Inactive(id__,x__,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)
				[]
				terminate -> SKIP,Clock_CLID_Inactive(id__,clock_type_plus(x__,1,CLID_Inactive_clock_type(id__,
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST)),
						          const_pre_pkg__VisualNav_TRACK_DIST,
						          const_pre_pkg__VisualNav_SCAN_DIST))
		
		StateClocks(id__,
				          const_pre_pkg__VisualNav_TRACK_DIST,
				          const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(Clock_CLID_Active(id__,0,
				          const_pre_pkg__VisualNav_TRACK_DIST,
				          const_pre_pkg__VisualNav_SCAN_DIST))
		[| { terminate } |] (
		dbisim(Clock_CLID_Inactive(id__,0,
				          const_pre_pkg__VisualNav_TRACK_DIST,
				          const_pre_pkg__VisualNav_SCAN_DIST))
		)
		
		stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
		
		-- Shared memory
		-- Shared memory variables
		
		-- sharedVarMemory process
		sharedVarMemory(id__,
				    const_pre_pkg__VisualNav_TRACK_DIST,
				    const_pre_pkg__VisualNav_SCAN_DIST) = terminate -> SKIP
		
		sharedVarSync = {||}
		
		sharedVarHide = {||}
		}
endmodule
