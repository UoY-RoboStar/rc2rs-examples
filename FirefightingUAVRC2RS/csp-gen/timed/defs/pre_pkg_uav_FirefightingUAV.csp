						Timed(OneStep) {
							--	Rule: behaviours(Node)
							--  Note that FDR has problems with efficiently compiling the process below
							-- 	if using a different recursion pattern.
							D__(id__,
									    const_pre_pkg__Flight_CLIMB_LIFT,
									    const_pre_pkg__Flight_DELAY_DISARM,
									    const_pre_pkg__Flight_HOME) = 
							dbisim(let
								-- IMPLEMENTATION NOTE: 
								-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
								-- however FDR struggles with that form in certain cases. So we use the exception operator
								-- instead to 'terminate'.
								
								Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
								
								Termination = terminate -> SKIP
								
								Active 		= true&CALL__fcLandCall(
											id__,
										    const_pre_pkg__Flight_CLIMB_LIFT,
										    const_pre_pkg__Flight_DELAY_DISARM,
										    const_pre_pkg__Flight_HOME
										) ; 
										 	  Behaviour ; 
										 	  share__choice(exit -> SKIP) ; SKIP ; 
										 	  share__choice(exited -> SKIP) ; Inactive
							
							
								Behaviour 	= dbisim(
									((
									 (((dbisim(
									 	sbisim(
									 		(let
									 			-- IMPLEMENTATION NOTE:
									 			-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
									 			-- modules for defining the semantics of each node.
									 			enterSS = {|
									 			i::enter,
									 			EmptyCycle::enter
									 			|}
									 			hideSet = union(enterSS,{|exit,exited,internal__|})
									 		within 
									 			((let
									 				-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									 				-- because CSPM modules are used for the semantics of Node.
									 				flowevts = union(enterSS,{|exit,exited,interrupt|})
									 				transSync = {|internal__.NID_i|}
									 			within
									 				((
									 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									 				   i::D__(id__,
									 				   		    const_pre_pkg__Flight_CLIMB_LIFT,
									 				   		    const_pre_pkg__Flight_DELAY_DISARM,
									 				   		    const_pre_pkg__Flight_HOME)
									 				   [| { share__, terminate } |] (
									 				   EmptyCycle::D__(id__,
									 				   		    const_pre_pkg__Flight_CLIMB_LIFT,
									 				   		    const_pre_pkg__Flight_DELAY_DISARM,
									 				   		    const_pre_pkg__Flight_HOME)
									 				   )
									 				 )
									 				 [[EmptyCycle::interrupt <- x__ | x__ <- {|interrupt|}]]
									 				 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
									 				 )
									 				  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 				 )
									 				 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 				|}) |]
									 				 ((i::enter -> Transitions(id__,
									 				 		    const_pre_pkg__Flight_CLIMB_LIFT,
									 				 		    const_pre_pkg__Flight_DELAY_DISARM,
									 				 		    const_pre_pkg__Flight_HOME))
									 				  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 				 )
									 				)
									 				)
									 			)
									 			 \ hideSet)
									 			[[
									 				fcControlAuth__.x____ <- fcControlAuth,
									 				fcTakeoffRet__.x____ <- fcTakeoffRet,
									 				fcGoHomeRet__.x____ <- fcGoHomeRet,
									 				fcLandRet__.x____ <- fcLandRet,
									 				fcWaypointFinishedMission__.x____ <- fcWaypointFinishedMission,
									 				fcMoveRelativeRet__.x____ <- fcMoveRelativeRet,
									 				navCommand__.x____ <- navCommand,
									 				waypoint__.x____ <- waypoint,
									 				uavStatus__.x____ <- uavStatus,
									 				visualPosition__.x____ <- visualPosition
									 				| x____ <- NIDS
									 			]]
									 		)
									 		[| {|get_CLID_EmptyCycle,EmptyCycle::entered,terminate|} |]
									 		dbisim(Clock_CLID_EmptyCycle(id__,0,
									 				          const_pre_pkg__Flight_CLIMB_LIFT,
									 				          const_pre_pkg__Flight_DELAY_DISARM,
									 				          const_pre_pkg__Flight_HOME))
									 	)\{|get_CLID_EmptyCycle|}
									 )
									 ))
									  [[ share__ <- x__ | x__ <- {| share__,setR_h,setR_cmd,setR_start,setR_wp,setR_vp,setR_gotStart |} ]] 
									  [[set_h <- setL_h,set_cmd <- setL_cmd,set_start <- setL_start,set_wp <- setL_wp,set_vp <- setL_vp,set_gotStart <- setL_gotStart]]
									 )
									 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
									 			,setL_h
									 			,setL_cmd
									 			,setL_start
									 			,setL_wp
									 			,setL_vp
									 			,setL_gotStart
									 			,setR_h
									 			 			,setR_cmd
									 			 			,setR_start
									 			 			,setR_wp
									 			 			,setR_vp
									 			 			,setR_gotStart
									 			|}) |]
									 ((During)
									  [[ share__ <- x__ | x__ <- {| share__,setL_h,setL_cmd,setL_start,setL_wp,setL_vp,setL_gotStart |} ]]
									  [[set_h <- setR_h,set_cmd <- setR_cmd,set_start <- setR_start,set_wp <- setR_wp,set_vp <- setR_vp,set_gotStart <- setR_gotStart]]
									 )
									)[[setL_h <- set_h,setL_cmd <- set_cmd,setL_start <- set_start,setL_wp <- set_wp,setL_vp <- set_vp,setL_gotStart <- set_gotStart]]
									 [[setR_h <- set_h,setR_cmd <- set_cmd,setR_start <- set_start,setR_wp <- set_wp,setR_vp <- set_vp,setR_gotStart <- set_gotStart]]
									)\union(enteredSS,{terminate}) 
								)
								During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
										 	  ; entered -> ((CRUN(enteredSS) ||| SKIP ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
							within
								Inactive [| {terminate} |> SKIP)
								
							VS_O__(id__,
									    const_pre_pkg__Flight_CLIMB_LIFT,
									    const_pre_pkg__Flight_DELAY_DISARM,
									    const_pre_pkg__Flight_HOME) = 
							dbisim(let
								Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
								
								Termination = terminate -> SKIP
								
								Active 		= true&CALL__fcLandCall(
											id__,
										    const_pre_pkg__Flight_CLIMB_LIFT,
										    const_pre_pkg__Flight_DELAY_DISARM,
										    const_pre_pkg__Flight_HOME
										) ; 
										 	  Behaviour ; 
										 	  share__choice(exit -> SKIP) ; SKIP ; 
										 	  share__choice(exited -> SKIP) ; Inactive
							
							
								Behaviour 	= dbisim(
									((
									 (((dbisim(
									 	sbisim(
									 		(let
									 			-- IMPLEMENTATION NOTE:
									 			-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
									 			-- modules for defining the semantics of each node.
									 			enterSS = {|
									 			i::enter,
									 			EmptyCycle::enter
									 			|}
									 			hideSet = union(enterSS,{|exit,exited,internal__|})
									 		within 
									 			((let
									 				-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									 				-- because CSPM modules are used for the semantics of Node.
									 				flowevts = union(enterSS,{|exit,exited,interrupt|})
									 				transSync = {|internal__.NID_i|}
									 			within
									 				((
									 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									 				   i::VS_O__(id__,
									 				   		    const_pre_pkg__Flight_CLIMB_LIFT,
									 				   		    const_pre_pkg__Flight_DELAY_DISARM,
									 				   		    const_pre_pkg__Flight_HOME)
									 				   [| { share__, terminate } |] (
									 				   EmptyCycle::VS_O__(id__,
									 				   		    const_pre_pkg__Flight_CLIMB_LIFT,
									 				   		    const_pre_pkg__Flight_DELAY_DISARM,
									 				   		    const_pre_pkg__Flight_HOME)
									 				   )
									 				 )
									 				 [[EmptyCycle::interrupt <- x__ | x__ <- {|interrupt|}]]
									 				 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
									 				 )
									 				  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 				 )
									 				 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 				|}) |]
									 				 ((i::enter -> Transitions(id__,
									 				 		    const_pre_pkg__Flight_CLIMB_LIFT,
									 				 		    const_pre_pkg__Flight_DELAY_DISARM,
									 				 		    const_pre_pkg__Flight_HOME))
									 				  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 				 )
									 				)
									 				)
									 			)
									 			 \ hideSet)
									 			[[
									 				fcControlAuth__.x____ <- fcControlAuth,
									 				fcTakeoffRet__.x____ <- fcTakeoffRet,
									 				fcGoHomeRet__.x____ <- fcGoHomeRet,
									 				fcLandRet__.x____ <- fcLandRet,
									 				fcWaypointFinishedMission__.x____ <- fcWaypointFinishedMission,
									 				fcMoveRelativeRet__.x____ <- fcMoveRelativeRet,
									 				navCommand__.x____ <- navCommand,
									 				waypoint__.x____ <- waypoint,
									 				uavStatus__.x____ <- uavStatus,
									 				visualPosition__.x____ <- visualPosition
									 				| x____ <- NIDS
									 			]]
									 		)
									 		[| {|get_CLID_EmptyCycle,EmptyCycle::entered,terminate|} |]
									 		dbisim(Clock_CLID_EmptyCycle(id__,0,
									 				          const_pre_pkg__Flight_CLIMB_LIFT,
									 				          const_pre_pkg__Flight_DELAY_DISARM,
									 				          const_pre_pkg__Flight_HOME))
									 	)\{|get_CLID_EmptyCycle|}
									 )
									 ))
									  [[ share__ <- x__ | x__ <- {| share__,setR_h,setR_cmd,setR_start,setR_wp,setR_vp,setR_gotStart |} ]] 
									  [[set_h <- setL_h,set_cmd <- setL_cmd,set_start <- setL_start,set_wp <- setL_wp,set_vp <- setL_vp,set_gotStart <- setL_gotStart]]
									 )
									 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
									 			,setL_h
									 			,setL_cmd
									 			,setL_start
									 			,setL_wp
									 			,setL_vp
									 			,setL_gotStart
									 			,setR_h
									 			 			,setR_cmd
									 			 			,setR_start
									 			 			,setR_wp
									 			 			,setR_vp
									 			 			,setR_gotStart
									 			|}) |]
									 ((During)
									  [[ share__ <- x__ | x__ <- {| share__,setL_h,setL_cmd,setL_start,setL_wp,setL_vp,setL_gotStart |} ]]
									  [[set_h <- setR_h,set_cmd <- setR_cmd,set_start <- setR_start,set_wp <- setR_wp,set_vp <- setR_vp,set_gotStart <- setR_gotStart]]
									 )
									)[[setL_h <- set_h,setL_cmd <- set_cmd,setL_start <- set_start,setL_wp <- set_wp,setL_vp <- set_vp,setL_gotStart <- set_gotStart]]
									 [[setR_h <- set_h,setR_cmd <- set_cmd,setR_start <- set_start,setR_wp <- set_wp,setR_vp <- set_vp,setR_gotStart <- set_gotStart]]
