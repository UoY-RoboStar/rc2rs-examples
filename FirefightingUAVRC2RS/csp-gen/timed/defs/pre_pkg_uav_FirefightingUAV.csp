									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__,
							 		          const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							 		          const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = 
						dbisim((let
							stateClockSync = {|get_CLID_Monitoring,Monitoring::entered|}
						 within
							(MachineBody_VS_O(id__,
									    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
									    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
									          const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
									          const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					IteratedBehaviour_VS_O(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = 
						dbisim((let
							stateClockSync = {|get_CLID_Monitoring,Monitoring::entered|}
						 within
							(dbisim(
								sbisim(
									MachineBody_VS_O(id__,
											    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
											    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)
									[| {|get_CLID_Monitoring,Monitoring::entered,terminate|} |]
									dbisim(Clock_CLID_Monitoring(id__,0,
