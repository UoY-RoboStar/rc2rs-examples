					Clock_CLID_Monitoring(id__,x__,
							          const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							          const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = 
						TimeOut_1(
