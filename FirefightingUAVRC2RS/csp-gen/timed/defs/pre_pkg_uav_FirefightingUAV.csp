							getsetLocalChannels = {|get_battery,set_battery|}
							clockSync = {||}
						within
							(Behaviour_VS_O(id__,
									    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
									    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
