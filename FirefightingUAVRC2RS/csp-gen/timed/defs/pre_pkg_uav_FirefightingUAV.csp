									 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									 				   i::D__(id__,
									 				   		    const_pre_pkg__VisualNav_TRACK_DIST,
									 				   		    const_pre_pkg__VisualNav_SCAN_DIST)
									 				   [| { share__, terminate } |] (
									 				   EmptyCycle::D__(id__,
									 				   		    const_pre_pkg__VisualNav_TRACK_DIST,
									 				   		    const_pre_pkg__VisualNav_SCAN_DIST)
									 				   )
									 				 )
									 				 [[EmptyCycle::interrupt <- x__ | x__ <- {|interrupt|}]]
									 				 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
									 				 )
									 				  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 				 )
									 				 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 				|}) |]
									 				 ((i::enter -> Transitions(id__,
									 				 		    const_pre_pkg__VisualNav_TRACK_DIST,
									 				 		    const_pre_pkg__VisualNav_SCAN_DIST))
									 				  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 				 )
									 				)
									 				)
									 			)
									 			 \ hideSet)
									 			[[
									 				wallMetrics__.x____ <- wallMetrics,
									 				fvSeenFire__.x____ <- fvSeenFire,
									 				visualPosition__.x____ <- visualPosition,
									 				vnavEnable__.x____ <- vnavEnable,
									 				vnavDisable__.x____ <- vnavDisable
									 				| x____ <- NIDS
									 			]]
									 		)
									 		[| {|get_CLID_EmptyCycle,EmptyCycle::entered,terminate|} |]
									 		dbisim(Clock_CLID_EmptyCycle(id__,0,
									 				          const_pre_pkg__VisualNav_TRACK_DIST,
									 				          const_pre_pkg__VisualNav_SCAN_DIST))
									 	)\{|get_CLID_EmptyCycle|}
									 )
									 ))
									  [[ share__ <- x__ | x__ <- {| share__,setR_tgt,setR_wm,setR_movement |} ]] 
									  [[set_tgt <- setL_tgt,set_wm <- setL_wm,set_movement <- setL_movement]]
									 )
									 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
									 			,setL_tgt
									 			,setL_wm
									 			,setL_movement
									 			,setR_tgt
									 			 			,setR_wm
									 			 			,setR_movement
									 			|}) |]
									 ((During)
									  [[ share__ <- x__ | x__ <- {| share__,setL_tgt,setL_wm,setL_movement |} ]]
									  [[set_tgt <- setR_tgt,set_wm <- setR_wm,set_movement <- setR_movement]]
									 )
									)[[setL_tgt <- set_tgt,setL_wm <- set_wm,setL_movement <- set_movement]]
