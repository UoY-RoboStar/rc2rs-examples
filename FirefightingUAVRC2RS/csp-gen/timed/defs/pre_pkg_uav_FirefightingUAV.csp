					-- Memory
					-- Memory variables
					Memory_battery(battery) =
						get_battery!battery -> Memory_battery(battery)
						[]
						set_battery?x__ -> Memory_battery(x__)
						[]
						terminate -> SKIP
					
					-- varMemory process
					varMemory(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = Memory_battery((0))
					
					getsetLocalChannels = {|get_battery,set_battery|}
					
