														    const_pre_pkg__VisualNav_TRACK_DIST,
														    const_pre_pkg__VisualNav_SCAN_DIST)
												[| {|get_movement,set_movement,terminate|} |]
												Memory_movement((0,0,0,0))
											)\{|get_movement,set_movement|}
										)
										[| {|get_wm,set_wm,terminate|} |]
										Memory_wm((0,0,0))
									)\{|get_wm,set_wm|}
								)
								[| {|get_tgt,set_tgt,terminate|} |]
								Memory_tgt((FireStatus_NoFire,0,0,0))
							)\{|get_tgt,set_tgt|}
						)
						)
					
					-- Visible counterparts
					MachineBody_VS_O(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								I::enter,
								Inactive::enter,
								Active::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_I,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Active.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   I::VS_O__(id__,
									   		    const_pre_pkg__VisualNav_TRACK_DIST,
									   		    const_pre_pkg__VisualNav_SCAN_DIST)
									   [| { share__, terminate } |] (
									   Inactive::VS_O__(id__,
									   		    const_pre_pkg__VisualNav_TRACK_DIST,
									   		    const_pre_pkg__VisualNav_SCAN_DIST)
									   [| { share__, terminate } |] (
									   Active::VS_O__(id__,
									   		    const_pre_pkg__VisualNav_TRACK_DIST,
									   		    const_pre_pkg__VisualNav_SCAN_DIST)
									   )
									   )
									 )
									 [[Inactive::interrupt <- x__ | x__ <- {|interrupt,vnavEnable__.NID_Inactive.in,vnavDisable__.NID_Inactive.in,wallMetrics__.NID_Inactive.in,fvSeenFire__.NID_Inactive.in|}]]
									 [[Active::interrupt <- x__ | x__ <- {|interrupt,vnavDisable__.NID_Active.in|}]]
									 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__,setR_tgt,setR_wm |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									 			,setR_tgt
									 			 			,setR_wm
									 			|}) |]
									 ((I::enter -> Transitions(id__,
									 		    const_pre_pkg__VisualNav_TRACK_DIST,
									 		    const_pre_pkg__VisualNav_SCAN_DIST))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									  [[set_tgt <- setR_tgt,set_wm <- setR_wm]]
									 )
									)
									 [[setR_tgt <- set_tgt,setR_wm <- set_wm]]
									)
								)
								 \ hideSet)
								[[
									wallMetrics__.x____ <- wallMetrics,
									fvSeenFire__.x____ <- fvSeenFire,
									visualPosition__.x____ <- visualPosition,
									vnavEnable__.x____ <- vnavEnable,
									vnavDisable__.x____ <- vnavDisable
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__,
							 		          const_pre_pkg__VisualNav_TRACK_DIST,
							 		          const_pre_pkg__VisualNav_SCAN_DIST)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = 
						dbisim((let
							stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
						 within
							(MachineBody_VS_O(id__,
									    const_pre_pkg__VisualNav_TRACK_DIST,
									    const_pre_pkg__VisualNav_SCAN_DIST) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					IteratedBehaviour_VS_O(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = 
						dbisim((let
							stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											MachineBody_VS_O(id__,
													    const_pre_pkg__VisualNav_TRACK_DIST,
													    const_pre_pkg__VisualNav_SCAN_DIST)
											[| {|get_CLID_Inactive,Inactive::entered,terminate|} |]
											dbisim(Clock_CLID_Inactive(id__,0,
													          const_pre_pkg__VisualNav_TRACK_DIST,
													          const_pre_pkg__VisualNav_SCAN_DIST))
										)\{|get_CLID_Inactive|}
									)
									[| {|get_CLID_Active,Active::entered,terminate|} |]
									dbisim(Clock_CLID_Active(id__,0,
											          const_pre_pkg__VisualNav_TRACK_DIST,
											          const_pre_pkg__VisualNav_SCAN_DIST))
								)\{|get_CLID_Active|}
							)
							) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					Stateful_VS_O(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = 
						dbisim((let
							getsetLocalChannels = {|get_tgt,set_tgt,
							get_wm,set_wm,
							get_movement,set_movement|}
							clockSync = {||}
						within
							(Behaviour_VS_O(id__,
									    const_pre_pkg__VisualNav_TRACK_DIST,
									    const_pre_pkg__VisualNav_SCAN_DIST) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__,
							 		    const_pre_pkg__VisualNav_TRACK_DIST,
							 		    const_pre_pkg__VisualNav_SCAN_DIST) [| {terminate} |] Clocks(id__,
							 		          const_pre_pkg__VisualNav_TRACK_DIST,
							 		          const_pre_pkg__VisualNav_SCAN_DIST))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful_VS_O(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) =
						(dbisim(
							sbisim(
								dbisim(
									sbisim(
										dbisim(
											sbisim(
												IteratedBehaviour_VS_O(id__,
														    const_pre_pkg__VisualNav_TRACK_DIST,
														    const_pre_pkg__VisualNav_SCAN_DIST)
												[| {|get_movement,set_movement,terminate|} |]
												Memory_movement((0,0,0,0))
											)\{|get_movement,set_movement|}
										)
										[| {|get_wm,set_wm,terminate|} |]
										Memory_wm((0,0,0))
									)\{|get_wm,set_wm|}
								)
								[| {|get_tgt,set_tgt,terminate|} |]
								Memory_tgt((FireStatus_NoFire,0,0,0))
							)\{|get_tgt,set_tgt|}
						)
						)
					
					-- END
					
					-- Memory
					-- Memory variables
					Memory_tgt(tgt) =
						get_tgt!tgt -> Memory_tgt(tgt)
						[]
						set_tgt?x__ -> Memory_tgt(x__)
						[]
						terminate -> SKIP
					Memory_wm(wm) =
						get_wm!wm -> Memory_wm(wm)
						[]
						set_wm?x__ -> Memory_wm(x__)
						[]
						terminate -> SKIP
					Memory_movement(movement) =
						get_movement!movement -> Memory_movement(movement)
						[]
						set_movement?x__ -> Memory_movement(x__)
						[]
						terminate -> SKIP
					
					-- varMemory process
					varMemory(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = Memory_tgt((FireStatus_NoFire,0,0,0))
					[| { terminate } |] (
					Memory_wm((0,0,0))
					[| { terminate } |] (
					Memory_movement((0,0,0,0))
					)
					)
					
					getsetLocalChannels = {|get_tgt,set_tgt,get_wm,set_wm,get_movement,set_movement|}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = STM_VS_O(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) \ localClockResets
					D__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = timed_priority(STM(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) \ union(internal_events,localClockResets))
					O__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(D__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST))
					VS__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = FVS__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST)
					VS_O__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(FVS__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST))
					HEXT__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = O__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) [|shared_variable_events|] SKIP
					FVS_C__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(timed_priority(STM(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) \ internal_events))
					HUP__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = timed_priority(O__(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) [|{share__}|] SKIP)
					
					-- Clocks
					
					Clocks(id__,
							          const_pre_pkg__VisualNav_TRACK_DIST,
							          const_pre_pkg__VisualNav_SCAN_DIST) = terminate -> SKIP
					
					clockSync = {||}
					
					Clock_CLID_Active(id__,x__,
							          const_pre_pkg__VisualNav_TRACK_DIST,
							          const_pre_pkg__VisualNav_SCAN_DIST) = 
						TimeOut_1(
							Active::entered -> Clock_CLID_Active(id__,0,
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST)
							[]
							get_CLID_Active!x__ -> Clock_CLID_Active(id__,x__,
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST)
							[]
							terminate -> SKIP,Clock_CLID_Active(id__,clock_type_plus(x__,1,CLID_Active_clock_type(id__,
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST)),
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST))
					Clock_CLID_Inactive(id__,x__,
							          const_pre_pkg__VisualNav_TRACK_DIST,
							          const_pre_pkg__VisualNav_SCAN_DIST) = 
						TimeOut_1(
							Inactive::entered -> Clock_CLID_Inactive(id__,0,
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST)
							[]
							get_CLID_Inactive!x__ -> Clock_CLID_Inactive(id__,x__,
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST)
							[]
							terminate -> SKIP,Clock_CLID_Inactive(id__,clock_type_plus(x__,1,CLID_Inactive_clock_type(id__,
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST)),
									          const_pre_pkg__VisualNav_TRACK_DIST,
									          const_pre_pkg__VisualNav_SCAN_DIST))
					
					StateClocks(id__,
							          const_pre_pkg__VisualNav_TRACK_DIST,
							          const_pre_pkg__VisualNav_SCAN_DIST) = dbisim(Clock_CLID_Active(id__,0,
							          const_pre_pkg__VisualNav_TRACK_DIST,
							          const_pre_pkg__VisualNav_SCAN_DIST))
					[| { terminate } |] (
					dbisim(Clock_CLID_Inactive(id__,0,
							          const_pre_pkg__VisualNav_TRACK_DIST,
							          const_pre_pkg__VisualNav_SCAN_DIST))
					)
					
					stateClockSync = {|get_CLID_Active,Active::entered,get_CLID_Inactive,Inactive::entered|}
					
					-- Shared memory
					-- Shared memory variables
					
					-- sharedVarMemory process
					sharedVarMemory(id__,
							    const_pre_pkg__VisualNav_TRACK_DIST,
							    const_pre_pkg__VisualNav_SCAN_DIST) = terminate -> SKIP
					
					sharedVarSync = {||}
					
					sharedVarHide = {||}
					}
			endmodule
			module CFlight
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
			
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I|
				              NID_Connect|
				              NID_Waiting|
				              NID_ProcessingCommand|
				              NID_Waypoint|
				              NID_Relative|
				              NID_TakingOff|
				              NID_Climbing|
				              NID_GoHome|
				              NID_BackToStart|
				              NID_Landing|
				              NID_Disarmed|
				              NID_GoingHome
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
				channel get_h, set_h, setL_h, setR_h: core_real
				channel get_cmd, set_cmd, setL_cmd, setR_cmd: NavCommand
				channel get_vp, set_vp, setL_vp, setR_vp: RelativeMotion
				channel get_wp, set_wp, setL_wp, setR_wp: Position
				channel get_start, set_start, setL_start, setR_start: Position
				channel get_gotStart, set_gotStart, setL_gotStart, setR_gotStart: core_boolean
				
				-- Shared variable channels
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				channel fcControlAuth__: NIDS.InOut
				channel fcControlAuth: InOut
				channel fcTakeoffRet__: NIDS.InOut
				channel fcTakeoffRet: InOut
				channel fcGoHomeRet__: NIDS.InOut
				channel fcGoHomeRet: InOut
				channel fcLandRet__: NIDS.InOut
				channel fcLandRet: InOut
				channel fcWaypointFinishedMission__: NIDS.InOut
				channel fcWaypointFinishedMission: InOut
				channel fcMoveRelativeRet__: NIDS.InOut
				channel fcMoveRelativeRet: InOut
				channel navCommand__: NIDS.InOut.NavCommand
				channel navCommand: InOut.NavCommand
				channel waypoint__: NIDS.InOut.Position
				channel waypoint: InOut.Position
				channel uavStatus__: NIDS.InOut.AircraftStatus
				channel uavStatus: InOut.AircraftStatus
				channel visualPosition__: NIDS.InOut.RelativeMotion
				channel visualPosition: InOut.RelativeMotion
				
				-- Declaring call and ret events for undefined operations
				channel fcGoHomeCallCall
				channel fcWaypointCallCall: Position
				channel fcTakeoffCallCall
				channel fcLandCallCall
				channel fcMoveRelativeCallCall: RelativeMotion
				
				enterSS = {|
				I::enter,
				Connect::enter,
				Waiting::enter,
				ProcessingCommand::enter,
				Waypoint::enter,
				Relative::enter,
				TakingOff::enter,
				Climbing::enter,
				GoHome::enter,
				BackToStart::enter,
				Landing::enter,
				Disarmed::enter,
				GoingHome::enter
				|}
				
				enteredSS = 	{|
				Connect::entered,
				Waiting::entered,
				Waypoint::entered,
				Relative::entered,
				TakingOff::entered,
				Climbing::entered,
				BackToStart::entered,
				Landing::entered,
				Disarmed::entered,
				GoingHome::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	fcControlAuth,
					fcTakeoffRet,
					fcGoHomeRet,
					fcLandRet,
					fcWaypointFinishedMission,
					fcMoveRelativeRet,
					navCommand,
					waypoint,
					uavStatus,
					visualPosition
				,	fcGoHomeCallCall,
					fcWaypointCallCall,
					fcTakeoffCallCall,
					fcLandCallCall,
					fcMoveRelativeCallCall
					|}
				
				channel clockReset, clockResetL, clockResetR 
				
				localClockResets = {||}
				
				
				channel get_CLID_Waypoint : core_clock_type 
				channel get_CLID_Disarmed : core_clock_type 
				channel get_CLID_Waiting : core_clock_type 
				channel get_CLID_BackToStart : core_clock_type 
				channel get_CLID_Landing : core_clock_type 
				channel get_CLID_TakingOff : core_clock_type 
				channel get_CLID_Climbing : core_clock_type 
				channel get_CLID_Connect : core_clock_type 
				channel get_CLID_Relative : core_clock_type 
				channel get_CLID_GoingHome : core_clock_type 
				--channel increment__
				
				CLID_Waypoint_clock_type(id__,
						          const_pre_pkg__Flight_CLIMB_LIFT,
						          const_pre_pkg__Flight_DELAY_DISARM,
						          const_pre_pkg__Flight_HOME) = 
					let
						max = (clock_type_max(Union({
				{}
				}))+1)
					ctype = {0..max}
				within
					if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
				
				CLID_Disarmed_clock_type(id__,
						          const_pre_pkg__Flight_CLIMB_LIFT,
						          const_pre_pkg__Flight_DELAY_DISARM,
						          const_pre_pkg__Flight_HOME) = 
					let
						max = (clock_type_max(Union({
				{}
				}))+1)
					ctype = {0..max}
				within
					if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
				
				CLID_Waiting_clock_type(id__,
						          const_pre_pkg__Flight_CLIMB_LIFT,
						          const_pre_pkg__Flight_DELAY_DISARM,
						          const_pre_pkg__Flight_HOME) = 
					let
						max = (clock_type_max(Union({
