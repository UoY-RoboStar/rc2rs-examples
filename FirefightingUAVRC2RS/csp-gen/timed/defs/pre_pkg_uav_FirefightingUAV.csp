									          const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD)),
									          const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
									          const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD))
					
					StateClocks(id__,
							          const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							          const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = dbisim(Clock_CLID_Monitoring(id__,0,
							          const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							          const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD))
					
					stateClockSync = {|get_CLID_Monitoring,Monitoring::entered|}
					
					-- Shared memory
					-- Shared memory variables
					
					-- sharedVarMemory process
					sharedVarMemory(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = terminate -> SKIP
					
					sharedVarSync = {||}
					
					sharedVarHide = {||}
					}
			endmodule
			module CGimbalAim
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
			
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I|
				              NID_Waiting|
				              NID_Calculate|
				              NID_Yaw|
				              NID_Pitch|
				              NID_IsValid|
				              NID_Clamp|
				              NID_MaybeAimed
				
				channel internal__ : NIDS
				
