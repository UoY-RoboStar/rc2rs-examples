					----------------------------------------------------------------------
					
					
					----------------------------------------------------------------------
					-- State: Connect
					module Connect
					
					enterSS = 
							{|			i::enter,
								EmptyCycle::enter
							|}
					enteredSS = 
							{|			EmptyCycle::entered
							|}
					exports
					
						--  Declarations
						
						channel enter, entered, interrupt
						channel enteredL, enteredR
						
										
						-- declaring identifiers of transitions
						datatype NIDS = 
						              NID_i|
						              NID_EmptyCycle
						
