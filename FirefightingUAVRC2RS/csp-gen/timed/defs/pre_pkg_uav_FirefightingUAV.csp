							VS_O__(id__,
									    const_pre_pkg__VisualNav_TRACK_DIST,
									    const_pre_pkg__VisualNav_SCAN_DIST) = 
							dbisim(let
								Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
								
								Termination = terminate -> SKIP
								
								Active 		= SKIP ; 
										 	  Behaviour ; 
										 	  share__choice(exit -> SKIP) ; SKIP ; 
