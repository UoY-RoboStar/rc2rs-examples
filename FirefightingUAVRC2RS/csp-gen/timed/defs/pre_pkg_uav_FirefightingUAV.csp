						          const_pre_pkg__Flight_HOME) = 
					let
						max = (clock_type_max(Union({
				{}
				}))+1)
					ctype = {0..max}
				within
					if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
				
				CLID_Landing_clock_type(id__,
						          const_pre_pkg__Flight_CLIMB_LIFT,
						          const_pre_pkg__Flight_DELAY_DISARM,
						          const_pre_pkg__Flight_HOME) = 
					let
						max = (clock_type_max(Union({
