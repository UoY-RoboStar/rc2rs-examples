									 )
									 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
									 			,setL_h
									 			,setL_cmd
									 			,setL_start
									 			,setL_wp
									 			,setL_vp
									 			,setL_gotStart
									 			,setR_h
									 			 			,setR_cmd
									 			 			,setR_start
									 			 			,setR_wp
									 			 			,setR_vp
									 			 			,setR_gotStart
