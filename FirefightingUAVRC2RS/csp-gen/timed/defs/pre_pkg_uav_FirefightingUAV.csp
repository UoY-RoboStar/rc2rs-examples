							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) \ localClockResets
					D__(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = timed_priority(STM(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) \ union(internal_events,localClockResets))
					O__(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
