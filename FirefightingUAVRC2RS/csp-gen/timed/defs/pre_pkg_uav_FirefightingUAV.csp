							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) \ internal_events))
					HUP__(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) = timed_priority(O__(id__,
							    const_pre_pkg__BatteryMonitor_BATTERY_LOW_THRESHOLD,
							    const_pre_pkg__BatteryMonitor_BATTERY_UNSAFE_THRESHOLD) [|{share__}|] SKIP)
					
