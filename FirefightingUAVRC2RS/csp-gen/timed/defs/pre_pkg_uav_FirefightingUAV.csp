						channel fcGoHomeRet__: NIDS.InOut
						channel fcLandRet__: NIDS.InOut
						channel fcWaypointFinishedMission__: NIDS.InOut
						channel fcMoveRelativeRet__: NIDS.InOut
						channel navCommand__: NIDS.InOut.NavCommand
						channel waypoint__: NIDS.InOut.Position
						channel uavStatus__: NIDS.InOut.AircraftStatus
						channel visualPosition__: NIDS.InOut.RelativeMotion
						
						channel get_CLID_EmptyCycle : core_clock_type 
						--channel increment__
						
						CLID_EmptyCycle_clock_type(id__,
								          const_pre_pkg__Flight_CLIMB_LIFT,
								          const_pre_pkg__Flight_DELAY_DISARM,
								          const_pre_pkg__Flight_HOME) = 
							let
								max = (clock_type_max(Union({
						}))+1)
							ctype = {0..max}
						within
							if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
						
						
						--	Nodes
						-- declaring all nodes
						
