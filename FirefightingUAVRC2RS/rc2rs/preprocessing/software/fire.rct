stm FireDetect {
	uses MLX90640Events uses RealSenseD435iEvents uses FireVisualEvents uses FireGimbalEvents uses FirePlanningEvents requires MLX90640 requires RealSenseD435i requires I_clone_normal_FireDetect_Superimpose_entry requires I_clone_normal_FireDetect_CheckFire_TGain_entry requires I_clone_normal_FireDetect_CheckFire_FLoss_entry requires I_clone_normal_FireDetect_Idle_IR_op requires I_clone_normal_FireDetect_I_II_op requires I_clone_normal_FireDetect_CheckFire_Algorithm_entry requires I_clone_normal_FireDetect_CheckFire_TLoss_entry requires I_clone_normal_FireDetect_Idle_ID_op requires I_clone_normal_FireDetect_CheckFire_FGain_entry requires I_clone_normal_FireDetect_CheckFire_FI_op requires I_clone_normal_FireDetect_CheckWall_entry requires I_clone_normal_FireDetect_CheckFire_Done_entry requires I_clone_normal_FireDetect_Idle_IT_op requires I_clone_normal_FireDetect_CheckFire_entry var fp : FireTarget , fs : FireStatus , wm : WallMetrics , checkDone : boolean
	var gotD : boolean , gotH : boolean , gotR : boolean
	var rgb : RgbFrame , d : Frame , t : Frame , super : SuperimposedFrame
	const LEFT_X : nat , CENTRE_X : nat , RIGHT_X : nat , CENTRE_Y : nat
	initial I
	state Idle {
		initial i
		state EmptyCycle {
		}
		transition tIdle {
			from i
			to EmptyCycle
		}
	}
	state Superimpose {
		initial i
		state EmptyCycle {
		}
		transition tSuperimpose {
			from i
			to EmptyCycle
		}
		entry clone_normal_FireDetect_Superimpose_entry ( )
	}
	state CheckFire {
		initial I
		state Algorithm {
			state EmptyCycle {
			}
			initial i
			transition tAlgorithm {
				from i
				to EmptyCycle
			}
			entry clone_normal_FireDetect_CheckFire_Algorithm_entry ( )
		}
		junction WasNoFire
		junction WasDetected
		junction WasTracked
		state FGain {
			initial i
			state EmptyCycle {
			}
			transition tFGain {
				from i
				to EmptyCycle
			}
			entry clone_normal_FireDetect_CheckFire_FGain_entry ( )
		}
		state TGain {
			state EmptyCycle {
			}
			initial i
			transition tTGain {
				from i
				to EmptyCycle
			}
			entry clone_normal_FireDetect_CheckFire_TGain_entry ( )
		}
		state TLoss {
			state EmptyCycle {
			}
			initial i
			transition tTLoss {
				from i
				to EmptyCycle
			}
			entry clone_normal_FireDetect_CheckFire_TLoss_entry ( )
		}
		state FLoss {
			state EmptyCycle {
			}
			initial i
			transition tFLoss {
				from i
				to EmptyCycle
			}
			entry clone_normal_FireDetect_CheckFire_FLoss_entry ( )
		}
		state Done {
			initial i
			state EmptyCycle {
			}
			transition tDone {
				from i
				to EmptyCycle
			}
			entry clone_normal_FireDetect_CheckFire_Done_entry ( )
		}
		transition Init {
			from I
			to Algorithm
		}
		transition WNF {
			from Algorithm
			to WasNoFire
			condition fs == FireStatus :: NoFire
		}
		transition WDT {
			from Algorithm
			to WasDetected
			condition fs == FireStatus :: Detected
		}
		transition WTR {
			from Algorithm
			to WasTracked
			condition fs == FireStatus :: Tracked
		}
		transition NoFirePass {
			from WasNoFire
			to Done
			condition fs == FireStatus :: NoFire
		}
		transition DetectedPass {
			from WasDetected
			to Done
			condition fs == FireStatus :: Detected
		}
		transition TrackedPass {
			from WasTracked
			to Done
			condition fs == FireStatus :: Tracked
		}
		transition FGainPass {
			from FGain
			to Done
			condition fs != FireStatus :: Tracked
		}
		transition TGainPass {
			from TGain
			to Done
		}
		transition TLossPass {
			from TLoss
			to Done
			condition fs != FireStatus :: NoFire
		}
		transition FLossPass {
			from FLoss
			to Done
		}
		transition FGainNF {
			from WasNoFire
			to FGain
			condition fs != FireStatus :: NoFire
		}
		transition TGainF {
			from FGain
			to TGain
			condition fs == FireStatus :: Tracked
		}
		transition TGainDT {
			from WasDetected
			to TGain
			condition fs == FireStatus :: Tracked
		}
		transition TLossNF {
			from WasTracked
			to TLoss
			condition fs != FireStatus :: Tracked
		}
		transition FLossT {
			from TLoss
			to FLoss
			condition fs == FireStatus :: NoFire
		}
		transition FLossDT {
			from WasDetected
			to FLoss
			condition fs == FireStatus :: NoFire
		}
		entry clone_normal_FireDetect_CheckFire_entry ( )
	}
	state CheckWall {
		initial i
		state EmptyCycle {
		}
		transition tCheckWall {
			from i
			to EmptyCycle
		}
		entry clone_normal_FireDetect_CheckWall_entry ( )
	}
	transition II {
		from I
		to Idle
		action clone_normal_FireDetect_I_II_op ( )
	}
	transition IT {
		from Idle
		to Idle
		trigger mlxHeatmap ? t
		action clone_normal_FireDetect_Idle_IT_op ( )
	}
	transition ID {
		from Idle
		to Idle
		trigger rsDepthFrame ? d
		action clone_normal_FireDetect_Idle_ID_op ( )
	}
	transition IR {
		from Idle
		to Idle
		trigger rsRgbFrame ? rgb
		action clone_normal_FireDetect_Idle_IR_op ( )
	}
	transition IS {
		from Idle
		to Superimpose
		condition gotH /\ gotD /\ gotR
	}
	transition SW {
		from Superimpose
		to CheckWall
	}
	transition WF {
		from CheckWall
		to CheckFire
	}
	transition FI {
		from CheckFire
		to Idle
		condition checkDone
		action clone_normal_FireDetect_CheckFire_FI_op ( )
	}
}

operation normal_FireDetect_CheckWall_entry ( ) {
	uses I_events_normal_FireDetect_CheckWall_entry requires req_normal_FireDetect_CheckWall_entry requires I_normal_FireDetect_CheckWall_entry_i_t_op requires I_normal_FireDetect_CheckWall_entry_j_2_34_t_2_34_op requires I_normal_FireDetect_CheckWall_entry_j_3_33_t_3_33_op requires I_normal_FireDetect_CheckWall_entry_j_4_22_t_4_22_op final f
	initial i
	junction j_4_22
	junction j_3_33
	junction j_2_34
	transition t {
		from i
		to j_4_22
		action normal_FireDetect_CheckWall_entry_i_t_op ( )
	}
	transition t_4_22 {
		from j_4_22
		to j_3_33
		action normal_FireDetect_CheckWall_entry_j_4_22_t_4_22_op ( )
	}
	transition t_3_33 {
		from j_3_33
		to j_2_34
		action normal_FireDetect_CheckWall_entry_j_3_33_t_3_33_op ( )
	}
	transition t_2_34 {
		from j_2_34
		to f
		action normal_FireDetect_CheckWall_entry_j_2_34_t_2_34_op ( )
	}
}

operation normal_FireDetect_Superimpose_entry ( ) {
	requires req_normal_FireDetect_Superimpose_entry initial i
	final f
	transition t {
		from i
		to f
		action super = superimpose ( rgb , d , t )
	}
}

operation normal_FireDetect_CheckFire_FI_op ( ) {
	requires req_normal_FireDetect_CheckFire_FI_op requires I_normal_FireDetect_CheckFire_FI_op_j_2_30_t_2_30_op requires I_normal_FireDetect_CheckFire_FI_op_i_t_op requires I_normal_FireDetect_CheckFire_FI_op_j_3_14_t_3_14_op final f
	initial i
	junction j_3_14
	junction j_2_30
	transition t {
		from i
		to j_3_14
		action normal_FireDetect_CheckFire_FI_op_i_t_op ( )
	}
	transition t_3_14 {
		from j_3_14
		to j_2_30
		action normal_FireDetect_CheckFire_FI_op_j_3_14_t_3_14_op ( )
	}
	transition t_2_30 {
		from j_2_30
		to f
		action normal_FireDetect_CheckFire_FI_op_j_2_30_t_2_30_op ( )
	}
}

operation normal_FireDetect_Idle_ID_op ( ) {
	requires req_normal_FireDetect_Idle_ID_op initial i
	final f
	transition t {
		from i
		to f
		action gotD = true
	}
}

operation normal_FireDetect_CheckFire_FGain_entry ( ) {
	uses I_events_normal_FireDetect_CheckFire_FGain_entry initial i
	final f
	transition t {
		from i
		to f
		action fireDetected
	}
