stm Flight {
	uses pre_pkg_::M600FlightEvents uses pre_pkg_::M600TelemetryEvents uses GCSControlEvents uses FlightPlanningEvents uses VisualFlightEvents requires pre_pkg_::M600Flight requires GCS requires I_clone_normal_Flight_Connect_CI_op requires I_clone_normal_Flight_Landing_Landed_op requires I_clone_normal_Flight_Climbing_Climbed_op requires I_clone_normal_Flight_Waypoint_entry requires I_clone_normal_Flight_Climbing_entry requires I_clone_normal_Flight_TakingOff_TakenOff_op requires I_clone_normal_Flight_GoingHome_ReturnedHome_op requires I_clone_normal_Flight_Waiting_WaypointNotify_op const CLIMB_LIFT : real
	const DELAY_DISARM : int
	const HOME : Position
	var h : real , cmd : NavCommand , vp : RelativeMotion , wp : Position
	var start : Position , gotStart : boolean = false
	initial I
	state Connect {
		initial i
		state EmptyCycle {
		}
		transition tConnect {
			from i
			to EmptyCycle
		}
	}
	state Waiting {
		initial i
		state EmptyCycle {
		}
		transition tWaiting {
			from i
			to EmptyCycle
		}
	}
	junction ProcessingCommand
	state Waypoint {
		initial i
		state EmptyCycle {
		}
		transition tWaypoint {
			from i
			to EmptyCycle
		}
		entry clone_normal_Flight_Waypoint_entry ( )
	}
	state Relative {
		initial i
		state EmptyCycle {
		}
		transition tRelative {
			from i
			to EmptyCycle
		}
		entry fcMoveRelativeCall ( vp )
	}
	state TakingOff {
		state EmptyCycle {
		}
		initial i
		transition tTakingOff {
			from i
			to EmptyCycle
		}
		entry fcTakeoffCall ( )
	}
	state Climbing {
		state EmptyCycle {
		}
		initial i
		transition tClimbing {
			from i
			to EmptyCycle
		}
		entry clone_normal_Flight_Climbing_entry ( )
	}
	junction GoHome
	state BackToStart {
		state EmptyCycle {
		}
		initial i
		transition tBackToStart {
			from i
			to EmptyCycle
		}
		entry fcWaypointCall ( start )
	}
	state Landing {
		initial i
		state EmptyCycle {
		}
		transition tLanding {
			from i
			to EmptyCycle
		}
		entry fcLandCall ( )
	}
	final Disarmed
	state GoingHome {
		initial i
		state EmptyCycle {
		}
		transition tGoingHome {
			from i
			to EmptyCycle
		}
		entry fcGoHomeCall ( )
	}
	transition II {
		from I
		to Connect
	}
	transition CI {
		from Connect
		to Waiting
		trigger fcControlAuth
		action clone_normal_Flight_Connect_CI_op ( )
	}
	transition GotWaypoint {
		from Waiting
		to Waypoint
		trigger waypoint ? wp
	}
	transition WaypointOff {
		from Waypoint
		to Waiting
	}
	transition WaypointNotify {
		from Waiting
		to Waiting
		trigger fcWaypointFinishedMission
		action clone_normal_Flight_Waiting_WaypointNotify_op ( )
	}
	transition GotRelative {
		from Waiting
		to Relative
		trigger visualPosition ? vp
	}
	transition RelativeOff {
		from Relative
		to Waiting
	}
	transition Command {
		from Waiting
		to ProcessingCommand
		trigger navCommand ? cmd
	}
	transition CoTO {
		from ProcessingCommand
		to TakingOff
		condition cmd == NavCommand :: TakeOff
	}
	transition CoRH {
		from ProcessingCommand
		to GoHome
		condition cmd == NavCommand :: GoHome
	}
	transition CoLD {
		from ProcessingCommand
		to Landing
		condition cmd == NavCommand :: Land
	}
	transition TakenOff {
		from TakingOff
		to Climbing
		trigger fcTakeoffRet
		action clone_normal_Flight_TakingOff_TakenOff_op ( )
	}
	transition Climbed {
		from Climbing
		to Waiting
		trigger fcWaypointFinishedMission
		action clone_normal_Flight_Climbing_Climbed_op ( )
	}
	transition GoHomeW {
		from GoHome
		to BackToStart
		condition gotStart
	}
	transition GoHomeNW {
		from GoHome
		to GoingHome
		condition not gotStart
	}
	transition GoHomeWD {
		from BackToStart
		to GoingHome
		trigger fcWaypointFinishedMission
	}
	transition Landed {
		from Landing
		to Disarmed
		trigger fcLandRet
		action clone_normal_Flight_Landing_Landed_op ( )
	}
	transition ReturnedHome {
		from GoingHome
		to Waiting
		trigger fcWaypointFinishedMission
		action clone_normal_Flight_GoingHome_ReturnedHome_op ( )
	}
}

stm BatteryMonitor {
	uses BatteryPlanningEvents uses pre_pkg_::M600BatteryTelemetryEvents requires I_clone_normal_BatteryMonitor_Monitoring_entry const BATTERY_LOW_THRESHOLD : int , BATTERY_UNSAFE_THRESHOLD : int
	var battery : Battery
	initial I
	state Monitoring {
		initial i
		state EmptyCycle {
		}
		transition tMonitoring {
			from i
			to EmptyCycle
		}
		entry clone_normal_BatteryMonitor_Monitoring_entry ( )
	}
	transition M {
		from I
		to Monitoring
	}
	transition SenseBatteryW {
		from Monitoring
		to Monitoring
		trigger batteryInfo ? battery
	}
}

operation normal_Flight_GoingHome_ReturnedHome_op ( ) {
	uses I_events_normal_Flight_GoingHome_ReturnedHome_op final f
