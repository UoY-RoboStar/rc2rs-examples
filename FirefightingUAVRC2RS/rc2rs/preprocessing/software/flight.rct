		to f
		action uavStatus ! AircraftStatus :: AtHome
	}
}

operation normal_Flight_Landing_Landed_op ( ) {
	uses I_events_normal_Flight_Landing_Landed_op requires req_normal_Flight_Landing_Landed_op requires pre_pkg_uav::I_waitOp requires I_normal_Flight_Landing_Landed_op_j_2_29_t_2_29_op requires I_normal_Flight_Landing_Landed_op_i_t_op final f
	initial i
	junction j_3_24
	junction j_2_29
	transition t {
		from i
		to j_3_24
		action normal_Flight_Landing_Landed_op_i_t_op ( )
	}
	transition t_3_24 {
		from j_3_24
		to j_2_29
		action waitOp ( 1 ) //DELAY_DISARM )
	}
	transition t_2_29 {
		from j_2_29
		to f
		action normal_Flight_Landing_Landed_op_j_2_29_t_2_29_op ( )
	}
}

operation normal_Flight_Waypoint_entry ( ) {
	requires req_normal_Flight_Waypoint_entry requires I_normal_Flight_Waypoint_entry_t_thenJ__t_thenTA__op requires I_normal_Flight_Waypoint_entry_j_2_36_t_2_36_op final f
	initial i
	junction j_2_23
	junction t_initialJunction_
	junction t_thenJ_
	junction t_elseJ_
	junction j_2_36
	transition t_2_23 {
		from j_2_23
		to f
		action fcWaypointCall ( wp )
	}
	transition t_initial_ {
		from i
		to t_initialJunction_
	}
	transition t_elseTA_ {
		from t_elseJ_
		to j_2_23
	}
	transition t_thenTA_ {
		from t_thenJ_
		to j_2_36
		action normal_Flight_Waypoint_entry_t_thenJ__t_thenTA__op ( )
	}
	transition t_thenTG_ {
		from t_initialJunction_
		to t_thenJ_
		condition not gotStart
	}
	transition t_elseTG_ {
		from t_initialJunction_
		to t_elseJ_
		condition not not gotStart
	}
	transition t_2_36 {
		from j_2_36
		to j_2_23
		action normal_Flight_Waypoint_entry_j_2_36_t_2_36_op ( )
	}
}

