operation normal_BatteryMonitor_Monitoring_entry ( ) {
	uses I_events_normal_BatteryMonitor_Monitoring_entry requires req_normal_BatteryMonitor_Monitoring_entry requires I_normal_BatteryMonitor_Monitoring_entry_t_thenJ__t_thenTA__op initial i
	final f
	junction t_initialJunction_
	junction t_thenJ_
	junction t_elseJ_
	transition t_initial_ {
		from i
		to t_initialJunction_
	}
	transition t_elseTA_ {
		from t_elseJ_
		to f
	}
	transition t_thenTA_ {
		from t_thenJ_
		to f
		action normal_BatteryMonitor_Monitoring_entry_t_thenJ__t_thenTA__op ( )
	}
	transition t_elseTG_ {
		from t_initialJunction_
		to t_elseJ_
		condition not battery . percentage < BATTERY_LOW_THRESHOLD
	}
	transition t_thenTG_ {
		from t_initialJunction_
		to t_thenJ_
		condition battery . percentage < BATTERY_LOW_THRESHOLD
	}
}

