stm Planning {
	uses GCSMissionEvents uses SprayPlanningEvents uses FirePlanningEvents uses FlightPlanningEvents uses BatteryPlanningEvents uses GimbalPlanningEvents uses VisualPlanningEvents uses SearchVars uses I_normal_Planning_Connected_Mission_LosingFire_inact_sinceEntry uses I_normal_Planning_Connect_inact_sinceEntry requires GCS requires Search requires I_clone_normal_Planning_Connected_Mission_Search_SETF_op requires I_clone_normal_Planning_Connected_Mission_Spray_entry requires I_clone_normal_Planning_Connected_Mission_exit requires I_clone_normal_Planning_Connected_Mission_Search_entry requires I_clone_normal_Planning_Connected_Land_entry requires I_clone_normal_Planning_Connected_Mission_LosingFire_exit requires I_clone_normal_Planning_Connected_TakeOffAndClimb_entry requires I_clone_normal_Planning_Connected_Mission_SPRT_op requires I_clone_normal_Planning_Connected_Mission_BatMS_op requires I_clone_normal_Planning_Connected_Mission_WatMS_op requires I_clone_normal_Planning_Connected_Mission_TrackFire_entry requires I_clone_normal_Planning_Connect_ConnectTO_op requires I_clone_normal_Planning_Connected_GoHome_entry requires I_clone_normal_Planning_Connect_ConnectOK_op requires I_clone_normal_Planning_Connected_Disarm_entry requires I_clone_normal_Planning_Connected_Mission_Spray_Spraying_exit requires I_clone_normal_Planning_Connected_Mission_FlyToWall_entry requires I_clone_normal_Planning_Connected_Mission_LosingFire_LostFire_op requires I_clone_normal_Planning_Connect_entry requires I_clone_normal_Planning_Connected_Mission_Spray_Spraying_entry requires I_clone_normal_Planning_Connect_exit requires I_clone_normal_Planning_Connected_Mission_entry requires I_clone_normal_Planning_Connected_Mission_LosingFire_entry const WALL_LOC : Position
	const FIRE_TO : nat , INIT_TO : nat
	var astatus : AircraftStatus
	initial I
	state Connect {
		initial I
		state Waiting {
			state EmptyCycle {
			}
			initial i
			transition tWaiting {
				from i
				to EmptyCycle
			}
		}
		transition IW {
			from I
			to Waiting
		}
		transition PollS {
			from Waiting
			to Waiting
			trigger uavStatus ? astatus
		}
		exit clone_normal_Planning_Connect_exit ( )
		entry clone_normal_Planning_Connect_entry ( )
	}
	state Connected {
		initial I
		state TakeOffAndClimb {
			initial I
			state Waiting {
				initial i
				state EmptyCycle {
				}
				transition tWaiting {
					from i
					to EmptyCycle
				}
			}
			transition IW {
				from I
				to Waiting
			}
			transition PollS {
				from Waiting
				to Waiting
				trigger uavStatus ? astatus
			}
			entry clone_normal_Planning_Connected_TakeOffAndClimb_entry ( )
		}
		state Mission {
			initial I
			state FlyToWall {
				initial I
				state Waiting {
					initial i
					state EmptyCycle {
					}
					transition tWaiting {
						from i
						to EmptyCycle
					}
				}
				transition IW {
					from I
					to Waiting
				}
				transition PollS {
					from Waiting
					to Waiting
					trigger uavStatus ? astatus
				}
				entry clone_normal_Planning_Connected_Mission_FlyToWall_entry ( )
			}
			state Search {
				initial i
				state EmptyCycle {
				}
				transition tSearch {
					from i
					to EmptyCycle
				}
				entry clone_normal_Planning_Connected_Mission_Search_entry ( )
			}
			state TrackFire {
				initial i
				state EmptyCycle {
				}
				transition tTrackFire {
					from i
					to EmptyCycle
				}
				entry clone_normal_Planning_Connected_Mission_TrackFire_entry ( )
			}
			state Spray {
				initial I
				state WaitGimbal {
					state EmptyCycle {
					}
					initial i
					transition tWaitGimbal {
						from i
						to EmptyCycle
					}
				}
				state Spraying {
					initial i
					state EmptyCycle {
					}
					transition tSpraying {
						from i
						to EmptyCycle
					}
					entry clone_normal_Planning_Connected_Mission_Spray_Spraying_entry ( )
					exit clone_normal_Planning_Connected_Mission_Spray_Spraying_exit ( )
				}
				transition Init {
					from I
					to WaitGimbal
				}
				transition DoSpray {
					from WaitGimbal
					to Spraying
					trigger gimbalAimed
				}
				entry clone_normal_Planning_Connected_Mission_Spray_entry ( )
			}
			state LosingFire {
				initial i
				state EmptyCycle {
				}
				transition tLosingFire {
					from i
					to EmptyCycle
				}
				exit clone_normal_Planning_Connected_Mission_LosingFire_exit ( )
				entry clone_normal_Planning_Connected_Mission_LosingFire_entry ( )
			}
			transition Init {
				from I
				to FlyToWall
			}
			transition FWSE {
				from FlyToWall
				to Search
				condition astatus == AircraftStatus :: AtWaypoint
			}
			transition SETF {
				from Search
				to TrackFire
				trigger fireDetected
				action clone_normal_Planning_Connected_Mission_Search_SETF_op ( )
			}
			transition TFSE {
				from TrackFire
				to LosingFire
				trigger fireLost
			}
			transition TFSP {
				from TrackFire
				to Spray
				trigger trackingGained
			}
			transition SPTF {
				from Spray
				to TrackFire
				trigger trackingLost
			}
			transition RegainedFire {
				from LosingFire
				to TrackFire
				trigger fireDetected
			}
			transition LostFire {
				from LosingFire
				to Search
				condition FIRE_TO < since ( clk_Planning_Connected_Mission_LosingFire )
				action clone_normal_Planning_Connected_Mission_LosingFire_LostFire_op ( )
			}
			entry clone_normal_Planning_Connected_Mission_entry ( )
			exit clone_normal_Planning_Connected_Mission_exit ( )
		}
		state GoHome {
			initial I
			state Waiting {
				state EmptyCycle {
				}
				initial i
				transition tWaiting {
					from i
					to EmptyCycle
				}
			}
			transition IW {
				from I
				to Waiting
			}
			transition Poll {
				from Waiting
				to Waiting
				trigger uavStatus ? astatus
			}
			entry clone_normal_Planning_Connected_GoHome_entry ( )
		}
		state Land {
			initial I
			state Waiting {
				state EmptyCycle {
				}
				initial i
				transition tWaiting {
					from i
					to EmptyCycle
				}
			}
			transition IW {
				from I
				to Waiting
			}
			transition Poll {
				from Waiting
				to Waiting
				trigger uavStatus ? astatus
			}
			entry clone_normal_Planning_Connected_Land_entry ( )
		}
		state Disarm {
			initial I
			state Waiting {
				initial i
				state EmptyCycle {
				}
				transition tWaiting {
					from i
					to EmptyCycle
				}
			}
			transition IW {
				from I
				to Waiting
			}
			transition Poll {
				from Waiting
				to Waiting
				trigger uavStatus ? astatus
			}
			entry clone_normal_Planning_Connected_Disarm_entry ( )
		}
		transition Start {
			from I
			to TakeOffAndClimb
		}
		transition TOFW {
			from TakeOffAndClimb
			to Mission
			condition astatus == AircraftStatus :: AtAltitude
		}
		transition SPRT {
			from Mission
			to GoHome
			condition searchComplete
			action clone_normal_Planning_Connected_Mission_SPRT_op ( )
		}
		transition Retreated {
			from GoHome
			to Land
			condition astatus == AircraftStatus :: AtHome
		}
		transition Landed {
			from Land
			to Disarm
			condition astatus == AircraftStatus :: Landed
		}
		transition BatMS {
			from Mission
			to GoHome
			trigger batteryLow
			action clone_normal_Planning_Connected_Mission_BatMS_op ( )
		}
		transition WatMS {
			from Mission
			to GoHome
			trigger waterEmpty
			action clone_normal_Planning_Connected_Mission_WatMS_op ( )
		}
	}
	final SwitchedOff
	transition On {
		from I
		to Connect
	}
	transition ConnectOK {
		from Connect
		to Connected
		condition astatus == AircraftStatus :: Connected
		action clone_normal_Planning_Connect_ConnectOK_op ( )
	}
	transition ConnectTO {
		from Connect
		to SwitchedOff
		condition INIT_TO < since ( clk_Planning_Connect )
		action clone_normal_Planning_Connect_ConnectTO_op ( )
	}
	transition SwitchOff {
		from Connected
		to SwitchedOff
		condition astatus == AircraftStatus :: Disarmed
	}
}

