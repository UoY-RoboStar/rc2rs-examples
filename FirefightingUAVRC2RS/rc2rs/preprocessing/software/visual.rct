operation normal_GimbalAim_Calculate_entry ( ) {
	requires req_normal_GimbalAim_Calculate_entry requires I_normal_GimbalAim_Calculate_entry_i_t_op requires I_normal_GimbalAim_Calculate_entry_j_2_6_t_2_6_op initial i
	final f
	junction j_2_6
	transition t {
