stm VisualNav {
	uses FireVisualEvents uses VisualFlightEvents uses VisualPlanningEvents requires I_clone_normal_VisualNav_Active_NoFire_entry requires I_clone_normal_VisualNav_Active_Wall_entry requires I_clone_normal_VisualNav_Active_Commit_Loop_op requires I_clone_normal_VisualNav_Active_Fire_entry var tgt : FireTarget , wm : WallMetrics , movement : RelativeMotion
	const TRACK_DIST : real , SCAN_DIST : real
	initial I
	state Inactive {
		initial i
		state EmptyCycle {
		}
		transition tInactive {
			from i
			to EmptyCycle
		}
	}
	state Active {
		initial I
		state Waiting {
			state EmptyCycle {
			}
			initial i
			transition tWaiting {
				from i
				to EmptyCycle
			}
		}
		state Wall {
			state EmptyCycle {
			}
			initial i
			transition tWall {
				from i
				to EmptyCycle
			}
			entry clone_normal_VisualNav_Active_Wall_entry ( )
		}
		junction FIsValid
		state Fire {
			state EmptyCycle {
			}
			initial i
			transition tFire {
				from i
				to EmptyCycle
			}
			entry clone_normal_VisualNav_Active_Fire_entry ( )
		}
		state NoFire {
			state EmptyCycle {
			}
			initial i
			transition tNoFire {
				from i
				to EmptyCycle
			}
			entry clone_normal_VisualNav_Active_NoFire_entry ( )
		}
		junction Commit
		transition Init {
			from I
			to Waiting
		}
		transition WW {
			from Waiting
			to Wall
			trigger wallMetrics ? wm
		}
		transition WF {
			from Wall
			to FIsValid
			trigger fvSeenFire ? tgt
		}
		transition FValid {
			from FIsValid
			to Fire
			condition tgt . status == FireStatus :: Tracked
		}
		transition FNotValid {
			from FIsValid
			to NoFire
			condition tgt . status != FireStatus :: Tracked
		}
		transition FCommit {
			from Fire
			to Commit
		}
		transition NCommit {
			from NoFire
			to Commit
		}
		transition Loop {
			from Commit
			to Waiting
			action clone_normal_VisualNav_Active_Commit_Loop_op ( )
		}
	}
	transition Init {
		from I
		to Inactive
	}
	transition Activate {
		from Inactive
		to Active
		trigger vnavEnable
	}
	transition Deactivate {
		from Active
		to Inactive
		trigger vnavDisable
	}
	transition IgnoreDeactivate {
		from Inactive
		to Inactive
		trigger vnavDisable
	}
	transition IgnoreW {
		from Inactive
		to Inactive
		trigger wallMetrics ? wm
	}
	transition IgnoreF {
		from Inactive
		to Inactive
		trigger fvSeenFire ? tgt
	}
}

stm GimbalAim {
	uses FireGimbalEvents uses GimbalSprayEvents uses GimbalPlanningEvents requires I_clone_normal_GimbalAim_MaybeAimed_DidAim_op requires I_clone_normal_GimbalAim_I_Init_op requires I_clone_normal_GimbalAim_Calculate_entry requires I_clone_normal_GimbalAim_Clamp_entry requires I_clone_normal_GimbalAim_Pitch_entry requires I_clone_normal_GimbalAim_Yaw_entry var tgt : FireTarget , yaw : nat , pitch : nat , tracking : boolean = false
	var cYaw : nat , cPitch : nat , YAW_DEAD_ZONE : nat , PITCH_DEAD_ZONE : nat
	const TRACK_DIST : real
	initial I
	state Waiting {
		initial i
		state EmptyCycle {
		}
		transition tWaiting {
			from i
			to EmptyCycle
		}
	}
	state Calculate {
		state EmptyCycle {
		}
		initial i
		transition tCalculate {
			from i
			to EmptyCycle
		}
		entry clone_normal_GimbalAim_Calculate_entry ( )
	}
	state Yaw {
		initial i
		state EmptyCycle {
		}
		transition tYaw {
			from i
			to EmptyCycle
		}
		entry clone_normal_GimbalAim_Yaw_entry ( )
	}
	state Pitch {
		initial i
		state EmptyCycle {
		}
		transition tPitch {
			from i
			to EmptyCycle
		}
		entry clone_normal_GimbalAim_Pitch_entry ( )
	}
	junction IsValid
	state Clamp {
		state EmptyCycle {
		}
		initial i
		transition tClamp {
			from i
			to EmptyCycle
		}
		entry clone_normal_GimbalAim_Clamp_entry ( )
	}
	junction MaybeAimed
	transition Init {
		from I
		to Waiting
		action clone_normal_GimbalAim_I_Init_op ( )
	}
	transition GotFire {
		from Waiting
		to IsValid
		trigger fgSeenFire ? tgt
	}
	transition CalcYaw {
		from Calculate
		to Clamp
	}
	transition YP {
		from Yaw
		to Pitch
		trigger gimbalYawAck
	}
	transition PW {
		from Pitch
		to MaybeAimed
		trigger gimbalPitchAck
	}
	transition Valid {
		from IsValid
		to Calculate
		condition tgt . status == FireStatus :: Tracked
	}
	transition NotValid {
		from IsValid
		to Waiting
		condition tgt . status != FireStatus :: Tracked
	}
	transition Clamped {
		from Clamp
		to Yaw
	}
	transition DidAim {
		from MaybeAimed
		to Waiting
		condition cYaw == yaw /\ cPitch == pitch
		action clone_normal_GimbalAim_MaybeAimed_DidAim_op ( )
	}
	transition DidNotAim {
		from MaybeAimed
		to Waiting
		condition cYaw != yaw \/ cPitch != pitch
	}
}

operation normal_GimbalAim_I_Init_op ( ) {
	requires req_normal_GimbalAim_I_Init_op initial i
	final f
	transition t {
		from i
		to f
		action tgt . status = FireStatus :: NoFire
	}
}

operation normal_GimbalAim_Yaw_entry ( ) {
	uses I_events_normal_GimbalAim_Yaw_entry requires req_normal_GimbalAim_Yaw_entry final f
	initial i
	transition t {
		from i
		to f
		action gimbalYaw ! yaw
	}
}

operation normal_VisualNav_Active_NoFire_entry ( ) {
	requires req_normal_VisualNav_Active_NoFire_entry requires I_normal_VisualNav_Active_NoFire_entry_j_3_21_t_3_21_op requires I_normal_VisualNav_Active_NoFire_entry_i_t_op requires I_normal_VisualNav_Active_NoFire_entry_j_2_28_t_2_28_op final f
	initial i
	junction j_3_21
	junction j_2_28
	transition t {
		from i
		to j_3_21
		action normal_VisualNav_Active_NoFire_entry_i_t_op ( )
	}
	transition t_3_21 {
		from j_3_21
		to j_2_28
		action normal_VisualNav_Active_NoFire_entry_j_3_21_t_3_21_op ( )
	}
	transition t_2_28 {
		from j_2_28
		to f
		action normal_VisualNav_Active_NoFire_entry_j_2_28_t_2_28_op ( )
	}
}

operation normal_GimbalAim_Pitch_entry ( ) {
	uses I_events_normal_GimbalAim_Pitch_entry requires req_normal_GimbalAim_Pitch_entry final f
