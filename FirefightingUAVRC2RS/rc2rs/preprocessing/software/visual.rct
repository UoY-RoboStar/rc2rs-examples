	}
}

operation normal_VisualNav_Active_Wall_entry ( ) {
	requires req_normal_VisualNav_Active_Wall_entry initial i
	final f
	transition t {
		from i
		to f
		action movement . dyaw = calcYawDelta ( wm )
	}
}

operation normal_GimbalAim_Clamp_entry ( ) {
	requires req_normal_GimbalAim_Clamp_entry requires I_normal_GimbalAim_Clamp_entry_j_2_16_t_2_16_op requires I_normal_GimbalAim_Clamp_entry_i_t_op final f
