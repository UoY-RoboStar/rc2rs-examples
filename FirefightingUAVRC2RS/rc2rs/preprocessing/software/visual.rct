operation normal_GimbalAim_Calculate_entry_i_t_op ( ) {
	requires I_req_normal_GimbalAim_Calculate_entry_i_t final f
	initial i
	transition t {
		from i
		to f
		action yaw = calcGimbalAxis ( tgt . distance , tgt . dx )
	}
}

