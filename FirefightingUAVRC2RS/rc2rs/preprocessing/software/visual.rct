operation normal_VisualNav_Active_Fire_entry ( ) {
	requires req_normal_VisualNav_Active_Fire_entry requires I_normal_VisualNav_Active_Fire_entry_j_3_7_t_3_7_op requires I_normal_VisualNav_Active_Fire_entry_j_2_26_t_2_26_op requires I_normal_VisualNav_Active_Fire_entry_i_t_op initial i
	final f
	junction j_3_7
	junction j_2_26
	transition t {
		from i
		to j_3_7
		action normal_VisualNav_Active_Fire_entry_i_t_op ( )
	}
	transition t_3_7 {
		from j_3_7
		to j_2_26
