			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: j3
			module j3
			exports
			
				channel enter, interrupt
				
				D__(id__,
							param_d,
						    const_step_c) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
							param_d,
						    const_step_c) = D__(id__,
							param_d,
						    const_step_c)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Waiting
			module Waiting
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
							param_d,
						    const_step_c) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
							param_d,
						    const_step_c) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: j4
			module j4
			exports
			
				channel enter, interrupt
				
				D__(id__,
							param_d,
						    const_step_c) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
							param_d,
						    const_step_c) = D__(id__,
							param_d,
						    const_step_c)
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			CALL__movez(id__,
					    const_step_c,
						param_r) 	= movezCall.param_r -> SKIP
			CALL__movex(id__,
					    const_step_c,
						param_r) 	= movexCall.param_r -> SKIP
			CALL__leanforward(id__,
					    const_step_c) 	= leanforwardCall -> SKIP
			CALL__movey(id__,
					    const_step_c,
						param_r) 	= moveyCall.param_r -> SKIP
			
			-- END of Operation calls --
			
			-- STM processes
			STM(id__,
						param_d,
					    const_step_c) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__,
						param_d,
					    const_step_c) \ {terminate}
			
			STM_VS_O(id__,
						param_d,
					    const_step_c) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__,
						param_d,
					    const_step_c) \ {terminate}
			
			-- Transitions
			Transitions(id__,
						param_d,
					    const_step_c) = ((let
				Trans = (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((pre_sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real))&sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)) != 0&CALL__movex(
					 			id__,
					 		    const_step_c,
					 			Div(Mult(const_step_c, Vector_x(param_d), core_real), sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)), core_real)
					 		) ; j1::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j1 -> SKIP ;  ((pre_sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real))&sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)) != 0&CALL__movey(
					 			id__,
					 		    const_step_c,
					 			Div((Mult(const_step_c, Vector_y(param_d), core_real)), sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)), core_real)
					 		) ; j2::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j2 -> SKIP ;  ((true&CALL__movez(
					 			id__,
					 		    const_step_c,
					 			const_step_c
					 		) ; j3::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j3 -> SKIP ;  ((true&(share__choice(leanOut.out -> SKIP)) ; Waiting::enter -> SKIP))))
					 	 [] dbisim((true)&(stepDownIn__!NID_Waiting.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(stepDone.out -> SKIP)) ; j4::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_j4 -> SKIP ;  ((true&CALL__movez(
					 			id__,
					 		    const_step_c,
					 			Neg(const_step_c, core_real)
					 		) ; F1::enter -> SKIP))))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__,
						param_d,
					    const_step_c) = 
				dbisim((
				let
					finalNodesEntered = {|F1::entered|}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						I1::enter,
						F1::enter,
						j1::enter,
						j2::enter,
						j3::enter,
						Waiting::enter,
						j4::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_I1,internal__.NID_j1,internal__.NID_j2,internal__.NID_j3,stepDownIn__.NID_Waiting.in,internal__.NID_j4|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   I1::D__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   F1::D__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j1::D__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j2::D__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j3::D__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Waiting::D__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j4::D__(id__,
							   			param_d,
							   		    const_step_c)
							   )
							   )
							   )
							   )
							   )
							   )
							 )
							 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,stepDownIn__.NID_Waiting.in|}]]
							 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
							 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
							 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
							 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3|}]]
							 [[j4::interrupt <- x__ | x__ <- {|internal__.NID_j4|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((I1::enter -> Transitions(id__,
							 			param_d,
							 		    const_step_c))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							leanOut__.x____ <- leanOut,
							stepDownIn__.x____ <- stepDownIn,
							stepDone__.x____ <- stepDone
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__,
						param_d,
					    const_step_c) = 
				dbisim((MachineBody(id__,
							param_d,
						    const_step_c)\ enteredSS)
				)
			
			
			Stateful(id__,
						param_d,
					    const_step_c) = 
				((
					(Behaviour(id__,
								param_d,
							    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
								param_d,
							    const_step_c))
				 	\getsetLocalChannels
				)
				)
			
			
			-- Visible counterparts
			MachineBody_VS_O(id__,
						param_d,
					    const_step_c) = 
				dbisim((
				let
					finalNodesEntered = {|F1::entered|}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						I1::enter,
						F1::enter,
						j1::enter,
						j2::enter,
						j3::enter,
						Waiting::enter,
						j4::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_I1,internal__.NID_j1,internal__.NID_j2,internal__.NID_j3,stepDownIn__.NID_Waiting.in,internal__.NID_j4|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   I1::VS_O__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   F1::VS_O__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j1::VS_O__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j2::VS_O__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j3::VS_O__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Waiting::VS_O__(id__,
							   			param_d,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   j4::VS_O__(id__,
							   			param_d,
							   		    const_step_c)
							   )
							   )
							   )
							   )
							   )
							   )
							 )
							 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,stepDownIn__.NID_Waiting.in|}]]
							 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
							 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
							 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
							 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3|}]]
							 [[j4::interrupt <- x__ | x__ <- {|internal__.NID_j4|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((I1::enter -> Transitions(id__,
							 			param_d,
							 		    const_step_c))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							leanOut__.x____ <- leanOut,
							stepDownIn__.x____ <- stepDownIn,
							stepDone__.x____ <- stepDone
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__,
						param_d,
					    const_step_c) = 
				dbisim((MachineBody_VS_O(id__,
							param_d,
						    const_step_c))
				)
			
			
			Stateful_VS_O(id__,
						param_d,
					    const_step_c) = 
				dbisim((
					(Behaviour_VS_O(id__,
								param_d,
							    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
								param_d,
							    const_step_c))
				 	\getsetLocalChannels
				)
				)
			
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__,
						param_d,
					    const_step_c) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
						param_d,
					    const_step_c) = STM_VS_O(id__,
						param_d,
					    const_step_c)
			
			D__(id__,
						param_d,
					    const_step_c) = STM(id__,
						param_d,
					    const_step_c) \ internal_events
			O__(id__,
						param_d,
					    const_step_c) = sbisim(diamond(D__(id__,
						param_d,
					    const_step_c)))
			VS__(id__,
						param_d,
					    const_step_c) = FVS__(id__,
						param_d,
					    const_step_c)
			VS_O__(id__,
						param_d,
					    const_step_c) = sbisim(diamond(FVS__(id__,
						param_d,
					    const_step_c)))
			HEXT__(id__,
						param_d,
					    const_step_c) = O__(id__,
						param_d,
					    const_step_c) [|shared_variable_events|] SKIP
			HUP__(id__,
						param_d,
					    const_step_c) = O__(id__,
						param_d,
					    const_step_c) [|{share__}|] SKIP
					endmodule
	
		-- declaring machines
		module stm_ref0
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_I1|
			              NID_Balanced|
			              NID_Moving|
			              NID_Leaning
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			channel get_v, set_v, setL_v, setR_v: Vector
			channel get_direction, set_direction, setL_direction, setR_direction: Vector
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel leanOut__: NIDS.InOut
			channel leanOut: InOut
			channel stepDone__: NIDS.InOut
			channel stepDone: InOut
			channel stepDownOut__: NIDS.InOut
			channel stepDownOut: InOut
			channel outOfBalance__: NIDS.InOut.Vector
			channel outOfBalance: InOut.Vector
			channel liftFoot__: NIDS.InOut
			channel liftFoot: InOut
			channel leanIn__: NIDS.InOut
			channel leanIn: InOut
			channel stepDownIn__: NIDS.InOut
			channel stepDownIn: InOut
			
			-- Declaring call and ret events for undefined operations
			channel movezCall: core_real
			channel movexCall: core_real
			channel leanforwardCall
			channel moveyCall: core_real
			
			enterSS = {|
			I1::enter,
			Balanced::enter,
			Moving::enter,
			Leaning::enter
			|}
			
			enteredSS = 	{|
			Balanced::entered,
			Moving::entered,
			Leaning::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	leanOut,
				stepDone,
				stepDownOut,
				outOfBalance,
				liftFoot,
				leanIn,
				stepDownIn
			,	movezCall,
				movexCall,
				leanforwardCall,
				moveyCall
				|}
		
			-- Nodes --
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: I1
			module I1
			exports
			
				channel enter, interrupt
				
				D__(id__,
						    const_step_c) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,
						    const_step_c) = D__(id__,
						    const_step_c)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Balanced
			module Balanced
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_step_c) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_step_c) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Moving
			module Moving
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_step_c) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_direction?direction -> true&CALL__step(
								id__,
								direction, 
								const_step_c
							)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_step_c) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(get_direction?direction -> true&CALL__step(
								id__,
								direction, 
								const_step_c
							)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Leaning
			module Leaning
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,
						    const_step_c) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&CALL__leanforward(
								id__,
								const_step_c
							) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
						    const_step_c) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&CALL__leanforward(
								id__,
								const_step_c
							) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			CALL__movez(id__,
						param_r,
					    const_step_c) 	= movezCall.param_r -> SKIP
			CALL__movex(id__,
						param_r,
					    const_step_c) 	= movexCall.param_r -> SKIP
			CALL__leanforward(id__,
					    const_step_c) 	= leanforwardCall -> SKIP
			CALL__movey(id__,
						param_r,
					    const_step_c) 	= moveyCall.param_r -> SKIP
			
			CALL__step(id__,
						param_d,
					    const_step_c) = (OP_step::O__(id__,
						param_d,
					    const_step_c))
			[[
				OP_step::leanOut <- leanOut,
				OP_step::stepDownIn <- stepDownIn,
				OP_step::stepDone <- stepDone
			]]
			[[
				OP_step::movezCall <- movezCall,
				OP_step::movexCall <- movexCall,
				OP_step::leanforwardCall <- leanforwardCall,
				OP_step::moveyCall <- moveyCall
			]]
			CALL__correct(id__,
						param_v,
					    const_step_c) = (OP_correct::O__(id__,
						param_v))
			[[
				OP_correct::movezCall <- movezCall,
				OP_correct::movexCall <- movexCall,
				OP_correct::leanforwardCall <- leanforwardCall,
				OP_correct::moveyCall <- moveyCall
			]]
			-- END of Operation calls --
			
			-- STM processes
			STM(id__,
					    const_step_c) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful(id__,
								    const_step_c) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__,
						    const_step_c))
			)\sharedVarHide
			
			STM_VS_O(id__,
					    const_step_c) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful_VS_O(id__,
								    const_step_c) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__,
						    const_step_c))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__,
					    const_step_c) = ((let
				Trans = (
					((share__ -> SKIP
					 [] dbisim((true)&(outOfBalance__!NID_Balanced.in?v:{v|v <- Vector, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&CALL__correct(
					 			id__,
					 			v,
					 			const_step_c
					 		)) ; Balanced::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((SKIP ; Balanced::enter -> SKIP))))
					 	 [] dbisim((true)&(liftFoot__!NID_Balanced.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Moving::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_Moving -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Balanced::enter -> SKIP)))
					 	 [] dbisim((true)&(leanIn__!NID_Balanced.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Leaning::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_Leaning -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(stepDownOut.out -> SKIP)) ; Balanced::enter -> SKIP)))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__,
					    const_step_c) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						I1::enter,
						Balanced::enter,
						Moving::enter,
						Leaning::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|outOfBalance__.NID_Balanced.in,internal__.NID_I1,liftFoot__.NID_Balanced.in,internal__.NID_Moving,leanIn__.NID_Balanced.in,internal__.NID_Leaning|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   I1::D__(id__,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Balanced::D__(id__,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Moving::D__(id__,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Leaning::D__(id__,
							   		    const_step_c)
							   )
							   )
							   )
							 )
							 [[Balanced::interrupt <- x__ | x__ <- {|interrupt,outOfBalance__.NID_Balanced.in,liftFoot__.NID_Balanced.in,leanIn__.NID_Balanced.in|}]]
							 [[Moving::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Moving|}]]
							 [[Leaning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Leaning|}]]
							 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 			,setR_v
							 			|}) |]
							 ((I1::enter -> Transitions(id__,
							 		    const_step_c))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							  [[set_v <- setR_v]]
							 )
							)
							 [[setR_v <- set_v]]
							)
						)
						 \ hideSet)
						[[
							leanOut__.x____ <- leanOut,
							stepDone__.x____ <- stepDone,
							stepDownOut__.x____ <- stepDownOut,
							outOfBalance__.x____ <- outOfBalance,
							liftFoot__.x____ <- liftFoot,
							leanIn__.x____ <- leanIn,
							stepDownIn__.x____ <- stepDownIn
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__,
					    const_step_c) = 
				dbisim((MachineBody(id__,
						    const_step_c)\ enteredSS)
				)
			
			IteratedBehaviour(id__,
					    const_step_c) = 
				dbisim((MachineBody(id__,
						    const_step_c)\ enteredSS)
				)
			
			Stateful(id__,
					    const_step_c) = 
				((
					(Behaviour(id__,
							    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
							    const_step_c))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful(id__,
					    const_step_c) =
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								Behaviour(id__,
										    const_step_c)
								[| {|get_direction,set_direction,terminate|} |]
								Memory_direction((0,0,0))
							)\{|get_direction,set_direction|}
						)
						[| {|get_v,set_v,terminate|} |]
						Memory_v((0,0,0))
					)\{|get_v,set_v|}
				)
				)
			
			-- Visible counterparts
			MachineBody_VS_O(id__,
					    const_step_c) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						I1::enter,
						Balanced::enter,
						Moving::enter,
						Leaning::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|outOfBalance__.NID_Balanced.in,internal__.NID_I1,liftFoot__.NID_Balanced.in,internal__.NID_Moving,leanIn__.NID_Balanced.in,internal__.NID_Leaning|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   I1::VS_O__(id__,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Balanced::VS_O__(id__,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Moving::VS_O__(id__,
							   		    const_step_c)
							   [| { share__, terminate } |] (
							   Leaning::VS_O__(id__,
							   		    const_step_c)
							   )
							   )
							   )
							 )
							 [[Balanced::interrupt <- x__ | x__ <- {|interrupt,outOfBalance__.NID_Balanced.in,liftFoot__.NID_Balanced.in,leanIn__.NID_Balanced.in|}]]
							 [[Moving::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Moving|}]]
							 [[Leaning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Leaning|}]]
							 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							 			,setR_v
							 			|}) |]
							 ((I1::enter -> Transitions(id__,
							 		    const_step_c))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							  [[set_v <- setR_v]]
							 )
							)
							 [[setR_v <- set_v]]
							)
						)
						 \ hideSet)
						[[
							leanOut__.x____ <- leanOut,
							stepDone__.x____ <- stepDone,
							stepDownOut__.x____ <- stepDownOut,
							outOfBalance__.x____ <- outOfBalance,
							liftFoot__.x____ <- liftFoot,
							leanIn__.x____ <- leanIn,
							stepDownIn__.x____ <- stepDownIn
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__,
					    const_step_c) = 
				dbisim((MachineBody_VS_O(id__,
						    const_step_c))
				)
			
			IteratedBehaviour_VS_O(id__,
					    const_step_c) = 
				dbisim((MachineBody_VS_O(id__,
						    const_step_c))
				)
			
			Stateful_VS_O(id__,
					    const_step_c) = 
				dbisim((
					(Behaviour_VS_O(id__,
							    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
							    const_step_c))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__,
					    const_step_c) =
				(dbisim(
					sbisim(
						dbisim(
							sbisim(
								Behaviour_VS_O(id__,
										    const_step_c)
								[| {|get_direction,set_direction,terminate|} |]
								Memory_direction((0,0,0))
							)\{|get_direction,set_direction|}
						)
						[| {|get_v,set_v,terminate|} |]
						Memory_v((0,0,0))
					)\{|get_v,set_v|}
				)
				)
			
			-- END
			
			-- Memory
			-- Memory variables
			Memory_v(v) =
				get_v!v -> Memory_v(v)
				[]
				set_v?x__ -> Memory_v(x__)
				[]
				terminate -> SKIP
			Memory_direction(direction) =
				get_direction!direction -> Memory_direction(direction)
				[]
				set_direction?x__ -> Memory_direction(x__)
				[]
				terminate -> SKIP
			
			-- varMemory process
			varMemory(id__,
					    const_step_c) = Memory_v((0,0,0))
			[| { terminate } |] (
			Memory_direction((0,0,0))
			)
			
			getsetLocalChannels = {|get_v,set_v,get_direction,set_direction|}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
					    const_step_c) = STM_VS_O(id__,
					    const_step_c)
			
			D__(id__,
					    const_step_c) = STM(id__,
					    const_step_c) \ internal_events
			O__(id__,
					    const_step_c) = sbisim(diamond(D__(id__,
					    const_step_c)))
			VS__(id__,
					    const_step_c) = FVS__(id__,
					    const_step_c)
			VS_O__(id__,
					    const_step_c) = sbisim(diamond(FVS__(id__,
					    const_step_c)))
			HEXT__(id__,
					    const_step_c) = O__(id__,
					    const_step_c) [|shared_variable_events|] SKIP
			HUP__(id__,
					    const_step_c) = O__(id__,
					    const_step_c) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__,
					    const_step_c) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		
			-- undefined operations
			CALL__movez(id__,
					    param_r) 	= movezCall.param_r -> SKIP
			CALL__movex(id__,
					    param_r) 	= movexCall.param_r -> SKIP
			CALL__leanforward(id__) 	= leanforwardCall -> SKIP
			CALL__movey(id__,
					    param_r) 	= moveyCall.param_r -> SKIP
			
			-- declaring controller memory
			Memory(id__) = SKIP
			
			D__(id__,
					   	const_Foot_op_ref1_c) = 	((
					let
						const_step_c = const_Foot_op_ref1_c
					within 
					stm_ref0::D__(id__,
							    const_step_c)[[
						stm_ref0::terminate <- terminate,
						stm_ref0::leanIn <- leanIn,
						stm_ref0::liftFoot <- liftFoot,
						stm_ref0::stepDownIn <- stepDownIn,
						stm_ref0::stepDownOut <- stepDownOut,
						stm_ref0::outOfBalance <- outOfBalance,
						stm_ref0::stepDone <- stepDone,
						stm_ref0::leanOut <- leanOut,
						stm_ref0::movezCall <- movezCall,
						stm_ref0::movexCall <- movexCall,
						stm_ref0::leanforwardCall <- leanforwardCall,
						stm_ref0::moveyCall <- moveyCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			
			-- VS version
			VS__(id__,
					   	const_Foot_op_ref1_c) = 	((
					let
						const_step_c = const_Foot_op_ref1_c
					within 
					stm_ref0::VS__(id__,
							    const_step_c)[[
						stm_ref0::terminate <- terminate,
						stm_ref0::leanIn <- leanIn,
						stm_ref0::liftFoot <- liftFoot,
						stm_ref0::stepDownIn <- stepDownIn,
						stm_ref0::stepDownOut <- stepDownOut,
						stm_ref0::outOfBalance <- outOfBalance,
						stm_ref0::stepDone <- stepDone,
						stm_ref0::leanOut <- leanOut,
						stm_ref0::movezCall <- movezCall,
						stm_ref0::movexCall <- movexCall,
						stm_ref0::leanforwardCall <- leanforwardCall,
						stm_ref0::moveyCall <- moveyCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
		
			-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
			O__(id__,
					   	const_Foot_op_ref1_c) = sbisim(diamond(	((
					let
						const_step_c = const_Foot_op_ref1_c
					within 
					stm_ref0::O__(id__,
							    const_step_c)[[
						stm_ref0::terminate <- terminate,
						stm_ref0::leanIn <- leanIn,
						stm_ref0::liftFoot <- liftFoot,
						stm_ref0::stepDownIn <- stepDownIn,
						stm_ref0::stepDownOut <- stepDownOut,
						stm_ref0::outOfBalance <- outOfBalance,
						stm_ref0::stepDone <- stepDone,
						stm_ref0::leanOut <- leanOut,
						stm_ref0::movezCall <- movezCall,
						stm_ref0::movexCall <- movexCall,
						stm_ref0::leanforwardCall <- leanforwardCall,
						stm_ref0::moveyCall <- moveyCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
							
			-- VS_O version
			VS_O__(id__,
					   	const_Foot_op_ref1_c) = sbisim(diamond(	((
					let
						const_step_c = const_Foot_op_ref1_c
					within 
					stm_ref0::VS_O__(id__,
							    const_step_c)[[
						stm_ref0::terminate <- terminate,
						stm_ref0::leanIn <- leanIn,
						stm_ref0::liftFoot <- liftFoot,
						stm_ref0::stepDownIn <- stepDownIn,
						stm_ref0::stepDownOut <- stepDownOut,
						stm_ref0::outOfBalance <- outOfBalance,
						stm_ref0::stepDone <- stepDone,
						stm_ref0::leanOut <- leanOut,
						stm_ref0::movezCall <- movezCall,
						stm_ref0::movexCall <- movexCall,
						stm_ref0::leanforwardCall <- leanforwardCall,
						stm_ref0::moveyCall <- moveyCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__,
					   	const_Foot_op_ref1_c) = O__(id__,
					   	const_Foot_op_ref1_c) [|shared_variable_events|] SKIP			

	endmodule
	module Head
		shared_variable_events = {|
		|}
		
	exports
		transparent diamond
		transparent sbisim
		transparent dbisim
		transparent chase

		-- declaring controller events
		channel startSiren: InOut
		channel wallDetected: InOut
		channel stopSiren: InOut
		channel liftFootLeft: InOut
		channel liftFootRight: InOut
		channel stepDoneLeft: InOut
		channel stepDoneRight: InOut
		
		
		
		-- declaring call and ret events for undefined operations
		channel turnCall
		channel WalkCall
		
		-- declaring controller termination channel
		channel terminate
		
		-- channel set with all visible events
		sem__events = {|
			terminate
		,	startSiren,
			wallDetected,
			stopSiren,
			liftFootLeft,
			liftFootRight,
			stepDoneLeft,
			stepDoneRight
		,	turnCall,
			WalkCall
		|}

		-- defined operations
		-- compileOperationDef
		module OP_Walk
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
			
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_i0|
			              NID_LeftFoot|
			              NID_RightFoot
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel liftFootLeft__: NIDS.InOut
			channel liftFootLeft: InOut
			channel liftFootRight__: NIDS.InOut
			channel liftFootRight: InOut
			channel stepDoneLeft__: NIDS.InOut
			channel stepDoneLeft: InOut
			channel stepDoneRight__: NIDS.InOut
			channel stepDoneRight: InOut
			
			-- Declaring call and ret events for undefined operations
			
			enterSS = {|
			i0::enter,
			LeftFoot::enter,
			RightFoot::enter
			|}
			
			enteredSS = 	{|
			LeftFoot::entered,
			RightFoot::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	liftFootLeft,
				liftFootRight,
				stepDoneLeft,
				stepDoneRight
				, share__
				|}
			
			-- Nodes --
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: i0
			module i0
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: LeftFoot
			module LeftFoot
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(liftFootLeft.out -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(liftFootLeft.out -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: RightFoot
			module RightFoot
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(liftFootRight.out -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&(share__choice(liftFootRight.out -> SKIP)) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			
			-- END of Operation calls --
			
			-- STM processes
			STM(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__) \ {terminate}
			
			STM_VS_O(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__) \ {terminate}
			
			-- Transitions
			Transitions(id__) = ((let
				Trans = (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; LeftFoot::enter -> SKIP))))
					 	 [] dbisim((true)&(stepDoneLeft__!NID_LeftFoot.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; RightFoot::enter -> SKIP)))
					 	 [] dbisim((true)&(stepDoneRight__!NID_RightFoot.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; LeftFoot::enter -> SKIP)))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						LeftFoot::enter,
						RightFoot::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,stepDoneLeft__.NID_LeftFoot.in,stepDoneRight__.NID_RightFoot.in|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::D__(id__)
							   [| { share__, terminate } |] (
							   LeftFoot::D__(id__)
							   [| { share__, terminate } |] (
							   RightFoot::D__(id__)
							   )
							   )
							 )
							 [[LeftFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneLeft__.NID_LeftFoot.in|}]]
							 [[RightFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneRight__.NID_RightFoot.in|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							liftFootLeft__.x____ <- liftFootLeft,
							liftFootRight__.x____ <- liftFootRight,
							stepDoneLeft__.x____ <- stepDoneLeft,
							stepDoneRight__.x____ <- stepDoneRight
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			
			Stateful(id__) = 
				((
					(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			
			-- Visible counterparts
			MachineBody_VS_O(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						LeftFoot::enter,
						RightFoot::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,stepDoneLeft__.NID_LeftFoot.in,stepDoneRight__.NID_RightFoot.in|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::VS_O__(id__)
							   [| { share__, terminate } |] (
							   LeftFoot::VS_O__(id__)
							   [| { share__, terminate } |] (
							   RightFoot::VS_O__(id__)
							   )
							   )
							 )
							 [[LeftFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneLeft__.NID_LeftFoot.in|}]]
							 [[RightFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneRight__.NID_RightFoot.in|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							liftFootLeft__.x____ <- liftFootLeft,
							liftFootRight__.x____ <- liftFootRight,
							stepDoneLeft__.x____ <- stepDoneLeft,
							stepDoneRight__.x____ <- stepDoneRight
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__) = 
				dbisim((MachineBody_VS_O(id__))
				)
			
			
			Stateful_VS_O(id__) = 
				dbisim((
					(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__) = STM_VS_O(id__)
			
			D__(id__) = STM(id__) \ internal_events
			O__(id__) = sbisim(diamond(D__(id__)))
			VS__(id__) = FVS__(id__)
			VS_O__(id__) = sbisim(diamond(FVS__(id__)))
			HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
			HUP__(id__) = O__(id__) [|{share__}|] SKIP
					endmodule
	
		-- declaring machines
		module HeadS
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_i0|
			              NID_j0|
			              NID_j1|
			              NID_j2|
			              NID_j3|
			              NID_Walking|
			              NID_Stopped|
			              NID_Turning
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel startSiren__: NIDS.InOut
			channel startSiren: InOut
			channel wallDetected__: NIDS.InOut
			channel wallDetected: InOut
			channel stopSiren__: NIDS.InOut
			channel stopSiren: InOut
			channel liftFootLeft__: NIDS.InOut
			channel liftFootLeft: InOut
			channel liftFootRight__: NIDS.InOut
			channel liftFootRight: InOut
			channel stepDoneLeft__: NIDS.InOut
			channel stepDoneLeft: InOut
			channel stepDoneRight__: NIDS.InOut
			channel stepDoneRight: InOut
			
			-- Declaring call and ret events for undefined operations
			channel turnCall
			
			enterSS = {|
			i0::enter,
			j0::enter,
			j1::enter,
			j2::enter,
			j3::enter,
			Walking::enter,
			Stopped::enter,
			Turning::enter
			|}
			
			enteredSS = 	{|
			Walking::entered,
			Stopped::entered,
			Turning::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	startSiren,
				wallDetected,
				stopSiren,
				liftFootLeft,
				liftFootRight,
				stepDoneLeft,
				stepDoneRight
			,	turnCall
				|}
		
			-- Nodes --
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: i0
			module i0
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: j0
			module j0
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: j1
			module j1
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: j2
			module j2
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: j3
			module j3
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Walking
			module Walking
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((true&CALL__Walk(
								id__
							) ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((true&CALL__Walk(
								id__
							) ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Stopped
			module Stopped
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Turning
			module Turning
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&CALL__turn(
								id__
							) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&CALL__turn(
								id__
							) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			CALL__turn(id__) 	= turnCall -> SKIP
			
			CALL__Walk(id__) = (OP_Walk::O__(id__))
			[[
				OP_Walk::liftFootLeft <- liftFootLeft,
				OP_Walk::liftFootRight <- liftFootRight,
				OP_Walk::stepDoneLeft <- stepDoneLeft,
				OP_Walk::stepDoneRight <- stepDoneRight
			]]
			-- END of Operation calls --
			
			-- STM processes
			STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__) = ((let
				Trans = (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; j0::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j0 -> SKIP ;  ((true&(share__choice(startSiren.out -> SKIP)) ; j1::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j0 -> SKIP ;  ((SKIP ; j2::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j1 -> SKIP ;  ((SKIP ; Walking::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j2 -> SKIP ;  ((SKIP ; Walking::enter -> SKIP))))
					 	 [] dbisim((true)&(wallDetected__!NID_Walking.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j3::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_j3 -> SKIP ;  ((true&(share__choice(stopSiren.out -> SKIP)) ; Stopped::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_j3 -> SKIP ;  ((SKIP ; Turning::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_Turning -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j0::enter -> SKIP)))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						j0::enter,
						j1::enter,
						j2::enter,
						j3::enter,
						Walking::enter,
						Stopped::enter,
						Turning::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j2,wallDetected__.NID_Walking.in,internal__.NID_j3,internal__.NID_j3,internal__.NID_Turning|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::D__(id__)
							   [| { share__, terminate } |] (
							   j0::D__(id__)
							   [| { share__, terminate } |] (
							   j1::D__(id__)
							   [| { share__, terminate } |] (
							   j2::D__(id__)
							   [| { share__, terminate } |] (
							   j3::D__(id__)
							   [| { share__, terminate } |] (
							   Walking::D__(id__)
							   [| { share__, terminate } |] (
							   Stopped::D__(id__)
							   [| { share__, terminate } |] (
							   Turning::D__(id__)
							   )
							   )
							   )
							   )
							   )
							   )
							   )
							 )
							 [[Walking::interrupt <- x__ | x__ <- {|interrupt,wallDetected__.NID_Walking.in|}]]
							 [[Stopped::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
							 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
							 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
							 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3,internal__.NID_j3|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							startSiren__.x____ <- startSiren,
							wallDetected__.x____ <- wallDetected,
							stopSiren__.x____ <- stopSiren,
							liftFootLeft__.x____ <- liftFootLeft,
							liftFootRight__.x____ <- liftFootRight,
							stepDoneLeft__.x____ <- stepDoneLeft,
							stepDoneRight__.x____ <- stepDoneRight
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			IteratedBehaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			Stateful(id__) = 
				((
					(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful(id__) =
				(Behaviour(id__))
			
			-- Visible counterparts
			MachineBody_VS_O(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						j0::enter,
						j1::enter,
						j2::enter,
						j3::enter,
						Walking::enter,
						Stopped::enter,
						Turning::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j2,wallDetected__.NID_Walking.in,internal__.NID_j3,internal__.NID_j3,internal__.NID_Turning|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::VS_O__(id__)
							   [| { share__, terminate } |] (
							   j0::VS_O__(id__)
							   [| { share__, terminate } |] (
							   j1::VS_O__(id__)
							   [| { share__, terminate } |] (
							   j2::VS_O__(id__)
							   [| { share__, terminate } |] (
							   j3::VS_O__(id__)
							   [| { share__, terminate } |] (
							   Walking::VS_O__(id__)
							   [| { share__, terminate } |] (
							   Stopped::VS_O__(id__)
							   [| { share__, terminate } |] (
							   Turning::VS_O__(id__)
							   )
							   )
							   )
							   )
							   )
							   )
							   )
							 )
							 [[Walking::interrupt <- x__ | x__ <- {|interrupt,wallDetected__.NID_Walking.in|}]]
							 [[Stopped::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
							 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
							 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
							 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3,internal__.NID_j3|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							startSiren__.x____ <- startSiren,
							wallDetected__.x____ <- wallDetected,
							stopSiren__.x____ <- stopSiren,
							liftFootLeft__.x____ <- liftFootLeft,
							liftFootRight__.x____ <- liftFootRight,
							stepDoneLeft__.x____ <- stepDoneLeft,
							stepDoneRight__.x____ <- stepDoneRight
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__) = 
				dbisim((MachineBody_VS_O(id__))
				)
			
			IteratedBehaviour_VS_O(id__) = 
				dbisim((MachineBody_VS_O(id__))
				)
			
			Stateful_VS_O(id__) = 
				dbisim((
					(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__) =
				(Behaviour_VS_O(id__))
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__) = STM_VS_O(id__)
			
			D__(id__) = STM(id__) \ internal_events
			O__(id__) = sbisim(diamond(D__(id__)))
			VS__(id__) = FVS__(id__)
			VS_O__(id__) = sbisim(diamond(FVS__(id__)))
			HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
			HUP__(id__) = O__(id__) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		
			-- undefined operations
			CALL__turn(id__) 	= turnCall -> SKIP
			CALL__Walk(id__) 	= WalkCall -> SKIP
			
			-- declaring controller memory
			Memory(id__) = SKIP
			
			D__(id__) = 	((
					HeadS::D__(id__)[[
						HeadS::terminate <- terminate,
						HeadS::startSiren <- startSiren,
						HeadS::stopSiren <- stopSiren,
						HeadS::wallDetected <- wallDetected,
						HeadS::liftFootLeft <- liftFootLeft,
						HeadS::liftFootRight <- liftFootRight,
						HeadS::stepDoneLeft <- stepDoneLeft,
						HeadS::stepDoneRight <- stepDoneRight,
						HeadS::turnCall <- turnCall,
						HeadS::WalkCall <- WalkCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			
			-- VS version
			VS__(id__) = 	((
					HeadS::VS__(id__)[[
						HeadS::terminate <- terminate,
						HeadS::startSiren <- startSiren,
						HeadS::stopSiren <- stopSiren,
						HeadS::wallDetected <- wallDetected,
						HeadS::liftFootLeft <- liftFootLeft,
						HeadS::liftFootRight <- liftFootRight,
						HeadS::stepDoneLeft <- stepDoneLeft,
						HeadS::stepDoneRight <- stepDoneRight,
						HeadS::turnCall <- turnCall,
						HeadS::WalkCall <- WalkCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
		
			-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
			O__(id__) = sbisim(diamond(	((
					HeadS::O__(id__)[[
						HeadS::terminate <- terminate,
						HeadS::startSiren <- startSiren,
						HeadS::stopSiren <- stopSiren,
						HeadS::wallDetected <- wallDetected,
						HeadS::liftFootLeft <- liftFootLeft,
						HeadS::liftFootRight <- liftFootRight,
						HeadS::stepDoneLeft <- stepDoneLeft,
						HeadS::stepDoneRight <- stepDoneRight,
						HeadS::turnCall <- turnCall,
						HeadS::WalkCall <- WalkCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
							
			-- VS_O version
			VS_O__(id__) = sbisim(diamond(	((
					HeadS::VS_O__(id__)[[
						HeadS::terminate <- terminate,
						HeadS::startSiren <- startSiren,
						HeadS::stopSiren <- stopSiren,
						HeadS::wallDetected <- wallDetected,
						HeadS::liftFootLeft <- liftFootLeft,
						HeadS::liftFootRight <- liftFootRight,
						HeadS::stepDoneLeft <- stepDoneLeft,
						HeadS::stepDoneRight <- stepDoneRight,
						HeadS::turnCall <- turnCall,
						HeadS::WalkCall <- WalkCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__) = O__(id__) [|shared_variable_events|] SKIP			

	endmodule
	module Siren
		shared_variable_events = {|
		|}
		
	exports
		transparent diamond
		transparent sbisim
		transparent dbisim
		transparent chase

		-- declaring controller events
		channel startSiren: InOut
		channel stopSiren: InOut
		
		
		
		-- declaring call and ret events for undefined operations
		channel red5sCall
		channel green5sCall
		channel playCall
		
		-- declaring controller termination channel
		channel terminate
		
		-- channel set with all visible events
		sem__events = {|
			terminate
		,	startSiren,
			stopSiren
		,	red5sCall,
			green5sCall,
			playCall
		|}

		-- defined operations
	
		-- declaring machines
		module SirenS
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
		
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_i0|
			              NID_Stopped|
			              NID_s1
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			channel stopSiren__: NIDS.InOut
			channel stopSiren: InOut
			channel startSiren__: NIDS.InOut
			channel startSiren: InOut
			
			-- Declaring call and ret events for undefined operations
			channel red5sCall
			channel green5sCall
			channel playCall
			
			enterSS = {|
			i0::enter,
			Stopped::enter,
			s1::enter
			|}
			
			enteredSS = 	{|
			Stopped::entered,
			s1::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	stopSiren,
				startSiren
			,	red5sCall,
				green5sCall,
				playCall
				|}
		
			-- Nodes --
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: i0
			module i0
			exports
			
				channel enter, interrupt
				
				D__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__) = D__(id__)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: Stopped
			module Stopped
			
			enterSS = {}
			
			enteredSS = {}
			
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				
				--	Nodes
				-- declaring all nodes
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- State: s1
			module s1
			
			enterSS = 
					{|			i0::enter,
						Red::enter,
						Green::enter
					|}
			enteredSS = 
					{|			Red::entered,
						Green::entered
					|}
			exports
			
				--  Declarations
				
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
								
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_i0|
				              NID_Red|
				              NID_Green
				
				channel internal__ : NIDS
				channel stopSiren__: NIDS.InOut
				channel startSiren__: NIDS.InOut
				
				--	Nodes
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: i0
				module i0
				exports
				
					channel enter, interrupt
					
					D__(id__) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__) = D__(id__)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Red
				module Red
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&CALL__green5s(
									id__
								) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&CALL__green5s(
									id__
								) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Green
				module Green
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&CALL__red5s(
									id__
								) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&CALL__red5s(
									id__
								) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((let
						 	-- IMPLEMENTATION NOTE:
						 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 	-- modules for defining the semantics of each node.
						 	enterSS = {|
						 	i0::enter,
						 	Red::enter,
						 	Green::enter
						 	|}
						 	hideSet = union(enterSS,{|exit,exited,internal__|})
						 within 
						 	((let
						 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 		-- because CSPM modules are used for the semantics of Node.
						 		flowevts = union(enterSS,{|exit,exited,interrupt|})
						 		transSync = {|internal__.NID_i0,internal__.NID_Red,internal__.NID_Green|}
						 	within
						 		((
						 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 		   i0::D__(id__)
						 		   [| { share__, terminate } |] (
						 		   Red::D__(id__)
						 		   [| { share__, terminate } |] (
						 		   Green::D__(id__)
						 		   )
						 		   )
						 		 )
						 		 [[Red::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Red|}]]
						 		 [[Green::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Green|}]]
						 		 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 		 )
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 		 )
						 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 		|}) |]
						 		 ((i0::enter -> Transitions(id__))
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						 		 )
						 		)
						 		)
						 	)
						 	 \ hideSet)
						 	[[
						 		stopSiren__.x____ <- stopSiren,
						 		startSiren__.x____ <- startSiren
						 		| x____ <- NIDS
						 	]]
						 )
						 )
						  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						 )
						)
						)\union(enteredSS,{terminate}) 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| true&CALL__play(
							 	  			id__
							 	  		) ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((let
						 	-- IMPLEMENTATION NOTE:
						 	-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 	-- modules for defining the semantics of each node.
						 	enterSS = {|
						 	i0::enter,
						 	Red::enter,
						 	Green::enter
						 	|}
						 	hideSet = union(enterSS,{|exit,exited,internal__|})
						 within 
						 	((let
						 		-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 		-- because CSPM modules are used for the semantics of Node.
						 		flowevts = union(enterSS,{|exit,exited,interrupt|})
						 		transSync = {|internal__.NID_i0,internal__.NID_Red,internal__.NID_Green|}
						 	within
						 		((
						 		 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 		   i0::VS_O__(id__)
						 		   [| { share__, terminate } |] (
						 		   Red::VS_O__(id__)
						 		   [| { share__, terminate } |] (
						 		   Green::VS_O__(id__)
						 		   )
						 		   )
						 		 )
						 		 [[Red::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Red|}]]
						 		 [[Green::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Green|}]]
						 		 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 		 )
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 		 )
						 		 [| union(union(union(flowevts,transSync),{terminate}),{|share__
						 		|}) |]
						 		 ((i0::enter -> Transitions(id__))
						 		  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						 		 )
						 		)
						 		)
						 	)
						 	 \ hideSet)
						 	[[
						 		stopSiren__.x____ <- stopSiren,
						 		startSiren__.x____ <- startSiren
						 		| x____ <- NIDS
						 	]]
						 )
						 )
						  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						 )
						)
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| true&CALL__play(
							 	  			id__
							 	  		) ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__) = ((let
					Trans = (
						((share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Red::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_Red -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Green::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_Green -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Red::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
				within
					Trans
				)
				)
				
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			CALL__red5s(id__) 	= red5sCall -> SKIP
			CALL__green5s(id__) 	= green5sCall -> SKIP
			CALL__play(id__) 	= playCall -> SKIP
			
			-- END of Operation calls --
			
			-- STM processes
			STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
			( 
				(
					(
						(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
					 	[[ share__ <- x__ | x__ <- {||} ]]
					)
				[| {share__} |]
				SKIP
				)
				[| union(sharedVarSync,{terminate}) |]
				dbisim(sharedVarMemory(id__))
			)\sharedVarHide
			
			-- Transitions
			Transitions(id__) = ((let
				Trans = (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; Stopped::enter -> SKIP))))
					 	 [] dbisim((true)&(internal__!NID_Stopped -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; s1::enter -> SKIP)))
					 	 [] dbisim((true)&(internal__!NID_s1 -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Stopped::enter -> SKIP)))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						Stopped::enter,
						s1::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,internal__.NID_Stopped,internal__.NID_s1|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::D__(id__)
							   [| { share__, terminate } |] (
							   Stopped::D__(id__)
							   [| { share__, terminate } |] (
							   s1::D__(id__)
							   )
							   )
							 )
							 [[Stopped::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Stopped|}]]
							 [[s1::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s1|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							stopSiren__.x____ <- stopSiren,
							startSiren__.x____ <- startSiren
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			IteratedBehaviour(id__) = 
				dbisim((MachineBody(id__)\ enteredSS)
				)
			
			Stateful(id__) = 
				((
					(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful(id__) =
				(Behaviour(id__))
			
			-- Visible counterparts
			MachineBody_VS_O(id__) = 
				dbisim((
				let
					finalNodesEntered = {||}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i0::enter,
						Stopped::enter,
						s1::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_i0,internal__.NID_Stopped,internal__.NID_s1|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i0::VS_O__(id__)
							   [| { share__, terminate } |] (
							   Stopped::VS_O__(id__)
							   [| { share__, terminate } |] (
							   s1::VS_O__(id__)
							   )
							   )
							 )
							 [[Stopped::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Stopped|}]]
							 [[s1::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s1|}]]
							 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((i0::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[
							stopSiren__.x____ <- stopSiren,
							startSiren__.x____ <- startSiren
							| x____ <- NIDS
						]]
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__) = 
				dbisim((MachineBody_VS_O(id__))
				)
			
			IteratedBehaviour_VS_O(id__) = 
				dbisim((MachineBody_VS_O(id__))
				)
			
			Stateful_VS_O(id__) = 
				dbisim((
					(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__) =
				(Behaviour_VS_O(id__))
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__) = STM_VS_O(id__)
			
			D__(id__) = STM(id__) \ internal_events
			O__(id__) = sbisim(diamond(D__(id__)))
			VS__(id__) = FVS__(id__)
			VS_O__(id__) = sbisim(diamond(FVS__(id__)))
			HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
			HUP__(id__) = O__(id__) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		
			-- undefined operations
			CALL__red5s(id__) 	= red5sCall -> SKIP
			CALL__green5s(id__) 	= green5sCall -> SKIP
			CALL__play(id__) 	= playCall -> SKIP
			
			-- declaring controller memory
			Memory(id__) = SKIP
			
			D__(id__) = 	((
					SirenS::D__(id__)[[
						SirenS::terminate <- terminate,
						SirenS::startSiren <- startSiren,
						SirenS::stopSiren <- stopSiren,
						SirenS::red5sCall <- red5sCall,
						SirenS::green5sCall <- green5sCall,
						SirenS::playCall <- playCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			
			-- VS version
			VS__(id__) = 	((
					SirenS::VS__(id__)[[
						SirenS::terminate <- terminate,
						SirenS::startSiren <- startSiren,
						SirenS::stopSiren <- stopSiren,
						SirenS::red5sCall <- red5sCall,
						SirenS::green5sCall <- green5sCall,
						SirenS::playCall <- playCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
		
			-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
			O__(id__) = sbisim(diamond(	((
					SirenS::O__(id__)[[
						SirenS::terminate <- terminate,
						SirenS::startSiren <- startSiren,
						SirenS::stopSiren <- stopSiren,
						SirenS::red5sCall <- red5sCall,
						SirenS::green5sCall <- green5sCall,
						SirenS::playCall <- playCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
							
			-- VS_O version
			VS_O__(id__) = sbisim(diamond(	((
					SirenS::VS_O__(id__)[[
						SirenS::terminate <- terminate,
						SirenS::startSiren <- startSiren,
						SirenS::stopSiren <- stopSiren,
						SirenS::red5sCall <- red5sCall,
						SirenS::green5sCall <- green5sCall,
						SirenS::playCall <- playCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__) = O__(id__) [|shared_variable_events|] SKIP			

	endmodule


module foot_controller
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I1|
	              NID_Balanced|
	              NID_Moving|
	              NID_Leaning
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_v, set_v, setL_v, setR_v: Vector
	channel get_direction, set_direction, setL_direction, setR_direction: Vector
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel leanOut__: NIDS.InOut
	channel leanOut: InOut
	channel stepDone__: NIDS.InOut
	channel stepDone: InOut
	channel stepDownOut__: NIDS.InOut
	channel stepDownOut: InOut
	channel outOfBalance__: NIDS.InOut.Vector
	channel outOfBalance: InOut.Vector
	channel liftFoot__: NIDS.InOut
	channel liftFoot: InOut
	channel leanIn__: NIDS.InOut
	channel leanIn: InOut
	channel stepDownIn__: NIDS.InOut
	channel stepDownIn: InOut
	
	-- Declaring call and ret events for undefined operations
	channel movezCall: core_real
	channel movexCall: core_real
	channel correctCall: Vector
	channel leanforwardCall
	channel moveyCall: core_real
	channel stepCall: Vector
	
	enterSS = {|
	I1::enter,
	Balanced::enter,
	Moving::enter,
	Leaning::enter
	|}
	
	enteredSS = 	{|
	Balanced::entered,
	Moving::entered,
	Leaning::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	leanOut,
		stepDone,
		stepDownOut,
		outOfBalance,
		liftFoot,
		leanIn,
		stepDownIn
	,	movezCall,
		movexCall,
		correctCall,
		leanforwardCall,
		moveyCall,
		stepCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I1
	module I1
	exports
	
		channel enter, interrupt
		
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Balanced
	module Balanced
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Moving
	module Moving
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_direction?direction -> true&CALL__step(
						id__,
						direction
					)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= share__choice(get_direction?direction -> true&CALL__step(
						id__,
						direction
					)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Leaning
	module Leaning
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&CALL__leanforward(
						id__
					) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&CALL__leanforward(
						id__
					) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__movez(id__,
				param_r) 	= movezCall.param_r -> SKIP
	CALL__movex(id__,
				param_r) 	= movexCall.param_r -> SKIP
	CALL__correct(id__,
				param_v) 	= correctCall.param_v -> SKIP
	CALL__leanforward(id__) 	= leanforwardCall -> SKIP
	CALL__movey(id__,
				param_r) 	= moveyCall.param_r -> SKIP
	CALL__step(id__,
				param_d) 	= stepCall.param_d -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(outOfBalance__!NID_Balanced.in?v:{v|v <- Vector, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&CALL__correct(
			 			id__,
			 			v
			 		)) ; Balanced::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((SKIP ; Balanced::enter -> SKIP))))
			 	 [] dbisim((true)&(liftFoot__!NID_Balanced.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Moving::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Moving -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Balanced::enter -> SKIP)))
			 	 [] dbisim((true)&(leanIn__!NID_Balanced.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Leaning::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_Leaning -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(stepDownOut.out -> SKIP)) ; Balanced::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I1::enter,
				Balanced::enter,
				Moving::enter,
				Leaning::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|outOfBalance__.NID_Balanced.in,internal__.NID_I1,liftFoot__.NID_Balanced.in,internal__.NID_Moving,leanIn__.NID_Balanced.in,internal__.NID_Leaning|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I1::D__(id__)
					   [| { share__, terminate } |] (
					   Balanced::D__(id__)
					   [| { share__, terminate } |] (
					   Moving::D__(id__)
					   [| { share__, terminate } |] (
					   Leaning::D__(id__)
					   )
					   )
					   )
					 )
					 [[Balanced::interrupt <- x__ | x__ <- {|interrupt,outOfBalance__.NID_Balanced.in,liftFoot__.NID_Balanced.in,leanIn__.NID_Balanced.in|}]]
					 [[Moving::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Moving|}]]
					 [[Leaning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Leaning|}]]
					 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_v
					 			|}) |]
					 ((I1::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_v <- setR_v]]
					 )
					)
					 [[setR_v <- set_v]]
					)
				)
				 \ hideSet)
				[[
					leanOut__.x____ <- leanOut,
					stepDone__.x____ <- stepDone,
					stepDownOut__.x____ <- stepDownOut,
					outOfBalance__.x____ <- outOfBalance,
					liftFoot__.x____ <- liftFoot,
					leanIn__.x____ <- leanIn,
					stepDownIn__.x____ <- stepDownIn
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	Stateful(id__) = 
		((
			(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						Behaviour(id__)
						[| {|get_direction,set_direction,terminate|} |]
						Memory_direction((0,0,0))
					)\{|get_direction,set_direction|}
				)
				[| {|get_v,set_v,terminate|} |]
				Memory_v((0,0,0))
			)\{|get_v,set_v|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I1::enter,
				Balanced::enter,
				Moving::enter,
				Leaning::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|outOfBalance__.NID_Balanced.in,internal__.NID_I1,liftFoot__.NID_Balanced.in,internal__.NID_Moving,leanIn__.NID_Balanced.in,internal__.NID_Leaning|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I1::VS_O__(id__)
					   [| { share__, terminate } |] (
					   Balanced::VS_O__(id__)
					   [| { share__, terminate } |] (
					   Moving::VS_O__(id__)
					   [| { share__, terminate } |] (
					   Leaning::VS_O__(id__)
					   )
					   )
					   )
					 )
					 [[Balanced::interrupt <- x__ | x__ <- {|interrupt,outOfBalance__.NID_Balanced.in,liftFoot__.NID_Balanced.in,leanIn__.NID_Balanced.in|}]]
					 [[Moving::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Moving|}]]
					 [[Leaning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Leaning|}]]
					 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setR_v
					 			|}) |]
					 ((I1::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					  [[set_v <- setR_v]]
					 )
					)
					 [[setR_v <- set_v]]
					)
				)
				 \ hideSet)
				[[
					leanOut__.x____ <- leanOut,
					stepDone__.x____ <- stepDone,
					stepDownOut__.x____ <- stepDownOut,
					outOfBalance__.x____ <- outOfBalance,
					liftFoot__.x____ <- liftFoot,
					leanIn__.x____ <- leanIn,
					stepDownIn__.x____ <- stepDownIn
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	IteratedBehaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	Stateful_VS_O(id__) = 
		dbisim((
			(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__) =
		(dbisim(
			sbisim(
				dbisim(
					sbisim(
						Behaviour_VS_O(id__)
						[| {|get_direction,set_direction,terminate|} |]
						Memory_direction((0,0,0))
					)\{|get_direction,set_direction|}
				)
				[| {|get_v,set_v,terminate|} |]
				Memory_v((0,0,0))
			)\{|get_v,set_v|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_v(v) =
		get_v!v -> Memory_v(v)
		[]
		set_v?x__ -> Memory_v(x__)
		[]
		terminate -> SKIP
	Memory_direction(direction) =
		get_direction!direction -> Memory_direction(direction)
		[]
		set_direction?x__ -> Memory_direction(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__) = Memory_v((0,0,0))
	[| { terminate } |] (
	Memory_direction((0,0,0))
	)
	
	getsetLocalChannels = {|get_v,set_v,get_direction,set_direction|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__) = STM_VS_O(id__)
	
	D__(id__) = STM(id__) \ internal_events
	O__(id__) = sbisim(diamond(D__(id__)))
	VS__(id__) = FVS__(id__)
	VS_O__(id__) = sbisim(diamond(FVS__(id__)))
	HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
	HUP__(id__) = O__(id__) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule

-- compileSelfContainedOperation
module OP_correct
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I1|
	              NID_F1
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	
	-- Declaring call and ret events for undefined operations
	channel movezCall: core_real
	channel movexCall: core_real
	channel leanforwardCall
	channel moveyCall: core_real
	
	enterSS = {|
	I1::enter,
	F1::enter
	|}
	
	enteredSS = 	{|
	F1::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	movezCall,
		movexCall,
		leanforwardCall,
		moveyCall
		, share__
		|}
	
	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I1
	module I1
	exports
	
		channel enter, interrupt
		
		D__(id__,
					param_v) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
					param_v) = D__(id__,
					param_v)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: F1
	module F1
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__,
					param_v) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
					param_v) = D__(id__,
					param_v)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__movez(id__,
				param_r) 	= movezCall.param_r -> SKIP
	CALL__movex(id__,
				param_r) 	= movexCall.param_r -> SKIP
	CALL__leanforward(id__) 	= leanforwardCall -> SKIP
	CALL__movey(id__,
				param_r) 	= moveyCall.param_r -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
				param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__,
				param_v) \ {terminate}
	
	STM_VS_O(id__,
				param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__,
				param_v) \ {terminate}
	
	-- Transitions
	Transitions(id__,
				param_v) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((true&CALL__movex(
			 			id__,
			 			Vector_x(param_v)
			 		);true&CALL__movey(
			 			id__,
			 			Vector_y(param_v)
			 		);true&CALL__movez(
			 			id__,
			 			Vector_z(param_v)
			 		) ; F1::enter -> SKIP))))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
				param_v) = 
		dbisim((
		let
			finalNodesEntered = {|F1::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I1::enter,
				F1::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I1|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I1::D__(id__,
					   			param_v)
					   [| { share__, terminate } |] (
					   F1::D__(id__,
					   			param_v)
					   )
					 )
					 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((I1::enter -> Transitions(id__,
					 			param_v))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
				param_v) = 
		dbisim((MachineBody(id__,
					param_v)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
				param_v) = 
		dbisim((MachineBody(id__,
					param_v)\ enteredSS)
		)
	
	Stateful(id__,
				param_v) = 
		((
			(Behaviour(id__,
						param_v) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
						param_v))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
				param_v) =
		(Behaviour(id__,
					param_v))
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
				param_v) = 
		dbisim((
		let
			finalNodesEntered = {|F1::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I1::enter,
				F1::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I1|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I1::VS_O__(id__,
					   			param_v)
					   [| { share__, terminate } |] (
					   F1::VS_O__(id__,
					   			param_v)
					   )
					 )
					 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((I1::enter -> Transitions(id__,
					 			param_v))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
				param_v) = 
		dbisim((MachineBody_VS_O(id__,
					param_v))
		)
	
	IteratedBehaviour_VS_O(id__,
				param_v) = 
		dbisim((MachineBody_VS_O(id__,
					param_v))
		)
	
	Stateful_VS_O(id__,
				param_v) = 
		dbisim((
			(Behaviour_VS_O(id__,
						param_v) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
						param_v))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
				param_v) =
		(Behaviour_VS_O(id__,
					param_v))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__,
				param_v) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
				param_v) = STM_VS_O(id__,
				param_v)
	
	D__(id__,
				param_v) = STM(id__,
				param_v) \ internal_events
	O__(id__,
				param_v) = sbisim(diamond(D__(id__,
				param_v)))
	VS__(id__,
				param_v) = FVS__(id__,
				param_v)
	VS_O__(id__,
				param_v) = sbisim(diamond(FVS__(id__,
				param_v)))
	HEXT__(id__,
				param_v) = O__(id__,
				param_v) [|shared_variable_events|] SKIP
	HUP__(id__,
				param_v) = O__(id__,
				param_v) [|{share__}|] SKIP
			endmodule
-- compileSelfContainedOperation
module OP_step
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_I1|
	              NID_F1|
	              NID_j1|
	              NID_j2|
	              NID_j3|
	              NID_Waiting|
	              NID_j4
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel leanOut__: NIDS.InOut
	channel leanOut: InOut
	channel stepDownIn__: NIDS.InOut
	channel stepDownIn: InOut
	channel stepDone__: NIDS.InOut
	channel stepDone: InOut
	
	-- Declaring call and ret events for undefined operations
	channel movezCall: core_real
	channel movexCall: core_real
	channel leanforwardCall
	channel moveyCall: core_real
	
	enterSS = {|
	I1::enter,
	F1::enter,
	j1::enter,
	j2::enter,
	j3::enter,
	Waiting::enter,
	j4::enter
	|}
	
	enteredSS = 	{|
	F1::entered,
	Waiting::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	leanOut,
		stepDownIn,
		stepDone
	,	movezCall,
		movexCall,
		leanforwardCall,
		moveyCall
		, share__
		|}
	
	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: I1
	module I1
	exports
	
		channel enter, interrupt
		
		D__(id__,
					param_d,
				    const_step_c) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
					param_d,
				    const_step_c) = D__(id__,
					param_d,
				    const_step_c)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: F1
	module F1
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__,
					param_d,
				    const_step_c) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
					param_d,
				    const_step_c) = D__(id__,
					param_d,
				    const_step_c)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Junction: j1
	module j1
	exports
	
		channel enter, interrupt
		
		D__(id__,
					param_d,
				    const_step_c) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
					param_d,
				    const_step_c) = D__(id__,
					param_d,
				    const_step_c)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Junction: j2
	module j2
	exports
	
		channel enter, interrupt
		
		D__(id__,
					param_d,
				    const_step_c) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
					param_d,
				    const_step_c) = D__(id__,
					param_d,
				    const_step_c)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Junction: j3
	module j3
	exports
	
		channel enter, interrupt
		
		D__(id__,
					param_d,
				    const_step_c) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
					param_d,
				    const_step_c) = D__(id__,
					param_d,
				    const_step_c)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: Waiting
	module Waiting
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
					param_d,
				    const_step_c) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
					param_d,
				    const_step_c) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Junction: j4
	module j4
	exports
	
		channel enter, interrupt
		
		D__(id__,
					param_d,
				    const_step_c) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
					param_d,
				    const_step_c) = D__(id__,
					param_d,
				    const_step_c)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__movez(id__,
			    const_step_c,
				param_r) 	= movezCall.param_r -> SKIP
	CALL__movex(id__,
			    const_step_c,
				param_r) 	= movexCall.param_r -> SKIP
	CALL__leanforward(id__,
			    const_step_c) 	= leanforwardCall -> SKIP
	CALL__movey(id__,
			    const_step_c,
				param_r) 	= moveyCall.param_r -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
				param_d,
			    const_step_c) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__,
				param_d,
			    const_step_c) \ {terminate}
	
	STM_VS_O(id__,
				param_d,
			    const_step_c) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__,
				param_d,
			    const_step_c) \ {terminate}
	
	-- Transitions
	Transitions(id__,
				param_d,
			    const_step_c) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((pre_sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real))&sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)) != 0&CALL__movex(
			 			id__,
			 		    const_step_c,
			 			Div(Mult(const_step_c, Vector_x(param_d), core_real), sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)), core_real)
			 		) ; j1::enter -> SKIP))))
			 	 [] dbisim((true)&(internal__!NID_j1 -> SKIP ;  ((pre_sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real))&sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)) != 0&CALL__movey(
			 			id__,
			 		    const_step_c,
			 			Div((Mult(const_step_c, Vector_y(param_d), core_real)), sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)), core_real)
			 		) ; j2::enter -> SKIP))))
			 	 [] dbisim((true)&(internal__!NID_j2 -> SKIP ;  ((true&CALL__movez(
			 			id__,
			 		    const_step_c,
			 			const_step_c
			 		) ; j3::enter -> SKIP))))
			 	 [] dbisim((true)&(internal__!NID_j3 -> SKIP ;  ((true&(share__choice(leanOut.out -> SKIP)) ; Waiting::enter -> SKIP))))
			 	 [] dbisim((true)&(stepDownIn__!NID_Waiting.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(stepDone.out -> SKIP)) ; j4::enter -> SKIP)))
			 	 [] dbisim((true)&(internal__!NID_j4 -> SKIP ;  ((true&CALL__movez(
			 			id__,
			 		    const_step_c,
			 			Neg(const_step_c, core_real)
			 		) ; F1::enter -> SKIP))))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
				param_d,
			    const_step_c) = 
		dbisim((
		let
			finalNodesEntered = {|F1::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I1::enter,
				F1::enter,
				j1::enter,
				j2::enter,
				j3::enter,
				Waiting::enter,
				j4::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I1,internal__.NID_j1,internal__.NID_j2,internal__.NID_j3,stepDownIn__.NID_Waiting.in,internal__.NID_j4|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I1::D__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   F1::D__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j1::D__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j2::D__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j3::D__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   Waiting::D__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j4::D__(id__,
					   			param_d,
					   		    const_step_c)
					   )
					   )
					   )
					   )
					   )
					   )
					 )
					 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,stepDownIn__.NID_Waiting.in|}]]
					 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
					 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
					 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
					 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3|}]]
					 [[j4::interrupt <- x__ | x__ <- {|internal__.NID_j4|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((I1::enter -> Transitions(id__,
					 			param_d,
					 		    const_step_c))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					leanOut__.x____ <- leanOut,
					stepDownIn__.x____ <- stepDownIn,
					stepDone__.x____ <- stepDone
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
				param_d,
			    const_step_c) = 
		dbisim((MachineBody(id__,
					param_d,
				    const_step_c)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
				param_d,
			    const_step_c) = 
		dbisim((MachineBody(id__,
					param_d,
				    const_step_c)\ enteredSS)
		)
	
	Stateful(id__,
				param_d,
			    const_step_c) = 
		((
			(Behaviour(id__,
						param_d,
					    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
						param_d,
					    const_step_c))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
				param_d,
			    const_step_c) =
		(Behaviour(id__,
					param_d,
				    const_step_c))
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
				param_d,
			    const_step_c) = 
		dbisim((
		let
			finalNodesEntered = {|F1::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				I1::enter,
				F1::enter,
				j1::enter,
				j2::enter,
				j3::enter,
				Waiting::enter,
				j4::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_I1,internal__.NID_j1,internal__.NID_j2,internal__.NID_j3,stepDownIn__.NID_Waiting.in,internal__.NID_j4|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   I1::VS_O__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   F1::VS_O__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j1::VS_O__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j2::VS_O__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j3::VS_O__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   Waiting::VS_O__(id__,
					   			param_d,
					   		    const_step_c)
					   [| { share__, terminate } |] (
					   j4::VS_O__(id__,
					   			param_d,
					   		    const_step_c)
					   )
					   )
					   )
					   )
					   )
					   )
					 )
					 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,stepDownIn__.NID_Waiting.in|}]]
					 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
					 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
					 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
					 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3|}]]
					 [[j4::interrupt <- x__ | x__ <- {|internal__.NID_j4|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((I1::enter -> Transitions(id__,
					 			param_d,
					 		    const_step_c))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					leanOut__.x____ <- leanOut,
					stepDownIn__.x____ <- stepDownIn,
					stepDone__.x____ <- stepDone
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
				param_d,
			    const_step_c) = 
		dbisim((MachineBody_VS_O(id__,
					param_d,
				    const_step_c))
		)
	
	IteratedBehaviour_VS_O(id__,
				param_d,
			    const_step_c) = 
		dbisim((MachineBody_VS_O(id__,
					param_d,
				    const_step_c))
		)
	
	Stateful_VS_O(id__,
				param_d,
			    const_step_c) = 
		dbisim((
			(Behaviour_VS_O(id__,
						param_d,
					    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
						param_d,
					    const_step_c))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
				param_d,
			    const_step_c) =
		(Behaviour_VS_O(id__,
					param_d,
				    const_step_c))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__,
				param_d,
			    const_step_c) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
				param_d,
			    const_step_c) = STM_VS_O(id__,
				param_d,
			    const_step_c)
	
	D__(id__,
				param_d,
			    const_step_c) = STM(id__,
				param_d,
			    const_step_c) \ internal_events
	O__(id__,
				param_d,
			    const_step_c) = sbisim(diamond(D__(id__,
				param_d,
			    const_step_c)))
	VS__(id__,
				param_d,
			    const_step_c) = FVS__(id__,
				param_d,
			    const_step_c)
	VS_O__(id__,
				param_d,
			    const_step_c) = sbisim(diamond(FVS__(id__,
				param_d,
			    const_step_c)))
	HEXT__(id__,
				param_d,
			    const_step_c) = O__(id__,
				param_d,
			    const_step_c) [|shared_variable_events|] SKIP
	HUP__(id__,
				param_d,
			    const_step_c) = O__(id__,
				param_d,
			    const_step_c) [|{share__}|] SKIP
			endmodule
-- compileSelfContainedOperation
module OP_Walk
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_i0|
	              NID_LeftFoot|
	              NID_RightFoot
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel liftFootLeft__: NIDS.InOut
	channel liftFootLeft: InOut
	channel liftFootRight__: NIDS.InOut
	channel liftFootRight: InOut
	channel stepDoneLeft__: NIDS.InOut
	channel stepDoneLeft: InOut
	channel stepDoneRight__: NIDS.InOut
	channel stepDoneRight: InOut
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	i0::enter,
	LeftFoot::enter,
	RightFoot::enter
	|}
	
	enteredSS = 	{|
	LeftFoot::entered,
	RightFoot::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	liftFootLeft,
		liftFootRight,
		stepDoneLeft,
		stepDoneRight
		, share__
		|}
	
	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: i0
	module i0
	exports
	
		channel enter, interrupt
		
		D__(id__) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__) = D__(id__)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: LeftFoot
	module LeftFoot
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(liftFootLeft.out -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(liftFootLeft.out -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: RightFoot
	module RightFoot
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(liftFootRight.out -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= true&(share__choice(liftFootRight.out -> SKIP)) ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	STM_VS_O(id__) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
	Stateful(id__) \ {terminate}
	
	-- Transitions
	Transitions(id__) = ((let
		Trans = (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; LeftFoot::enter -> SKIP))))
			 	 [] dbisim((true)&(stepDoneLeft__!NID_LeftFoot.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; RightFoot::enter -> SKIP)))
			 	 [] dbisim((true)&(stepDoneRight__!NID_RightFoot.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; LeftFoot::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i0::enter,
				LeftFoot::enter,
				RightFoot::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,stepDoneLeft__.NID_LeftFoot.in,stepDoneRight__.NID_RightFoot.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   i0::D__(id__)
					   [| { share__, terminate } |] (
					   LeftFoot::D__(id__)
					   [| { share__, terminate } |] (
					   RightFoot::D__(id__)
					   )
					   )
					 )
					 [[LeftFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneLeft__.NID_LeftFoot.in|}]]
					 [[RightFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneRight__.NID_RightFoot.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					liftFootLeft__.x____ <- liftFootLeft,
					liftFootRight__.x____ <- liftFootRight,
					stepDoneLeft__.x____ <- stepDoneLeft,
					stepDoneRight__.x____ <- stepDoneRight
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	IteratedBehaviour(id__) = 
		dbisim((MachineBody(id__)\ enteredSS)
		)
	
	Stateful(id__) = 
		((
			(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__) =
		(Behaviour(id__))
	
	-- Visible counterparts
	MachineBody_VS_O(id__) = 
		dbisim((
		let
			finalNodesEntered = {||}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i0::enter,
				LeftFoot::enter,
				RightFoot::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i0,stepDoneLeft__.NID_LeftFoot.in,stepDoneRight__.NID_RightFoot.in|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   i0::VS_O__(id__)
					   [| { share__, terminate } |] (
					   LeftFoot::VS_O__(id__)
					   [| { share__, terminate } |] (
					   RightFoot::VS_O__(id__)
					   )
					   )
					 )
					 [[LeftFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneLeft__.NID_LeftFoot.in|}]]
					 [[RightFoot::interrupt <- x__ | x__ <- {|interrupt,stepDoneRight__.NID_RightFoot.in|}]]
					 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					|}) |]
					 ((i0::enter -> Transitions(id__))
					  [[ share__ <- x__ | x__ <- {| share__ |} ]]
					 )
					)
					)
				)
				 \ hideSet)
				[[
					liftFootLeft__.x____ <- liftFootLeft,
					liftFootRight__.x____ <- liftFootRight,
					stepDoneLeft__.x____ <- stepDoneLeft,
					stepDoneRight__.x____ <- stepDoneRight
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	IteratedBehaviour_VS_O(id__) = 
		dbisim((MachineBody_VS_O(id__))
		)
	
	Stateful_VS_O(id__) = 
		dbisim((
			(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__) =
		(Behaviour_VS_O(id__))
	
	-- END
	
	-- Memory
	-- Memory variables
	
	-- varMemory process
	varMemory(id__) = terminate -> SKIP
	
	getsetLocalChannels = {||}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__) = STM_VS_O(id__)
	
	D__(id__) = STM(id__) \ internal_events
	O__(id__) = sbisim(diamond(D__(id__)))
	VS__(id__) = FVS__(id__)
	VS_O__(id__) = sbisim(diamond(FVS__(id__)))
	HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
	HUP__(id__) = O__(id__) [|{share__}|] SKIP
			endmodule

