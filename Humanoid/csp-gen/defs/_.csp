							stm_ref0::stepDone <- stepDone,
							stm_ref0::leanOut <- leanOut,
							stm_ref0::movezCall <- movezCall,
							stm_ref0::movexCall <- movexCall,
							stm_ref0::leanforwardCall <- leanforwardCall,
							stm_ref0::moveyCall <- moveyCall
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				
				-- VS version
				VS__(id__,
						   	const_Foot_op_ref1_c) = 	((
						let
							const_step_c = const_Foot_op_ref1_c
						within 
