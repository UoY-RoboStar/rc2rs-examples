	module Foot
		shared_variable_events = {|
		|}
		
	exports
		transparent diamond
		transparent sbisim
		transparent dbisim
		transparent chase

		-- declaring controller events
		channel leanOut: InOut
		channel stepDone: InOut
		channel stepDownOut: InOut
		channel outOfBalance: InOut.Vector
		channel liftFoot: InOut
		channel leanIn: InOut
		channel stepDownIn: InOut
		
		
		
		-- declaring call and ret events for undefined operations
		channel movezCall: core_real
		channel movexCall: core_real
		channel leanforwardCall
		channel moveyCall: core_real
		
		-- declaring controller termination channel
		channel terminate
		
		-- channel set with all visible events
		sem__events = {|
			terminate
		,	leanOut,
			stepDone,
			stepDownOut,
			outOfBalance,
			liftFoot,
			leanIn,
			stepDownIn
		,	movezCall,
			movexCall,
			leanforwardCall,
			moveyCall
		|}

		-- defined operations
		-- compileOperationDef
		module OP_correct
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
			
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_I1|
			              NID_F1
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			
			-- Shared variable channels
			
			-- Local variable channels for defined operations that are required by the state machine
			
			-- Declaring state machine events
			
			-- Declaring call and ret events for undefined operations
			channel movezCall: core_real
			channel movexCall: core_real
			channel leanforwardCall
			channel moveyCall: core_real
			
			enterSS = {|
			I1::enter,
			F1::enter
			|}
			
			enteredSS = 	{|
			F1::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	movezCall,
				movexCall,
				leanforwardCall,
				moveyCall
				, share__
				|}
			
			-- Nodes --
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: I1
			module I1
			exports
			
				channel enter, interrupt
				
				D__(id__,
							param_v) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(interrupt -> SKIP) ; Inactive
					within
						Inactive [| {terminate} |> SKIP)
				
				VS_O__(id__,
							param_v) = D__(id__,
							param_v)
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Final state: F1
			module F1
			
			exports
			
				channel enter, entered, interrupt
				channel enteredL, enteredR
				
				--	Rule: behaviours(Node)
				D__(id__,
							param_v) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
						
						Entering 	= entered -> SKIP ; Active
						Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
						Interrupted	= share__choice(exit -> exited -> Inactive)
					within
						Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,
							param_v) = D__(id__,
							param_v)
			
			endmodule
			----------------------------------------------------------------------
			
			-- END of Nodes --
			
			-- Operation calls --
			-- Only the undefined operations are declared here.
			-- If the state machine is in isolation, all required operations will be undefined.
			-- If it is in the context of a controller, the required operations not provided by the
			-- controller will be declared here, and the defined operations will be defined in the
			-- context of the Controller module, and therefore within scope of the state machine module.
			CALL__movez(id__,
						param_r) 	= movezCall.param_r -> SKIP
			CALL__movex(id__,
						param_r) 	= movexCall.param_r -> SKIP
			CALL__leanforward(id__) 	= leanforwardCall -> SKIP
			CALL__movey(id__,
						param_r) 	= moveyCall.param_r -> SKIP
			
			-- END of Operation calls --
			
			-- STM processes
			STM(id__,
						param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__,
						param_v) \ {terminate}
			
			STM_VS_O(id__,
						param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
			Stateful(id__,
						param_v) \ {terminate}
			
			-- Transitions
			Transitions(id__,
						param_v) = ((let
				Trans = (
					((share__ -> SKIP
					 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((true&CALL__movex(
					 			id__,
					 			Vector_x(param_v)
					 		);true&CALL__movey(
					 			id__,
					 			Vector_y(param_v)
					 		);true&CALL__movez(
					 			id__,
					 			Vector_z(param_v)
					 		) ; F1::enter -> SKIP))))
					 ) ; Trans)
					 []
					 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
					 []
					 terminate -> SKIP
				)
			within
				Trans
			)
			)
			
			-- Stateful
			-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
			
			-- Named process definitions
			MachineBody(id__,
						param_v) = 
				dbisim((
				let
					finalNodesEntered = {|F1::entered|}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						I1::enter,
						F1::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_I1|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   I1::D__(id__,
							   			param_v)
							   [| { share__, terminate } |] (
							   F1::D__(id__,
							   			param_v)
							   )
							 )
							 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((I1::enter -> Transitions(id__,
							 			param_v))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour(id__,
						param_v) = 
				dbisim((MachineBody(id__,
							param_v)\ enteredSS)
				)
			
			
			Stateful(id__,
						param_v) = 
				((
					(Behaviour(id__,
								param_v) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
								param_v))
				 	\getsetLocalChannels
				)
				)
			
			
			-- Visible counterparts
			MachineBody_VS_O(id__,
						param_v) = 
				dbisim((
				let
					finalNodesEntered = {|F1::entered|}
				within
					((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						I1::enter,
						F1::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited,interrupt|})
							transSync = {|internal__.NID_I1|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   I1::VS_O__(id__,
							   			param_v)
							   [| { share__, terminate } |] (
							   F1::VS_O__(id__,
							   			param_v)
							   )
							 )
							 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((I1::enter -> Transitions(id__,
							 			param_v))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__,
						param_v) = 
				dbisim((MachineBody_VS_O(id__,
							param_v))
				)
			
			
			Stateful_VS_O(id__,
						param_v) = 
				dbisim((
					(Behaviour_VS_O(id__,
								param_v) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
								param_v))
				 	\getsetLocalChannels
				)
				)
			
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__,
						param_v) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
						param_v) = STM_VS_O(id__,
						param_v)
			
			D__(id__,
						param_v) = STM(id__,
						param_v) \ internal_events
			O__(id__,
						param_v) = sbisim(diamond(D__(id__,
						param_v)))
			VS__(id__,
						param_v) = FVS__(id__,
						param_v)
			VS_O__(id__,
						param_v) = sbisim(diamond(FVS__(id__,
						param_v)))
			HEXT__(id__,
						param_v) = O__(id__,
						param_v) [|shared_variable_events|] SKIP
			HUP__(id__,
						param_v) = O__(id__,
						param_v) [|{share__}|] SKIP
					endmodule
		-- compileOperationDef
		module OP_step
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
			
			-- Transition identifiers
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_I1|
			              NID_F1|
			              NID_j1|
			              NID_j2|
			              NID_j3|
			              NID_Waiting|
			              NID_j4
			
			channel internal__ : NIDS
			
			-- Flow channels		
			channel interrupt
			channel exited
			channel exit
			channel terminate
			
			-- Variable channels
			
			-- Shared variable channels
			
