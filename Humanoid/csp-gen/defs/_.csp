								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i0,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j2,wallDetected__.NID_Walking.in,internal__.NID_j3,internal__.NID_j3,internal__.NID_Turning|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   i0::D__(id__)
								   [| { share__, terminate } |] (
								   j0::D__(id__)
								   [| { share__, terminate } |] (
								   j1::D__(id__)
								   [| { share__, terminate } |] (
								   j2::D__(id__)
								   [| { share__, terminate } |] (
								   j3::D__(id__)
								   [| { share__, terminate } |] (
								   Walking::D__(id__)
								   [| { share__, terminate } |] (
								   Stopped::D__(id__)
								   [| { share__, terminate } |] (
								   Turning::D__(id__)
								   )
								   )
								   )
								   )
								   )
								   )
								   )
								 )
								 [[Walking::interrupt <- x__ | x__ <- {|interrupt,wallDetected__.NID_Walking.in|}]]
								 [[Stopped::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
								 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
								 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
								 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3,internal__.NID_j3|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((i0::enter -> Transitions(id__))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
							[[
								startSiren__.x____ <- startSiren,
								wallDetected__.x____ <- wallDetected,
								stopSiren__.x____ <- stopSiren,
								liftFootLeft__.x____ <- liftFootLeft,
								liftFootRight__.x____ <- liftFootRight,
								stepDoneLeft__.x____ <- stepDoneLeft,
