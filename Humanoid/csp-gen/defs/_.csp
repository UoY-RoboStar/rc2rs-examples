				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				))
			
				HEXT(id__) = O__(id__) [|shared_variable_events|] SKIP			
	
		endmodule
		module ctrl_ref1
			shared_variable_events = {|
			|}
			
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
	
			-- declaring controller events
			channel leanOut: InOut
			channel stepDone: InOut
			channel stepDownOut: InOut
			channel outOfBalance: InOut.Vector
			channel liftFoot: InOut
			channel leanIn: InOut
			channel stepDownIn: InOut
			
			
			
			-- declaring call and ret events for undefined operations
			channel movezCall: core_real
			channel movexCall: core_real
			channel leanforwardCall
			channel moveyCall: core_real
			
			-- declaring controller termination channel
			channel terminate
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	leanOut,
				stepDone,
				stepDownOut,
				outOfBalance,
				liftFoot,
				leanIn,
				stepDownIn
			,	movezCall,
				movexCall,
				leanforwardCall,
				moveyCall
			|}
	
			-- defined operations
			-- compileOperationDef
			module OP_correct
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
				
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I1|
				              NID_F1
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
				
				-- Shared variable channels
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				
				-- Declaring call and ret events for undefined operations
				channel movezCall: core_real
				channel movexCall: core_real
				channel leanforwardCall
				channel moveyCall: core_real
				
				enterSS = {|
				I1::enter,
				F1::enter
				|}
				
				enteredSS = 	{|
				F1::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	movezCall,
					movexCall,
					leanforwardCall,
					moveyCall
					, share__
					|}
				
				-- Nodes --
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: I1
				module I1
				exports
				
					channel enter, interrupt
					
					D__(id__,
								param_v) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
								param_v) = D__(id__,
								param_v)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Final state: F1
				module F1
				
				exports
				
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
					--	Rule: behaviours(Node)
					D__(id__,
								param_v) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
							
							Entering 	= entered -> SKIP ; Active
							Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
							Interrupted	= share__choice(exit -> exited -> Inactive)
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_v) = D__(id__,
								param_v)
				
				endmodule
				----------------------------------------------------------------------
				
				-- END of Nodes --
				
				-- Operation calls --
				-- Only the undefined operations are declared here.
				-- If the state machine is in isolation, all required operations will be undefined.
				-- If it is in the context of a controller, the required operations not provided by the
				-- controller will be declared here, and the defined operations will be defined in the
				-- context of the Controller module, and therefore within scope of the state machine module.
				CALL__movez(id__,
							param_r) 	= movezCall.param_r -> SKIP
				CALL__movex(id__,
							param_r) 	= movexCall.param_r -> SKIP
				CALL__leanforward(id__) 	= leanforwardCall -> SKIP
				CALL__movey(id__,
							param_r) 	= moveyCall.param_r -> SKIP
				
				-- END of Operation calls --
				
				-- STM processes
				STM(id__,
							param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
				Stateful(id__,
							param_v) \ {terminate}
				
				STM_VS_O(id__,
							param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
				Stateful(id__,
							param_v) \ {terminate}
				
				-- Transitions
				Transitions(id__,
							param_v) = ((let
					Trans = (
						((share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((true&CALL__movex(
						 			id__,
						 			Vector_x(param_v)
						 		);true&CALL__movey(
						 			id__,
						 			Vector_y(param_v)
						 		);true&CALL__movez(
						 			id__,
						 			Vector_z(param_v)
						 		) ; F1::enter -> SKIP))))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
				within
					Trans
				)
				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__,
							param_v) = 
					dbisim((
					let
						finalNodesEntered = {|F1::entered|}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I1::enter,
							F1::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I1|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I1::D__(id__,
								   			param_v)
								   [| { share__, terminate } |] (
								   F1::D__(id__,
								   			param_v)
								   )
								 )
								 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((I1::enter -> Transitions(id__,
								 			param_v))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__,
							param_v) = 
					dbisim((MachineBody(id__,
								param_v)\ enteredSS)
					)
				
				
				Stateful(id__,
							param_v) = 
					((
						(Behaviour(id__,
									param_v) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
									param_v))
					 	\getsetLocalChannels
					)
					)
				
				
				-- Visible counterparts
				MachineBody_VS_O(id__,
							param_v) = 
					dbisim((
					let
						finalNodesEntered = {|F1::entered|}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I1::enter,
							F1::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I1|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I1::VS_O__(id__,
								   			param_v)
								   [| { share__, terminate } |] (
								   F1::VS_O__(id__,
								   			param_v)
								   )
								 )
								 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((I1::enter -> Transitions(id__,
								 			param_v))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__,
							param_v) = 
					dbisim((MachineBody_VS_O(id__,
								param_v))
					)
				
				
				Stateful_VS_O(id__,
							param_v) = 
					dbisim((
						(Behaviour_VS_O(id__,
									param_v) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
									param_v))
					 	\getsetLocalChannels
					)
					)
				
				
				-- END
				
				-- Memory
				-- Memory variables
				
				-- varMemory process
				varMemory(id__,
							param_v) = terminate -> SKIP
				
				getsetLocalChannels = {||}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__,
							param_v) = STM_VS_O(id__,
							param_v)
				
				D__(id__,
							param_v) = STM(id__,
							param_v) \ internal_events
				O__(id__,
							param_v) = sbisim(diamond(D__(id__,
							param_v)))
				VS__(id__,
							param_v) = FVS__(id__,
							param_v)
				VS_O__(id__,
							param_v) = sbisim(diamond(FVS__(id__,
							param_v)))
				HEXT__(id__,
							param_v) = O__(id__,
							param_v) [|shared_variable_events|] SKIP
				HUP__(id__,
							param_v) = O__(id__,
							param_v) [|{share__}|] SKIP
						endmodule
			-- compileOperationDef
			module OP_step
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
				
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I1|
				              NID_F1|
				              NID_j1|
				              NID_j2|
				              NID_j3|
				              NID_Waiting|
				              NID_j4
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
				
				-- Shared variable channels
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				channel leanOut__: NIDS.InOut
				channel leanOut: InOut
				channel stepDownIn__: NIDS.InOut
				channel stepDownIn: InOut
				channel stepDone__: NIDS.InOut
				channel stepDone: InOut
				
				-- Declaring call and ret events for undefined operations
				channel movezCall: core_real
				channel movexCall: core_real
				channel leanforwardCall
				channel moveyCall: core_real
				
				enterSS = {|
				I1::enter,
				F1::enter,
				j1::enter,
				j2::enter,
				j3::enter,
				Waiting::enter,
				j4::enter
				|}
				
				enteredSS = 	{|
				F1::entered,
				Waiting::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	leanOut,
					stepDownIn,
					stepDone
				,	movezCall,
					movexCall,
					leanforwardCall,
					moveyCall
					, share__
					|}
				
				-- Nodes --
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: I1
				module I1
				exports
				
					channel enter, interrupt
					
					D__(id__,
								param_d,
							    const_step_c) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
								param_d,
							    const_step_c) = D__(id__,
								param_d,
							    const_step_c)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Final state: F1
				module F1
				
				exports
				
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
					--	Rule: behaviours(Node)
					D__(id__,
								param_d,
							    const_step_c) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
							
							Entering 	= entered -> SKIP ; Active
							Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
							Interrupted	= share__choice(exit -> exited -> Inactive)
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_d,
							    const_step_c) = D__(id__,
								param_d,
							    const_step_c)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Junction: j1
				module j1
				exports
				
					channel enter, interrupt
					
					D__(id__,
								param_d,
							    const_step_c) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_d,
							    const_step_c) = D__(id__,
								param_d,
							    const_step_c)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Junction: j2
				module j2
				exports
				
					channel enter, interrupt
					
					D__(id__,
								param_d,
							    const_step_c) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_d,
							    const_step_c) = D__(id__,
								param_d,
							    const_step_c)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Junction: j3
				module j3
				exports
				
					channel enter, interrupt
					
					D__(id__,
								param_d,
							    const_step_c) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_d,
							    const_step_c) = D__(id__,
								param_d,
							    const_step_c)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Waiting
				module Waiting
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
								param_d,
							    const_step_c) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_d,
							    const_step_c) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Junction: j4
				module j4
				exports
				
					channel enter, interrupt
					
					D__(id__,
								param_d,
							    const_step_c) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_d,
							    const_step_c) = D__(id__,
								param_d,
							    const_step_c)
				
				endmodule
				----------------------------------------------------------------------
				
				-- END of Nodes --
				
				-- Operation calls --
				-- Only the undefined operations are declared here.
				-- If the state machine is in isolation, all required operations will be undefined.
				-- If it is in the context of a controller, the required operations not provided by the
				-- controller will be declared here, and the defined operations will be defined in the
				-- context of the Controller module, and therefore within scope of the state machine module.
				CALL__movez(id__,
						    const_step_c,
							param_r) 	= movezCall.param_r -> SKIP
				CALL__movex(id__,
						    const_step_c,
							param_r) 	= movexCall.param_r -> SKIP
				CALL__leanforward(id__,
						    const_step_c) 	= leanforwardCall -> SKIP
				CALL__movey(id__,
						    const_step_c,
							param_r) 	= moveyCall.param_r -> SKIP
				
				-- END of Operation calls --
				
				-- STM processes
				STM(id__,
							param_d,
						    const_step_c) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
				Stateful(id__,
							param_d,
						    const_step_c) \ {terminate}
				
				STM_VS_O(id__,
							param_d,
						    const_step_c) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
				Stateful(id__,
							param_d,
						    const_step_c) \ {terminate}
				
				-- Transitions
				Transitions(id__,
							param_d,
						    const_step_c) = ((let
					Trans = (
						((share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((pre_sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real))&sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)) != 0&CALL__movex(
						 			id__,
						 		    const_step_c,
						 			Div(Mult(const_step_c, Vector_x(param_d), core_real), sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)), core_real)
						 		) ; j1::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_j1 -> SKIP ;  ((pre_sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real))&sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)) != 0&CALL__movey(
						 			id__,
						 		    const_step_c,
						 			Div((Mult(const_step_c, Vector_y(param_d), core_real)), sqrt(Plus((Mult(Vector_x(param_d), Vector_x(param_d), core_real)), (Mult(Vector_y(param_d), Vector_y(param_d), core_real)), core_real)), core_real)
						 		) ; j2::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_j2 -> SKIP ;  ((true&CALL__movez(
						 			id__,
						 		    const_step_c,
						 			const_step_c
						 		) ; j3::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_j3 -> SKIP ;  ((true&(share__choice(leanOut.out -> SKIP)) ; Waiting::enter -> SKIP))))
						 	 [] dbisim((true)&(stepDownIn__!NID_Waiting.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(stepDone.out -> SKIP)) ; j4::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_j4 -> SKIP ;  ((true&CALL__movez(
						 			id__,
						 		    const_step_c,
						 			Neg(const_step_c, core_real)
						 		) ; F1::enter -> SKIP))))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
				within
					Trans
				)
				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__,
							param_d,
						    const_step_c) = 
					dbisim((
					let
						finalNodesEntered = {|F1::entered|}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I1::enter,
							F1::enter,
							j1::enter,
							j2::enter,
							j3::enter,
							Waiting::enter,
							j4::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I1,internal__.NID_j1,internal__.NID_j2,internal__.NID_j3,stepDownIn__.NID_Waiting.in,internal__.NID_j4|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I1::D__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   F1::D__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j1::D__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j2::D__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j3::D__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Waiting::D__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j4::D__(id__,
								   			param_d,
								   		    const_step_c)
								   )
								   )
								   )
								   )
								   )
								   )
								 )
								 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,stepDownIn__.NID_Waiting.in|}]]
								 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
								 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
								 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
								 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3|}]]
								 [[j4::interrupt <- x__ | x__ <- {|internal__.NID_j4|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((I1::enter -> Transitions(id__,
								 			param_d,
								 		    const_step_c))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
							[[
								leanOut__.x____ <- leanOut,
								stepDownIn__.x____ <- stepDownIn,
								stepDone__.x____ <- stepDone
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__,
							param_d,
						    const_step_c) = 
					dbisim((MachineBody(id__,
								param_d,
							    const_step_c)\ enteredSS)
					)
				
				
				Stateful(id__,
							param_d,
						    const_step_c) = 
					((
						(Behaviour(id__,
									param_d,
								    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
									param_d,
								    const_step_c))
					 	\getsetLocalChannels
					)
					)
				
				
				-- Visible counterparts
				MachineBody_VS_O(id__,
							param_d,
						    const_step_c) = 
					dbisim((
					let
						finalNodesEntered = {|F1::entered|}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I1::enter,
							F1::enter,
							j1::enter,
							j2::enter,
							j3::enter,
							Waiting::enter,
							j4::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I1,internal__.NID_j1,internal__.NID_j2,internal__.NID_j3,stepDownIn__.NID_Waiting.in,internal__.NID_j4|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I1::VS_O__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   F1::VS_O__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j1::VS_O__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j2::VS_O__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j3::VS_O__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Waiting::VS_O__(id__,
								   			param_d,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   j4::VS_O__(id__,
								   			param_d,
								   		    const_step_c)
								   )
								   )
								   )
								   )
								   )
								   )
								 )
								 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[Waiting::interrupt <- x__ | x__ <- {|interrupt,stepDownIn__.NID_Waiting.in|}]]
								 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
								 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
								 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
								 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3|}]]
								 [[j4::interrupt <- x__ | x__ <- {|internal__.NID_j4|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((I1::enter -> Transitions(id__,
								 			param_d,
								 		    const_step_c))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
							[[
								leanOut__.x____ <- leanOut,
								stepDownIn__.x____ <- stepDownIn,
								stepDone__.x____ <- stepDone
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__,
							param_d,
						    const_step_c) = 
					dbisim((MachineBody_VS_O(id__,
								param_d,
							    const_step_c))
					)
				
				
				Stateful_VS_O(id__,
							param_d,
						    const_step_c) = 
					dbisim((
						(Behaviour_VS_O(id__,
									param_d,
								    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
									param_d,
								    const_step_c))
					 	\getsetLocalChannels
					)
					)
				
				
				-- END
				
				-- Memory
				-- Memory variables
				
				-- varMemory process
				varMemory(id__,
							param_d,
						    const_step_c) = terminate -> SKIP
				
				getsetLocalChannels = {||}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__,
							param_d,
						    const_step_c) = STM_VS_O(id__,
							param_d,
						    const_step_c)
				
				D__(id__,
							param_d,
						    const_step_c) = STM(id__,
							param_d,
						    const_step_c) \ internal_events
				O__(id__,
							param_d,
						    const_step_c) = sbisim(diamond(D__(id__,
							param_d,
						    const_step_c)))
				VS__(id__,
							param_d,
						    const_step_c) = FVS__(id__,
							param_d,
						    const_step_c)
				VS_O__(id__,
							param_d,
						    const_step_c) = sbisim(diamond(FVS__(id__,
							param_d,
						    const_step_c)))
				HEXT__(id__,
							param_d,
						    const_step_c) = O__(id__,
							param_d,
						    const_step_c) [|shared_variable_events|] SKIP
				HUP__(id__,
							param_d,
						    const_step_c) = O__(id__,
							param_d,
						    const_step_c) [|{share__}|] SKIP
						endmodule
		
			-- declaring machines
			module stm_ref0
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
			
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I1|
				              NID_Balanced|
				              NID_Moving|
				              NID_Leaning
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
				channel get_v, set_v, setL_v, setR_v: Vector
				channel get_direction, set_direction, setL_direction, setR_direction: Vector
				
				-- Shared variable channels
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				channel leanOut__: NIDS.InOut
				channel leanOut: InOut
				channel stepDone__: NIDS.InOut
				channel stepDone: InOut
				channel stepDownOut__: NIDS.InOut
				channel stepDownOut: InOut
				channel outOfBalance__: NIDS.InOut.Vector
				channel outOfBalance: InOut.Vector
				channel liftFoot__: NIDS.InOut
				channel liftFoot: InOut
				channel leanIn__: NIDS.InOut
				channel leanIn: InOut
				channel stepDownIn__: NIDS.InOut
				channel stepDownIn: InOut
				
				-- Declaring call and ret events for undefined operations
				channel movezCall: core_real
				channel movexCall: core_real
				channel leanforwardCall
				channel moveyCall: core_real
				
				enterSS = {|
				I1::enter,
				Balanced::enter,
				Moving::enter,
				Leaning::enter
				|}
				
				enteredSS = 	{|
				Balanced::entered,
				Moving::entered,
				Leaning::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	leanOut,
					stepDone,
					stepDownOut,
					outOfBalance,
					liftFoot,
					leanIn,
					stepDownIn
				,	movezCall,
					movexCall,
					leanforwardCall,
					moveyCall
					|}
			
				-- Nodes --
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: I1
				module I1
				exports
				
					channel enter, interrupt
					
					D__(id__,
							    const_step_c) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
							    const_step_c) = D__(id__,
							    const_step_c)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Balanced
				module Balanced
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_step_c) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_step_c) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Moving
				module Moving
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_step_c) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(get_direction?direction -> true&CALL__step(
									id__,
									direction, 
									const_step_c
								)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_step_c) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(get_direction?direction -> true&CALL__step(
									id__,
									direction, 
									const_step_c
								)) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: Leaning
				module Leaning
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
							    const_step_c) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&CALL__leanforward(
									id__,
									const_step_c
								) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
							    const_step_c) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= true&CALL__leanforward(
									id__,
									const_step_c
								) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				-- END of Nodes --
				
				-- Operation calls --
				-- Only the undefined operations are declared here.
				-- If the state machine is in isolation, all required operations will be undefined.
				-- If it is in the context of a controller, the required operations not provided by the
				-- controller will be declared here, and the defined operations will be defined in the
				-- context of the Controller module, and therefore within scope of the state machine module.
				CALL__movez(id__,
							param_r,
						    const_step_c) 	= movezCall.param_r -> SKIP
				CALL__movex(id__,
							param_r,
						    const_step_c) 	= movexCall.param_r -> SKIP
				CALL__leanforward(id__,
						    const_step_c) 	= leanforwardCall -> SKIP
				CALL__movey(id__,
							param_r,
						    const_step_c) 	= moveyCall.param_r -> SKIP
				
				CALL__step(id__,
							param_d,
						    const_step_c) = (OP_step::O__(id__,
							param_d,
						    const_step_c))
				[[
					OP_step::leanOut <- leanOut,
					OP_step::stepDownIn <- stepDownIn,
					OP_step::stepDone <- stepDone
				]]
				[[
					OP_step::movezCall <- movezCall,
					OP_step::movexCall <- movexCall,
					OP_step::leanforwardCall <- leanforwardCall,
					OP_step::moveyCall <- moveyCall
				]]
				CALL__correct(id__,
							param_v,
						    const_step_c) = (OP_correct::O__(id__,
							param_v))
				[[
					OP_correct::movezCall <- movezCall,
					OP_correct::movexCall <- movexCall,
					OP_correct::leanforwardCall <- leanforwardCall,
					OP_correct::moveyCall <- moveyCall
				]]
				-- END of Operation calls --
				
				-- STM processes
				STM(id__,
						    const_step_c) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful(id__,
									    const_step_c) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__,
							    const_step_c))
				)\sharedVarHide
				
				STM_VS_O(id__,
						    const_step_c) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
				( 
					(
						(
							(IteratedStateful_VS_O(id__,
									    const_step_c) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__,
							    const_step_c))
				)\sharedVarHide
				
				-- Transitions
				Transitions(id__,
						    const_step_c) = ((let
					Trans = (
						((share__ -> SKIP
						 [] dbisim((true)&(outOfBalance__!NID_Balanced.in?v:{v|v <- Vector, true} -> share__choice(set_v!v -> SKIP) ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; share__choice(get_v?v -> true&CALL__correct(
						 			id__,
						 			v,
						 			const_step_c
						 		)) ; Balanced::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((SKIP ; Balanced::enter -> SKIP))))
						 	 [] dbisim((true)&(liftFoot__!NID_Balanced.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Moving::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_Moving -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Balanced::enter -> SKIP)))
						 	 [] dbisim((true)&(leanIn__!NID_Balanced.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; Leaning::enter -> SKIP)))
						 	 [] dbisim((true)&(internal__!NID_Leaning -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(stepDownOut.out -> SKIP)) ; Balanced::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
				within
					Trans
				)
				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__,
						    const_step_c) = 
					dbisim((
					let
						finalNodesEntered = {||}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I1::enter,
							Balanced::enter,
							Moving::enter,
							Leaning::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|outOfBalance__.NID_Balanced.in,internal__.NID_I1,liftFoot__.NID_Balanced.in,internal__.NID_Moving,leanIn__.NID_Balanced.in,internal__.NID_Leaning|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I1::D__(id__,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Balanced::D__(id__,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Moving::D__(id__,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Leaning::D__(id__,
								   		    const_step_c)
								   )
								   )
								   )
								 )
								 [[Balanced::interrupt <- x__ | x__ <- {|interrupt,outOfBalance__.NID_Balanced.in,liftFoot__.NID_Balanced.in,leanIn__.NID_Balanced.in|}]]
								 [[Moving::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Moving|}]]
								 [[Leaning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Leaning|}]]
								 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								 			,setR_v
								 			|}) |]
								 ((I1::enter -> Transitions(id__,
								 		    const_step_c))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								  [[set_v <- setR_v]]
								 )
								)
								 [[setR_v <- set_v]]
								)
							)
							 \ hideSet)
							[[
								leanOut__.x____ <- leanOut,
								stepDone__.x____ <- stepDone,
								stepDownOut__.x____ <- stepDownOut,
								outOfBalance__.x____ <- outOfBalance,
								liftFoot__.x____ <- liftFoot,
								leanIn__.x____ <- leanIn,
								stepDownIn__.x____ <- stepDownIn
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__,
						    const_step_c) = 
					dbisim((MachineBody(id__,
							    const_step_c)\ enteredSS)
					)
				
				IteratedBehaviour(id__,
						    const_step_c) = 
					dbisim((MachineBody(id__,
							    const_step_c)\ enteredSS)
					)
				
				Stateful(id__,
						    const_step_c) = 
					((
						(Behaviour(id__,
								    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
								    const_step_c))
					 	\getsetLocalChannels
					)
					)
				
				IteratedStateful(id__,
						    const_step_c) =
					(dbisim(
						sbisim(
							dbisim(
								sbisim(
									Behaviour(id__,
											    const_step_c)
									[| {|get_direction,set_direction,terminate|} |]
									Memory_direction((0,0,0))
								)\{|get_direction,set_direction|}
							)
							[| {|get_v,set_v,terminate|} |]
							Memory_v((0,0,0))
						)\{|get_v,set_v|}
					)
					)
				
				-- Visible counterparts
				MachineBody_VS_O(id__,
						    const_step_c) = 
					dbisim((
					let
						finalNodesEntered = {||}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I1::enter,
							Balanced::enter,
							Moving::enter,
							Leaning::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|outOfBalance__.NID_Balanced.in,internal__.NID_I1,liftFoot__.NID_Balanced.in,internal__.NID_Moving,leanIn__.NID_Balanced.in,internal__.NID_Leaning|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I1::VS_O__(id__,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Balanced::VS_O__(id__,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Moving::VS_O__(id__,
								   		    const_step_c)
								   [| { share__, terminate } |] (
								   Leaning::VS_O__(id__,
								   		    const_step_c)
								   )
								   )
								   )
								 )
								 [[Balanced::interrupt <- x__ | x__ <- {|interrupt,outOfBalance__.NID_Balanced.in,liftFoot__.NID_Balanced.in,leanIn__.NID_Balanced.in|}]]
								 [[Moving::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Moving|}]]
								 [[Leaning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Leaning|}]]
								 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__,setR_v |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								 			,setR_v
								 			|}) |]
								 ((I1::enter -> Transitions(id__,
								 		    const_step_c))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								  [[set_v <- setR_v]]
								 )
								)
								 [[setR_v <- set_v]]
								)
							)
							 \ hideSet)
							[[
								leanOut__.x____ <- leanOut,
								stepDone__.x____ <- stepDone,
								stepDownOut__.x____ <- stepDownOut,
								outOfBalance__.x____ <- outOfBalance,
								liftFoot__.x____ <- liftFoot,
								leanIn__.x____ <- leanIn,
								stepDownIn__.x____ <- stepDownIn
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__,
						    const_step_c) = 
					dbisim((MachineBody_VS_O(id__,
							    const_step_c))
					)
				
				IteratedBehaviour_VS_O(id__,
						    const_step_c) = 
					dbisim((MachineBody_VS_O(id__,
							    const_step_c))
					)
				
				Stateful_VS_O(id__,
						    const_step_c) = 
					dbisim((
						(Behaviour_VS_O(id__,
								    const_step_c) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
								    const_step_c))
					 	\getsetLocalChannels
					)
					)
				
				IteratedStateful_VS_O(id__,
						    const_step_c) =
					(dbisim(
						sbisim(
							dbisim(
								sbisim(
									Behaviour_VS_O(id__,
											    const_step_c)
									[| {|get_direction,set_direction,terminate|} |]
									Memory_direction((0,0,0))
								)\{|get_direction,set_direction|}
							)
							[| {|get_v,set_v,terminate|} |]
							Memory_v((0,0,0))
						)\{|get_v,set_v|}
					)
					)
				
				-- END
				
				-- Memory
				-- Memory variables
				Memory_v(v) =
					get_v!v -> Memory_v(v)
					[]
					set_v?x__ -> Memory_v(x__)
					[]
					terminate -> SKIP
				Memory_direction(direction) =
					get_direction!direction -> Memory_direction(direction)
					[]
					set_direction?x__ -> Memory_direction(x__)
					[]
					terminate -> SKIP
				
				-- varMemory process
				varMemory(id__,
						    const_step_c) = Memory_v((0,0,0))
				[| { terminate } |] (
				Memory_direction((0,0,0))
				)
				
				getsetLocalChannels = {|get_v,set_v,get_direction,set_direction|}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__,
						    const_step_c) = STM_VS_O(id__,
						    const_step_c)
				
				D__(id__,
						    const_step_c) = STM(id__,
						    const_step_c) \ internal_events
				O__(id__,
						    const_step_c) = sbisim(diamond(D__(id__,
						    const_step_c)))
				VS__(id__,
						    const_step_c) = FVS__(id__,
						    const_step_c)
				VS_O__(id__,
						    const_step_c) = sbisim(diamond(FVS__(id__,
						    const_step_c)))
				HEXT__(id__,
						    const_step_c) = O__(id__,
						    const_step_c) [|shared_variable_events|] SKIP
				HUP__(id__,
						    const_step_c) = O__(id__,
						    const_step_c) [|{share__}|] SKIP
				
				-- Shared memory
				-- Shared memory variables
				
				-- sharedVarMemory process
				sharedVarMemory(id__,
						    const_step_c) = terminate -> SKIP
				
				sharedVarSync = {||}
				
				sharedVarHide = {||}
			endmodule
			
				-- undefined operations
				CALL__movez(id__,
						    param_r) 	= movezCall.param_r -> SKIP
				CALL__movex(id__,
						    param_r) 	= movexCall.param_r -> SKIP
				CALL__leanforward(id__) 	= leanforwardCall -> SKIP
				CALL__movey(id__,
						    param_r) 	= moveyCall.param_r -> SKIP
				
				-- declaring controller memory
				Memory(id__) = SKIP
				
				D__(id__,
						   	const_Foot_op_ref1_c) = 	((
