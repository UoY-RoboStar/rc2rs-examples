				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
			
				-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
				O__(id__,
						   	const_Foot_op_ref1_c) = sbisim(diamond(	((
						let
							const_step_c = const_Foot_op_ref1_c
						within 
						stm_ref0::O__(id__,
								    const_step_c)[[
							stm_ref0::terminate <- terminate,
