				-- Shared memory variables
				
				-- sharedVarMemory process
				sharedVarMemory(id__) = terminate -> SKIP
				
				sharedVarSync = {||}
				
				sharedVarHide = {||}
			endmodule
			
				-- undefined operations
				CALL__turn(id__) 	= turnCall -> SKIP
				CALL__Walk(id__) 	= WalkCall -> SKIP
				
				-- declaring controller memory
				Memory(id__) = SKIP
				
				D__(id__) = 	((
						HeadS::D__(id__)[[
							HeadS::terminate <- terminate,
							HeadS::startSiren <- startSiren,
							HeadS::stopSiren <- stopSiren,
							HeadS::wallDetected <- wallDetected,
							HeadS::liftFootLeft <- liftFootLeft,
							HeadS::liftFootRight <- liftFootRight,
							HeadS::stepDoneLeft <- stepDoneLeft,
							HeadS::stepDoneRight <- stepDoneRight,
							HeadS::turnCall <- turnCall,
							HeadS::WalkCall <- WalkCall
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				
				-- VS version
				VS__(id__) = 	((
						HeadS::VS__(id__)[[
							HeadS::terminate <- terminate,
							HeadS::startSiren <- startSiren,
							HeadS::stopSiren <- stopSiren,
							HeadS::wallDetected <- wallDetected,
							HeadS::liftFootLeft <- liftFootLeft,
							HeadS::liftFootRight <- liftFootRight,
							HeadS::stepDoneLeft <- stepDoneLeft,
							HeadS::stepDoneRight <- stepDoneRight,
							HeadS::turnCall <- turnCall,
							HeadS::WalkCall <- WalkCall
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
			
				-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
				O__(id__) = sbisim(diamond(	((
						HeadS::O__(id__)[[
							HeadS::terminate <- terminate,
							HeadS::startSiren <- startSiren,
							HeadS::stopSiren <- stopSiren,
							HeadS::wallDetected <- wallDetected,
							HeadS::liftFootLeft <- liftFootLeft,
							HeadS::liftFootRight <- liftFootRight,
							HeadS::stepDoneLeft <- stepDoneLeft,
							HeadS::stepDoneRight <- stepDoneRight,
							HeadS::turnCall <- turnCall,
							HeadS::WalkCall <- WalkCall
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					dbisim(Memory(id__))
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				))
								
				-- VS_O version
				VS_O__(id__) = sbisim(diamond(	((
						HeadS::VS_O__(id__)[[
							HeadS::terminate <- terminate,
							HeadS::startSiren <- startSiren,
							HeadS::stopSiren <- stopSiren,
							HeadS::wallDetected <- wallDetected,
							HeadS::liftFootLeft <- liftFootLeft,
							HeadS::liftFootRight <- liftFootRight,
							HeadS::stepDoneLeft <- stepDoneLeft,
							HeadS::stepDoneRight <- stepDoneRight,
							HeadS::turnCall <- turnCall,
