							stateClockSync = {||}
						}
					
					endmodule
					----------------------------------------------------------------------
					
					-- END of Nodes --
					
					Timed(OneStep) {
					-- Operation calls --
					-- Only the undefined operations are declared here.
					-- If the state machine is in isolation, all required operations will be undefined.
					-- If it is in the context of a controller, the required operations not provided by the
					-- controller will be declared here, and the defined operations will be defined in the
					-- context of the Controller module, and therefore within scope of the state machine module.
					CALL__turn(id__) = EDeadline(turnCall,0)
					
					CALL__Walk(id__) = (OP_Walk::O__(id__))
					[[
						OP_Walk::liftFootLeft <- liftFootLeft,
						OP_Walk::liftFootRight <- liftFootRight,
						OP_Walk::stepDoneLeft <- stepDoneLeft,
						OP_Walk::stepDoneRight <- stepDoneRight
					]]
					-- END of Operation calls --
				
					-- STM processes
					STM(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
					( 
						(
							(
								(IteratedStateful(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {||} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__))
					)\sharedVarHide
					
					STM_VS_O(id__) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
					( 
						(
							(
								(IteratedStateful_VS_O(id__) \ {terminate} ; share__choice(terminate -> SKIP))
							 	[[ share__ <- x__ | x__ <- {||} ]]
							)
						[| {share__} |]
						SKIP
						)
						[| union(sharedVarSync,{terminate}) |]
						dbisim(sharedVarMemory(id__))
					)\sharedVarHide
					
					-- Transitions
					Transitions(id__) = ((let
						Trans = TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((SKIP ; j0::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_j0 -> SKIP ;  ((true&(share__choice(startSiren.out -> SKIP)) ; j1::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_j0 -> SKIP ;  ((SKIP ; j2::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_j1 -> SKIP ;  ((SKIP ; Walking::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_j2 -> SKIP ;  ((SKIP ; Walking::enter -> SKIP))))
							 [] dbisim((true)&(wallDetected__!NID_Walking.in -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j3::enter -> SKIP)))
							 [] dbisim((true)&(internal__!NID_j3 -> SKIP ;  ((true&(share__choice(stopSiren.out -> SKIP)) ; Stopped::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_j3 -> SKIP ;  ((SKIP ; Turning::enter -> SKIP))))
							 [] dbisim((true)&(internal__!NID_Turning -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; j0::enter -> SKIP)))
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
							 )
						,SKIP);Trans
					within
						Trans [|{terminate}|> SKIP
					)
					)
					
					-- Stateful
					-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
					
					-- Named process definitions
					MachineBody(id__) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								i0::enter,
								j0::enter,
								j1::enter,
								j2::enter,
								j3::enter,
								Walking::enter,
								Stopped::enter,
								Turning::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_i0,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j2,wallDetected__.NID_Walking.in,internal__.NID_j3,internal__.NID_j3,internal__.NID_Turning|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   i0::D__(id__)
									   [| { share__, terminate } |] (
									   j0::D__(id__)
									   [| { share__, terminate } |] (
									   j1::D__(id__)
									   [| { share__, terminate } |] (
									   j2::D__(id__)
									   [| { share__, terminate } |] (
									   j3::D__(id__)
									   [| { share__, terminate } |] (
									   Walking::D__(id__)
									   [| { share__, terminate } |] (
									   Stopped::D__(id__)
									   [| { share__, terminate } |] (
									   Turning::D__(id__)
									   )
									   )
									   )
									   )
									   )
									   )
									   )
									 )
									 [[Walking::interrupt <- x__ | x__ <- {|interrupt,wallDetected__.NID_Walking.in|}]]
									 [[Stopped::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
									 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
									 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
									 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3,internal__.NID_j3|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 )
									)
									)
								)
								 \ hideSet)
								[[
									startSiren__.x____ <- startSiren,
									wallDetected__.x____ <- wallDetected,
									stopSiren__.x____ <- stopSiren,
									liftFootLeft__.x____ <- liftFootLeft,
									liftFootRight__.x____ <- liftFootRight,
									stepDoneLeft__.x____ <- stepDoneLeft,
									stepDoneRight__.x____ <- stepDoneRight
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Stopped,Stopped::entered,get_CLID_Turning,Turning::entered,get_CLID_Walking,Walking::entered|}
						 within
							(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
						)
						)
					
					IteratedBehaviour(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Stopped,Stopped::entered,get_CLID_Turning,Turning::entered,get_CLID_Walking,Walking::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody(id__)
													[| {|get_CLID_Walking,Walking::entered,terminate|} |]
													dbisim(Clock_CLID_Walking(id__,0))
												)\{|get_CLID_Walking|}
											)
											[| {|get_CLID_Turning,Turning::entered,terminate|} |]
											dbisim(Clock_CLID_Turning(id__,0))
										)\{|get_CLID_Turning|}
									)
									[| {|get_CLID_Stopped,Stopped::entered,terminate|} |]
									dbisim(Clock_CLID_Stopped(id__,0))
								)\{|get_CLID_Stopped|}
							)
							) \ union(stateClockSync,enteredSS)
						)
						)
					
					Stateful(id__) = 
						((let
							getsetLocalChannels = {||}
							clockSync = {||}
						within
							(Behaviour(id__) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful(id__) =
						(IteratedBehaviour(id__))
					
					-- Visible counterparts
					MachineBody_VS_O(id__) = 
						dbisim((
						let
							finalNodesEntered = {||}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								i0::enter,
								j0::enter,
								j1::enter,
								j2::enter,
								j3::enter,
								Walking::enter,
								Stopped::enter,
								Turning::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_i0,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j2,wallDetected__.NID_Walking.in,internal__.NID_j3,internal__.NID_j3,internal__.NID_Turning|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   i0::VS_O__(id__)
									   [| { share__, terminate } |] (
									   j0::VS_O__(id__)
									   [| { share__, terminate } |] (
									   j1::VS_O__(id__)
									   [| { share__, terminate } |] (
									   j2::VS_O__(id__)
									   [| { share__, terminate } |] (
									   j3::VS_O__(id__)
									   [| { share__, terminate } |] (
									   Walking::VS_O__(id__)
									   [| { share__, terminate } |] (
									   Stopped::VS_O__(id__)
									   [| { share__, terminate } |] (
									   Turning::VS_O__(id__)
									   )
									   )
									   )
									   )
									   )
									   )
									   )
									 )
									 [[Walking::interrupt <- x__ | x__ <- {|interrupt,wallDetected__.NID_Walking.in|}]]
									 [[Stopped::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[Turning::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Turning|}]]
									 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
									 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
									 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
									 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
									 [[j3::interrupt <- x__ | x__ <- {|internal__.NID_j3,internal__.NID_j3|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									|}) |]
									 ((i0::enter -> Transitions(id__))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 )
									)
									)
								)
								 \ hideSet)
								[[
									startSiren__.x____ <- startSiren,
									wallDetected__.x____ <- wallDetected,
									stopSiren__.x____ <- stopSiren,
									liftFootLeft__.x____ <- liftFootLeft,
									liftFootRight__.x____ <- liftFootRight,
									stepDoneLeft__.x____ <- stepDoneLeft,
									stepDoneRight__.x____ <- stepDoneRight
									| x____ <- NIDS
								]]
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Stopped,Stopped::entered,get_CLID_Turning,Turning::entered,get_CLID_Walking,Walking::entered|}
						 within
							(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					IteratedBehaviour_VS_O(id__) = 
						dbisim((let
							stateClockSync = {|get_CLID_Stopped,Stopped::entered,get_CLID_Turning,Turning::entered,get_CLID_Walking,Walking::entered|}
						 within
							(dbisim(
								sbisim(
									dbisim(
										sbisim(
											dbisim(
												sbisim(
													MachineBody_VS_O(id__)
													[| {|get_CLID_Walking,Walking::entered,terminate|} |]
													dbisim(Clock_CLID_Walking(id__,0))
												)\{|get_CLID_Walking|}
											)
											[| {|get_CLID_Turning,Turning::entered,terminate|} |]
											dbisim(Clock_CLID_Turning(id__,0))
										)\{|get_CLID_Turning|}
									)
									[| {|get_CLID_Stopped,Stopped::entered,terminate|} |]
									dbisim(Clock_CLID_Stopped(id__,0))
								)\{|get_CLID_Stopped|}
							)
							) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					Stateful_VS_O(id__) = 
						dbisim((let
							getsetLocalChannels = {||}
							clockSync = {||}
						within
							(Behaviour_VS_O(id__) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					IteratedStateful_VS_O(id__) =
						(IteratedBehaviour_VS_O(id__))
					
					-- END
					
					-- Memory
					-- Memory variables
					
					-- varMemory process
					varMemory(id__) = terminate -> SKIP
					
					getsetLocalChannels = {||}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__) = STM_VS_O(id__) \ localClockResets
					D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
					O__(id__) = dbisim(D__(id__))
					VS__(id__) = FVS__(id__)
					VS_O__(id__) = dbisim(FVS__(id__))
					HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
					FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
					HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
					
					-- Clocks
					
					Clocks(id__) = terminate -> SKIP
					
					clockSync = {||}
					
					Clock_CLID_Stopped(id__,x__) = 
						TimeOut_1(
							Stopped::entered -> Clock_CLID_Stopped(id__,0)
							[]
							get_CLID_Stopped!x__ -> Clock_CLID_Stopped(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_Stopped(id__,clock_type_plus(x__,1,CLID_Stopped_clock_type(id__))))
					Clock_CLID_Turning(id__,x__) = 
						TimeOut_1(
							Turning::entered -> Clock_CLID_Turning(id__,0)
							[]
							get_CLID_Turning!x__ -> Clock_CLID_Turning(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_Turning(id__,clock_type_plus(x__,1,CLID_Turning_clock_type(id__))))
					Clock_CLID_Walking(id__,x__) = 
						TimeOut_1(
							Walking::entered -> Clock_CLID_Walking(id__,0)
							[]
							get_CLID_Walking!x__ -> Clock_CLID_Walking(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_Walking(id__,clock_type_plus(x__,1,CLID_Walking_clock_type(id__))))
					
					StateClocks(id__) = dbisim(Clock_CLID_Stopped(id__,0))
					[| { terminate } |] (
					dbisim(Clock_CLID_Turning(id__,0))
					[| { terminate } |] (
					dbisim(Clock_CLID_Walking(id__,0))
					)
					)
					
					stateClockSync = {|get_CLID_Stopped,Stopped::entered,get_CLID_Turning,Turning::entered,get_CLID_Walking,Walking::entered|}
					
					-- Shared memory
					-- Shared memory variables
					
					-- sharedVarMemory process
					sharedVarMemory(id__) = terminate -> SKIP
					
					sharedVarSync = {||}
					
					sharedVarHide = {||}
					}
			endmodule
			
			Timed(OneStep) {
					-- undefined operations
					CALL__turn(id__) 	= turnCall -> SKIP
					CALL__Walk(id__) 	= WalkCall -> SKIP
					
					-- declaring controller memory
					Memory(id__) = SKIP
					
					D__(id__) = prioritise(	((
							HeadS::D__(id__)[[
								HeadS::terminate <- terminate,
								HeadS::startSiren <- startSiren,
								HeadS::stopSiren <- stopSiren,
								HeadS::wallDetected <- wallDetected,
								HeadS::liftFootLeft <- liftFootLeft,
								HeadS::liftFootRight <- liftFootRight,
								HeadS::stepDoneLeft <- stepDoneLeft,
								HeadS::stepDoneRight <- stepDoneRight,
								HeadS::turnCall <- turnCall,
								HeadS::WalkCall <- WalkCall
							]]
						)
							[|
								union(
									{|
									|},
									{|
									|}
								)
							|]
						Memory(id__)
					)
					\ union(
						{|
						|},
						{|
						|}
					)
					[|{|terminate|}|>SKIP
					,<visibleMemoryEvents,{tock}>)
					
					-- VS version
					VS__(id__) = prioritise(	((
							HeadS::VS__(id__)[[
								HeadS::terminate <- terminate,
								HeadS::startSiren <- startSiren,
								HeadS::stopSiren <- stopSiren,
								HeadS::wallDetected <- wallDetected,
								HeadS::liftFootLeft <- liftFootLeft,
								HeadS::liftFootRight <- liftFootRight,
								HeadS::stepDoneLeft <- stepDoneLeft,
								HeadS::stepDoneRight <- stepDoneRight,
								HeadS::turnCall <- turnCall,
								HeadS::WalkCall <- WalkCall
							]]
						)
							[|
								union(
									{|
									|},
									{|
									|}
								)
							|]
						Memory(id__)
					)
					\ union(
						{|
						|},
						{|
						|}
					)
					[|{|terminate|}|>SKIP
					,<visibleMemoryEvents,{tock}>)
				
					-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
					O__(id__) = dbisim(prioritise(	((
							HeadS::O__(id__)[[
								HeadS::terminate <- terminate,
								HeadS::startSiren <- startSiren,
								HeadS::stopSiren <- stopSiren,
								HeadS::wallDetected <- wallDetected,
								HeadS::liftFootLeft <- liftFootLeft,
								HeadS::liftFootRight <- liftFootRight,
								HeadS::stepDoneLeft <- stepDoneLeft,
								HeadS::stepDoneRight <- stepDoneRight,
								HeadS::turnCall <- turnCall,
								HeadS::WalkCall <- WalkCall
							]]
						)
							[|
								union(
									{|
									|},
									{|
									|}
								)
							|]
						dbisim(Memory(id__))
					)
					\ union(
						{|
						|},
						{|
						|}
					)
					[|{|terminate|}|>SKIP
					,<visibleMemoryEvents,{tock}>))
									
					-- VS_O version
					VS_O__(id__) = dbisim(prioritise(	((
							HeadS::VS_O__(id__)[[
								HeadS::terminate <- terminate,
								HeadS::startSiren <- startSiren,
								HeadS::stopSiren <- stopSiren,
								HeadS::wallDetected <- wallDetected,
								HeadS::liftFootLeft <- liftFootLeft,
								HeadS::liftFootRight <- liftFootRight,
								HeadS::stepDoneLeft <- stepDoneLeft,
								HeadS::stepDoneRight <- stepDoneRight,
								HeadS::turnCall <- turnCall,
								HeadS::WalkCall <- WalkCall
							]]
						)
							[|
								union(
									{|
									|},
									{|
									|}
								)
							|]
						dbisim(Memory(id__))
					)
					\ union(
						{|
						|},
						{|
						|}
					)
					[|{|terminate|}|>SKIP
					,<visibleMemoryEvents,{tock}>))
				
					HEXT(id__) = O__(id__) [|shared_variable_events|] SKIP			
			}
	
		endmodule
		module ctrl_ref1
			shared_variable_events = {|
			|}
			
		exports
			transparent diamond
			transparent sbisim
			transparent dbisim
			transparent chase
	
			-- declaring controller events
			channel leanOut: InOut
			channel stepDone: InOut
			channel stepDownOut: InOut
			channel outOfBalance: InOut.Vector
			channel liftFoot: InOut
			channel leanIn: InOut
			channel stepDownIn: InOut
			
			
			
			-- declaring call and ret events for undefined operations
			channel movezCall: core_real
			channel movexCall: core_real
			channel leanforwardCall
			channel moveyCall: core_real
			
			-- declaring controller termination channel
			channel terminate
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	leanOut,
				stepDone,
				stepDownOut,
				outOfBalance,
				liftFoot,
				leanIn,
				stepDownIn
			,	movezCall,
				movexCall,
				leanforwardCall,
				moveyCall
			|}
			
			-- set of visible memory events
			visibleMemoryEvents = {||}
	
			-- defined operations
			-- compileOperationDef
			module OP_correct
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
				
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I1|
				              NID_F1
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
				
				-- Shared variable channels
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				
				-- Declaring call and ret events for undefined operations
				channel movezCall: core_real
				channel movexCall: core_real
				channel leanforwardCall
				channel moveyCall: core_real
				
				enterSS = {|
				I1::enter,
				F1::enter
				|}
				
				enteredSS = 	{|
				F1::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	movezCall,
					movexCall,
					leanforwardCall,
					moveyCall
					, share__
					|}
				
				channel clockReset, clockResetL, clockResetR 
				
				localClockResets = {||}
				
				
				channel get_CLID_F1 : core_clock_type 
				--channel increment__
				
				CLID_F1_clock_type(id__) = 
					let
						max = (clock_type_max(Union({
				}))+1)
					ctype = {0..max}
				within
					if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
				
				
				
					-- Nodes --
					-- declaring all nodes
					
					----------------------------------------------------------------------
					-- Initial: I1
					module I1
					exports
					
						channel enter, interrupt
						
						Timed(OneStep) {
							D__(id__,
										param_v) = 
								dbisim(let
									Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
									
									Termination = terminate -> SKIP
									
									Active 		= share__choice(interrupt -> SKIP) ; Inactive
								within
									Inactive [| {terminate} |> SKIP)
							
							VS_O__(id__,
										param_v) = D__(id__,
										param_v)
						}
					
					endmodule
					----------------------------------------------------------------------
					
					
					----------------------------------------------------------------------
					-- Final state: F1
					module F1
					
					exports
					
						channel enter, entered, interrupt
						channel enteredL, enteredR
						
						Timed(OneStep) {
							--	Rule: behaviours(Node)
							D__(id__,
										param_v) = 
								dbisim(let
									Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
									
									Entering 	= entered -> SKIP ; Active
									Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
									Interrupted	= share__choice(exit -> exited -> Inactive)
								within
									Inactive [| {terminate} |> SKIP)
								
							VS_O__(id__,
										param_v) = D__(id__,
										param_v)
						}
					
					endmodule
					----------------------------------------------------------------------
					
					-- END of Nodes --
					
					Timed(OneStep) {
					-- Operation calls --
					-- Only the undefined operations are declared here.
					-- If the state machine is in isolation, all required operations will be undefined.
					-- If it is in the context of a controller, the required operations not provided by the
					-- controller will be declared here, and the defined operations will be defined in the
					-- context of the Controller module, and therefore within scope of the state machine module.
					CALL__movez(id__,
								param_r) = EDeadline(movezCall.param_r,0)
					CALL__movex(id__,
								param_r) = EDeadline(movexCall.param_r,0)
					CALL__leanforward(id__) = EDeadline(leanforwardCall,0)
					CALL__movey(id__,
								param_r) = EDeadline(moveyCall.param_r,0)
					
					-- END of Operation calls --
				
					-- STM processes
					STM(id__,
								param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
					Stateful(id__,
								param_v) \ {terminate}
					
					STM_VS_O(id__,
								param_v) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
					Stateful(id__,
								param_v) \ {terminate}
					
					-- Transitions
					Transitions(id__,
								param_v) = ((let
						Trans = TimeOut_1(
							 (share__ -> SKIP
							 [] dbisim((true)&(internal__!NID_I1 -> SKIP ;  ((true&CALL__movex(
							 			id__,
							 			Vector_x(param_v)
							 		);true&CALL__movey(
							 			id__,
							 			Vector_y(param_v)
							 		);true&CALL__movez(
							 			id__,
							 			Vector_z(param_v)
							 		) ; F1::enter -> SKIP))))
							 []
							 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
							 []
							 terminate -> SKIP
							 )
						,SKIP);Trans
					within
						Trans [|{terminate}|> SKIP
					)
					)
					
					-- Stateful
					-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
					
					-- Named process definitions
					MachineBody(id__,
								param_v) = 
						dbisim((
						let
							finalNodesEntered = {|F1::entered|}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								I1::enter,
								F1::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_I1|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   I1::D__(id__,
									   			param_v)
									   [| { share__, terminate } |] (
									   F1::D__(id__,
									   			param_v)
									   )
									 )
									 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									|}) |]
									 ((I1::enter -> Transitions(id__,
									 			param_v))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 )
									)
									)
								)
								 \ hideSet)
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour(id__,
								param_v) = 
						dbisim((let
							stateClockSync = {||}
						 within
							(MachineBody(id__,
										param_v) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
						)
						)
					
					
					Stateful(id__,
								param_v) = 
						((let
							getsetLocalChannels = {||}
							clockSync = {||}
						within
							(Behaviour(id__,
										param_v) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__,
							 			param_v) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					
					-- Visible counterparts
					MachineBody_VS_O(id__,
								param_v) = 
						dbisim((
						let
							finalNodesEntered = {|F1::entered|}
						within
							(dbisim((dbisim((let
								-- IMPLEMENTATION NOTE:
								-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
								-- modules for defining the semantics of each node.
								enterSS = {|
								I1::enter,
								F1::enter
								|}
								hideSet = union(enterSS,{|exit,exited,internal__|})
							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_I1|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   I1::VS_O__(id__,
									   			param_v)
									   [| { share__, terminate } |] (
									   F1::VS_O__(id__,
									   			param_v)
									   )
									 )
									 [[F1::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[I1::interrupt <- x__ | x__ <- {|internal__.NID_I1|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									|}) |]
									 ((I1::enter -> Transitions(id__,
									 			param_v))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 )
									)
									)
								)
								 \ hideSet)
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__,
								param_v) = 
						dbisim((let
							stateClockSync = {||}
						 within
							(MachineBody_VS_O(id__,
										param_v) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					
					Stateful_VS_O(id__,
								param_v) = 
						dbisim((let
							getsetLocalChannels = {||}
							clockSync = {||}
						within
							(Behaviour_VS_O(id__,
										param_v) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__,
							 			param_v) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					
					-- END
					
					-- Memory
					-- Memory variables
					
					-- varMemory process
					varMemory(id__,
								param_v) = terminate -> SKIP
					
					getsetLocalChannels = {||}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__,
								param_v) = STM_VS_O(id__,
								param_v) \ localClockResets
					D__(id__,
								param_v) = timed_priority(STM(id__,
								param_v) \ union(internal_events,localClockResets))
					O__(id__,
								param_v) = dbisim(D__(id__,
								param_v))
					VS__(id__,
								param_v) = FVS__(id__,
								param_v)
					VS_O__(id__,
								param_v) = dbisim(FVS__(id__,
								param_v))
					HEXT__(id__,
								param_v) = O__(id__,
								param_v) [|shared_variable_events|] SKIP
					FVS_C__(id__,
								param_v) = dbisim(timed_priority(STM(id__,
								param_v) \ internal_events))
					HUP__(id__,
								param_v) = timed_priority(O__(id__,
								param_v) [|{share__}|] SKIP)
					
					-- Clocks
					
					Clocks(id__) = terminate -> SKIP
					
					clockSync = {||}
					
					
					StateClocks(id__) = terminate -> SKIP
					
					stateClockSync = {||}
					}
						endmodule
			-- compileOperationDef
			module OP_step
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
				
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I1|
