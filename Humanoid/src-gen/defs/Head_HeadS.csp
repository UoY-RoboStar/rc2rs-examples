channel Head_HeadS_internal__: Head_HeadS_TIDS

ShowEvents_Head_HeadS(P,E) = P[[ Head_HeadS_entered.x.y <- Head_HeadS_enteredV.y | Head_HeadS_entered.x.y <- E]]
							 [[	Head_HeadS_enter.x.y <- Head_HeadS_enterV.y | Head_HeadS_enter.x.y <- E]]
							 [[ Head_HeadS_exit.x.y <- Head_HeadS_exitV.y | Head_HeadS_exit.x.y <- E]]
							 [[ Head_HeadS_exited.x.y <- Head_HeadS_exitedV.y | Head_HeadS_exited.x.y <- E ]]

channel Head_HeadS_enteredV, Head_HeadS_enterV, Head_HeadS_exitV, Head_HeadS_exitedV : Head_HeadS_SIDS
channel Head_HeadS_enter, Head_HeadS_entered: Head_HeadS_SIDS.Head_HeadS_SIDS
channel Head_HeadS_exit,Head_HeadS_exited: Head_HeadS_SIDS.Head_HeadS_SIDS


-- declaring identifiers of state and final states
Head_HeadS_SIDS = {
	"Head_HeadS",
	"Head_HeadS_Walking",
	"Head_HeadS_Stopped",
	"Head_HeadS_Turning"
}

-- declaring identifiers of transitions
Head_HeadS_TIDS = {
	"__NULLTRANSITION__",
	"Head_HeadS_t5",
	"Head_HeadS_t8"
}

-- declaring state machine events
channel Head_HeadS_startSiren__:Head_HeadS_TIDS
channel Head_HeadS_startSiren
channel Head_HeadS_wallDetected__:Head_HeadS_TIDS
channel Head_HeadS_wallDetected
channel Head_HeadS_stopSiren__:Head_HeadS_TIDS
channel Head_HeadS_stopSiren

channel Head_HeadS_terminate

-- declaring all states
CS_Head_HeadS_Walking_sync = {|
	Head_HeadS_enter.y.x, 
	Head_HeadS_entered.y.x, 
	Head_HeadS_exit.y.x, 
	Head_HeadS_exited.y.x,
	Head_HeadS_enter.x.y, 
	Head_HeadS_entered.x.y, 
	Head_HeadS_exit.x.y, 
	Head_HeadS_exited.x.y |
	x <- {"Head_HeadS_Walking","Head_HeadS_Stopped","Head_HeadS_Turning"},
	y <- {"Head_HeadS_Walking"}
|}



Head_HeadS_Walking_triggers = {|
	Head_HeadS_wallDetected__."Head_HeadS_t5"
|}
		   
S_Head_HeadS_Walking = let
	T_Head_HeadS_t5	= Head_HeadS_wallDetected__!"Head_HeadS_t5" ->  ((
					(Head_HeadS_stopSiren -> SKIP;Head_HeadS_enter!"Head_HeadS_Walking"!"Head_HeadS_Stopped" -> Head_HeadS_entered!"Head_HeadS_Walking"!"Head_HeadS_Stopped" ->
					S_Head_HeadS_Walking
					)[]
					(Head_HeadS_enter!"Head_HeadS_Walking"!"Head_HeadS_Turning" -> Head_HeadS_entered!"Head_HeadS_Walking"!"Head_HeadS_Turning" ->
					S_Head_HeadS_Walking
					)
					))
	

	S_Head_HeadS_Walking_execute(o__) = 
	SKIP; 
	Head_HeadS_entered!o__!"Head_HeadS_Walking" ->
	   (Walk
	   										; STOP /\ (
	   											    T_Head_HeadS_t5
	   											    []
	   											    Head_HeadS_internal__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t5"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Walking"})!"Head_HeadS_Walking" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Walking" -> SKIP);
	   											      	S_Head_HeadS_Walking
	   											    [] Head_HeadS_startSiren__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t5"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Walking"})!"Head_HeadS_Walking" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Walking" -> SKIP);
	   											      	S_Head_HeadS_Walking
	   											    [] Head_HeadS_wallDetected__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t5"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Walking"})!"Head_HeadS_Walking" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Walking" -> SKIP);
	   											      	S_Head_HeadS_Walking
	   											    [] Head_HeadS_stopSiren__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t5"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Walking"})!"Head_HeadS_Walking" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Walking" -> SKIP);
	   											      	S_Head_HeadS_Walking
	   											    )
	   										)
within
Head_HeadS_enter?x:diff(Head_HeadS_SIDS,{"Head_HeadS_Walking"})!"Head_HeadS_Walking" -> ( 
	S_Head_HeadS_Walking_execute(x)) 
CS_Head_HeadS_Stopped_sync = {|
	Head_HeadS_enter.y.x, 
	Head_HeadS_entered.y.x, 
	Head_HeadS_exit.y.x, 
	Head_HeadS_exited.y.x,
	Head_HeadS_enter.x.y, 
	Head_HeadS_entered.x.y, 
	Head_HeadS_exit.x.y, 
	Head_HeadS_exited.x.y |
	x <- {"Head_HeadS_Walking","Head_HeadS_Stopped","Head_HeadS_Turning"},
	y <- {"Head_HeadS_Stopped"}
|}



Head_HeadS_Stopped_triggers = {||}
		   
S_Head_HeadS_Stopped = let
	

	S_Head_HeadS_Stopped_execute(o__) = 
	SKIP; 
	Head_HeadS_entered!o__!"Head_HeadS_Stopped" ->
	   (SKIP
	   										; STOP /\ (
	   											    Head_HeadS_internal__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Stopped"})!"Head_HeadS_Stopped" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Stopped" -> SKIP);
	   											      	S_Head_HeadS_Stopped
	   											    [] Head_HeadS_startSiren__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Stopped"})!"Head_HeadS_Stopped" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Stopped" -> SKIP);
	   											      	S_Head_HeadS_Stopped
	   											    [] Head_HeadS_wallDetected__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Stopped"})!"Head_HeadS_Stopped" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Stopped" -> SKIP);
	   											      	S_Head_HeadS_Stopped
	   											    [] Head_HeadS_stopSiren__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Stopped"})!"Head_HeadS_Stopped" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Stopped" -> SKIP);
	   											      	S_Head_HeadS_Stopped
	   											    )
	   										)
within
Head_HeadS_enter?x:diff(Head_HeadS_SIDS,{"Head_HeadS_Stopped"})!"Head_HeadS_Stopped" -> ( 
	S_Head_HeadS_Stopped_execute(x)) 
CS_Head_HeadS_Turning_sync = {|
	Head_HeadS_enter.y.x, 
	Head_HeadS_entered.y.x, 
	Head_HeadS_exit.y.x, 
	Head_HeadS_exited.y.x,
	Head_HeadS_enter.x.y, 
	Head_HeadS_entered.x.y, 
	Head_HeadS_exit.x.y, 
	Head_HeadS_exited.x.y |
	x <- {"Head_HeadS_Walking","Head_HeadS_Stopped","Head_HeadS_Turning"},
	y <- {"Head_HeadS_Turning"}
|}



Head_HeadS_Turning_triggers = {|
	Head_HeadS_internal__."Head_HeadS_t8"
|}
		   
S_Head_HeadS_Turning = let
	T_Head_HeadS_t8	= Head_HeadS_internal__!"Head_HeadS_t8" ->  (
					(Head_HeadS_startSiren -> SKIP;(
									(Head_HeadS_enter!"Head_HeadS_Turning"!"Head_HeadS_Walking" -> Head_HeadS_entered!"Head_HeadS_Turning"!"Head_HeadS_Walking" ->
									S_Head_HeadS_Turning
									)
									))[]
					((
									(Head_HeadS_enter!"Head_HeadS_Turning"!"Head_HeadS_Walking" -> Head_HeadS_entered!"Head_HeadS_Turning"!"Head_HeadS_Walking" ->
									S_Head_HeadS_Turning
									)
									))
					)
	

	S_Head_HeadS_Turning_execute(o__) = 
	turnCall -> turnRet -> SKIP; 
	Head_HeadS_entered!o__!"Head_HeadS_Turning" ->
	   (SKIP
	   										; STOP /\ (
	   											    T_Head_HeadS_t8
	   											    []
	   											    Head_HeadS_internal__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t8"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Turning"})!"Head_HeadS_Turning" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Turning" -> SKIP);
	   											      	S_Head_HeadS_Turning
	   											    [] Head_HeadS_startSiren__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t8"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Turning"})!"Head_HeadS_Turning" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Turning" -> SKIP);
	   											      	S_Head_HeadS_Turning
	   											    [] Head_HeadS_wallDetected__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t8"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Turning"})!"Head_HeadS_Turning" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Turning" -> SKIP);
	   											      	S_Head_HeadS_Turning
	   											    [] Head_HeadS_stopSiren__?x:diff(Head_HeadS_TIDS,{"__NULLTRANSITION__","Head_HeadS_t8"}) ->
	   											      Head_HeadS_exit?y:diff(Head_HeadS_SIDS,{"Head_HeadS_Turning"})!"Head_HeadS_Turning" -> (
	   											      	Head_HeadS_exited!y!"Head_HeadS_Turning" -> SKIP);
	   											      	S_Head_HeadS_Turning
	   											    )
	   										)
within
Head_HeadS_enter?x:diff(Head_HeadS_SIDS,{"Head_HeadS_Turning"})!"Head_HeadS_Turning" -> ( 
	S_Head_HeadS_Turning_execute(x)) 

I_Head_HeadS_i0 = T_Head_HeadS_t0



Head_HeadS_int_int = {|
	Head_HeadS_startSiren__."Head_HeadS_t5",
	Head_HeadS_wallDetected__."Head_HeadS_t5",
	Head_HeadS_stopSiren__."Head_HeadS_t5",
Head_HeadS_internal__."Head_HeadS_t5",
	Head_HeadS_startSiren__."Head_HeadS_t8",
	Head_HeadS_wallDetected__."Head_HeadS_t8",
	Head_HeadS_stopSiren__."Head_HeadS_t8",
Head_HeadS_internal__."Head_HeadS_t8"
|}


T_Head_HeadS_t0	= (
				(Head_HeadS_startSiren -> SKIP;(
								(Head_HeadS_enter!"Head_HeadS"!"Head_HeadS_Walking" -> Head_HeadS_entered!"Head_HeadS"!"Head_HeadS_Walking" ->
								SKIP
								)
								))[]
				((
								(Head_HeadS_enter!"Head_HeadS"!"Head_HeadS_Walking" -> Head_HeadS_entered!"Head_HeadS"!"Head_HeadS_Walking" ->
								SKIP
								)
								))
				)

S_Head_HeadS_Walking_R = S_Head_HeadS_Walking
 		[|diff(Head_HeadS_int_int,Head_HeadS_Walking_triggers)|]
 		SKIP
 		
S_Head_HeadS_Stopped_R = S_Head_HeadS_Stopped
 		[|diff(Head_HeadS_int_int,Head_HeadS_Stopped_triggers)|]
 		SKIP
 		
S_Head_HeadS_Turning_R = S_Head_HeadS_Turning
 		[|diff(Head_HeadS_int_int,Head_HeadS_Turning_triggers)|]
 		SKIP
 		
STM_Head_HeadS = ShowEvents_Head_HeadS(I_Head_HeadS_i0
[|{|Head_HeadS_enter.x.y,
		Head_HeadS_entered.x.y,
		Head_HeadS_exit.x.y,
		Head_HeadS_exited.x.y |
		x <- diff(Head_HeadS_SIDS,{"Head_HeadS_Walking","Head_HeadS_Stopped","Head_HeadS_Turning"}),
		y <- {"Head_HeadS_Walking","Head_HeadS_Stopped","Head_HeadS_Turning"}
|}|]
ShowEvents_Head_HeadS(S_Head_HeadS_Walking_R
  [|inter(CS_Head_HeadS_Walking_sync,union(CS_Head_HeadS_Stopped_sync,CS_Head_HeadS_Turning_sync))|]
 ShowEvents_Head_HeadS(S_Head_HeadS_Stopped_R
   [|inter(CS_Head_HeadS_Stopped_sync,CS_Head_HeadS_Turning_sync)|]
  S_Head_HeadS_Turning_R,inter(CS_Head_HeadS_Stopped_sync,CS_Head_HeadS_Turning_sync))\inter(CS_Head_HeadS_Stopped_sync,CS_Head_HeadS_Turning_sync)
 ,inter(CS_Head_HeadS_Walking_sync,union(CS_Head_HeadS_Stopped_sync,CS_Head_HeadS_Turning_sync)))\inter(CS_Head_HeadS_Walking_sync,union(CS_Head_HeadS_Stopped_sync,CS_Head_HeadS_Turning_sync))
 	,{|Head_HeadS_enter,Head_HeadS_entered,
 	Head_HeadS_exit,Head_HeadS_exited|})\{|Head_HeadS_enter,Head_HeadS_entered,
  Head_HeadS_exit,Head_HeadS_exited|}
-- memory process
Memory_Head_HeadS = (
	Head_HeadS_wallDetected__!"Head_HeadS_t5" -> Memory_Head_HeadS
	  []
	Head_HeadS_internal__!"Head_HeadS_t8" -> Memory_Head_HeadS
	)
-- main process
Head_HeadS_aux = ((STM_Head_HeadS
	[|union(
		{||},
		{|Head_HeadS_wallDetected__."Head_HeadS_t5",
		Head_HeadS_internal__."Head_HeadS_t8"|}
	)|]
	Memory_Head_HeadS
)[[Head_HeadS_startSiren__.x <- Head_HeadS_startSiren, Head_HeadS_wallDetected__.x <- Head_HeadS_wallDetected, Head_HeadS_stopSiren__.x <- Head_HeadS_stopSiren| x<-Head_HeadS_TIDS]]\{||})
[|{|Head_HeadS_terminate|}|>SKIP\{|Head_HeadS_terminate, Head_HeadS_internal__|}

Head_HeadS = Head_HeadS_aux \ {|Head_HeadS_enteredV, Head_HeadS_enterV, Head_HeadS_exitV, Head_HeadS_exitedV|}
Head_HeadS_VS = Head_HeadS_aux
