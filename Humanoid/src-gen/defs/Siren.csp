-- declaring controller events
channel Siren_stopSiren
channel Siren_startSiren

Siren = Siren_SirenS[[Siren_SirenS_startSiren <- Siren_startSiren,
						    Siren_SirenS_stopSiren <- Siren_stopSiren]]

-- VS version
Siren_VS = Siren_SirenS_VS[[Siren_SirenS_startSiren <- Siren_startSiren,
						    Siren_SirenS_stopSiren <- Siren_stopSiren]]
