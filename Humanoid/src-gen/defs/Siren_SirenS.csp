channel Siren_SirenS_internal__: Siren_SirenS_TIDS

ShowEvents_Siren_SirenS(P,E) = P[[ Siren_SirenS_entered.x.y <- Siren_SirenS_enteredV.y | Siren_SirenS_entered.x.y <- E]]
							 [[	Siren_SirenS_enter.x.y <- Siren_SirenS_enterV.y | Siren_SirenS_enter.x.y <- E]]
							 [[ Siren_SirenS_exit.x.y <- Siren_SirenS_exitV.y | Siren_SirenS_exit.x.y <- E]]
							 [[ Siren_SirenS_exited.x.y <- Siren_SirenS_exitedV.y | Siren_SirenS_exited.x.y <- E ]]

channel Siren_SirenS_enteredV, Siren_SirenS_enterV, Siren_SirenS_exitV, Siren_SirenS_exitedV : Siren_SirenS_SIDS
channel Siren_SirenS_enter, Siren_SirenS_entered: Siren_SirenS_SIDS.Siren_SirenS_SIDS
channel Siren_SirenS_exit,Siren_SirenS_exited: Siren_SirenS_SIDS.Siren_SirenS_SIDS


-- declaring identifiers of state and final states
Siren_SirenS_SIDS = {
	"Siren_SirenS",
	"Siren_SirenS_Stopped",
	"Siren_SirenS_s1",
	"Siren_SirenS_s1_Red",
	"Siren_SirenS_s1_Green"
}

-- declaring identifiers of transitions
Siren_SirenS_TIDS = {
	"__NULLTRANSITION__",
	"Siren_SirenS_s1_t1",
	"Siren_SirenS_s1_t2",
	"Siren_SirenS_t1",
	"Siren_SirenS_t2"
}

