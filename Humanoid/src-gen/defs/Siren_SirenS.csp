	   											      Siren_SirenS_exit?y:diff(Siren_SirenS_SIDS,{"Siren_SirenS_s1"})!"Siren_SirenS_s1" -> (
	   											      	Siren_SirenS_exit!"Siren_SirenS_s1"?z:{"Siren_SirenS_s1_Red","Siren_SirenS_s1_Green"} ->
	   											      	Siren_SirenS_exited!"Siren_SirenS_s1"!z -> 
	   											      		SKIP;
	   											      	Siren_SirenS_exited!y!"Siren_SirenS_s1" -> SKIP);
