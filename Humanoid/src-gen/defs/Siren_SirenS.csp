	   											    [] Siren_SirenS_startSiren__?x:diff(Siren_SirenS_TIDS,{"__NULLTRANSITION__","Siren_SirenS_t2","Siren_SirenS_s1_t1","Siren_SirenS_s1_t2"}) ->
