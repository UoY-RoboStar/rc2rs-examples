channel Siren_SirenS_stopSiren
channel Siren_SirenS_startSiren__:Siren_SirenS_TIDS
channel Siren_SirenS_startSiren

channel Siren_SirenS_terminate

-- declaring all states
CS_Siren_SirenS_Stopped_sync = {|
	Siren_SirenS_enter.y.x, 
	Siren_SirenS_entered.y.x, 
	Siren_SirenS_exit.y.x, 
	Siren_SirenS_exited.y.x,
	Siren_SirenS_enter.x.y, 
	Siren_SirenS_entered.x.y, 
	Siren_SirenS_exit.x.y, 
	Siren_SirenS_exited.x.y |
	x <- {"Siren_SirenS_Stopped","Siren_SirenS_s1"},
	y <- {"Siren_SirenS_Stopped"}
|}



Siren_SirenS_Stopped_triggers = {|
	Siren_SirenS_internal__."Siren_SirenS_t1"
|}
		   
S_Siren_SirenS_Stopped = let
	T_Siren_SirenS_t1	= Siren_SirenS_internal__!"Siren_SirenS_t1" ->  Siren_SirenS_enter!"Siren_SirenS_Stopped"!"Siren_SirenS_s1" -> Siren_SirenS_entered!"Siren_SirenS_Stopped"!"Siren_SirenS_s1" ->
	S_Siren_SirenS_Stopped
	

	S_Siren_SirenS_Stopped_execute(o__) = 
	SKIP; 
	Siren_SirenS_entered!o__!"Siren_SirenS_Stopped" ->
	   (SKIP
	   										; STOP /\ (
	   											    T_Siren_SirenS_t1
	   											    []
	   											    Siren_SirenS_internal__?x:diff(Siren_SirenS_TIDS,{"__NULLTRANSITION__","Siren_SirenS_t1"}) ->
	   											      Siren_SirenS_exit?y:diff(Siren_SirenS_SIDS,{"Siren_SirenS_Stopped"})!"Siren_SirenS_Stopped" -> (
	   											      	Siren_SirenS_exited!y!"Siren_SirenS_Stopped" -> SKIP);
	   											      	S_Siren_SirenS_Stopped
	   											    [] Siren_SirenS_stopSiren__?x:diff(Siren_SirenS_TIDS,{"__NULLTRANSITION__","Siren_SirenS_t1"}) ->
	   											      Siren_SirenS_exit?y:diff(Siren_SirenS_SIDS,{"Siren_SirenS_Stopped"})!"Siren_SirenS_Stopped" -> (
	   											      	Siren_SirenS_exited!y!"Siren_SirenS_Stopped" -> SKIP);
	   											      	S_Siren_SirenS_Stopped
	   											    [] Siren_SirenS_startSiren__?x:diff(Siren_SirenS_TIDS,{"__NULLTRANSITION__","Siren_SirenS_t1"}) ->
	   											      Siren_SirenS_exit?y:diff(Siren_SirenS_SIDS,{"Siren_SirenS_Stopped"})!"Siren_SirenS_Stopped" -> (
	   											      	Siren_SirenS_exited!y!"Siren_SirenS_Stopped" -> SKIP);
	   											      	S_Siren_SirenS_Stopped
	   											    )
	   										)
