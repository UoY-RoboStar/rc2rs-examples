S_foot_controller_Moving = let
	T_foot_controller_t4	= foot_controller_internal__!"foot_controller_t4" ->  foot_controller_enter!"foot_controller_Moving"!"foot_controller_Balanced" -> foot_controller_entered!"foot_controller_Moving"!"foot_controller_Balanced" ->
	S_foot_controller_Moving
	

	S_foot_controller_Moving_execute(o__) = 
	get_foot_controller_direction?direction -> step(direction); 
	foot_controller_entered!o__!"foot_controller_Moving" ->
	   (SKIP
	   										; STOP /\ (
	   											    T_foot_controller_t4
	   											    []
	   											    foot_controller_internal__?x:diff(foot_controller_TIDS,{"__NULLTRANSITION__","foot_controller_t4"}) ->
	   											      foot_controller_exit?y:diff(foot_controller_SIDS,{"foot_controller_Moving"})!"foot_controller_Moving" -> (
	   											      	foot_controller_exited!y!"foot_controller_Moving" -> SKIP);
	   											      	S_foot_controller_Moving
	   											    [] foot_controller_leanOut__?x:diff(foot_controller_TIDS,{"__NULLTRANSITION__","foot_controller_t4"}) ->
	   											      foot_controller_exit?y:diff(foot_controller_SIDS,{"foot_controller_Moving"})!"foot_controller_Moving" -> (
	   											      	foot_controller_exited!y!"foot_controller_Moving" -> SKIP);
