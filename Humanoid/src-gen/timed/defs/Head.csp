Timed(OneStep) {
Head = timed_priority(wbisim(Head_HeadS[[Head_HeadS_startSiren <- Head_startSiren,
						    Head_HeadS_stopSiren <- Head_stopSiren,
						    Head_HeadS_wallDetected <- Head_wallDetected]]))
-- VS version
Head_VS = timed_priority(wbisim(Head_HeadS_VS[[Head_HeadS_startSiren <- Head_startSiren,
						    Head_HeadS_stopSiren <- Head_stopSiren,
						    Head_HeadS_wallDetected <- Head_wallDetected]]))
}