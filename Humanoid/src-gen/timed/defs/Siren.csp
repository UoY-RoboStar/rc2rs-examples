Timed(OneStep) {
Siren = timed_priority(wbisim(Siren_SirenS[[Siren_SirenS_startSiren <- Siren_startSiren,
						    Siren_SirenS_stopSiren <- Siren_stopSiren]]))
-- VS version
Siren_VS = timed_priority(wbisim(Siren_SirenS_VS[[Siren_SirenS_startSiren <- Siren_startSiren,
						    Siren_SirenS_stopSiren <- Siren_stopSiren]]))
}