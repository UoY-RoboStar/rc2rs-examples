|}|]
ShowEvents_foot_controller(S_foot_controller_Balanced_R
  [|inter(CS_foot_controller_Balanced_sync,union(CS_foot_controller_Moving_sync,CS_foot_controller_Leaning_sync))|]
 ShowEvents_foot_controller(S_foot_controller_Moving_R
   [|inter(CS_foot_controller_Moving_sync,CS_foot_controller_Leaning_sync)|]
  S_foot_controller_Leaning_R,inter(CS_foot_controller_Moving_sync,CS_foot_controller_Leaning_sync))\inter(CS_foot_controller_Moving_sync,CS_foot_controller_Leaning_sync)
 ,inter(CS_foot_controller_Balanced_sync,union(CS_foot_controller_Moving_sync,CS_foot_controller_Leaning_sync)))\inter(CS_foot_controller_Balanced_sync,union(CS_foot_controller_Moving_sync,CS_foot_controller_Leaning_sync))
 	,{|foot_controller_enter,foot_controller_entered,
 	foot_controller_exit,foot_controller_exited|})\{|foot_controller_enter,foot_controller_entered,
  foot_controller_exit,foot_controller_exited|}
-- memory process
channel getWC_foot_controller : foot_controller_WC_enablerSet.Bool

channel getV_foot_controller_v: Vector
channel getV_foot_controller_direction: Vector

Memomy_foot_controller_v(v) = (
get_foot_controller_v!v -> Memomy_foot_controller_v(v)
[]
getV_foot_controller_v!v -> Memomy_foot_controller_v(v)
[]
set_foot_controller_v?x__ -> Memomy_foot_controller_v(x__)
[]
foot_controller_outOfBalance__!"foot_controller_t1"?v -> Memomy_foot_controller_v(v)
)


Memomy_foot_controller_direction(direction) = (
get_foot_controller_direction!direction -> Memomy_foot_controller_direction(direction)
[]
getV_foot_controller_direction!direction -> Memomy_foot_controller_direction(direction)
[]
set_foot_controller_direction?x__ -> Memomy_foot_controller_direction(x__)
)


MemoryTransitions_foot_controller = (getV_foot_controller_v?v ->
getV_foot_controller_direction?direction ->
(foot_controller_outOfBalance__!"foot_controller_t1"?v -> MemoryTransitions_foot_controller
[]
foot_controller_liftFoot__!"foot_controller_t3" -> MemoryTransitions_foot_controller
[]
foot_controller_internal__!"foot_controller_t4" -> MemoryTransitions_foot_controller
[]
foot_controller_leanIn__!"foot_controller_t5" -> MemoryTransitions_foot_controller
[]
foot_controller_internal__!"foot_controller_t6" -> MemoryTransitions_foot_controller
[]
set_foot_controller_v?x__ -> MemoryTransitions_foot_controller
[]
set_foot_controller_direction?x__ -> MemoryTransitions_foot_controller))


MemoryVariablesProcesses_foot_controller = {(Memomy_foot_controller_v((0,0,0)),{|get_foot_controller_v,getV_foot_controller_v,foot_controller_outOfBalance__."foot_controller_t1",set_foot_controller_v|}),
(Memomy_foot_controller_direction((0,0,0)),{|set_foot_controller_direction,getV_foot_controller_direction,get_foot_controller_direction|})}

MemoryVariables_foot_controller = ||| (P, alpha) : MemoryVariablesProcesses_foot_controller @ P
MemoryVariablesSyncSet_foot_controller = {|set_foot_controller_direction,
getV_foot_controller_direction,
getV_foot_controller_v,
foot_controller_outOfBalance__."foot_controller_t1",
set_foot_controller_v|}
MemoryVariablesHideSet_foot_controller = {|getV_foot_controller_direction,
getWC_foot_controller,
getV_foot_controller_v|}

MemoryN_foot_controller = (wbisim(MemoryVariables_foot_controller) [| MemoryVariablesSyncSet_foot_controller |] wbisim(MemoryTransitions_foot_controller)) \ MemoryVariablesHideSet_foot_controller

Memory_foot_controller(v,direction) = (
get_foot_controller_v!v -> Memory_foot_controller(v,direction)
[]
set_foot_controller_v?x__ -> Memory_foot_controller(x__,direction)
[]
get_foot_controller_direction!direction -> Memory_foot_controller(v,direction)
[]
