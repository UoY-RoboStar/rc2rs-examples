		foot_controller_WCresets
	})|]
	(wbisim(MemoryN_foot_controller) [| union({|foot_controller_WC|},foot_controller_WCsync) |] foot_controller_WaitingConditions)\{|foot_controller_WC|}
)[[foot_controller_leanOut__.x <- foot_controller_leanOut, foot_controller_stepDone__.x <- foot_controller_stepDone, foot_controller_stepDownOut__.x <- foot_controller_stepDownOut, foot_controller_outOfBalance__.x <- foot_controller_outOfBalance, foot_controller_liftFoot__.x <- foot_controller_liftFoot, foot_controller_leanIn__.x <- foot_controller_leanIn, foot_controller_stepDownIn__.x <- foot_controller_stepDownIn| x<-foot_controller_TIDS]]\union({|get_foot_controller_v,set_foot_controller_v,
get_foot_controller_direction,set_foot_controller_direction|},{|foot_controller_deadline,foot_controller_clockReset|}))
[|{|foot_controller_terminate|}|>SKIP\{|foot_controller_terminate, foot_controller_internal__|}),<{|foot_controller_enteredV,foot_controller_enterV,foot_controller_exitV,foot_controller_exitedV|},{tock}>)

foot_controller = timed_priority(foot_controller_aux \ {|foot_controller_enteredV, foot_controller_enterV, foot_controller_exitV, foot_controller_exitedV|})
foot_controller_VS = foot_controller_aux
}

