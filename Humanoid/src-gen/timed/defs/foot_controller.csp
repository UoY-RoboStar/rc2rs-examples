foot_controller_internal__."foot_controller_t6"
|}


T_foot_controller_t2	= foot_controller_enter!"foot_controller"!"foot_controller_Balanced" -> foot_controller_entered!"foot_controller"!"foot_controller_Balanced" ->
SKIP

S_foot_controller_Balanced_R = S_foot_controller_Balanced
 		[|diff(foot_controller_int_int,foot_controller_Balanced_triggers)|]
 		SKIP
 		
S_foot_controller_Moving_R = S_foot_controller_Moving
 		[|diff(foot_controller_int_int,foot_controller_Moving_triggers)|]
 		SKIP
 		
S_foot_controller_Leaning_R = S_foot_controller_Leaning
