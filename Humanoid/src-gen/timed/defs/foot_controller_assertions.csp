ExternalEvents_foot_controller = {|moveyCall,foot_controller_leanOut,foot_controller_outOfBalance,foot_controller_liftFoot,movexRet,moveyRet,movezRet,leanforwardRet,movezCall,leanforwardCall,foot_controller_leanIn,correctRet,foot_controller_stepDownIn,stepCall,stepRet,correctCall,foot_controller_stepDownOut,movexCall,foot_controller_stepDone|}

assert T_foot_controller :[deterministic]
assert T_foot_controller :[divergence-free]

-- no time locks
assert RUN({tock}) ||| CHAOS(ExternalEvents_foot_controller)      [F= T_foot_controller |\ union(ExternalEvents_foot_controller,{tock})

-- every state is reachable
assert not STOP [T= T_foot_controller_VS |\ {|foot_controller_enteredV."foot_controller_Balanced"|}
assert not STOP [T= T_foot_controller_VS |\ {|foot_controller_enteredV."foot_controller_Moving"|}
assert not STOP [T= T_foot_controller_VS |\ {|foot_controller_enteredV."foot_controller_Leaning"|}

-- states can be reached infinitely often
assert T_foot_controller_VS |\ {|foot_controller_enteredV."foot_controller_Balanced"|} [T= RUN({|foot_controller_enteredV."foot_controller_Balanced"|})
assert T_foot_controller_VS |\ {|foot_controller_enteredV."foot_controller_Moving"|} [T= RUN({|foot_controller_enteredV."foot_controller_Moving"|})
assert T_foot_controller_VS |\ {|foot_controller_enteredV."foot_controller_Leaning"|} [T= RUN({|foot_controller_enteredV."foot_controller_Leaning"|})

-- timed model is a refinement
assert sbisim(diamond(foot_controller)) [F= T_foot_controller \ {tock}
assert sbisim(diamond(foot_controller_VS)) [T= T_foot_controller_VS \ {tock}

-- do time constraints constrain traces?
assert T_foot_controller \ {tock} [T= sbisim(diamond(foot_controller))
assert T_foot_controller_VS \ {tock} [T= sbisim(diamond(foot_controller_VS))

-- memory models consistency check
assert timed::MemoryN_foot_controller [FD= timed::MemoryO_foot_controller
assert timed::MemoryO_foot_controller [FD= timed::MemoryN_foot_controller
