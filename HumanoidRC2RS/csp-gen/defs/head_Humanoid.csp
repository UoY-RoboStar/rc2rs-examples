								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i0,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j2,wallDetected__.NID_Walking.in|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   i0::D__(id__)
								   [| { share__, terminate } |] (
								   j0::D__(id__)
								   [| { share__, terminate } |] (
								   j1::D__(id__)
								   [| { share__, terminate } |] (
								   j2::D__(id__)
								   [| { share__, terminate } |] (
								   Walking::D__(id__)
								   [| { share__, terminate } |] (
								   f0::D__(id__)
								   )
								   )
								   )
								   )
								   )
								 )
								 [[Walking::interrupt <- x__ | x__ <- {|interrupt,wallDetected__.NID_Walking.in|}]]
								 [[f0::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
								 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
								 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((i0::enter -> Transitions(id__))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
							[[
								startSiren__.x____ <- startSiren,
								wallDetected__.x____ <- wallDetected,
								stopSiren__.x____ <- stopSiren,
								liftFootLeft__.x____ <- liftFootLeft,
								liftFootRight__.x____ <- liftFootRight,
								stepDoneLeft__.x____ <- stepDoneLeft,
								stepDoneRight__.x____ <- stepDoneRight
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__) = 
					dbisim((MachineBody(id__)\ enteredSS)
					)
				
				IteratedBehaviour(id__) = 
					dbisim((MachineBody(id__)\ enteredSS)
					)
				
				Stateful(id__) = 
					((
						(Behaviour(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
					 	\getsetLocalChannels
					)
					)
				
				IteratedStateful(id__) =
					(Behaviour(id__))
				
				-- Visible counterparts
				MachineBody_VS_O(id__) = 
					dbisim((
					let
						finalNodesEntered = {|f0::entered|}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							i0::enter,
							j0::enter,
							j1::enter,
							j2::enter,
							Walking::enter,
							f0::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i0,internal__.NID_j0,internal__.NID_j0,internal__.NID_j1,internal__.NID_j2,wallDetected__.NID_Walking.in|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   i0::VS_O__(id__)
								   [| { share__, terminate } |] (
								   j0::VS_O__(id__)
								   [| { share__, terminate } |] (
								   j1::VS_O__(id__)
								   [| { share__, terminate } |] (
								   j2::VS_O__(id__)
								   [| { share__, terminate } |] (
								   Walking::VS_O__(id__)
								   [| { share__, terminate } |] (
								   f0::VS_O__(id__)
								   )
								   )
								   )
								   )
								   )
								 )
								 [[Walking::interrupt <- x__ | x__ <- {|interrupt,wallDetected__.NID_Walking.in|}]]
								 [[f0::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
								 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
								 [[j1::interrupt <- x__ | x__ <- {|internal__.NID_j1|}]]
								 [[j2::interrupt <- x__ | x__ <- {|internal__.NID_j2|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((i0::enter -> Transitions(id__))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
							[[
								startSiren__.x____ <- startSiren,
								wallDetected__.x____ <- wallDetected,
								stopSiren__.x____ <- stopSiren,
								liftFootLeft__.x____ <- liftFootLeft,
								liftFootRight__.x____ <- liftFootRight,
								stepDoneLeft__.x____ <- stepDoneLeft,
								stepDoneRight__.x____ <- stepDoneRight
								| x____ <- NIDS
							]]
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__) = 
					dbisim((MachineBody_VS_O(id__))
					)
				
				IteratedBehaviour_VS_O(id__) = 
					dbisim((MachineBody_VS_O(id__))
					)
				
				Stateful_VS_O(id__) = 
					dbisim((
						(Behaviour_VS_O(id__) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__))
					 	\getsetLocalChannels
					)
					)
				
				IteratedStateful_VS_O(id__) =
					(Behaviour_VS_O(id__))
				
				-- END
				
				-- Memory
				-- Memory variables
				
				-- varMemory process
				varMemory(id__) = terminate -> SKIP
				
				getsetLocalChannels = {||}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__) = STM_VS_O(id__)
				
				D__(id__) = STM(id__) \ internal_events
				O__(id__) = sbisim(diamond(D__(id__)))
				VS__(id__) = FVS__(id__)
				VS_O__(id__) = sbisim(diamond(FVS__(id__)))
				HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
				HUP__(id__) = O__(id__) [|{share__}|] SKIP
				
				-- Shared memory
				-- Shared memory variables
				
				-- sharedVarMemory process
				sharedVarMemory(id__) = terminate -> SKIP
				
				sharedVarSync = {||}
				
				sharedVarHide = {||}
			endmodule
			
				-- undefined operations
				CALL__turn(id__) 	= turnCall -> SKIP
				
				-- declaring controller memory
				Memory(id__) = SKIP
				
				D__(id__) = 	((
						stm_ref::D__(id__)[[
							stm_ref::terminate <- terminate,
							stm_ref::startSiren <- startSiren,
							stm_ref::stopSiren <- stopSiren,
							stm_ref::wallDetected <- wallDetected,
							stm_ref::turnCall <- turnCall
						]]
						\ {|
							stm_ref::liftFootLeft,
							stm_ref::liftFootRight,
							stm_ref::stepDoneLeft,
							stm_ref::stepDoneRight
						|}
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				
				-- VS version
				VS__(id__) = 	((
						stm_ref::VS__(id__)[[
							stm_ref::terminate <- terminate,
							stm_ref::startSiren <- startSiren,
							stm_ref::stopSiren <- stopSiren,
							stm_ref::wallDetected <- wallDetected,
							stm_ref::turnCall <- turnCall
						]]
						\ {|
							stm_ref::liftFootLeft,
							stm_ref::liftFootRight,
							stm_ref::stepDoneLeft,
							stm_ref::stepDoneRight
						|}
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
			
				-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
				O__(id__) = sbisim(diamond(	((
						stm_ref::O__(id__)[[
							stm_ref::terminate <- terminate,
							stm_ref::startSiren <- startSiren,
							stm_ref::stopSiren <- stopSiren,
							stm_ref::wallDetected <- wallDetected,
							stm_ref::turnCall <- turnCall
						]]
						\ {|
							stm_ref::liftFootLeft,
							stm_ref::liftFootRight,
							stm_ref::stepDoneLeft,
							stm_ref::stepDoneRight
						|}
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					dbisim(Memory(id__))
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				))
								
				-- VS_O version
				VS_O__(id__) = sbisim(diamond(	((
						stm_ref::VS_O__(id__)[[
							stm_ref::terminate <- terminate,
							stm_ref::startSiren <- startSiren,
							stm_ref::stopSiren <- stopSiren,
							stm_ref::wallDetected <- wallDetected,
							stm_ref::turnCall <- turnCall
						]]
						\ {|
							stm_ref::liftFootLeft,
							stm_ref::liftFootRight,
							stm_ref::stepDoneLeft,
							stm_ref::stepDoneRight
						|}
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					dbisim(Memory(id__))
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				))
			
				HEXT(id__) = O__(id__) [|shared_variable_events|] SKIP			
	
		endmodule
	
	-- declaring module memory
	Memory(id__) = SKIP
	
	D__(id__) = 	(
			(
				(SKIP)
					[|{||}|]
				(
					(
						ctrl_ref0::D__(id__)[[
							ctrl_ref0::terminate <- terminate,
							ctrl_ref0::wallDetected <- wallDetected,
							ctrl_ref0::turnCall <- turnCall
