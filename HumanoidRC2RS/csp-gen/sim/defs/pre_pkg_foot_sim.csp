	channel movexCall: core_real
	channel moveyCall: core_real
	channel clone_foot_controller_correct1Call: pre_pkg_foot_sim_Vectorfoot
	
	enterSS = {|
	I1::enter,
	Balanced::enter,
	Moving::enter,
	Leaning::enter
	|}
	
	enteredSS = 	{|
	Balanced::entered,
	Moving::entered,
	Leaning::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	
	channel clockReset, clockResetL, clockResetR 
	
	localClockResets = {||}
	
	
	channel get_CLID_Leaning : core_clock_type 
