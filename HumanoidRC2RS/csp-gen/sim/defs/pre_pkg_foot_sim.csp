			get_outOfBalance!x__ -> Memory_outOfBalance(x__)
			[]
			registerRead.i_outOfBalance?x__ -> Memory_outOfBalance(x__)
			[]
			terminate -> SKIP
		)
		Memory_liftFoot(x__) = (
			get_liftFoot!x__ -> Memory_liftFoot(x__)
			[]
			registerRead.i_liftFoot?x__ -> Memory_liftFoot(x__)
			[]
			terminate -> SKIP
		)
		Memory_leanIn(x__) = (
			get_leanIn!x__ -> Memory_leanIn(x__)
			[]
			registerRead.i_leanIn?x__ -> Memory_leanIn(x__)
			[]
			terminate -> SKIP
		)
		Memory_stepDownIn(x__) = (
			get_stepDownIn!x__ -> Memory_stepDownIn(x__)
			[]
			registerRead.i_stepDownIn?x__ -> Memory_stepDownIn(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_pre_pkg_foot_sim_foot_controller_foot_controller) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_outOfBalance(false.(0,0,0))
		 [| { terminate } |] (
		 Memory_liftFoot(false)
		 [| { terminate } |] (
		 Memory_leanIn(false)
		 [| { terminate } |] (
		 Memory_stepDownIn(false)
		 )
		 )
		 )
		 )
		)
		
		sharedVarSync = union({|get_outOfBalance,
		get_liftFoot,
		get_leanIn,
		get_stepDownIn|},
			  {||}
			 )
		
		sharedVarHide = union({|get_outOfBalance,
		get_liftFoot,
		get_leanIn,
		get_stepDownIn|},
			  {||}
			 )
		
		}
endmodule

