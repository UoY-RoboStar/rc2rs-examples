		-- END of Operation calls --
	
		datatype SOutputEvents = SOutput_movex
			| SOutput_leanOut
			| SOutput_movey
			| SOutput_movez
			| SOutput_stepDone
			| SOutput_stepDownOut
			| SOutput_leanforward
		
		cycle(cycle_pre_pkg_foot_sim_foot_controller_foot_controller) =
			let
				project(o_movex.x__) = SOutput_movex
				project(o_leanOut) = SOutput_leanOut
				project(o_movey.x__) = SOutput_movey
				project(o_movez.x__) = SOutput_movez
				project(o_stepDone) = SOutput_stepDone
				project(o_stepDownOut) = SOutput_stepDownOut
				project(o_leanforward) = SOutput_leanforward
		
				Cycle =
					Deadline(
						(registerRead.i_stepDownIn?x__ -> SKIP
							||| registerRead.i_outOfBalance?x__ -> SKIP
							||| registerRead.i_liftFoot?x__ -> SKIP
							||| registerRead.i_leanIn?x__ -> SKIP);
