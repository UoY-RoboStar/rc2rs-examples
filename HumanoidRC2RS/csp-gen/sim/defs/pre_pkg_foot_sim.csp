			Behaviour(id__) = 
				dbisim((let
					stateClockSync = {||}
				 within
					(MachineBody(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ union(stateClockSync,enteredSS)
				)
				)
			
			
			Stateful(id__) = 
				((let
					getsetLocalChannels = {||}
					clockSync = {||}
				within
					(Behaviour(id__) 
					 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
					 (varMemory(id__) [| {terminate} |] Clocks(id__))
				 	)\union(getsetLocalChannels,clockSync)
				)
				)
			
			
			-- Visible counterparts
			MachineBody_VS_O(id__) = 
				dbisim((
				let
					finalNodesEntered = {|f::entered|}
				within
					(dbisim((dbisim((let
						-- IMPLEMENTATION NOTE:
						-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						-- modules for defining the semantics of each node.
						enterSS = {|
						i::enter,
						f::enter
						|}
						hideSet = union(enterSS,{|exit,exited,internal__|})
					within 
						((let
							-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
							-- because CSPM modules are used for the semantics of Node.
							flowevts = union(enterSS,{|exit,exited|})
							transSync = {|internal__.NID_i|}
						within
							((
							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i::VS_O__(id__)
							   [| { share__, terminate } |] (
							   f::VS_O__(id__)
							   )
							 )
							 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
							|}) |]
							 ((i::enter -> Transitions(id__))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
						[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
						[[ endexec_action <- endexec ]]
						[[ startexec_action <- startexec ]]
					)
					)
					 [| union(stateClockSync,{terminate}) |]
					 StateClocks(id__)
					)\diff(stateClockSync,enteredSS))
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__) = 
				dbisim((let
					stateClockSync = {||}
				 within
					(MachineBody_VS_O(id__) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
				)
				)
			
			
			Stateful_VS_O(id__) = 
				dbisim((let
					getsetLocalChannels = {||}
					clockSync = {||}
				within
					(Behaviour_VS_O(id__) 
					 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
					 (varMemory(id__) [| {terminate} |] Clocks(id__))
				 	)\union(getsetLocalChannels,clockSync)
				)
				)
			
			
			-- END
			
			-- Memory
			-- Memory variables
			
			-- varMemory process
			varMemory(id__) = terminate -> SKIP
			
			getsetLocalChannels = {||}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__) = STM_VS_O(id__) \ localClockResets
			D__(id__) = timed_priority(STM(id__) \ union(internal_events,localClockResets))
			O__(id__) = dbisim(D__(id__))
			VS__(id__) = FVS__(id__)
			VS_O__(id__) = dbisim(FVS__(id__))
			HEXT__(id__) = O__(id__) [|shared_variable_events|] SKIP
			FVS_C__(id__) = dbisim(timed_priority(STM(id__) \ internal_events))
			HUP__(id__) = timed_priority(O__(id__) [|{share__}|] SKIP)
			
			-- Clocks
			
			Clocks(id__) = terminate -> SKIP
			
			clockSync = {||}
			
			
			StateClocks(id__) = terminate -> SKIP
			
			stateClockSync = {||}
			
			}
				endmodule
	
	Timed(OneStep) {
	-- (Rule 8) cycleController(...) : CSPProcess
	datatype SOutputEvents = SOutput_leanOut
		| SOutput_movex
		| SOutput_leanforward
		| SOutput_stepDownOut
		| SOutput_stepDone
		| SOutput_movey
		| SOutput_movez
	
	DVarsEvents = {}
	
	EVarsEvents = {}
	
	cycleController(id__,cycle_pre_pkg_foot_sim_Foot_Foot,
			   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c) =
	let
				
		project_stm_ref0(stm_ref0::o_leanOut) = SOutput_leanOut
		project_stm_ref0(stm_ref0::o_movex.x__) = SOutput_movex
		project_stm_ref0(stm_ref0::o_leanforward) = SOutput_leanforward
		project_stm_ref0(stm_ref0::o_stepDownOut) = SOutput_stepDownOut
		project_stm_ref0(stm_ref0::o_stepDone) = SOutput_stepDone
		project_stm_ref0(stm_ref0::o_movey.x__) = SOutput_movey
		project_stm_ref0(stm_ref0::o_movez.x__) = SOutput_movez
	
		connected_stm_ref0(stm_ref0::o_leanOut) = true
		connected_stm_ref0(stm_ref0::o_movex.x__) = true
		connected_stm_ref0(stm_ref0::o_leanforward) = true
		connected_stm_ref0(stm_ref0::o_stepDownOut) = true
		connected_stm_ref0(stm_ref0::o_stepDone) = true
		connected_stm_ref0(stm_ref0::o_movey.x__) = true
		connected_stm_ref0(stm_ref0::o_movez.x__) = true
		connected_stm_ref0(_) = false
	
		lift_stm_ref0(stm_ref0::o_leanOut) = o_leanOut
		lift_stm_ref0(stm_ref0::o_movex.x__) = o_movex.x__
		lift_stm_ref0(stm_ref0::o_leanforward) = o_leanforward
		lift_stm_ref0(stm_ref0::o_stepDownOut) = o_stepDownOut
		lift_stm_ref0(stm_ref0::o_stepDone) = o_stepDone
		lift_stm_ref0(stm_ref0::o_movey.x__) = o_movey.x__
		lift_stm_ref0(stm_ref0::o_movez.x__) = o_movez.x__
		
		CycleController =
			Deadline(
			-- read inputs from the controller and pass to state machines
			(
			((registerRead.i_leanIn?x__ ->
				((stm_ref0::registerRead.stm_ref0::i_leanIn!x__ -> SKIP)))
				|||
			(registerRead.i_stepDownIn?x__ ->
				((stm_ref0::registerRead.stm_ref0::i_stepDownIn!x__ -> SKIP)))
				|||
			(registerRead.i_outOfBalance?x__ ->
				((stm_ref0::registerRead.stm_ref0::i_outOfBalance!x__ -> SKIP)))
				|||
			(registerRead.i_liftFoot?x__ ->
				((stm_ref0::registerRead.stm_ref0::i_liftFoot!x__ -> SKIP))))
			-- ensure state machines read the values being communicated via evars
					);
			-- synchronize on events related to evars to erase memory
			-- collect outputs, and monitor termination of the cycle, by all controllers
			(CollectOutputs(SOutputEvents) [| {endexec} |] Monitor),0);
			-- wait for the cycleDef period
			TimeOut_1(terminate -> SKIP,WAIT(cycle_pre_pkg_foot_sim_Foot_Foot-1));
			-- recurse
			CycleController
			
									
		CollectOutputs(sout) =
			(stm_ref0::registerWrite?outp:{ outp | outc <- diff(sout,union(EVarsEvents,DVarsEvents)), outp <- stm_ref0::RegisterDataOutput, connected_stm_ref0(outp), project_stm_ref0(outp) == outc}
					-> registerWrite!lift_stm_ref0(outp)
						-> CollectOutputs(diff(sout,{project_stm_ref0(outp)}))
			[]
			endexec -> SKIP
			)
	
		Monitor = 
			(	 (stm_ref0::endexec -> SKIP)); endexec -> SKIP
	within
		CycleController
	
	-- (Rule 5) memoryComp(...) : CSPProcess
	memoryComp(id__,
			   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c) = (
		STOP)
	
	
	-- (Rule 7) [[ c : Controller ]]_C : CSPProcess
	D__(id__,cycle_pre_pkg_foot_sim_Foot_Foot,
			   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c) =
	timed_priority(
		(
			(
				(
					(
					dbisim(cycleController(id__,cycle_pre_pkg_foot_sim_Foot_Foot,
							   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c))
				 	 [| Union({{||},
				 	 		  {||},
				 	 		  {||},
				 	 		  {||}}) |]
				 	memoryComp(id__,
				 			   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c)
				 	)\{||}
					[| {| 	terminate,tock,
							stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((let
				 		const_pre_pkg_foot_sim_clone_foot_controller_step_entry_2_c = const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c
				 		cycle_pre_pkg_foot_sim_foot_controller_foot_controller = cycle_pre_pkg_foot_sim_Foot_Foot
				 	within
				 		(stm_ref0::D__(id__,cycle_pre_pkg_foot_sim_foot_controller_foot_controller,
				 				    const_pre_pkg_foot_sim_clone_foot_controller_step_entry_2_c)
				 		\{| |})
				 		[[stm_ref0::terminate <- terminate]]
				 	)
				 	)
				) \ {|	stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	
	O__(id__,cycle_pre_pkg_foot_sim_Foot_Foot,
			   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c) = 
	timed_priority(
		dbisim(
			(
				(
					(
					dbisim(cycleController(id__,cycle_pre_pkg_foot_sim_Foot_Foot,
							   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c))
				 	 [| Union({{||},
				 	 		  {||},
				 	 		  {||},
				 	 		  {||}}) |]
				 	memoryComp(id__,
				 			   	const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c)
				 	)\{||}
					[| {| 	terminate,tock,
							stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((let
				 		const_pre_pkg_foot_sim_clone_foot_controller_step_entry_2_c = const_pre_pkg_foot_sim_Foot_Foot_ref_clone_foot_controller_step_entry_2_c
				 		cycle_pre_pkg_foot_sim_foot_controller_foot_controller = cycle_pre_pkg_foot_sim_Foot_Foot
				 	within
				 		(stm_ref0::O__(id__,cycle_pre_pkg_foot_sim_foot_controller_foot_controller,
				 				    const_pre_pkg_foot_sim_clone_foot_controller_step_entry_2_c)
				 		\{| |})
				 		[[stm_ref0::terminate <- terminate]]
				 	)
				 	)
				) \ {|	stm_ref0::endexec,stm_ref0::registerRead,stm_ref0::registerWrite |}
			) [| {terminate} |> SKIP
		)
	)
	}
endmodule

module foot_controller
exports
	transparent diamond
