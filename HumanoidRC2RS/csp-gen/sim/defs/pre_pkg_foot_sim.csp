	nametype RegisterOutputs = {|
	o_movex,
	o_leanOut,
	o_movey,
	o_movez,
	o_stepDone,
	o_stepDownOut,
	o_leanforward|}
		
	nametype RegisterInputs = {|
	i_stepDownIn,
	i_outOfBalance,
	i_liftFoot,
