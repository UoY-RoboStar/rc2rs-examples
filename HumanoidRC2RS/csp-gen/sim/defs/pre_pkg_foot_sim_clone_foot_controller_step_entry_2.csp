		StateClocks(id__,
				          const_pre_pkg_foot_sim_clone_foot_controller_step_entry_2_c) = dbisim(Clock_CLID_Waiting(id__,0,
				          const_pre_pkg_foot_sim_clone_foot_controller_step_entry_2_c))
		
		stateClockSync = {|get_CLID_Waiting,Waiting::entered|}
		
		}
			endmodule
