			terminate -> SKIP
		
		-- varMemory process
		varMemory(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = Memory_wallDetectedF(true)
		[| { terminate } |] (
		Memory_stepDoneLeftF(true)
		[| { terminate } |] (
		Memory_stepDoneRightF(true)
		[| { terminate } |] (
		Memory_exec_ds_HeadS_Walking(false)
		[| { terminate } |] (
		Memory_exec_ms_HeadS_Walking(false)
		[| { terminate } |] (
		Memory_inact_HeadS_Walking(true)
		)
		)
		)
		)
		)
		
		getsetLocalChannels = {|get_wallDetectedF,set_wallDetectedF,get_stepDoneLeftF,set_stepDoneLeftF,get_stepDoneRightF,set_stepDoneRightF,get_exec_ds_HeadS_Walking,set_exec_ds_HeadS_Walking,get_exec_ms_HeadS_Walking,set_exec_ms_HeadS_Walking,get_inact_HeadS_Walking,set_inact_HeadS_Walking|}
		
		-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
		FVS__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = STM_VS_O(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) \ localClockResets
		D__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = timed_priority(STM(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) \ union(internal_events,localClockResets))
		O__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = dbisim(D__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS))
		VS__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = FVS__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS)
		VS_O__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = dbisim(FVS__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS))
		HEXT__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = O__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) [|shared_variable_events|] SKIP
		FVS_C__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = dbisim(timed_priority(STM(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) \ internal_events))
		HUP__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = timed_priority(O__(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_Walking(id__,x__) = 
			TimeOut_1(
				Walking::entered -> Clock_CLID_Walking(id__,0)
				[]
				get_CLID_Walking!x__ -> Clock_CLID_Walking(id__,x__)
				[]
				terminate -> SKIP,Clock_CLID_Walking(id__,clock_type_plus(x__,1,CLID_Walking_clock_type(id__))))
		
		StateClocks(id__) = dbisim(Clock_CLID_Walking(id__,0))
		
		stateClockSync = {|get_CLID_Walking,Walking::entered|}
		
		
		-- Shared memory
		-- Shared memory variables
		
		Memory_wallDetected(x__) = (
			get_wallDetected!x__ -> Memory_wallDetected(x__)
			[]
			registerRead.i_wallDetected?x__ -> Memory_wallDetected(x__)
			[]
			terminate -> SKIP
		)
		Memory_stepDoneLeft(x__) = (
			get_stepDoneLeft!x__ -> Memory_stepDoneLeft(x__)
			[]
			registerRead.i_stepDoneLeft?x__ -> Memory_stepDoneLeft(x__)
			[]
			terminate -> SKIP
		)
		Memory_stepDoneRight(x__) = (
			get_stepDoneRight!x__ -> Memory_stepDoneRight(x__)
			[]
			registerRead.i_stepDoneRight?x__ -> Memory_stepDoneRight(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_pre_pkg_head_sim_HeadS_HeadS) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_wallDetected(false)
		 [| { terminate } |] (
		 Memory_stepDoneLeft(false)
		 [| { terminate } |] (
		 Memory_stepDoneRight(false)
		 )
		 )
		 )
		)
		
		sharedVarSync = union({|get_wallDetected,
		get_stepDoneLeft,
		get_stepDoneRight|},
			  {||}
			 )
		
		sharedVarHide = union({|get_wallDetected,
		get_stepDoneLeft,
		get_stepDoneRight|},
			  {||}
			 )
		
		}
endmodule
