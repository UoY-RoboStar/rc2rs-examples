package siren

import humanoid::*
 
interface SirenI {
	green5s()
	red5s()
	play()
} 
controller Siren {
	requires SirenI 
	event startSiren
	event stopSiren
	sref stm_ref1 = SirenS
	connection Siren on startSiren to stm_ref1 on startSiren
	connection Siren on stopSiren to stm_ref1 on stopSiren
}
stm SirenS {
		requires SirenI
		event stopSiren
		event startSiren
		initial i0
		state Stopped {
			
		}
		state s1 {
			initial i0
			state Red {
				entry green5s();wait(1)
			}
			state Green {
				entry red5s()
			}
			transition t0 {
				from i0
				to Red
			}
			transition t1 {
				from Red
				to Green
				
			}
			transition t2 {
				from Green
				to Red
			}
			
			during play()
		}
		transition t0 {
			from i0
			to Stopped
		}
		transition t1 {
			from Stopped
			to s1
		
			
		}
		transition t2 {
			from s1
			to Stopped
		}
	}