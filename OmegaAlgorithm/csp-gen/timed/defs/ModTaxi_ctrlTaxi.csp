			channel CalcAvoidanceHeadingCall
			
			enterSS = {|
			i1::enter,
			Forward::enter,
			Coherence::enter,
			Avoidance::enter
			|}
			
			enteredSS = 	{|
			Forward::entered,
			Coherence::entered,
			Avoidance::entered
			|}
			
			internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
			
			shared_variable_events = {|
			|}
			
			-- channel set with all visible events
			sem__events = {|
				terminate
			,	anyRobotToAvoid
			,	RotateAntiClockwiseCall,
				CheckIlluminationStatusCall,
				RotateClockwiseCall,
				CalcCoherenceHeadingCall,
				CalcAvoidanceHeadingCall
				|}
