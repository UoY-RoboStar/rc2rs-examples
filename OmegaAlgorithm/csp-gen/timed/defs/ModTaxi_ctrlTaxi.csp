			localClockResets = {|clockReset.CLID_T|}
			
			
			channel get_CLID_Forward : core_clock_type 
			channel get_CLID_Coherence : core_clock_type 
			channel get_CLID_Avoidance : core_clock_type 
			channel get_CLID_T : core_clock_type 
