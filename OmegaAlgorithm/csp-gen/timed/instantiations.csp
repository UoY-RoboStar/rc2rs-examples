			{{Plus(degreeTurned, Mult(angularSpeed, angularSpeed1, { -2..2}), { -2..2})|angularSpeed1 <- { -2..2},degreeTurned <- { -2..2},angularSpeed <- { -2..2}},{0},{0},{avoidanceRadius2|avoidanceRadius2 <- { -2..2}},{avoidanceRadius1|avoidanceRadius1 <- { -2..2}},{i|i <- { -2..2}},{0},{0},{j|j <- { -2..2}},{0},{j|j <- { -2..2}},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{MoveForwardVal|MoveForwardVal <- { -2..2}},{Neg(rotate, { -2..2})|rotate <- { -2..2}},{rotate|rotate <- { -2..2}}}))..calc_type_max(Union({{Plus(degreeTurned, Mult(angularSpeed, angularSpeed1, { -2..2}), { -2..2})|angularSpeed1 <- { -2..2},degreeTurned <- { -2..2},angularSpeed <- { -2..2}},{0},{0},{avoidanceRadius2|avoidanceRadius2 <- { -2..2}},{avoidanceRadius1|avoidanceRadius1 <- { -2..2}},{i|i <- { -2..2}},{0},{0},{j|j <- { -2..2}},{0},{j|j <- { -2..2}},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{MoveForwardVal|MoveForwardVal <- { -2..2}},{Neg(rotate, { -2..2})|rotate <- { -2..2}},{rotate|rotate <- { -2..2}}}))}) 

