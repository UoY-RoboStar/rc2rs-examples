				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
				
				-- Transition identifiers
				-- declaring identifiers of transitions
				datatype NIDS = 
				              NID_I|
				              NID_F|
				              NID_s1
				
				channel internal__ : NIDS
				
				-- Flow channels		
				channel interrupt
				channel exited
				channel exit
				channel terminate
				
				-- Variable channels
				channel get_linearSpeed, set_linearSpeed, setL_linearSpeed, setR_linearSpeed: core_real
				channel get_angularSpeed, set_angularSpeed, setL_angularSpeed, setR_angularSpeed: core_real
				channel get_reached, set_reached, setL_reached, setR_reached: core_boolean
				channel get_desiredTurningDegree, set_desiredTurningDegree, setL_desiredTurningDegree, setR_desiredTurningDegree: core_real
				channel get_degreeTurned, set_degreeTurned, setL_degreeTurned, setR_degreeTurned: core_real
				channel get_avoidanceRadius, set_avoidanceRadius, setL_avoidanceRadius, setR_avoidanceRadius: core_real
				channel get_illuminated, set_illuminated, setL_illuminated, setR_illuminated: core_boolean
				
				-- Shared variable channels
				channel set_EXT_linearSpeed: core_real
				channel set_EXT_angularSpeed: core_real
				channel set_EXT_reached: core_boolean
				channel set_EXT_desiredTurningDegree: core_real
				channel set_EXT_degreeTurned: core_real
				channel set_EXT_avoidanceRadius: core_real
				channel set_EXT_illuminated: core_boolean
				
				-- Local variable channels for defined operations that are required by the state machine
				
				-- Declaring state machine events
				
				-- Declaring call and ret events for undefined operations
				
				enterSS = {|
				I::enter,
				F::enter,
				s1::enter
				|}
				
				enteredSS = 	{|
				F::entered,
				s1::entered
				|}
				
				internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
				
				shared_variable_events = {|
					set_EXT_linearSpeed,
					set_EXT_angularSpeed,
					set_EXT_reached,
					set_EXT_desiredTurningDegree,
					set_EXT_degreeTurned,
					set_EXT_avoidanceRadius,
					set_EXT_illuminated
				|}
				
				-- channel set with all visible events
				sem__events = {|
					terminate
				,	set_EXT_linearSpeed, set_linearSpeed,
					set_EXT_angularSpeed, set_angularSpeed,
					set_EXT_reached, set_reached,
					set_EXT_desiredTurningDegree, set_desiredTurningDegree,
					set_EXT_degreeTurned, set_degreeTurned,
					set_EXT_avoidanceRadius, set_avoidanceRadius,
					set_EXT_illuminated, set_illuminated
					, share__
					|}
				
				-- Nodes --
				-- declaring all nodes
				
				----------------------------------------------------------------------
				-- Initial: I
				module I
				exports
				
					channel enter, interrupt
					
					D__(id__,
								param_j) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,
								param_j) = D__(id__,
								param_j)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- Final state: F
				module F
				
				exports
				
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
					--	Rule: behaviours(Node)
					D__(id__,
								param_j) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
							
							Entering 	= entered -> SKIP ; Active
							Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
							Interrupted	= share__choice(exit -> exited -> Inactive)
						within
							Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_j) = D__(id__,
								param_j)
				
				endmodule
				----------------------------------------------------------------------
				
				
				----------------------------------------------------------------------
				-- State: s1
				module s1
				
				enterSS = {}
				
				enteredSS = {}
				
				exports
				
					--  Declarations
					
					channel enter, entered, interrupt
					channel enteredL, enteredR
					
									
					
					--	Nodes
					-- declaring all nodes
					
					
					--	Rule: behaviours(Node)
					--  Note that FDR has problems with efficiently compiling the process below
					-- 	if using a different recursion pattern.
					D__(id__,
								param_j) = 
					dbisim(let
						-- IMPLEMENTATION NOTE: 
						-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
						-- however FDR struggles with that form in certain cases. So we use the exception operator
						-- instead to 'terminate'.
						
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(true & (share__choice(set_linearSpeed!0 -> SKIP)));share__choice(true & (share__choice(set_angularSpeed!param_j -> SKIP))) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
						
					VS_O__(id__,
								param_j) = 
					dbisim(let
						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= share__choice(true & (share__choice(set_linearSpeed!0 -> SKIP)));share__choice(true & (share__choice(set_angularSpeed!param_j -> SKIP))) ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
				
				endmodule
				----------------------------------------------------------------------
				
				-- END of Nodes --
				
				-- Operation calls --
				-- Only the undefined operations are declared here.
				-- If the state machine is in isolation, all required operations will be undefined.
				-- If it is in the context of a controller, the required operations not provided by the
				-- controller will be declared here, and the defined operations will be defined in the
				-- context of the Controller module, and therefore within scope of the state machine module.
				
				-- END of Operation calls --
				
				-- STM processes
				STM(id__,
							param_j) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
				Stateful(id__,
							param_j) \ {terminate}
				
				STM_VS_O(id__,
							param_j) = -- RULE: [[stm:OperationDef]]_STM^nops : CSPProcess
				Stateful(id__,
							param_j) \ {terminate}
				
				-- Transitions
				Transitions(id__,
							param_j) = ((let
					Trans = (
						((share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_I -> SKIP ;  ((SKIP ; s1::enter -> SKIP))))
						 	 [] dbisim((true)&(internal__!NID_s1 -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; F::enter -> SKIP)))
						 ) ; Trans)
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
					)
				within
					Trans
				)
				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__,
							param_j) = 
					dbisim((
					let
						finalNodesEntered = {|F::entered|}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I::enter,
							F::enter,
							s1::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I,internal__.NID_s1|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I::D__(id__,
								   			param_j)
								   [| { share__, terminate } |] (
								   F::D__(id__,
								   			param_j)
								   [| { share__, terminate } |] (
								   s1::D__(id__,
								   			param_j)
								   )
								   )
								 )
								 [[F::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[s1::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s1|}]]
								 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((I::enter -> Transitions(id__,
								 			param_j))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__,
							param_j) = 
					dbisim((MachineBody(id__,
								param_j)\ enteredSS)
					)
				
				
				Stateful(id__,
							param_j) = 
					((
						(Behaviour(id__,
									param_j) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
									param_j))
					 	\getsetLocalChannels
					)
					)
				
				
				-- Visible counterparts
				MachineBody_VS_O(id__,
							param_j) = 
					dbisim((
					let
						finalNodesEntered = {|F::entered|}
					within
						((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							I::enter,
							F::enter,
							s1::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_I,internal__.NID_s1|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   I::VS_O__(id__,
								   			param_j)
								   [| { share__, terminate } |] (
								   F::VS_O__(id__,
								   			param_j)
								   [| { share__, terminate } |] (
								   s1::VS_O__(id__,
								   			param_j)
								   )
								   )
								 )
								 [[F::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[s1::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s1|}]]
								 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((I::enter -> Transitions(id__,
								 			param_j))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
						)
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__,
							param_j) = 
					dbisim((MachineBody_VS_O(id__,
								param_j))
					)
				
				
				Stateful_VS_O(id__,
							param_j) = 
					dbisim((
						(Behaviour_VS_O(id__,
									param_j) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
									param_j))
					 	\getsetLocalChannels
					)
					)
				
				
				-- END
				
				-- Memory
				-- Memory variables
				
				-- varMemory process
				varMemory(id__,
							param_j) = terminate -> SKIP
				
				getsetLocalChannels = {||}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__,
							param_j) = STM_VS_O(id__,
							param_j)
				
				D__(id__,
							param_j) = STM(id__,
							param_j) \ internal_events
				O__(id__,
							param_j) = sbisim(diamond(D__(id__,
							param_j)))
				VS__(id__,
							param_j) = FVS__(id__,
							param_j)
				VS_O__(id__,
							param_j) = sbisim(diamond(FVS__(id__,
							param_j)))
				HEXT__(id__,
							param_j) = O__(id__,
							param_j) [|shared_variable_events|] SKIP
				HUP__(id__,
							param_j) = O__(id__,
							param_j) [|{share__}|] SKIP
						endmodule
