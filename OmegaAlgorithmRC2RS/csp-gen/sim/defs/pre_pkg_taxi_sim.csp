		channel get_clone_clone_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_normal_Turn_S_entry_entry_7_RotateClockwise_t_thenJ__j_4_2_10_linearSpeed, set_clone_clone_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_normal_Turn_S_entry_entry_7_RotateClockwise_t_thenJ__j_4_2_10_linearSpeed: core_real
