		channel CalcAvoidanceHeadingCall
		channel CheckIlluminationStatusCall
		channel CalcCoherenceHeadingCall
		
		enterSS = {|
		i1::enter,
		Forward::enter,
		Avoidance::enter,
		Coherence::enter
		|}
		
		enteredSS = 	{|
		Forward::entered,
		Avoidance::entered,
		Coherence::entered
		|}
		
		internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
		
		shared_variable_events = {|
		|}
		
		datatype ClockSet = 
			CLID_T
		
		channel clockReset, clockResetL, clockResetR : ClockSet
		
