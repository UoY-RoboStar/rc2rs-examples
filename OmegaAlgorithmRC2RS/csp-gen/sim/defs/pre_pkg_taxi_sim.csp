	-- declaring inputs and outputs of the module
	
	Timed(OneStep) {
	-- (Rule 3) cycleModule(...) : CSPProcess
	
	datatype COutputEvents = COutput_CalcCoherenceHeading
		| COutput_CalcAvoidanceHeading
		| COutput_CheckIlluminationStatus
	
	EVarsEvents = {}
	
	
	cycleModule(id__,cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi) =
	let 
					
		project_ctrl1(ctrl1::o_CalcCoherenceHeading) = COutput_CalcCoherenceHeading
		project_ctrl1(ctrl1::o_CalcAvoidanceHeading) = COutput_CalcAvoidanceHeading
		project_ctrl1(ctrl1::o_CheckIlluminationStatus) = COutput_CheckIlluminationStatus
		
		connected_ctrl1(ctrl1::o_CalcCoherenceHeading) = true
		connected_ctrl1(ctrl1::o_CalcAvoidanceHeading) = true
		connected_ctrl1(ctrl1::o_CheckIlluminationStatus) = true
		connected_ctrl1(_) = false
	
		lift_ctrl1(ctrl1::o_CalcCoherenceHeading) = o_CalcCoherenceHeading
		lift_ctrl1(ctrl1::o_CalcAvoidanceHeading) = o_CalcAvoidanceHeading
		lift_ctrl1(ctrl1::o_CheckIlluminationStatus) = o_CheckIlluminationStatus
	
		CycleModule =
			Deadline(
			-- read inputs from the platform and pass to controllers
			-- synchronize on events related to evars
			-- collect outputs, and monitor termination of the cycle, by all controllers
			(CollectOutputs(COutputEvents) [| {endexec} |] Monitor),0);
			-- wait for the cycleDef period
			TimeOut_1(terminate -> SKIP,WAIT(cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi-1));
			-- recurse
			CycleModule
								
		CollectOutputs(sout) =
			(
			ctrl1::registerWrite?outp:{ outp | outc <- diff(sout,EVarsEvents), outp <- ctrl1::RegisterDataOutput, connected_ctrl1(outp), project_ctrl1(outp) == outc}
			 	-> registerWrite!lift_ctrl1(outp)
			 		-> CollectOutputs(diff(sout,{project_ctrl1(outp)}))
			[]
			endexec -> SKIP
			)
			
		Monitor = 
			(	 (ctrl1::endexec -> SKIP)); endexec -> SKIP
		
	within
		CycleModule 
	
	-- (Rule 5) memoryComp(...) : CSPProcess
	memoryComp(id__) = (
		STOP)
	
	
	-- (Rule 1) [[ M : SimModule ]]_M : CSPProcess
	D__(id__,cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi,
			    const_pre_pkg_taxi_sim_ctrlTaxi_stm1_MoveForwardVal,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius1,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius2,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_angularSpeed1,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_rotate) =
	timed_priority(
		(
			(
				(
					(
						dbisim(cycleModule(id__,cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi))
								[| Union({{||},
										  {||},
										  {||},
										  {||}}) |]
									memoryComp(id__)
						)\{||}
					[| {| 	terminate,tock,
							ctrl1::endexec,ctrl1::registerWrite	|} |]
					-- (Rule 6) composeControllers(...) : CSPProcess
						((let
								cycle_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi = cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi
							within
								(ctrl1::D__(id__,cycle_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi,
										    const_pre_pkg_taxi_sim_ctrlTaxi_stm1_MoveForwardVal,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius1,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius2,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_angularSpeed1,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_rotate)
								\{| |})
									[[ctrl1::terminate <- terminate]]
							)
						)
				) \ {|	endexec,
						ctrl1::endexec,ctrl1::registerWrite |}
			) [| {terminate} |> SKIP
		) \ {terminate}
	)
	
	
	
	O__(id__,cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi,
			    const_pre_pkg_taxi_sim_ctrlTaxi_stm1_MoveForwardVal,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius1,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius2,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_angularSpeed1,
			   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_rotate) =
	timed_priority(
		(
			(
				(
					(
						dbisim(cycleModule(id__,cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi))
								[| Union({{||},
										  {||},
										  {||},
										  {||}}) |]
									memoryComp(id__)
						)\{||}
					[| {| 	terminate,tock,
							ctrl1::endexec,ctrl1::registerWrite	|} |]
					-- (Rule 6) composeControllers(...) : CSPProcess
						((let
								cycle_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi = cycle_pre_pkg_taxi_sim_ModTaxi_ModTaxi
							within
								(ctrl1::O__(id__,cycle_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi,
										    const_pre_pkg_taxi_sim_ctrlTaxi_stm1_MoveForwardVal,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius1,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Forward_entry_UpdateAvoidanceRadius_j_3_8_j_2_10_1_avoidanceRadius2,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_angularSpeed1,
										   	const_pre_pkg_taxi_sim_ctrlTaxi_ctrlTaxi_ref_clone_clone_normal_SwarmTaxisFSM_Coherence_entry_Turn_j_2_4_f_2_rotate)
								\{| |})
									[[ctrl1::terminate <- terminate]]
							)
						)
				) \ {|	endexec,
						ctrl1::endexec,ctrl1::registerWrite |}
			) [| {terminate} |> SKIP
		) \ {terminate}
	)
	}
endmodule

module ctrlTaxi
exports

	transparent dbisim
	transparent sbisim
	transparent chase

	-- declaring channels
	-- allInputs = inputs_evars? true
	-- allOutputs = outputs_evars? false
	
	-- inputs, evars, rvars and outputs as calculated internally
	-- outputs = {
