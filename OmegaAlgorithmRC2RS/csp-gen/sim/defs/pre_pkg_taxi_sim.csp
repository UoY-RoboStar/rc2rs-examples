	--	 }
	-- inputs = {}
	-- evars = {}
	-- dvars = {}
	
	-- declaring registerRead/Write datatypes
	datatype RegisterDataOutput = o_CalcAvoidanceHeading
		| o_CalcCoherenceHeading
		| o_CheckIlluminationStatus
	
	
	nametype RegisterOutputs = {|
	o_CalcCoherenceHeading,
	o_CalcAvoidanceHeading,
	o_CheckIlluminationStatus|}
		
	nametype RegisterInputs = {||}
	
	channel registerWrite 	: RegisterDataOutput
	
	channel endexec, terminate
	
	
	-- declaring call and ret events for undefined operations
	channel CalcAvoidanceHeadingCall
	channel CheckIlluminationStatusCall
	channel CalcCoherenceHeadingCall
	
	-- channel set with all visible events
	sem__events = {|endexec,terminate
	,registerWrite
	|}
	
	module stm1
