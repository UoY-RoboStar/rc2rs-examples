									 [[Coherence::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Coherence|}]]
									 [[Avoidance::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Avoidance|}]]
									 [[i1::interrupt <- x__ | x__ <- {|internal__.NID_i1|}]]
