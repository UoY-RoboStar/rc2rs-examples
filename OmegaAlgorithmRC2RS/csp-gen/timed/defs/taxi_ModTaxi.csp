							within 
								((let
									-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
									-- because CSPM modules are used for the semantics of Node.
									flowevts = union(enterSS,{|exit,exited,interrupt|})
									transSync = {|internal__.NID_I,internal__.NID_s1|}
								within
									((
									 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
									   I::VS_O__(id__,
									   			param_j)
									   [| { share__, terminate } |] (
									   F::VS_O__(id__,
									   			param_j)
									   [| { share__, terminate } |] (
									   s1::VS_O__(id__,
									   			param_j)
									   )
									   )
									 )
									 [[F::interrupt <- x__ | x__ <- {|interrupt|}]]
									 [[s1::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s1|}]]
									 [[I::interrupt <- x__ | x__ <- {|internal__.NID_I|}]]
									 )
									  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
									 )
									 [| union(union(union(flowevts,transSync),{terminate}),{|share__
									|}) |]
									 ((I::enter -> Transitions(id__,
									 			param_j))
									  [[ share__ <- x__ | x__ <- {| share__ |} ]]
									 )
									)
									)
								)
								 \ hideSet)
							)
							)
							 [| union(stateClockSync,{terminate}) |]
							 StateClocks(id__)
							)\diff(stateClockSync,enteredSS))
							 [| {| interrupt |} |] SKIP)
						)
						)
					
					Behaviour_VS_O(id__,
								param_j) = 
						dbisim((let
							stateClockSync = {|get_CLID_s1,s1::entered|}
						 within
							(MachineBody_VS_O(id__,
										param_j) [| union(stateClockSync,{terminate}) |] StateClocks(id__)) \ diff(union(stateClockSync,enteredSS),enteredSS)
						)
						)
					
					
					Stateful_VS_O(id__,
								param_j) = 
						dbisim((let
							getsetLocalChannels = {|get_linearSpeed,set_linearSpeed,
							get_angularSpeed,set_angularSpeed|}
							clockSync = {||}
						within
							(Behaviour_VS_O(id__,
										param_j) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
							 (varMemory(id__,
							 			param_j) [| {terminate} |] Clocks(id__))
						 	)\union(getsetLocalChannels,clockSync)
						)
						)
					
					
					-- END
					
					-- Memory
					-- Memory variables
					Memory_linearSpeed(linearSpeed) =
						get_linearSpeed!linearSpeed -> Memory_linearSpeed(linearSpeed)
						[]
						set_linearSpeed?x__ -> Memory_linearSpeed(x__)
						[]
						terminate -> SKIP
					Memory_angularSpeed(angularSpeed) =
						get_angularSpeed!angularSpeed -> Memory_angularSpeed(angularSpeed)
						[]
						set_angularSpeed?x__ -> Memory_angularSpeed(x__)
						[]
						terminate -> SKIP
					
					-- varMemory process
					varMemory(id__,
								param_j) = Memory_linearSpeed(0)
					[| { terminate } |] (
					Memory_angularSpeed(0)
					)
					
					getsetLocalChannels = {|get_linearSpeed,set_linearSpeed,get_angularSpeed,set_angularSpeed|}
					
					-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
					FVS__(id__,
								param_j) = STM_VS_O(id__,
								param_j) \ localClockResets
					D__(id__,
								param_j) = timed_priority(STM(id__,
								param_j) \ union(internal_events,localClockResets))
					O__(id__,
								param_j) = dbisim(D__(id__,
								param_j))
					VS__(id__,
								param_j) = FVS__(id__,
								param_j)
					VS_O__(id__,
								param_j) = dbisim(FVS__(id__,
								param_j))
					HEXT__(id__,
								param_j) = O__(id__,
								param_j) [|shared_variable_events|] SKIP
					FVS_C__(id__,
								param_j) = dbisim(timed_priority(STM(id__,
								param_j) \ internal_events))
					HUP__(id__,
								param_j) = timed_priority(O__(id__,
								param_j) [|{share__}|] SKIP)
					
					-- Clocks
					
					Clocks(id__) = terminate -> SKIP
					
					clockSync = {||}
					
					Clock_CLID_s1(id__,x__) = 
						TimeOut_1(
							s1::entered -> Clock_CLID_s1(id__,0)
							[]
							get_CLID_s1!x__ -> Clock_CLID_s1(id__,x__)
							[]
							terminate -> SKIP,Clock_CLID_s1(id__,clock_type_plus(x__,1,CLID_s1_clock_type(id__))))
					
					StateClocks(id__) = dbisim(Clock_CLID_s1(id__,0))
					
					stateClockSync = {|get_CLID_s1,s1::entered|}
					}
						endmodule
			-- compileOperationDef
			module OP_MoveForward
			exports
				transparent diamond
				transparent sbisim
				transparent dbisim
				transparent chase
				
