							    const_taxi_UpdateAvoidanceRadius_avoidanceRadius2) = 
						dbisim((let
							stateClockSync = {|get_CLID_S,S::entered|}
						 within
							(MachineBody_VS_O(id__,
									    const_taxi_UpdateAvoidanceRadius_avoidanceRadius1,
									    const_taxi_UpdateAvoidanceRadius_avoidanceRadius2) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
									          const_taxi_UpdateAvoidanceRadius_avoidanceRadius1,
									          const_taxi_UpdateAvoidanceRadius_avoidanceRadius2)) \ diff(union(stateClockSync,enteredSS),enteredSS)
