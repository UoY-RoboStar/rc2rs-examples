									    const_taxi_UpdateAvoidanceRadius_avoidanceRadius1,
									    const_taxi_UpdateAvoidanceRadius_avoidanceRadius2) 
							 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
