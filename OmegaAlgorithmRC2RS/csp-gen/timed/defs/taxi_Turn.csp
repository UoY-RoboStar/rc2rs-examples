				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) = dbisim(D__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate))
		VS__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) = FVS__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate)
		VS_O__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) = dbisim(FVS__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate))
		HEXT__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) = O__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) [|shared_variable_events|] SKIP
		FVS_C__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) = dbisim(timed_priority(STM(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) \ internal_events))
		HUP__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) = timed_priority(O__(id__,
				    const_taxi_Turn_angularSpeed1,
				    const_taxi_Turn_rotate) [|{share__}|] SKIP)
		
		-- Clocks
		
		Clocks(id__,
				          const_taxi_Turn_angularSpeed1,
				          const_taxi_Turn_rotate) = terminate -> SKIP
		
		clockSync = {||}
		
		Clock_CLID_S(id__,x__,
				          const_taxi_Turn_angularSpeed1,
				          const_taxi_Turn_rotate) = 
			TimeOut_1(
				S::entered -> Clock_CLID_S(id__,0,
						          const_taxi_Turn_angularSpeed1,
						          const_taxi_Turn_rotate)
				[]
				get_CLID_S!x__ -> Clock_CLID_S(id__,x__,
						          const_taxi_Turn_angularSpeed1,
						          const_taxi_Turn_rotate)
				[]
				terminate -> SKIP,Clock_CLID_S(id__,clock_type_plus(x__,1,CLID_S_clock_type(id__,
						          const_taxi_Turn_angularSpeed1,
						          const_taxi_Turn_rotate)),
						          const_taxi_Turn_angularSpeed1,
						          const_taxi_Turn_rotate))
		
		StateClocks(id__,
				          const_taxi_Turn_angularSpeed1,
				          const_taxi_Turn_rotate) = dbisim(Clock_CLID_S(id__,0,
				          const_taxi_Turn_angularSpeed1,
				          const_taxi_Turn_rotate))
		
		stateClockSync = {|get_CLID_S,S::entered|}
		}
			endmodule
