			{{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{0},{lv|lv <- { -2..2}},{0},{av|av <- { -2..2}},{0},{av|av <- { -2..2}},{lv|lv <- { -2..2}},{0}}))..calc_type_max(Union({{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{ -2..2},{0},{lv|lv <- { -2..2}},{0},{av|av <- { -2..2}},{0},{av|av <- { -2..2}},{lv|lv <- { -2..2}},{0}}))}) 

