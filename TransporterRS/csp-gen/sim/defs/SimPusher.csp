						 			 			,setR_neighbours
						 			 			,clockResetR.CLID_T
						 			 			,clockResetR.CLID_N
						 			|}) |]
						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_goal,setL_n,setL_distance,setL_d,clockResetL.CLID_C,setL_neighbours,clockResetL.CLID_T,clockResetL.CLID_N |} ]]
						  [[set_goal <- setR_goal,set_n <- setR_n,set_distance <- setR_distance,set_d <- setR_d,clockReset.CLID_C <- clockResetR.CLID_C,set_neighbours <- setR_neighbours,clockReset.CLID_T <- clockResetR.CLID_T,clockReset.CLID_N <- clockResetR.CLID_N]]
						 )
						)[[setL_goal <- set_goal,setL_n <- set_n,setL_distance <- set_distance,setL_d <- set_d,clockResetL.CLID_C <- clockReset.CLID_C,setL_neighbours <- set_neighbours,clockResetL.CLID_T <- clockReset.CLID_T,clockResetL.CLID_N <- clockReset.CLID_N]]
						 [[setR_goal <- set_goal,setR_n <- set_n,setR_distance <- set_distance,setR_d <- set_d,clockResetR.CLID_C <- clockReset.CLID_C,setR_neighbours <- set_neighbours,clockResetR.CLID_T <- clockReset.CLID_T,clockResetR.CLID_N <- clockReset.CLID_N]]
						)\union(enteredSS,{terminate}) 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| true&CALL__searchObject(
							 	  			id__,
							 	  		    const_SimPusher_close,
							 	  		    const_SimPusher_Ta,
							 	  		    const_SimPusher_Tb,
							 	  		    const_SimPusher_Tc,
							 	  		    const_SimPusher_Td,
							 	  		    const_SimPusher_Te,
							 	  		    const_SimPusher_S
							 	  		) ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
					
				VS_O__(id__,cycle_SimPusher_SimPusher,
						    const_SimPusher_close,
						    const_SimPusher_Ta,
						    const_SimPusher_Tb,
						    const_SimPusher_Tc,
						    const_SimPusher_Td,
						    const_SimPusher_Te,
						    const_SimPusher_S) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= true&CALL__enableObjectWatch(
								id__,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
							    const_SimPusher_Te,
							    const_SimPusher_S
							) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((dbisim(
						 	sbisim(
						 		(let
						 			-- IMPLEMENTATION NOTE:
						 			-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 			-- modules for defining the semantics of each node.
						 			enterSS = {|
						 			i0::enter,
						 			Watch::enter
						 			|}
						 			hideSet = union(enterSS,{|exit,exited,internal__|})
						 		within 
						 			((let
						 				-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 				-- because CSPM modules are used for the semantics of Node.
						 				flowevts = union(enterSS,{|exit,exited|})
						 				transSync = {|internal__.NID_i0,endexec__.NID_Watch|}
						 			within
						 				((
						 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 				   i0::VS_O__(id__,cycle_SimPusher_SimPusher,
						 				   		    const_SimPusher_close,
						 				   		    const_SimPusher_Ta,
						 				   		    const_SimPusher_Tb,
						 				   		    const_SimPusher_Tc,
						 				   		    const_SimPusher_Td,
						 				   		    const_SimPusher_Te,
						 				   		    const_SimPusher_S)
						 				   [| { share__, terminate } |] (
						 				   Watch::VS_O__(id__,cycle_SimPusher_SimPusher,
						 				   		    const_SimPusher_close,
						 				   		    const_SimPusher_Ta,
						 				   		    const_SimPusher_Tb,
						 				   		    const_SimPusher_Tc,
						 				   		    const_SimPusher_Td,
						 				   		    const_SimPusher_Te,
						 				   		    const_SimPusher_S)
						 				   )
						 				 )
						 				 [[Watch::interrupt <- x__ | x__ <- {|interrupt,endexec__.NID_Watch|}]]
						 				 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 				 )
						 				  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
