			| SOutput_disableObjectWatch
			| SOutput_disableNeighbourDetection
			| SOutput_moveAroundObject
			| SOutput_moveToObject
			| SOutput_scanAndAlign
		
		cycle(cycle_SimPusher_SimPusher) =
			let
				project(o_searchObject) = SOutput_searchObject
				project(o_closeInOnObject) = SOutput_closeInOnObject
				project(o_enableNeighbourDetection) = SOutput_enableNeighbourDetection
				project(o_enableGoalFinding) = SOutput_enableGoalFinding
				project(o_evade) = SOutput_evade
				project(o_disableGoalFinding) = SOutput_disableGoalFinding
				project(o_pushObject) = SOutput_pushObject
				project(o_enableObjectWatch) = SOutput_enableObjectWatch
				project(o_disableObjectWatch) = SOutput_disableObjectWatch
				project(o_disableNeighbourDetection) = SOutput_disableNeighbourDetection
				project(o_moveAroundObject) = SOutput_moveAroundObject
				project(o_moveToObject) = SOutput_moveToObject
				project(o_scanAndAlign) = SOutput_scanAndAlign
		
				Cycle =
					Deadline(
						(registerRead.i_goalSeen?x__ -> SKIP
							||| registerRead.i_neighbourDetected?x__ -> SKIP
							||| registerRead.i_objectSeen?x__ -> SKIP);
						startexec -> CollectOutputs(SOutputEvents),0);
					TimeOut_1(terminate -> SKIP,WAIT(cycle_SimPusher_SimPusher-1);Cycle)
				
				CollectOutputs(sout) =
					(registerWrite?outp:{ outp | outc <- inter(sout,SOutputEvents), outp <- RegisterDataOutput,project(outp) == outc} -> CollectOutputs(diff(sout,{project(outp)}))
						[]
					endexec -> SKIP
