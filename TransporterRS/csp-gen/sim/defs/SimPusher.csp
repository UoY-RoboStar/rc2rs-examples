						 [] dbisim(((not (member(neighbourDetected,{true.n | n <- core_nat}))))&(internal__!NID_j3 -> SKIP ; get_neighbourDetected?b__?x__ -> set_n!x__ -> SKIP
						 ; ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; j5::enter -> SKIP))))
						 [] dbisim((((neighbours<2) and (n<2)))&(internal__!NID_j4 -> SKIP ;  ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; j5::enter -> SKIP))))
						 [] dbisim((((neighbours>=2) and (n<2)))&(internal__!NID_j4 -> SKIP ;  ((((share__choice(clockReset.CLID_N -> SKIP);share__choice(share__choice(get_n?n -> true & (share__choice(set_neighbours!n -> SKIP)))))[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; j5::enter -> SKIP))))
						 [] dbisim((((neighbours<2) and (n>=2)))&(internal__!NID_j4 -> SKIP ;  ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; j5::enter -> SKIP))))
						 [] dbisim((((neighbours>=2) and (n>=2)))&(internal__!NID_j4 -> SKIP ;  ((((share__choice(share__choice(get_n?n -> true & (share__choice(set_neighbours!n -> SKIP)))))[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; j5::enter -> SKIP))))
						 [] dbisim((true)&(endexec__.NID_NewCycle -> startexec_action -> SKIP ;  share__choice(exit -> SKIP) ; ((let 
						 	X = share__choice(exited -> SKIP [] endexec -> Y)
						 	Y = share__choice(exited -> SKIP [] startexec -> X)
						  within
						  	X) ; ((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; j0::enter -> SKIP)))
						 [] dbisim((true)&(internal__!NID_j5 -> SKIP ;  ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; NewCycle::enter -> SKIP))))
						 []
						 (exit -> SKIP ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
						 []
						 (endexec -> SKIP ; share__choice(startexec -> SKIP))
						 )
					,SKIP);Trans
