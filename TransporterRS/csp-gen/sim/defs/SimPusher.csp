				Transitions(id__,cycle_SimPusher_SimPusher,
						    const_SimPusher_close,
						    const_SimPusher_Ta,
						    const_SimPusher_Tb,
						    const_SimPusher_Tc,
						    const_SimPusher_Td,
						    const_SimPusher_Te,
						    const_SimPusher_S) = ((let
					Trans = share__choice(get_goalSeen?goalSeen -> TimeOut_1(
						 (share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; Watch::enter -> SKIP))))
						 [] dbisim((true)&(internal__!NID_Watch -> SKIP ;  share__choice(exit -> SKIP) ; ((let 
						 	X = share__choice(exited -> SKIP [] endexec -> Y)
						 	Y = share__choice(exited -> SKIP [] startexec -> X)
						  within
						  	X) ; ((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; j0::enter -> SKIP)))
						 [] dbisim((member(goalSeen,{true}))&(internal__!NID_j0 -> SKIP ;  ((((share__choice(true & (share__choice(set_goal!true -> SKIP))))[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; NewCycle::enter -> SKIP))))
						 [] dbisim(((not (member(goalSeen,{true}))))&(internal__!NID_j0 -> SKIP ;  ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; NewCycle::enter -> SKIP))))
						 [] dbisim((true)&(endexec__.NID_NewCycle -> startexec_action -> SKIP ;  share__choice(exit -> SKIP) ; ((let 
						 	X = share__choice(exited -> SKIP [] endexec -> Y)
						 	Y = share__choice(exited -> SKIP [] startexec -> X)
						  within
						  	X) ; ((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; Watch::enter -> SKIP)))
						 []
						 (exit -> SKIP ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
						 []
						 (endexec -> SKIP ; share__choice(startexec -> SKIP))
						 )
					,SKIP);Trans
					)
				within
					Trans [|{terminate}|> SKIP
				)
				)
				
				
				-- Clocks
				Clock_CLID_NewCycle(id__,x__,
						          const_SimPusher_close,
						          const_SimPusher_Ta,
						          const_SimPusher_Tb,
						          const_SimPusher_Tc,
