				VS_O__(id__,cycle_SimPusher_SimPusher,
						    const_SimPusher_close,
						    const_SimPusher_Ta,
						    const_SimPusher_Tb,
						    const_SimPusher_Tc,
						    const_SimPusher_Td,
						    const_SimPusher_Te,
						    const_SimPusher_S) = 
				dbisim(let
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
					Behaviour 	= entered -> During
					During 		= ((true&CALL__evade(
								id__,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
							    const_SimPusher_Te,
							    const_SimPusher_S
							) ; SStop) /\ interrupt -> SKIP)
				within
					Inactive [| {terminate} |> SKIP)
				
				
				-- Clocks
				
				StateClocks(id__,
						          const_SimPusher_close,
						          const_SimPusher_Ta,
						          const_SimPusher_Tb,
						          const_SimPusher_Tc,
						          const_SimPusher_Td,
						          const_SimPusher_Te,
						          const_SimPusher_S) = terminate -> SKIP
				
				stateClockSync = {||}
			}
		
