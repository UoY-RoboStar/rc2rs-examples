		endmodule
		----------------------------------------------------------------------
		
		
		----------------------------------------------------------------------
		-- State: Pushing
		module Pushing
		
		enterSS = 
				{|			i0::enter,
					NewCycle::enter,
					j0::enter,
					j1::enter,
					j2::enter,
					j3::enter,
					j4::enter,
					j5::enter,
					Watch::enter
				|}
		enteredSS = 
				{|			NewCycle::entered,
					Watch::entered
				|}
		exports
		
			--  Declarations
			channel endexec__ : NIDS
			
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_i0|
			              NID_NewCycle|
			              NID_j0|
			              NID_j1|
			              NID_j2|
			              NID_j3|
			              NID_j4|
			              NID_j5|
			              NID_Watch
			
			channel internal__ : NIDS
			
			channel get_CLID_NewCycle : core_clock_type 
			channel get_CLID_Watch : core_clock_type 
			--channel increment__
			
			CLID_NewCycle_clock_type(id__,
					          const_SimPusher_close,
					          const_SimPusher_Ta,
					          const_SimPusher_Tb,
					          const_SimPusher_Tc,
					          const_SimPusher_Td,
					          const_SimPusher_Te,
					          const_SimPusher_S) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			CLID_Watch_clock_type(id__,
					          const_SimPusher_close,
					          const_SimPusher_Ta,
					          const_SimPusher_Tb,
					          const_SimPusher_Tc,
					          const_SimPusher_Td,
					          const_SimPusher_Te,
					          const_SimPusher_S) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			
			--	Nodes
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: i0
			module i0
			exports
			
				channel enter, interrupt
				
				Timed(OneStep) {
					D__(id__,cycle_SimPusher_SimPusher,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
							    const_SimPusher_Te,
							    const_SimPusher_S) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,cycle_SimPusher_SimPusher,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
