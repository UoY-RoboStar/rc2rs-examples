		----------------------------------------------------------------------
		-- State: CloseInOnObject
		module CloseInOnObject
		
		enterSS = 
				{|			i0::enter,
					jWatch::enter,
					Watch::enter
				|}
		enteredSS = 
				{|			Watch::entered
				|}
		exports
		
			--  Declarations
			channel endexec__ : NIDS
			
			
			channel enter, entered, interrupt
			channel enteredL, enteredR
			
							
			-- declaring identifiers of transitions
			datatype NIDS = 
			              NID_i0|
			              NID_jWatch|
			              NID_Watch
			
			channel internal__ : NIDS
			
			channel get_CLID_Watch : core_clock_type 
			--channel increment__
			
			CLID_Watch_clock_type(id__,
					          const_SimPusher_close,
					          const_SimPusher_Ta,
					          const_SimPusher_Tb,
					          const_SimPusher_Tc,
					          const_SimPusher_Td,
					          const_SimPusher_Te,
					          const_SimPusher_S) = 
				let
					max = (clock_type_max(Union({
			{}
			}))+1)
				ctype = {0..max}
			within
				if member(max,core_clock_type) then ctype else error("core_clock_type is not wide enough")
			
			
			--	Nodes
			-- declaring all nodes
			
			----------------------------------------------------------------------
			-- Initial: i0
			module i0
			exports
			
				channel enter, interrupt
				
				Timed(OneStep) {
					D__(id__,cycle_SimPusher_SimPusher,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
							    const_SimPusher_Te,
							    const_SimPusher_S) = 
						dbisim(let
							Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
							
							Termination = terminate -> SKIP
							
							Active 		= share__choice(interrupt -> SKIP) ; Inactive
						within
							Inactive [| {terminate} |> SKIP)
					
					VS_O__(id__,cycle_SimPusher_SimPusher,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
							    const_SimPusher_Te,
							    const_SimPusher_S) = D__(id__,cycle_SimPusher_SimPusher,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
							    const_SimPusher_Te,
							    const_SimPusher_S)
				}
			
			endmodule
			----------------------------------------------------------------------
			
			
			----------------------------------------------------------------------
			-- Junction: jWatch
			module jWatch
			exports
			
				channel enter, interrupt
				
				Timed(OneStep) {
					D__(id__,cycle_SimPusher_SimPusher,
							    const_SimPusher_close,
