					Active 		= SKIP ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; SKIP ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((dbisim(
						 	sbisim(
						 		(let
						 			-- IMPLEMENTATION NOTE:
						 			-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 			-- modules for defining the semantics of each node.
						 			enterSS = {|
						 			i1::enter,
						 			jWatch::enter,
						 			Watch::enter
						 			|}
						 			hideSet = union(enterSS,{|exit,exited,internal__|})
						 		within 
						 			((let
						 				-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 				-- because CSPM modules are used for the semantics of Node.
						 				flowevts = union(enterSS,{|exit,exited|})
						 				transSync = {|internal__.NID_i1,endexec__.NID_Watch,internal__.NID_jWatch,internal__.NID_jWatch|}
						 			within
						 				((
						 				 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 				   i1::D__(id__,cycle_SimPusher_SimPusher,
						 				   		    const_SimPusher_close,
						 				   		    const_SimPusher_Ta,
						 				   		    const_SimPusher_Tb,
						 				   		    const_SimPusher_Tc,
						 				   		    const_SimPusher_Td,
						 				   		    const_SimPusher_Te,
						 				   		    const_SimPusher_S)
						 				   [| { share__, terminate } |] (
						 				   jWatch::D__(id__,cycle_SimPusher_SimPusher,
						 				   		    const_SimPusher_close,
						 				   		    const_SimPusher_Ta,
						 				   		    const_SimPusher_Tb,
						 				   		    const_SimPusher_Tc,
						 				   		    const_SimPusher_Td,
						 				   		    const_SimPusher_Te,
						 				   		    const_SimPusher_S)
						 				   [| { share__, terminate } |] (
						 				   Watch::D__(id__,cycle_SimPusher_SimPusher,
						 				   		    const_SimPusher_close,
						 				   		    const_SimPusher_Ta,
