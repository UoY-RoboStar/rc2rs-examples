						 ((During)
						  [[ share__ <- x__ | x__ <- {| share__,setL_goal,setL_n,setL_distance,setL_d,clockResetL.CLID_C,setL_neighbours,clockResetL.CLID_T,clockResetL.CLID_N |} ]]
						  [[set_goal <- setR_goal,set_n <- setR_n,set_distance <- setR_distance,set_d <- setR_d,clockReset.CLID_C <- clockResetR.CLID_C,set_neighbours <- setR_neighbours,clockReset.CLID_T <- clockResetR.CLID_T,clockReset.CLID_N <- clockResetR.CLID_N]]
						 )
						)[[setL_goal <- set_goal,setL_n <- set_n,setL_distance <- set_distance,setL_d <- set_d,clockResetL.CLID_C <- clockReset.CLID_C,setL_neighbours <- set_neighbours,clockResetL.CLID_T <- clockReset.CLID_T,clockResetL.CLID_N <- clockReset.CLID_N]]
						 [[setR_goal <- set_goal,setR_n <- set_n,setR_distance <- set_distance,setR_d <- set_d,clockResetR.CLID_C <- clockReset.CLID_C,setR_neighbours <- set_neighbours,clockResetR.CLID_T <- clockReset.CLID_T,clockResetR.CLID_N <- clockReset.CLID_N]]
						)\{terminate} 
					)
					During 		= share__choice(([] e__ : enteredSS @ e__ -> SKIP))
							 	  ; entered -> ((CRUN(enteredSS) ||| true&CALL__closeInOnObject(
							 	  			id__,
							 	  		    const_SimPusher_close,
							 	  		    const_SimPusher_Ta,
							 	  		    const_SimPusher_Tb,
							 	  		    const_SimPusher_Tc,
							 	  		    const_SimPusher_Td,
							 	  		    const_SimPusher_Te,
							 	  		    const_SimPusher_S
							 	  		) ; SStop) /\ interrupt -> share__choice(terminate -> SKIP))
				within
					Inactive [| {terminate} |> SKIP)
				
				Transitions(id__,cycle_SimPusher_SimPusher,
						    const_SimPusher_close,
						    const_SimPusher_Ta,
						    const_SimPusher_Tb,
						    const_SimPusher_Tc,
						    const_SimPusher_Td,
						    const_SimPusher_Te,
						    const_SimPusher_S) = ((let
					Trans = share__choice(get_objectSeen?objectSeen -> get_distance?distance -> get_CLID_T?T -> TimeOut_1(
						 (share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_i0 -> SKIP ;  ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; Watch::enter -> SKIP))))
						 [] dbisim((true)&(endexec__.NID_Watch -> startexec_action -> SKIP ;  share__choice(exit -> SKIP) ; ((let 
						 	X = share__choice(exited -> SKIP [] endexec -> Y)
						 	Y = share__choice(exited -> SKIP [] startexec -> X)
						  within
						  	X) ; ((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; jWatch::enter -> SKIP)))
						 [] dbisim(((not ((((member(objectSeen,{true.d | d <- core_nat}) and (distance>0)) and (T<const_SimPusher_Ta))))))&(internal__!NID_jWatch -> SKIP ; get_objectSeen?b__?x__ -> set_d!x__ -> SKIP
						 ; ((((SKIP)[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; Watch::enter -> SKIP))))
						 [] dbisim((((member(objectSeen,{true.d | d <- core_nat}) and (distance>0)) and (T<const_SimPusher_Ta)))&(internal__!NID_jWatch -> SKIP ; get_objectSeen?b__?x__ -> set_d!x__ -> SKIP
						 ; ((((share__choice(clockReset.CLID_T -> SKIP);share__choice(share__choice(get_d?d -> true & (share__choice(set_distance!d -> SKIP)))))[[ endexec <- endexec_action, startexec <- startexec_action ]]) ; Watch::enter -> SKIP))))
						 []
						 (exit -> SKIP ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
						 []
						 (endexec -> SKIP ; share__choice(startexec -> SKIP))
						 )
					,SKIP);Trans
					)
				within
					Trans [|{terminate}|> SKIP
				)
				)
				
				
				-- Clocks
				Clock_CLID_Watch(id__,x__,
						          const_SimPusher_close,
						          const_SimPusher_Ta,
						          const_SimPusher_Tb,
						          const_SimPusher_Tc,
						          const_SimPusher_Td,
						          const_SimPusher_Te,
						          const_SimPusher_S) = 
