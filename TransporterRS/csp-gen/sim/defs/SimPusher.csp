				    const_SimPusher_Te,
				    const_SimPusher_S) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
		dbisim(
			sbisim(
				dbisim(
					sbisim(
						dbisim(
							sbisim(
								(
									cycle(cycle_SimPusher_SimPusher)
									[| {| endexec,registerWrite,startexec,terminate |} |]
									(
										(
											(startexec -> IteratedStateful_VS_O(id__,cycle_SimPusher_SimPusher,
