				          const_SimPusher_Tc,
				          const_SimPusher_Td,
				          const_SimPusher_Te,
				          const_SimPusher_S))
		[| { terminate } |] (
		dbisim(Clock_CLID_Pushing(id__,0,
				          const_SimPusher_close,
				          const_SimPusher_Ta,
				          const_SimPusher_Tb,
				          const_SimPusher_Tc,
				          const_SimPusher_Td,
				          const_SimPusher_Te,
				          const_SimPusher_S))
		[| { terminate } |] (
		dbisim(Clock_CLID_Evading(id__,0,
				          const_SimPusher_close,
				          const_SimPusher_Ta,
				          const_SimPusher_Tb,
				          const_SimPusher_Tc,
				          const_SimPusher_Td,
				          const_SimPusher_Te,
				          const_SimPusher_S))
		)
		)
		)
		)
		)
		)
		
		stateClockSync = {|get_CLID_Searching,Searching::entered,get_CLID_MovingAround,MovingAround::entered,get_CLID_MovingToObject,MovingToObject::entered,get_CLID_CloseInOnObject,CloseInOnObject::entered,get_CLID_Scanning,Scanning::entered,get_CLID_Pushing,Pushing::entered,get_CLID_Evading,Evading::entered|}
		
		
		-- Shared memory
		-- Shared memory variables
		
		Memory_neighbourDetected(x__) = (
			get_neighbourDetected!x__ -> Memory_neighbourDetected(x__)
			[]
			registerRead.i_neighbourDetected?x__ -> Memory_neighbourDetected(x__)
			[]
			terminate -> SKIP
		)
		Memory_goalSeen(x__) = (
			get_goalSeen!x__ -> Memory_goalSeen(x__)
			[]
			registerRead.i_goalSeen?x__ -> Memory_goalSeen(x__)
			[]
			terminate -> SKIP
		)
		Memory_objectSeen(x__) = (
			get_objectSeen!x__ -> Memory_objectSeen(x__)
			[]
			registerRead.i_objectSeen?x__ -> Memory_objectSeen(x__)
			[]
			terminate -> SKIP
		)
		
		-- sharedVarMemory process
		sharedVarMemory(id__,cycle_SimPusher_SimPusher,
				    const_SimPusher_close,
				    const_SimPusher_Ta,
				    const_SimPusher_Tb,
				    const_SimPusher_Tc,
				    const_SimPusher_Td,
				    const_SimPusher_Te,
				    const_SimPusher_S) = (
		 (terminate -> SKIP
		 )
		 [| { terminate } |]
		 (Memory_neighbourDetected(false.0)
		 [| { terminate } |] (
		 Memory_goalSeen(false)
		 [| { terminate } |] (
		 Memory_objectSeen(false.0)
		 )
		 )
		 )
		)
		
		sharedVarSync = union({|get_neighbourDetected,
		get_goalSeen,
		get_objectSeen|},
			  {||}
			 )
		
		sharedVarHide = union({|get_neighbourDetected,
		get_goalSeen,
		get_objectSeen|},
			  {||}
			 )
		
		}
endmodule
