						 ))
						  [[ share__ <- x__ | x__ <- {| share__,setR_goal,setR_n,setR_distance,setR_d,clockResetR.CLID_C,setR_neighbours,clockResetR.CLID_T,clockResetR.CLID_N |} ]] 
						  [[set_goal <- setL_goal,set_n <- setL_n,set_distance <- setL_distance,set_d <- setL_d,clockReset.CLID_C <- clockResetL.CLID_C,set_neighbours <- setL_neighbours,clockReset.CLID_T <- clockResetL.CLID_T,clockReset.CLID_N <- clockResetL.CLID_N]]
						 )
						 [| union(union(enteredSS,{| interrupt, terminate |}),{|share__
						 			,setL_goal
						 			,setL_n
						 			,setL_distance
						 			,setL_d
						 			,clockResetL.CLID_C
						 			,setL_neighbours
						 			,clockResetL.CLID_T
