						Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
						
						Termination = terminate -> SKIP
						
						Active 		= SKIP ; 
								 	  Behaviour ; 
								 	  share__choice(exit -> SKIP) ; SKIP ; 
								 	  share__choice(exited -> SKIP) ; Inactive
					
						Behaviour 	= entered -> During
						During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
					within
						Inactive [| {terminate} |> SKIP)
					
					
					-- Clocks
					
					StateClocks(id__,
							          const_SimPusher_close,
							          const_SimPusher_Ta,
							          const_SimPusher_Tb,
							          const_SimPusher_Tc,
							          const_SimPusher_Td,
							          const_SimPusher_Te,
							          const_SimPusher_S) = terminate -> SKIP
					
					stateClockSync = {||}
				}
			
			endmodule
			----------------------------------------------------------------------
			
			
			
			Timed(OneStep) {
				--	Rule: behaviours(Node)
				--  Note that FDR has problems with efficiently compiling the process below
				-- 	if using a different recursion pattern.
				D__(id__,cycle_SimPusher_SimPusher,
						    const_SimPusher_close,
						    const_SimPusher_Ta,
						    const_SimPusher_Tb,
						    const_SimPusher_Tc,
						    const_SimPusher_Td,
						    const_SimPusher_Te,
						    const_SimPusher_S) = 
				dbisim(let
					-- IMPLEMENTATION NOTE: 
					-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
					-- however FDR struggles with that form in certain cases. So we use the exception operator
					-- instead to 'terminate'.
					
					Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
					
					Termination = terminate -> SKIP
					
					Active 		= share__choice(true & (share__choice(set_goal!false -> SKIP)));true&CALL__enableGoalFinding(
								id__,
							    const_SimPusher_close,
							    const_SimPusher_Ta,
							    const_SimPusher_Tb,
							    const_SimPusher_Tc,
							    const_SimPusher_Td,
							    const_SimPusher_Te,
							    const_SimPusher_S
							) ; 
							 	  Behaviour ; 
							 	  share__choice(exit -> SKIP) ; true&CALL__disableGoalFinding(
							 	  			id__,
							 	  		    const_SimPusher_close,
							 	  		    const_SimPusher_Ta,
							 	  		    const_SimPusher_Tb,
							 	  		    const_SimPusher_Tc,
							 	  		    const_SimPusher_Td,
							 	  		    const_SimPusher_Te,
							 	  		    const_SimPusher_S
							 	  		) ; 
							 	  share__choice(exited -> SKIP) ; Inactive
				
				
					Behaviour 	= dbisim(
						((
						 (((dbisim(
						 	sbisim(
						 		dbisim(
						 			sbisim(
						 				(let
						 					-- IMPLEMENTATION NOTE:
						 					-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
						 					-- modules for defining the semantics of each node.
						 					enterSS = {|
						 					i0::enter,
						 					NewCycle::enter,
						 					j0::enter,
						 					Watch::enter
						 					|}
						 					hideSet = union(enterSS,{|exit,exited,internal__|})
						 				within 
						 					((let
						 						-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
						 						-- because CSPM modules are used for the semantics of Node.
						 						flowevts = union(enterSS,{|exit,exited|})
						 						transSync = {|internal__.NID_i0,internal__.NID_Watch,internal__.NID_j0,internal__.NID_j0,endexec__.NID_NewCycle|}
						 					within
						 						((
						 						 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
						 						   i0::D__(id__,cycle_SimPusher_SimPusher,
						 						   		    const_SimPusher_close,
						 						   		    const_SimPusher_Ta,
						 						   		    const_SimPusher_Tb,
						 						   		    const_SimPusher_Tc,
						 						   		    const_SimPusher_Td,
						 						   		    const_SimPusher_Te,
						 						   		    const_SimPusher_S)
						 						   [| { share__, terminate } |] (
						 						   NewCycle::D__(id__,cycle_SimPusher_SimPusher,
						 						   		    const_SimPusher_close,
						 						   		    const_SimPusher_Ta,
						 						   		    const_SimPusher_Tb,
						 						   		    const_SimPusher_Tc,
						 						   		    const_SimPusher_Td,
						 						   		    const_SimPusher_Te,
						 						   		    const_SimPusher_S)
						 						   [| { share__, terminate } |] (
						 						   j0::D__(id__,cycle_SimPusher_SimPusher,
						 						   		    const_SimPusher_close,
						 						   		    const_SimPusher_Ta,
						 						   		    const_SimPusher_Tb,
						 						   		    const_SimPusher_Tc,
						 						   		    const_SimPusher_Td,
						 						   		    const_SimPusher_Te,
						 						   		    const_SimPusher_S)
						 						   [| { share__, terminate } |] (
						 						   Watch::D__(id__,cycle_SimPusher_SimPusher,
						 						   		    const_SimPusher_close,
						 						   		    const_SimPusher_Ta,
						 						   		    const_SimPusher_Tb,
						 						   		    const_SimPusher_Tc,
						 						   		    const_SimPusher_Td,
						 						   		    const_SimPusher_Te,
						 						   		    const_SimPusher_S)
						 						   )
						 						   )
						 						   )
						 						 )
						 						 [[NewCycle::interrupt <- x__ | x__ <- {|interrupt,endexec__.NID_NewCycle|}]]
						 						 [[Watch::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_Watch|}]]
						 						 [[i0::interrupt <- x__ | x__ <- {|internal__.NID_i0|}]]
						 						 [[j0::interrupt <- x__ | x__ <- {|internal__.NID_j0,internal__.NID_j0|}]]
						 						 )
						 						  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
						 						 )
						 						 [| union(union(union(flowevts,transSync),{|terminate,endexec,startexec|}),{|share__
						 						|}) |]
						 						 ((i0::enter -> Transitions(id__,cycle_SimPusher_SimPusher,
						 						 		    const_SimPusher_close,
						 						 		    const_SimPusher_Ta,
						 						 		    const_SimPusher_Tb,
						 						 		    const_SimPusher_Tc,
						 						 		    const_SimPusher_Td,
						 						 		    const_SimPusher_Te,
						 						 		    const_SimPusher_S))
						 						  [[ share__ <- x__ | x__ <- {| share__ |} ]]
						 						 )
						 						)
						 						)
						 					)
						 					 \ hideSet)
						 					[[ endexec__.x____  <- endexec | x____ <- NIDS ]]
						 					[[ endexec_action <- endexec ]]
						 					[[ startexec_action <- startexec ]]
						 				)
						 				[| {|get_CLID_Watch,Watch::entered,terminate|} |]
						 				dbisim(Clock_CLID_Watch(id__,0,
						 						          const_SimPusher_close,
						 						          const_SimPusher_Ta,
						 						          const_SimPusher_Tb,
						 						          const_SimPusher_Tc,
						 						          const_SimPusher_Td,
						 						          const_SimPusher_Te,
						 						          const_SimPusher_S))
						 			)\{|get_CLID_Watch|}
						 		)
						 		[| {|get_CLID_NewCycle,NewCycle::entered,terminate|} |]
						 		dbisim(Clock_CLID_NewCycle(id__,0,
						 				          const_SimPusher_close,
