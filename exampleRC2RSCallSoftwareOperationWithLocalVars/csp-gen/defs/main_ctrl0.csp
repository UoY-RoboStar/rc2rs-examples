							 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
							   i::VS_O__(id__,
							   		    const_main_op1_y)
							   [| { share__, terminate } |] (
							   s::VS_O__(id__,
							   		    const_main_op1_y)
							   [| { share__, terminate } |] (
							   f::VS_O__(id__,
							   		    const_main_op1_y)
							   )
							   )
							 )
							 [[s::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s|}]]
							 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
							 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
							 )
							  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
							 )
							 [| union(union(union(flowevts,transSync),{terminate}),{|share__
							|}) |]
							 ((i::enter -> Transitions(id__,
							 		    const_main_op1_y))
							  [[ share__ <- x__ | x__ <- {| share__ |} ]]
							 )
							)
							)
						)
						 \ hideSet)
					)
					 [| {| interrupt |} |] SKIP)
				)
				)
			
			Behaviour_VS_O(id__,
					    const_main_op1_y) = 
				dbisim((MachineBody_VS_O(id__,
						    const_main_op1_y))
				)
			
			IteratedBehaviour_VS_O(id__,
					    const_main_op1_y) = 
				dbisim((MachineBody_VS_O(id__,
						    const_main_op1_y))
				)
			
			Stateful_VS_O(id__,
					    const_main_op1_y) = 
				dbisim((
					(Behaviour_VS_O(id__,
							    const_main_op1_y) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
							    const_main_op1_y))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__,
					    const_main_op1_y) =
				(dbisim(
					sbisim(
						Behaviour_VS_O(id__,
								    const_main_op1_y)
						[| {|get_x,set_x,terminate|} |]
						Memory_x(0)
					)\{|get_x,set_x|}
				)
				)
			
			-- END
			
			-- Memory
			-- Memory variables
			Memory_x(x) =
				get_x!x -> Memory_x(x)
				[]
				set_x?x__ -> Memory_x(x__)
				[]
				terminate -> SKIP
			
			-- varMemory process
			varMemory(id__,
					    const_main_op1_y) = Memory_x(0)
			
			getsetLocalChannels = {|get_x,set_x|}
			
			-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
			FVS__(id__,
					    const_main_op1_y) = STM_VS_O(id__,
					    const_main_op1_y)
			
			D__(id__,
					    const_main_op1_y) = STM(id__,
					    const_main_op1_y) \ internal_events
			O__(id__,
					    const_main_op1_y) = sbisim(diamond(D__(id__,
					    const_main_op1_y)))
			VS__(id__,
					    const_main_op1_y) = FVS__(id__,
					    const_main_op1_y)
			VS_O__(id__,
					    const_main_op1_y) = sbisim(diamond(FVS__(id__,
					    const_main_op1_y)))
			HEXT__(id__,
					    const_main_op1_y) = O__(id__,
					    const_main_op1_y) [|shared_variable_events|] SKIP
			HUP__(id__,
					    const_main_op1_y) = O__(id__,
					    const_main_op1_y) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__,
					    const_main_op1_y) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		
			-- undefined operations
			
			-- declaring controller memory
			Memory(id__) = SKIP
			
			D__(id__,
					   	const_main_ctrl0_opRef_y) = 	((
					let
						const_main_op1_y = const_main_ctrl0_opRef_y
					within 
					stm_ref0::D__(id__,
							    const_main_op1_y)[[
						stm_ref0::terminate <- terminate
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			
			-- VS version
			VS__(id__,
					   	const_main_ctrl0_opRef_y) = 	((
					let
						const_main_op1_y = const_main_ctrl0_opRef_y
					within 
					stm_ref0::VS__(id__,
							    const_main_op1_y)[[
						stm_ref0::terminate <- terminate
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
		
			-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
			O__(id__,
					   	const_main_ctrl0_opRef_y) = sbisim(diamond(	((
					let
						const_main_op1_y = const_main_ctrl0_opRef_y
					within 
					stm_ref0::O__(id__,
							    const_main_op1_y)[[
						stm_ref0::terminate <- terminate
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
							
			-- VS_O version
			VS_O__(id__,
					   	const_main_ctrl0_opRef_y) = sbisim(diamond(	((
					let
						const_main_op1_y = const_main_ctrl0_opRef_y
					within 
					stm_ref0::VS_O__(id__,
							    const_main_op1_y)[[
						stm_ref0::terminate <- terminate
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				dbisim(Memory(id__))
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__,
					   	const_main_ctrl0_opRef_y) = O__(id__,
					   	const_main_ctrl0_opRef_y) [|shared_variable_events|] SKIP			

	endmodule
