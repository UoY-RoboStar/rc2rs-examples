			StateClocks(id__,
					          const_pre_pkg_main_sim_clone_op1_1_y) = dbisim(Clock_CLID_s0(id__,0,
					          const_pre_pkg_main_sim_clone_op1_1_y))
			
			stateClockSync = {|get_CLID_s0,s0::entered|}
			
			}
				endmodule
	
	Timed(OneStep) {
	-- (Rule 8) cycleController(...) : CSPProcess
	SOutputEvents = {}
	
	DVarsEvents = {}
	
	EVarsEvents = {}
	
	cycleController(id__,cycle_pre_pkg_main_sim_ctrl0_ctrl0,
