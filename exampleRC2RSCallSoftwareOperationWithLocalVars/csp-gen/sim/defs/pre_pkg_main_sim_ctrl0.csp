				 			   	const_pre_pkg_main_sim_ctrl0_ctrl0_ref_clone_op1_1_y)
				 	)\{||}
					[| {| 	terminate,tock,
							stm_ref0::endexec|} |]
					-- (Rule 9) composeMachines(...) : CSPProcess
				 	((let
				 		const_pre_pkg_main_sim_clone_op1_1_y = const_pre_pkg_main_sim_ctrl0_ctrl0_ref_clone_op1_1_y
				 		cycle_pre_pkg_main_sim_stm0_stm0 = cycle_pre_pkg_main_sim_ctrl0_ctrl0
