									    const_main_stm0_y) \ {terminate} ; share__choice(terminate -> SKIP))
						 	[[ share__ <- x__ | x__ <- {||} ]]
						)
					[| {share__} |]
					SKIP
					)
					[| union(sharedVarSync,{terminate}) |]
					dbisim(sharedVarMemory(id__,
							    const_main_stm0_y))
				)\sharedVarHide
				
				-- Transitions
				Transitions(id__,
						    const_main_stm0_y) = ((let
					Trans = TimeOut_1(
						 (share__ -> SKIP
						 [] dbisim((true)&(internal__!NID_i -> SKIP ;  ((SKIP ; s::enter -> SKIP))))
						 [] dbisim((true)&(internal__!NID_s -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&CALL__op1(
						 			id__,
						 		    const_main_stm0_y,
						 			const_main_stm0_y
						 		) ; f::enter -> SKIP)))
						 []
						 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
						 []
						 terminate -> SKIP
						 )
					,SKIP);Trans
				within
					Trans [|{terminate}|> SKIP
				)
				)
				
				-- Stateful
				-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
				
				-- Named process definitions
				MachineBody(id__,
						    const_main_stm0_y) = 
					dbisim((
					let
						finalNodesEntered = {|f::entered|}
					within
						(dbisim((dbisim((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							i::enter,
							s::enter,
							f::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i,internal__.NID_s|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   i::D__(id__,
								   		    const_main_stm0_y)
								   [| { share__, terminate } |] (
								   s::D__(id__,
								   		    const_main_stm0_y)
								   [| { share__, terminate } |] (
								   f::D__(id__,
								   		    const_main_stm0_y)
								   )
								   )
								 )
								 [[s::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s|}]]
								 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((i::enter -> Transitions(id__,
								 		    const_main_stm0_y))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
						)
						)
						 [| union(stateClockSync,{terminate}) |]
						 StateClocks(id__,
						 		          const_main_stm0_y)
						)\diff(stateClockSync,enteredSS))
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour(id__,
						    const_main_stm0_y) = 
					dbisim((let
						stateClockSync = {|get_CLID_s,s::entered|}
					 within
						(MachineBody(id__,
								    const_main_stm0_y) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
								          const_main_stm0_y)) \ union(stateClockSync,enteredSS)
					)
					)
				
				IteratedBehaviour(id__,
						    const_main_stm0_y) = 
					dbisim((let
						stateClockSync = {|get_CLID_s,s::entered|}
					 within
						(dbisim(
							sbisim(
								MachineBody(id__,
										    const_main_stm0_y)
								[| {|get_CLID_s,s::entered,terminate|} |]
								dbisim(Clock_CLID_s(id__,0,
										          const_main_stm0_y))
							)\{|get_CLID_s|}
						)
						) \ union(stateClockSync,enteredSS)
					)
					)
				
				Stateful(id__,
						    const_main_stm0_y) = 
					((let
						getsetLocalChannels = {|get_x,set_x|}
						clockSync = {||}
					within
						(Behaviour(id__,
								    const_main_stm0_y) 
						 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
						 (varMemory(id__,
						 		    const_main_stm0_y) [| {terminate} |] Clocks(id__,
						 		          const_main_stm0_y))
					 	)\union(getsetLocalChannels,clockSync)
					)
					)
				
				IteratedStateful(id__,
						    const_main_stm0_y) =
					(dbisim(
						sbisim(
							IteratedBehaviour(id__,
									    const_main_stm0_y)
							[| {|get_x,set_x,terminate|} |]
							Memory_x(0)
						)\{|get_x,set_x|}
					)
					)
				
				-- Visible counterparts
				MachineBody_VS_O(id__,
						    const_main_stm0_y) = 
					dbisim((
					let
						finalNodesEntered = {|f::entered|}
					within
						(dbisim((dbisim((let
							-- IMPLEMENTATION NOTE:
							-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
							-- modules for defining the semantics of each node.
							enterSS = {|
							i::enter,
							s::enter,
							f::enter
							|}
							hideSet = union(enterSS,{|exit,exited,internal__|})
						within 
							((let
								-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
								-- because CSPM modules are used for the semantics of Node.
								flowevts = union(enterSS,{|exit,exited,interrupt|})
								transSync = {|internal__.NID_i,internal__.NID_s|}
							within
								((
								 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
								   i::VS_O__(id__,
								   		    const_main_stm0_y)
								   [| { share__, terminate } |] (
								   s::VS_O__(id__,
								   		    const_main_stm0_y)
								   [| { share__, terminate } |] (
								   f::VS_O__(id__,
								   		    const_main_stm0_y)
								   )
								   )
								 )
								 [[s::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s|}]]
								 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
								 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
								 )
								  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
								 )
								 [| union(union(union(flowevts,transSync),{terminate}),{|share__
								|}) |]
								 ((i::enter -> Transitions(id__,
								 		    const_main_stm0_y))
								  [[ share__ <- x__ | x__ <- {| share__ |} ]]
								 )
								)
								)
							)
							 \ hideSet)
						)
						)
						 [| union(stateClockSync,{terminate}) |]
						 StateClocks(id__,
						 		          const_main_stm0_y)
						)\diff(stateClockSync,enteredSS))
						 [| {| interrupt |} |] SKIP)
					)
					)
				
				Behaviour_VS_O(id__,
						    const_main_stm0_y) = 
					dbisim((let
						stateClockSync = {|get_CLID_s,s::entered|}
					 within
						(MachineBody_VS_O(id__,
								    const_main_stm0_y) [| union(stateClockSync,{terminate}) |] StateClocks(id__,
								          const_main_stm0_y)) \ diff(union(stateClockSync,enteredSS),enteredSS)
					)
					)
				
				IteratedBehaviour_VS_O(id__,
						    const_main_stm0_y) = 
					dbisim((let
						stateClockSync = {|get_CLID_s,s::entered|}
					 within
						(dbisim(
							sbisim(
								MachineBody_VS_O(id__,
										    const_main_stm0_y)
								[| {|get_CLID_s,s::entered,terminate|} |]
								dbisim(Clock_CLID_s(id__,0,
										          const_main_stm0_y))
							)\{|get_CLID_s|}
						)
						) \ diff(union(stateClockSync,enteredSS),enteredSS)
					)
					)
				
				Stateful_VS_O(id__,
						    const_main_stm0_y) = 
					dbisim((let
						getsetLocalChannels = {|get_x,set_x|}
						clockSync = {||}
					within
						(Behaviour_VS_O(id__,
								    const_main_stm0_y) 
						 [| union(union(getsetLocalChannels,clockSync),{terminate}) |] 
						 (varMemory(id__,
						 		    const_main_stm0_y) [| {terminate} |] Clocks(id__,
						 		          const_main_stm0_y))
					 	)\union(getsetLocalChannels,clockSync)
					)
					)
				
				IteratedStateful_VS_O(id__,
						    const_main_stm0_y) =
					(dbisim(
						sbisim(
							IteratedBehaviour_VS_O(id__,
									    const_main_stm0_y)
							[| {|get_x,set_x,terminate|} |]
							Memory_x(0)
						)\{|get_x,set_x|}
					)
					)
				
				-- END
				
				-- Memory
				-- Memory variables
				Memory_x(x) =
					get_x!x -> Memory_x(x)
					[]
					set_x?x__ -> Memory_x(x__)
					[]
					terminate -> SKIP
				
				-- varMemory process
				varMemory(id__,
						    const_main_stm0_y) = Memory_x(0)
				
				getsetLocalChannels = {|get_x,set_x|}
				
				-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
				FVS__(id__,
						    const_main_stm0_y) = STM_VS_O(id__,
						    const_main_stm0_y) \ localClockResets
				D__(id__,
						    const_main_stm0_y) = timed_priority(STM(id__,
						    const_main_stm0_y) \ union(internal_events,localClockResets))
				O__(id__,
						    const_main_stm0_y) = dbisim(D__(id__,
						    const_main_stm0_y))
				VS__(id__,
						    const_main_stm0_y) = FVS__(id__,
						    const_main_stm0_y)
				VS_O__(id__,
						    const_main_stm0_y) = dbisim(FVS__(id__,
						    const_main_stm0_y))
				HEXT__(id__,
						    const_main_stm0_y) = O__(id__,
						    const_main_stm0_y) [|shared_variable_events|] SKIP
				FVS_C__(id__,
						    const_main_stm0_y) = dbisim(timed_priority(STM(id__,
						    const_main_stm0_y) \ internal_events))
				HUP__(id__,
						    const_main_stm0_y) = timed_priority(O__(id__,
						    const_main_stm0_y) [|{share__}|] SKIP)
				
				-- Clocks
				
				Clocks(id__,
						          const_main_stm0_y) = terminate -> SKIP
				
				clockSync = {||}
				
				Clock_CLID_s(id__,x__,
						          const_main_stm0_y) = 
					TimeOut_1(
						s::entered -> Clock_CLID_s(id__,0,
								          const_main_stm0_y)
						[]
						get_CLID_s!x__ -> Clock_CLID_s(id__,x__,
								          const_main_stm0_y)
						[]
						terminate -> SKIP,Clock_CLID_s(id__,clock_type_plus(x__,1,CLID_s_clock_type(id__,
								          const_main_stm0_y)),
								          const_main_stm0_y))
				
				StateClocks(id__,
						          const_main_stm0_y) = dbisim(Clock_CLID_s(id__,0,
						          const_main_stm0_y))
				
				stateClockSync = {|get_CLID_s,s::entered|}
				
				-- Shared memory
				-- Shared memory variables
				
				-- sharedVarMemory process
				sharedVarMemory(id__,
						    const_main_stm0_y) = terminate -> SKIP
				
				sharedVarSync = {||}
				
				sharedVarHide = {||}
				}
		endmodule
		
		Timed(OneStep) {
				-- undefined operations
				
				-- declaring controller memory
				Memory(id__) = SKIP
				
				D__(id__,
						    const_main_ctrl0_stm_ref0_y) = prioritise(	((
						let
							const_main_stm0_y = const_main_ctrl0_stm_ref0_y
						within 
						stm_ref0::D__(id__,
								    const_main_stm0_y)[[
							stm_ref0::terminate <- terminate
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>)
				
				-- VS version
				VS__(id__,
						    const_main_ctrl0_stm_ref0_y) = prioritise(	((
						let
							const_main_stm0_y = const_main_ctrl0_stm_ref0_y
						within 
						stm_ref0::VS__(id__,
								    const_main_stm0_y)[[
							stm_ref0::terminate <- terminate
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					Memory(id__)
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>)
			
				-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
				O__(id__,
						    const_main_ctrl0_stm_ref0_y) = dbisim(prioritise(	((
						let
							const_main_stm0_y = const_main_ctrl0_stm_ref0_y
						within 
						stm_ref0::O__(id__,
								    const_main_stm0_y)[[
							stm_ref0::terminate <- terminate
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					dbisim(Memory(id__))
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>))
								
				-- VS_O version
				VS_O__(id__,
						    const_main_ctrl0_stm_ref0_y) = dbisim(prioritise(	((
						let
							const_main_stm0_y = const_main_ctrl0_stm_ref0_y
						within 
						stm_ref0::VS_O__(id__,
								    const_main_stm0_y)[[
							stm_ref0::terminate <- terminate
						]]
					)
						[|
							union(
								{|
								|},
								{|
								|}
							)
						|]
					dbisim(Memory(id__))
				)
				\ union(
					{|
					|},
					{|
					|}
				)
				[|{|terminate|}|>SKIP
				,<visibleMemoryEvents,{tock}>))
			
				HEXT(id__,
						    const_main_ctrl0_stm_ref0_y) = O__(id__,
						    const_main_ctrl0_stm_ref0_y) [|shared_variable_events|] SKIP			
		}

	endmodule
