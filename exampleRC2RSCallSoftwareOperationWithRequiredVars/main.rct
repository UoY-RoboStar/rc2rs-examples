package main




interface IOps{
	op1()
}

controller ctrl0 {

	
	opref opRef = op1 
sref stm_ref0 = stm0

}

module mod0 {
	robotic platform rp0 {

		
	}

	cref ctrl_ref0 = ctrl0

}

stm stm0 {
	

	requires IOps
var x:int
const y:int
initial i
state s{
}
final f
transition t{
	from i to s
}
transition t2{
	from s to f
	action op1()
}
}

interface Ivars{
	var x:int
const y:int
}

operation op1(){
	
	requires Ivars
	initial i
	final f
	state s0 {
	}

	transition t0 {
		from i
		to s0
	}
	transition t1 {
		from s0
		to f
		condition x>y
	}
}
