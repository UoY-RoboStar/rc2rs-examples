package main


interface I1{
	event ev1
}



controller ctrl0 {
	
	uses I1
sref stm_ref0 = stm0

connection ctrl0 on ev1 to stm_ref0 on ev1
}

module mod0 {
	robotic platform rp0 {
		uses I1
	}

	cref ctrl_ref0 = ctrl0
connection rp0 on ev1 to ctrl_ref0 on ev1 ( _async )
}

stm stm0 {
	uses I1
	

initial i
state s{
	

initial i0
		final f0
		transition t0 {
			from i0
			to f0
		}
	}
final f
transition t{
	from i to s
}
transition t2{
	from s to f
	trigger ev1 
	}
}



