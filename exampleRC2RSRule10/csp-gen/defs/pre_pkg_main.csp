	-- END
	
	-- Memory
	-- Memory variables
	Memory_x(x) =
		get_x!x -> Memory_x(x)
		[]
		set_x?x__ -> Memory_x(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_pre_pkg_main_clone_op_3_n) = Memory_x(0)
	
	getsetLocalChannels = {|get_x,set_x|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_pre_pkg_main_clone_op_3_n) = STM_VS_O(id__,
			    const_pre_pkg_main_clone_op_3_n)
	
	D__(id__,
			    const_pre_pkg_main_clone_op_3_n) = STM(id__,
			    const_pre_pkg_main_clone_op_3_n) \ internal_events
	O__(id__,
			    const_pre_pkg_main_clone_op_3_n) = sbisim(diamond(D__(id__,
			    const_pre_pkg_main_clone_op_3_n)))
	VS__(id__,
			    const_pre_pkg_main_clone_op_3_n) = FVS__(id__,
			    const_pre_pkg_main_clone_op_3_n)
	VS_O__(id__,
			    const_pre_pkg_main_clone_op_3_n) = sbisim(diamond(FVS__(id__,
