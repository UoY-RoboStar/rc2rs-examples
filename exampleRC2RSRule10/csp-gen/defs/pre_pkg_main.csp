			-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
			O__(id__,
					    const_pre_pkg_main_ctrl0_stm_ref0_n,
					   	const_pre_pkg_main_ctrl0_op1_n,
					   	const_pre_pkg_main_ctrl0_ctrl0_ref_clone_op_3_n) = sbisim(diamond(	((
					let
						const_pre_pkg_main_stm0_n = const_pre_pkg_main_ctrl0_stm_ref0_n
						const_pre_pkg_main_op_n = const_pre_pkg_main_ctrl0_op1_n
						const_pre_pkg_main_clone_op_3_n = const_pre_pkg_main_ctrl0_ctrl0_ref_clone_op_3_n
