			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_pre_pkg_main_stm0_n) = 
		dbisim((MachineBody_VS_O(id__,
				    const_pre_pkg_main_stm0_n))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_pre_pkg_main_stm0_n) = 
		dbisim((MachineBody_VS_O(id__,
				    const_pre_pkg_main_stm0_n))
		)
	
	Stateful_VS_O(id__,
			    const_pre_pkg_main_stm0_n) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_pre_pkg_main_stm0_n) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_pre_pkg_main_stm0_n))
