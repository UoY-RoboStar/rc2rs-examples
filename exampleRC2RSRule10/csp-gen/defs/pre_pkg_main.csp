						    const_pre_pkg_main_stm0_n,
						    const_pre_pkg_main_op_n,
						    const_pre_pkg_main_clone_op_3_n))
				)
			
			Stateful_VS_O(id__,
					    const_pre_pkg_main_stm0_n,
					    const_pre_pkg_main_op_n,
					    const_pre_pkg_main_clone_op_3_n) = 
				dbisim((
					(Behaviour_VS_O(id__,
							    const_pre_pkg_main_stm0_n,
							    const_pre_pkg_main_op_n,
							    const_pre_pkg_main_clone_op_3_n) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
							    const_pre_pkg_main_stm0_n,
							    const_pre_pkg_main_op_n,
							    const_pre_pkg_main_clone_op_3_n))
				 	\getsetLocalChannels
				)
				)
			
			IteratedStateful_VS_O(id__,
					    const_pre_pkg_main_stm0_n,
