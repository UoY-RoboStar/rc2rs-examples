		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_pre_pkg_main_stm0_n) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_pre_pkg_main_stm0_n)
				[| {|get_x,set_x,terminate|} |]
				Memory_x(0)
			)\{|get_x,set_x|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_x(x) =
		get_x!x -> Memory_x(x)
		[]
		set_x?x__ -> Memory_x(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_pre_pkg_main_stm0_n) = Memory_x(0)
	
	getsetLocalChannels = {|get_x,set_x|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_pre_pkg_main_stm0_n) = STM_VS_O(id__,
			    const_pre_pkg_main_stm0_n)
	
	D__(id__,
			    const_pre_pkg_main_stm0_n) = STM(id__,
			    const_pre_pkg_main_stm0_n) \ internal_events
	O__(id__,
			    const_pre_pkg_main_stm0_n) = sbisim(diamond(D__(id__,
			    const_pre_pkg_main_stm0_n)))
	VS__(id__,
			    const_pre_pkg_main_stm0_n) = FVS__(id__,
			    const_pre_pkg_main_stm0_n)
	VS_O__(id__,
			    const_pre_pkg_main_stm0_n) = sbisim(diamond(FVS__(id__,
			    const_pre_pkg_main_stm0_n)))
	HEXT__(id__,
			    const_pre_pkg_main_stm0_n) = O__(id__,
			    const_pre_pkg_main_stm0_n) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_pre_pkg_main_stm0_n) = O__(id__,
			    const_pre_pkg_main_stm0_n) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_pre_pkg_main_stm0_n) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule

-- compileSelfContainedOperation
module OP_op
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_i|
	              NID_s|
	              NID_f
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_x, set_x, setL_x, setR_x: core_int
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	
	-- Declaring call and ret events for undefined operations
	
	enterSS = {|
	i::enter,
	s::enter,
	f::enter
	|}
	
	enteredSS = 	{|
	s::entered,
	f::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
		, share__
		|}
	
