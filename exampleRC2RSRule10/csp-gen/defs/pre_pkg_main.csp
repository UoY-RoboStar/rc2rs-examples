	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_pre_pkg_main_clone_op_3_n) = 
		dbisim((
		let
			finalNodesEntered = {|f::entered|}
