			 	 [] dbisim(((x>const_pre_pkg_main_clone_op_3_n))&(internal__!NID_s -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; SKIP ; f::enter -> SKIP)))
			 ) ; Trans)
