			HEXT__(id__,
					    const_pre_pkg_main_stm0_n,
					    const_pre_pkg_main_op_n,
					    const_pre_pkg_main_clone_op_3_n) = O__(id__,
					    const_pre_pkg_main_stm0_n,
					    const_pre_pkg_main_op_n,
					    const_pre_pkg_main_clone_op_3_n) [|shared_variable_events|] SKIP
			HUP__(id__,
					    const_pre_pkg_main_stm0_n,
					    const_pre_pkg_main_op_n,
					    const_pre_pkg_main_clone_op_3_n) = O__(id__,
					    const_pre_pkg_main_stm0_n,
					    const_pre_pkg_main_op_n,
					    const_pre_pkg_main_clone_op_3_n) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__,
					    const_pre_pkg_main_stm0_n,
					    const_pre_pkg_main_op_n,
					    const_pre_pkg_main_clone_op_3_n) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		
			-- undefined operations
			
			-- declaring controller memory
			Memory(id__) = SKIP
			
			D__(id__,
					    const_pre_pkg_main_ctrl0_stm_ref0_n,
					   	const_pre_pkg_main_ctrl0_op1_n,
					   	const_pre_pkg_main_ctrl0_ctrl0_ref_clone_op_3_n) = 	((
