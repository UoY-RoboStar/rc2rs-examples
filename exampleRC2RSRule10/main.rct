package main

interface IOps{
	op()
}


 
controller ctrl0 {
	
	
sref stm_ref0 = stm0
opref op1 = op

}

operation op(){
	var x : int
	const n:int
	initial i
	state s{}
	final f
	transition t1{
		from i to s
	}
	transition t2{
		
		from s to f
		condition x>n
	}
}

module mod0 {
	robotic platform rp0 {
	
		
	}

	cref ctrl_ref0 = ctrl0

}

stm stm0 {
	requires IOps
	
	clock C

initial i
state S{
	
	}
final f
transition t{
	from i to S
}
transition t2{
	from S to f
	# C
		condition x > n
		action 
	op ( ) ; skip
	}
var x : int
	const n : int

	clock C2
}

