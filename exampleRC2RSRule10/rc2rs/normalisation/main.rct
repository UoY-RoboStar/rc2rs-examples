	normal_stm0_S_t2_op_j_2_2_t_2_2_op ( )
}

controller ctrl0 {
	opref op1 = op
	opref ctrl0_ref_normal_stm0_S_t2_op = normal_stm0_S_t2_op
	opref ctrl0_ref_tStop = tStop
	opref ctrl0_ref_deadlineCheck = deadlineCheck
	opref ctrl0_ref_waitOp = waitOp
