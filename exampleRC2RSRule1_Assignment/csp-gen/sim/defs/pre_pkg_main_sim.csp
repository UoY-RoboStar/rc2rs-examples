	-- (Rule 8) cycleController(...) : CSPProcess
	datatype SOutputEvents = SOutput_op
	
	DVarsEvents = {}
	
	EVarsEvents = {}
	
	cycleController(id__,cycle_pre_pkg_main_sim_ctrl0_ctrl0,
			    const_pre_pkg_main_sim_ctrl0_stm_ref0_n) =
	let
				
		project_stm_ref0(stm_ref0::o_op) = SOutput_op
	
		connected_stm_ref0(stm_ref0::o_op) = true
		connected_stm_ref0(_) = false
	
		lift_stm_ref0(stm_ref0::o_op) = o_op
		
		CycleController =
			Deadline(
			-- read inputs from the controller and pass to state machines
			(
			((registerRead.i_ev1?x__ ->
				((stm_ref0::registerRead.stm_ref0::i_ev1!x__ -> SKIP))))
			-- ensure state machines read the values being communicated via evars
					);
			-- synchronize on events related to evars to erase memory
			-- collect outputs, and monitor termination of the cycle, by all controllers
			(CollectOutputs(SOutputEvents) [| {endexec} |] Monitor),0);
			-- wait for the cycleDef period
			TimeOut_1(terminate -> SKIP,WAIT(cycle_pre_pkg_main_sim_ctrl0_ctrl0-1));
			-- recurse
