package main

interface IOps{
	op()
}

interface I1{
	event ev1
}
 
controller ctrl0 {
	requires IOps
	uses I1
sref stm_ref0 = stm0

connection ctrl0 on ev1 to stm_ref0 on ev1
}


module mod0 {
	robotic platform rp0 {
		uses I1
		provides IOps
	}

	cref ctrl_ref0 = ctrl0
connection rp0 on ev1 to ctrl_ref0 on ev1 ( _async )
}

stm stm0 {
	requires IOps
	uses I1
	clock C

initial i
state s{
	
	}
final f
transition t{
	from i to s
}
transition t2{
	from s to f
	trigger  
	ev1
		# C
		condition x > n
		action x=n+x
	}
var x : int
	const n : int
}

