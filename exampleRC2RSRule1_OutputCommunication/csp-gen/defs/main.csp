			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
							
			-- VS_O version
			VS_O__(id__,
					    const_main_ctrl0_stm_ref0_n) = sbisim(diamond(	((
					let
						const_main_stm0_n = const_main_ctrl0_stm_ref0_n
					within 
