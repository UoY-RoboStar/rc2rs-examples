			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			))
		
			HEXT(id__,
					    const_main_ctrl0_stm_ref0_n) = O__(id__,
					    const_main_ctrl0_stm_ref0_n) [|shared_variable_events|] SKIP			

	endmodule


module stm0
exports
	transparent diamond
	transparent sbisim
	transparent dbisim
	transparent chase

	-- Transition identifiers
	-- declaring identifiers of transitions
	datatype NIDS = 
	              NID_i|
	              NID_s|
	              NID_f
	
	channel internal__ : NIDS
	
	-- Flow channels		
	channel interrupt
	channel exited
	channel exit
	channel terminate
	
	-- Variable channels
	channel get_x, set_x, setL_x, setR_x: core_int
	
	-- Shared variable channels
	
	-- Local variable channels for defined operations that are required by the state machine
	
	-- Declaring state machine events
	channel ev1__: NIDS.InOut
	channel ev1: InOut
	
	-- Declaring call and ret events for undefined operations
	channel opCall
	
	enterSS = {|
	i::enter,
	s::enter,
	f::enter
	|}
	
	enteredSS = 	{|
	s::entered,
	f::entered
	|}
	
	internal_events = union(enteredSS,union(enterSS,{|interrupt,exited|}))
	
	shared_variable_events = {|
	|}
	
	-- channel set with all visible events
	sem__events = {|
		terminate
	,	ev1
	,	opCall
		|}

	-- Nodes --
	-- declaring all nodes
	
	----------------------------------------------------------------------
	-- Initial: i
	module i
	exports
	
		channel enter, interrupt
		
		D__(id__,
				    const_main_stm0_n) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
				
				Termination = terminate -> SKIP
				
				Active 		= share__choice(interrupt -> SKIP) ; Inactive
			within
				Inactive [| {terminate} |> SKIP)
		
		VS_O__(id__,
				    const_main_stm0_n) = D__(id__,
				    const_main_stm0_n)
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- State: s
	module s
	
	enterSS = {}
	
	enteredSS = {}
	
	exports
	
		--  Declarations
		
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
						
		
		--	Nodes
		-- declaring all nodes
		
		
		--	Rule: behaviours(Node)
		--  Note that FDR has problems with efficiently compiling the process below
		-- 	if using a different recursion pattern.
		D__(id__,
				    const_main_stm0_n) = 
		dbisim(let
			-- IMPLEMENTATION NOTE: 
			-- The following should be defined as: Inactive = share__choice(Activation [] Termination),
			-- however FDR struggles with that form in certain cases. So we use the exception operator
			-- instead to 'terminate'.
			
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_main_stm0_n) = 
		dbisim(let
			Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Active
			
			Termination = terminate -> SKIP
			
			Active 		= SKIP ; 
					 	  Behaviour ; 
					 	  share__choice(exit -> SKIP) ; SKIP ; 
					 	  share__choice(exited -> SKIP) ; Inactive
		
			Behaviour 	= entered -> During
			During 		= ((SKIP ; SStop) /\ interrupt -> SKIP)
		within
			Inactive [| {terminate} |> SKIP)
		
	
	endmodule
	----------------------------------------------------------------------
	
	
	----------------------------------------------------------------------
	-- Final state: f
	module f
	
	exports
	
		channel enter, entered, interrupt
		channel enteredL, enteredR
		
		--	Rule: behaviours(Node)
		D__(id__,
				    const_main_stm0_n) = 
			dbisim(let
				Inactive 	= share__choice(enter -> SKIP [] terminate -> SKIP) ; Entering
				
				Entering 	= entered -> SKIP ; Active
				Active		= share__choice(terminate -> SKIP [] interrupt -> SKIP) ; Interrupted
				Interrupted	= share__choice(exit -> exited -> Inactive)
			within
				Inactive [| {terminate} |> SKIP)
			
		VS_O__(id__,
				    const_main_stm0_n) = D__(id__,
				    const_main_stm0_n)
	
	endmodule
	----------------------------------------------------------------------
	
	-- END of Nodes --
	
	-- Operation calls --
	-- Only the undefined operations are declared here.
	-- If the state machine is in isolation, all required operations will be undefined.
	-- If it is in the context of a controller, the required operations not provided by the
	-- controller will be declared here, and the defined operations will be defined in the
	-- context of the Controller module, and therefore within scope of the state machine module.
	CALL__op(id__,
			    const_main_stm0_n) 	= opCall -> SKIP
	
	-- END of Operation calls --
	
	-- STM processes
	STM(id__,
			    const_main_stm0_n) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful(id__,
						    const_main_stm0_n) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_main_stm0_n))
	)\sharedVarHide
	
	STM_VS_O(id__,
			    const_main_stm0_n) = -- RULE: [[stm:StateMachineDef]]_STM^nops : CSPProcess
	( 
		(
			(
				(IteratedStateful_VS_O(id__,
						    const_main_stm0_n) \ {terminate} ; share__choice(terminate -> SKIP))
			 	[[ share__ <- x__ | x__ <- {||} ]]
			)
		[| {share__} |]
		SKIP
		)
		[| union(sharedVarSync,{terminate}) |]
		dbisim(sharedVarMemory(id__,
				    const_main_stm0_n))
	)\sharedVarHide
	
	-- Transitions
	Transitions(id__,
			    const_main_stm0_n) = ((let
		Trans = share__choice(get_x?x -> (
			((share__ -> SKIP
			 [] dbisim((true)&(internal__!NID_i -> SKIP ;  ((SKIP ; s::enter -> SKIP))))
			 	 [] dbisim(((x>const_main_stm0_n))&(internal__!NID_s -> SKIP ;  share__choice(exit -> SKIP) ; (share__choice(exited -> SKIP) ; true&(share__choice(ev1.out -> SKIP)) ; f::enter -> SKIP)))
			 ) ; Trans)
			 []
			 (interrupt -> share__choice(exit -> SKIP) ; share__choice(exited -> terminate -> SKIP))
			 []
			 terminate -> SKIP
		)
		)
	within
		Trans
	)
	)
	
	-- Stateful
	-- RULE: Stateful(stm:StateMachineBody) : CSPProcess
	
	-- Named process definitions
	MachineBody(id__,
			    const_main_stm0_n) = 
		dbisim((
		let
			finalNodesEntered = {|f::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i::enter,
				s::enter,
				f::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i,internal__.NID_s|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   i::D__(id__,
					   		    const_main_stm0_n)
					   [| { share__, terminate } |] (
					   s::D__(id__,
					   		    const_main_stm0_n)
					   [| { share__, terminate } |] (
					   f::D__(id__,
					   		    const_main_stm0_n)
					   )
					   )
					 )
					 [[s::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s|}]]
					 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_x <- setL_x]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_x
					|}) |]
					 ((i::enter -> Transitions(id__,
					 		    const_main_stm0_n))
					  [[ share__ <- x__ | x__ <- {| share__,setL_x |} ]]
					 )
					)[[setL_x <- set_x]]
					)
				)
				 \ hideSet)
				[[
					ev1__.x____ <- ev1
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour(id__,
			    const_main_stm0_n) = 
		dbisim((MachineBody(id__,
				    const_main_stm0_n)\ enteredSS)
		)
	
	IteratedBehaviour(id__,
			    const_main_stm0_n) = 
		dbisim((MachineBody(id__,
				    const_main_stm0_n)\ enteredSS)
		)
	
	Stateful(id__,
			    const_main_stm0_n) = 
		((
			(Behaviour(id__,
					    const_main_stm0_n) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_main_stm0_n))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful(id__,
			    const_main_stm0_n) =
		(dbisim(
			sbisim(
				Behaviour(id__,
						    const_main_stm0_n)
				[| {|get_x,set_x,terminate|} |]
				Memory_x(0)
			)\{|get_x,set_x|}
		)
		)
	
	-- Visible counterparts
	MachineBody_VS_O(id__,
			    const_main_stm0_n) = 
		dbisim((
		let
			finalNodesEntered = {|f::entered|}
		within
			((let
				-- IMPLEMENTATION NOTE:
				-- Here the 'enter' channel set is calculated explicitly because of the use of CSPM 
				-- modules for defining the semantics of each node.
				enterSS = {|
				i::enter,
				s::enter,
				f::enter
				|}
				hideSet = union(enterSS,{|exit,exited,internal__|})
			within 
				((let
					-- IMPLEMENTATION NOTE: the channel set 'enter' is calculated explicitly
					-- because CSPM modules are used for the semantics of Node.
					flowevts = union(enterSS,{|exit,exited,interrupt|})
					transSync = {|internal__.NID_i,internal__.NID_s|}
				within
					((
					 (((-- RULE composeNodes(nc:NodeContainer)^nops : CSPProcess
					   i::VS_O__(id__,
					   		    const_main_stm0_n)
					   [| { share__, terminate } |] (
					   s::VS_O__(id__,
					   		    const_main_stm0_n)
					   [| { share__, terminate } |] (
					   f::VS_O__(id__,
					   		    const_main_stm0_n)
					   )
					   )
					 )
					 [[s::interrupt <- x__ | x__ <- {|interrupt,internal__.NID_s|}]]
					 [[f::interrupt <- x__ | x__ <- {|interrupt|}]]
					 [[i::interrupt <- x__ | x__ <- {|internal__.NID_i|}]]
					 )
					  [[ share__ <- x__ | x__ <- {| share__ |} ]] 
					  [[set_x <- setL_x]]
					 )
					 [| union(union(union(flowevts,transSync),{terminate}),{|share__
					 			,setL_x
					|}) |]
					 ((i::enter -> Transitions(id__,
					 		    const_main_stm0_n))
					  [[ share__ <- x__ | x__ <- {| share__,setL_x |} ]]
					 )
					)[[setL_x <- set_x]]
					)
				)
				 \ hideSet)
				[[
					ev1__.x____ <- ev1
					| x____ <- NIDS
				]]
			)
			 [| {| interrupt |} |] SKIP)
		)
		)
	
	Behaviour_VS_O(id__,
			    const_main_stm0_n) = 
		dbisim((MachineBody_VS_O(id__,
				    const_main_stm0_n))
		)
	
	IteratedBehaviour_VS_O(id__,
			    const_main_stm0_n) = 
		dbisim((MachineBody_VS_O(id__,
				    const_main_stm0_n))
		)
	
	Stateful_VS_O(id__,
			    const_main_stm0_n) = 
		dbisim((
			(Behaviour_VS_O(id__,
					    const_main_stm0_n) [| union(getsetLocalChannels,{terminate}) |] varMemory(id__,
					    const_main_stm0_n))
		 	\getsetLocalChannels
		)
		)
	
	IteratedStateful_VS_O(id__,
			    const_main_stm0_n) =
		(dbisim(
			sbisim(
				Behaviour_VS_O(id__,
						    const_main_stm0_n)
				[| {|get_x,set_x,terminate|} |]
				Memory_x(0)
			)\{|get_x,set_x|}
		)
		)
	
	-- END
	
	-- Memory
	-- Memory variables
	Memory_x(x) =
		get_x!x -> Memory_x(x)
		[]
		set_x?x__ -> Memory_x(x__)
		[]
		terminate -> SKIP
	
	-- varMemory process
	varMemory(id__,
			    const_main_stm0_n) = Memory_x(0)
	
	getsetLocalChannels = {|get_x,set_x|}
	
	-- Definition of the behaviour of state machines (default, optimised, visible, visible and optimised)
	FVS__(id__,
			    const_main_stm0_n) = STM_VS_O(id__,
			    const_main_stm0_n)
	
	D__(id__,
			    const_main_stm0_n) = STM(id__,
			    const_main_stm0_n) \ internal_events
	O__(id__,
			    const_main_stm0_n) = sbisim(diamond(D__(id__,
			    const_main_stm0_n)))
	VS__(id__,
			    const_main_stm0_n) = FVS__(id__,
			    const_main_stm0_n)
	VS_O__(id__,
			    const_main_stm0_n) = sbisim(diamond(FVS__(id__,
			    const_main_stm0_n)))
	HEXT__(id__,
			    const_main_stm0_n) = O__(id__,
			    const_main_stm0_n) [|shared_variable_events|] SKIP
	HUP__(id__,
			    const_main_stm0_n) = O__(id__,
			    const_main_stm0_n) [|{share__}|] SKIP
	
	-- Shared memory
	-- Shared memory variables
	
	-- sharedVarMemory process
	sharedVarMemory(id__,
			    const_main_stm0_n) = terminate -> SKIP
	
	sharedVarSync = {||}
	
	sharedVarHide = {||}
endmodule


endmodule
