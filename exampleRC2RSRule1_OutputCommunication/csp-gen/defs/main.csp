					    const_main_stm0_n) = O__(id__,
					    const_main_stm0_n) [|shared_variable_events|] SKIP
			HUP__(id__,
					    const_main_stm0_n) = O__(id__,
					    const_main_stm0_n) [|{share__}|] SKIP
			
			-- Shared memory
			-- Shared memory variables
			
			-- sharedVarMemory process
			sharedVarMemory(id__,
					    const_main_stm0_n) = terminate -> SKIP
			
			sharedVarSync = {||}
			
			sharedVarHide = {||}
		endmodule
		
			-- undefined operations
			CALL__op(id__) 	= opCall -> SKIP
			
			-- declaring controller memory
			Memory(id__) = SKIP
			
			D__(id__,
					    const_main_ctrl0_stm_ref0_n) = 	((
					let
						const_main_stm0_n = const_main_ctrl0_stm_ref0_n
