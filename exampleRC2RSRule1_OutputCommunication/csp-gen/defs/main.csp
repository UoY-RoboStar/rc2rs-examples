							    const_main_stm0_n)[[
						stm_ref0::terminate <- terminate,
						stm_ref0::ev1 <- ev1,
						stm_ref0::opCall <- opCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
			
			-- VS version
			VS__(id__,
					    const_main_ctrl0_stm_ref0_n) = 	((
					let
						const_main_stm0_n = const_main_ctrl0_stm_ref0_n
					within 
					stm_ref0::VS__(id__,
							    const_main_stm0_n)[[
						stm_ref0::terminate <- terminate,
						stm_ref0::ev1 <- ev1,
						stm_ref0::opCall <- opCall
					]]
				)
					[|
						union(
							{|
							|},
							{|
							|}
						)
					|]
				Memory(id__)
			)
			\ union(
				{|
				|},
				{|
				|}
			)
			[|{|terminate|}|>SKIP
		
			-- O version (optimised) THESE TWO PROCESSES SHOULD BE KEPT IN SYNC WITH THE ABOVE TWO
			O__(id__,
					    const_main_ctrl0_stm_ref0_n) = sbisim(diamond(	((
					let
						const_main_stm0_n = const_main_ctrl0_stm_ref0_n
