					HEXT__(id__,
							    const_main_stm0_n) = O__(id__,
							    const_main_stm0_n) [|shared_variable_events|] SKIP
					FVS_C__(id__,
							    const_main_stm0_n) = dbisim(timed_priority(STM(id__,
							    const_main_stm0_n) \ internal_events))
					HUP__(id__,
							    const_main_stm0_n) = timed_priority(O__(id__,
							    const_main_stm0_n) [|{share__}|] SKIP)
					
					-- Clocks
					Clock_CLID_C2(id__,x__,
							          const_main_stm0_n) = 
						TimeOut_1(
							clockReset.CLID_C2 -> Clock_CLID_C2(id__,0,
									          const_main_stm0_n)
							[]
							get_CLID_C2!x__ -> Clock_CLID_C2(id__,x__,
									          const_main_stm0_n)
							[]
							terminate -> SKIP,Clock_CLID_C2(id__,clock_type_plus(x__,1,CLID_C2_clock_type(id__,
									          const_main_stm0_n)),
									          const_main_stm0_n))
					Clock_CLID_C(id__,x__,
							          const_main_stm0_n) = 
						TimeOut_1(
							clockReset.CLID_C -> Clock_CLID_C(id__,0,
									          const_main_stm0_n)
							[]
							get_CLID_C!x__ -> Clock_CLID_C(id__,x__,
									          const_main_stm0_n)
							[]
							terminate -> SKIP,Clock_CLID_C(id__,clock_type_plus(x__,1,CLID_C_clock_type(id__,
									          const_main_stm0_n)),
									          const_main_stm0_n))
					
					Clocks(id__,
							          const_main_stm0_n) = dbisim(Clock_CLID_C2(id__,0,
							          const_main_stm0_n))
					[| { terminate } |] (
					dbisim(Clock_CLID_C(id__,0,
							          const_main_stm0_n))
					)
					
					clockSync = {|get_CLID_C2,clockReset.CLID_C2,get_CLID_C,clockReset.CLID_C|}
					
					Clock_CLID_S(id__,x__,
							          const_main_stm0_n) = 
						TimeOut_1(
							S::entered -> Clock_CLID_S(id__,0,
									          const_main_stm0_n)
							[]
							get_CLID_S!x__ -> Clock_CLID_S(id__,x__,
									          const_main_stm0_n)
							[]
							terminate -> SKIP,Clock_CLID_S(id__,clock_type_plus(x__,1,CLID_S_clock_type(id__,
									          const_main_stm0_n)),
									          const_main_stm0_n))
					
					StateClocks(id__,
							          const_main_stm0_n) = dbisim(Clock_CLID_S(id__,0,
							          const_main_stm0_n))
					
					stateClockSync = {|get_CLID_S,S::entered|}
					
					-- Shared memory
					-- Shared memory variables
					
					-- sharedVarMemory process
					sharedVarMemory(id__,
							    const_main_stm0_n) = terminate -> SKIP
					
					sharedVarSync = {||}
					
					sharedVarHide = {||}
					}
			endmodule
			
